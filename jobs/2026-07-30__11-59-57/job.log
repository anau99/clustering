Sending keys: ['cat > /app/run_cluster.py <<\'PY\'\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.decomposition import PCA\nfrom sklearn.cluster import KMeans\nfrom sklearn.metrics import silhouette_score\n\n\ndef select_kmeans(X, seeds=(0, 1, 2, 3, 4, 7, 11, 42, 101, 202), min_prop=0.1):\n    """Pick KMeans run by silhouette on PCA space with a penalty for tiny clusters."""\n    # PCA for speed/stability in silhouette computation\n    n_comp = int(min(10, X.shape[1]))\n    Z = PCA(n_components=n_comp, random_state=0).fit_transform(X)\n\n    best = None\n    best_score = -1e9\n\n    for seed in seeds:\n        km = KMeans(n_clusters=2, n_init=50, random_state=seed)\n        lab = km.fit_predict(X)\n\n        # balance penalty\n        counts = np.bincount(lab, minlength=2)\n        props = counts / counts.sum()\n        small = props.min()\n        penalty = 0.0\n        if small < min_prop:\n            penalty = (min_prop - small) * 5.0  # strong penalty\n\n        # silhouette on reduced space\n        if len(np.unique(lab)) < 2:\n            continue\n        sil = silhouette_score(Z, lab)\n        score = sil - penalty\n\n        if score > best_score:\n            best_score = score\n            best = lab\n\n    return best\n\n\ndef cluster_diabetes(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    # Encode gender to 0/1, keep all other binary columns numeric\n    df = df.copy()\n    df["gender"] = df["gender"].map({"Female": 0, "Male": 1}).astype(int)\n\n    X = StandardScaler().fit_transform(df.values)\n    labels = select_kmeans(X, min_prop=0.15)\n\n    pd.DataFrame({"pseudo_label": labels.astype(int)}).to_csv(out_path, index=False)\n\n\ndef cluster_heart(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    # Binary treated as numeric; multi-class categoricals one-hot\n    bin_cols = ["sex", "fbs", "exang"]\n    multi_cat = ["cp", "restecg", "slope", "ca", "thal"]\n    num_cols = ["age", "trestbps", "chol", "thalach", "oldpeak"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            ("num", StandardScaler(), num_cols + bin_cols),\n            ("cat", OneHotEncoder(handle_unknown="ignore", sparse_output=False), multi_cat),\n        ],\n        remainder="drop",\n    )\n\n    X = pre.fit_transform(df)\n    labels = select_kmeans(X, min_prop=0.15)\n\n    pd.DataFrame({"pseudo_label": labels.astype(int)}).to_csv(out_path, index=False)\n\n\nif __name__ == "__main__":\n    cluster_diabetes("/app/diabetes_data.csv", "/app/output_diabetes_data.csv")\n    cluster_heart("/app/heart.csv", "/app/output_heart.csv")\n    print("Wrote /app/output_diabetes_data.csv and /app/output_heart.csv")\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
