Sending keys: ['cat > /app/run_cluster.py <<\'PY\'\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.metrics import silhouette_score, calinski_harabasz_score, davies_bouldin_score\n\nfrom sklearn.cluster import KMeans, AgglomerativeClustering, Birch, MiniBatchKMeans, SpectralClustering\nfrom sklearn.mixture import GaussianMixture\n\nRANDOM_STATE = 42\n\n\ndef _score_clustering(X, labels):\n    # internal metrics; for k=2 silhouette is generally useful\n    scores = {}\n    # Some algorithms may produce a single cluster; guard.\n    if len(set(labels)) < 2:\n        return {"sil": -1e9, "ch": -1e9, "db": 1e9}\n    try:\n        scores["sil"] = float(silhouette_score(X, labels, metric="euclidean"))\n    except Exception:\n        scores["sil"] = -1e9\n    try:\n        scores["ch"] = float(calinski_harabasz_score(X, labels))\n    except Exception:\n        scores["ch"] = -1e9\n    try:\n        scores["db"] = float(davies_bouldin_score(X, labels))\n    except Exception:\n        scores["db"] = 1e9\n    return scores\n\n\ndef _pick_best(candidates):\n    # candidates: list of (name, labels, scores)\n    # Rank: maximize silhouette, maximize CH, minimize DB.\n    def key(t):\n        _, _, s = t\n        return (s.get("sil", -1e9), s.get("ch", -1e9), -s.get("db", 1e9))\n    return sorted(candidates, key=key, reverse=True)[0]\n\n\ndef cluster_dataset(path, categorical_cols, numeric_cols, out_path):\n    df = pd.read_csv(path)\n\n    # Preprocess: impute + encode + scale\n    cat_pipe = Pipeline([\n        ("imputer", SimpleImputer(strategy="most_frequent")),\n        ("ohe", OneHotEncoder(handle_unknown="ignore", sparse_output=False))\n    ])\n    num_pipe = Pipeline([\n        ("imputer", SimpleImputer(strategy="median")),\n        ("scaler", StandardScaler())\n    ])\n\n    pre = ColumnTransformer([\n        ("cat", cat_pipe, categorical_cols),\n        ("num", num_pipe, numeric_cols),\n    ], remainder="drop")\n\n    X = pre.fit_transform(df)\n    # ensure float64 dense\n    X = np.asarray(X, dtype=float)\n\n    algos = []\n    algos.append(("kmeans", lambda: KMeans(n_clusters=2, n_init=50, random_state=RANDOM_STATE)))\n    algos.append(("minibatch", lambda: MiniBatchKMeans(n_clusters=2, random_state=RANDOM_STATE, batch_size=256, n_init=20)))\n    algos.append(("gmm", lambda: GaussianMixture(n_components=2, covariance_type="full", random_state=RANDOM_STATE, n_init=5)))\n    algos.append(("agglo_ward", lambda: AgglomerativeClustering(n_clusters=2, linkage="ward")))\n    algos.append(("birch", lambda: Birch(n_clusters=2)))\n    # spectral can be expensive; keep but guard\n    algos.append(("spectral", lambda: SpectralClustering(n_clusters=2, affinity="nearest_neighbors", n_neighbors=min(10, max(2, X.shape[0]-1)), random_state=RANDOM_STATE)))\n\n    candidates = []\n    for name, ctor in algos:\n        try:\n            model = ctor()\n            if isinstance(model, GaussianMixture):\n                labels = model.fit_predict(X)\n            else:\n                labels = model.fit_predict(X)\n            scores = _score_clustering(X, labels)\n            candidates.append((name, labels, scores))\n        except Exception as e:\n            # skip failures\n            continue\n\n    if not candidates:\n        raise RuntimeError("No clustering candidates succeeded")\n\n    best_name, best_labels, best_scores = _pick_best(candidates)\n\n    # normalize to {0,1}\n    best_labels = pd.Series(best_labels).astype(int)\n    # in case labels are not 0/1\n    uniq = sorted(best_labels.unique().tolist())\n    mapping = {u:i for i,u in enumerate(uniq)}\n    pseudo = best_labels.map(mapping).astype(int)\n\n    out = pd.DataFrame({"pseudo_label": pseudo.values})\n    out.to_csv(out_path, index=False)\n\n    print(f"{path} -> {out_path} using {best_name} scores={best_scores} label_counts={pseudo.value_counts().to_dict()}")\n\n\nif __name__ == "__main__":\n    diabetes_cat = [\n        \'gender\',\'polyuria\',\'polydipsia\',\'sudden_weight_loss\',\'weakness\',\'polyphagia\',\n        \'genital_thrush\',\'visual_blurring\',\'itching\',\'irritability\',\'delayed_healing\',\n        \'partial_paresis\',\'muscle_stiffness\',\'alopecia\',\'obesity\'\n    ]\n    diabetes_num = [\'age\']\n\n    heart_cat = [\'sex\',\'cp\',\'fbs\',\'restecg\',\'exang\',\'slope\',\'ca\',\'thal\']\n    heart_num = [\'trestbps\',\'chol\',\'thalach\',\'oldpeak\']\n\n    cluster_dataset(\'/app/diabetes_data.csv\', diabetes_cat, diabetes_num, \'/app/output_diabetes_data.csv\')\n    cluster_dataset(\'/app/heart.csv\', heart_cat, heart_num, \'/app/output_heart.csv\')\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
