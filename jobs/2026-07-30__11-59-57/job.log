Sending keys: ['cat > /app/run_cluster.py <<\'PY\'\nimport pandas as pd\nimport numpy as np\n\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.metrics import silhouette_score, calinski_harabasz_score\n\nfrom src.cluster.kmean import kmeans\nfrom src.cluster.gaussian_mixture import gaussian_mixture\nfrom src.cluster.spectral import spectral\nfrom src.cluster.agglomerative import agglomerative\nfrom src.cluster.birch import birch\nfrom src.cluster.minibatch_kmeans import minibatch_kmeans\nfrom src.cluster.bisecting_kmeans import bisecting_kmeans\n\nCLUSTERERS = {\n    "kmeans": kmeans,\n    "gmm": gaussian_mixture,\n    "spectral": spectral,\n    "agglomerative": agglomerative,\n    "birch": birch,\n    "minibatch": minibatch_kmeans,\n    "bisect": bisecting_kmeans,\n}\n\n\ndef eval_clustering(X, y):\n    # Some clusterers can return a single cluster in edge cases; guard.\n    if len(np.unique(y)) < 2:\n        return {"sil": -1.0, "ch": -1.0}\n    out = {}\n    try:\n        out["sil"] = float(silhouette_score(X, y, metric="euclidean"))\n    except Exception:\n        out["sil"] = -1.0\n    try:\n        out["ch"] = float(calinski_harabasz_score(X, y))\n    except Exception:\n        out["ch"] = -1.0\n    return out\n\n\ndef choose_best(df, preprocessors, k=2, random_tries=1):\n    best = None\n    for pname, pre in preprocessors.items():\n        X = pre.fit_transform(df)\n        # Ensure dense float\n        if hasattr(X, "toarray"):\n            X = X.toarray()\n        X = np.asarray(X, dtype=float)\n\n        for cname, clusterer in CLUSTERERS.items():\n            # spectral can be slow; still ok for these sizes\n            try:\n                y = clusterer(X, k)\n            except Exception as e:\n                continue\n\n            scores = eval_clustering(X, y)\n            # Combine metrics: prioritize silhouette, then CH (scaled)\n            combo = scores["sil"] + 1e-4 * scores["ch"]\n            cand = (combo, scores, pname, cname, y)\n            if best is None or cand[0] > best[0]:\n                best = cand\n\n    if best is None:\n        raise RuntimeError("No clustering succeeded")\n    return best\n\n\ndef main():\n    # Diabetes\n    d = pd.read_csv("/app/diabetes_data.csv")\n    d_cat = ["gender"]\n    d_num = [c for c in d.columns if c not in d_cat]\n\n    diabetes_pre = {\n        "onehot_gender_std": ColumnTransformer(\n            [\n                ("cat", OneHotEncoder(sparse_output=False, handle_unknown="ignore"), d_cat),\n                ("num", Pipeline([("sc", StandardScaler())]), d_num),\n            ],\n            remainder="drop",\n        ),\n        "std_all_numeric_after_binary_gender": ColumnTransformer(\n            [\n                ("cat", OneHotEncoder(sparse_output=False, handle_unknown="ignore"), d_cat),\n                ("num", "passthrough", d_num),\n            ],\n            remainder="drop",\n        ),\n    }\n\n    best_d = choose_best(d, diabetes_pre, k=2)\n    _, scores_d, pname_d, cname_d, y_d = best_d\n    print("BEST diabetes:", pname_d, cname_d, scores_d)\n\n    out_d = pd.DataFrame({"pseudo_label": pd.Series(y_d).astype(int)})\n    out_d.to_csv("/app/output_diabetes_data.csv", index=False)\n\n    # Heart\n    h = pd.read_csv("/app/heart.csv")\n    # As per prompt: numeric: trestbps, chol, thalach, oldpeak. others (except age) are categorical.\n    h_num = ["trestbps", "chol", "thalach", "oldpeak", "age"]\n    h_cat = [c for c in h.columns if c not in h_num]\n\n    heart_pre = {\n        "onehot_cat_std_num": ColumnTransformer(\n            [\n                ("cat", OneHotEncoder(sparse_output=False, handle_unknown="ignore"), h_cat),\n                ("num", StandardScaler(), h_num),\n            ],\n            remainder="drop",\n        ),\n        "std_all_as_numeric": ColumnTransformer(\n            [("all", StandardScaler(), h.columns.tolist())],\n            remainder="drop",\n        ),\n    }\n\n    best_h = choose_best(h, heart_pre, k=2)\n    _, scores_h, pname_h, cname_h, y_h = best_h\n    print("BEST heart:", pname_h, cname_h, scores_h)\n\n    out_h = pd.DataFrame({"pseudo_label": pd.Series(y_h).astype(int)})\n    out_h.to_csv("/app/output_heart.csv", index=False)\n\n\nif __name__ == "__main__":\n    main()\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
