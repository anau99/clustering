import pandas as pd
for path, n in [('/app/output_diabetes_data.csv',520),('/app/output_heart.csv',1025)]:
    df=pd.read_csv(path)
    print(path, 'shape', df.shape)
    print('columns', list(df.columns))
    vals=set(df['pseudo_label'].unique())
    print('unique', vals)
    print('counts', df['pseudo_label'].value_counts().to_dict())
    assert df.shape==(n,1)
    assert list(df.columns)==['pseudo_label']
    assert vals.issubset({0,1})
print('ok')
