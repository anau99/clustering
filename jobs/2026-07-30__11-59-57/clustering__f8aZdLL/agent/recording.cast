[27.396447, "i", "cat > /app/run_cluster.py <<'PY'\nimport numpy as np\nimport pandas as pd\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.metrics import silhouette_score\n\n\ndef _best_by_silhouette(X, candidates):\n    best = None\n    best_score = -1e9\n    for name, model in candidates:\n        if name == 'gmm':\n            labels = model.fit_predict(X)\n        else:\n            labels = model.fit_predict(X)\n        # silhouette requires >1 label\n        if len(np.unique(labels)) < 2:\n            score = -1e9\n        else:\n            score = silhouette_score(X, labels, metric='euclidean')\n        if score > best_score:\n            best_score = score\n            best = (name, model, labels, score)\n    return best\n\n\ndef cluster_diabetes(in_path, out_path):\n    df = pd.read_csv(in_path)\n    # features\n    num_cols = ['"]
[27.396538, "i", "age']\n    cat_cols = ['gender']\n    other_cols = [c for c in df.columns if c not in num_cols + cat_cols]\n\n    pre = ColumnTransformer(\n        transformers=[\n            ('num', StandardScaler(), num_cols),\n            ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), cat_cols),\n            ('bin', 'passthrough', other_cols),\n        ],\n        remainder='drop'\n    )\n\n    X = pre.fit_transform(df)\n\n    candidates = [\n        ('kmeans', KMeans(n_clusters=2, n_init='auto', random_state=42)),\n        ('gmm', GaussianMixture(n_components=2, covariance_type='full', random_state=42)),\n        ('agg', AgglomerativeClustering(n_clusters=2, linkage='ward')),\n    ]\n\n    name, model, labels, score = _best_by_silhouette(X, candidates)\n    labels = labels.astype(int)\n    # ensure 0/1\n    labels = (labels == np.min(labels)).astype(int) if set(np.unique(labels))=={0,1} else (labels % 2)\n\n    out = pd.DataFrame({'pseudo_label': labels.astype(int)})\n    out.to_csv(out_path, index=False)\n    return name, sco"]
[27.396572, "i", "re\n\n\ndef cluster_heart(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    cat_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n    num_cols = [c for c in df.columns if c not in cat_cols]\n\n    pre = ColumnTransformer(\n        transformers=[\n            ('num', StandardScaler(), num_cols),\n            ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), cat_cols),\n        ],\n        remainder='drop'\n    )\n\n    X = pre.fit_transform(df)\n\n    candidates = [\n        ('kmeans', KMeans(n_clusters=2, n_init='auto', random_state=42)),\n        ('gmm', GaussianMixture(n_components=2, covariance_type='full', random_state=42)),\n        ('agg', AgglomerativeClustering(n_clusters=2, linkage='ward')),\n    ]\n\n    name, model, labels, score = _best_by_silhouette(X, candidates)\n    labels = labels.astype(int)\n    labels = (labels == np.min(labels)).astype(int) if set(np.unique(labels))=={0,1} else (labels % 2)\n\n    out = pd.DataFrame({'pseudo_label': labels.astype(int)})\n    out.to_csv("]
[27.396602, "i", "out_path, index=False)\n    return name, score\n\n\nif __name__ == '__main__':\n    d_name, d_score = cluster_diabetes('/app/diabetes_data.csv', '/app/output_diabetes_data.csv')\n    h_name, h_score = cluster_heart('/app/heart.csv', '/app/output_heart.csv')\n    print('diabetes best:', d_name, 'silhouette:', d_score)\n    print('heart best:', h_name, 'silhouette:', h_score)\nPY\n"]
