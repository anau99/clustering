[9.846976, "o", "import hashlib\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef hash_encoder(df: pd.DataFrame, columns=None, n_features=8) -> pd.DataFrame:\r\n    \"\"\"\r\n    Hash categorical columns into fixed-size integer features.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n\r\n"]
[9.84703, "o", "        hashed = result[col].astype(str).apply(\r\n            lambda x: int(hashlib.md5(x.encode()).hexdigest(), 16)\r\n        )\r\n\r\n        result[col] = hashed % n_features\r\n\r\n"]
[9.847211, "o", "    return result"]
[9.847575, "o", "/app/src/transform/MaxAbsScaler.py\r\n"]
[9.848951, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import MaxAbsScaler\r\n\r\n\r\ndef max_abs_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Scale numeric features by their maximum absolute value.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = MaxAbsScaler()\r\n\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n"]
[9.849063, "o", "    return result"]
[9.849291, "o", "/app/src/transform/KBinsDiscretizer.py\r\n"]
[9.850438, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import KBinsDiscretizer\r\n\r\n\r\ndef kbins_discretizer(df: pd.DataFrame,columns=None, n_bins=5, strategy=\"quantile\") -> pd.DataFrame:\r\n    \"\"\"\r\n    Discretize numeric columns into bins.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n"]
[9.850528, "o", "    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = KBinsDiscretizer(\r\n        n_bins=n_bins,\r\n        encode=\"ordinal\",\r\n        strategy=strategy\r\n    )\r\n\r\n    result[columns] = encoder.fit_transform(result[columns])\r\n\r\n"]
[9.850551, "o", "    return result"]
[9.850886, "o", "/app/src/transform/FrequencyEncoder.py\r\n"]
[9.851876, "o", "import pandas as pd\r\n\r\n\r\ndef frequency_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Replace categories with their frequencies.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n"]
[9.851996, "o", "\r\n    for col in columns:\r\n        freq = result[col].value_counts(normalize=True)\r\n        result[col] = result[col].map(freq)\r\n\r\n    return result"]
[9.852149, "o", "/app/src/transform/CountEncoder.py\r\n"]
[9.853225, "o", "import pandas as pd\r\n\r\n\r\ndef count_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Replace categories with occurrence counts.\r\n    \"\"\"\r\n\r\n"]
[9.853306, "o", "    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n        counts = result[col].value_counts()\r\n        result[col] = result[col].map(counts)\r\n\r\n    return result"]
[9.853487, "o", "/app/src/transform/StandardScaler.py\r\n"]
[9.854646, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\ndef standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n"]
[9.854762, "o", "    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[9.854983, "o", "/app/src/transform/OrdinalEncoder.py\r\n"]
[9.856042, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OrdinalEncoder\r\n\r\n\r\ndef ordinal_encoder(df: pd.DataFrame, columns=None, encode_all=False) -> pd.DataFrame:\r\n    \"\"\"\r\n    Encode selected categorical columns using OrdinalEncoder.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is not None:\r\n        pass\r\n"]
[9.856101, "o", "\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OrdinalEncoder(\r\n        handle_unknown=\"use_encoded_value\",\r\n"]
[9.856223, "o", "        unknown_value=-1\r\n    )\r\n\r\n    result[columns] = encoder.fit_transform(result[columns])\r\n\r\n    return result"]
[9.85639, "o", "/app/src/transform/OnehotEncoder.py\r\n"]
[9.857372, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\ndef one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n    result = df.copy()\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n"]
[9.857409, "o", "        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n"]
[9.857426, "o", "    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n"]
[9.85744, "o", "    result = pd.concat([result, encoded_df], axis=1)\r\n\r\n"]
[9.857646, "o", "    return result"]
[9.857721, "o", "/app/src/transform/Normalizer.py\r\n"]
[9.85871, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import Normalizer\r\n\r\n\r\ndef normalizer(df: pd.DataFrame, columns=None, norm=\"l2\") -> pd.DataFrame:\r\n    \"\"\"\r\n    Normalize samples using L1, L2 or Max norm.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = Normalizer(norm=norm)"]
[9.858767, "o", "\r\n\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n"]
[9.858916, "o", "    return result"]
[9.858949, "o", "/app/src/transform/BinaryEncoder.py\r\n"]
[9.860125, "o", "import pandas as pd\r\n\r\n\r\ndef binary_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Binary encode categorical columns.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n\r\n        uniques = sorted(result[col].dropna().unique())\r\n"]
[9.860209, "o", "        mapping = {v: i for i, v in enumerate(uniques)}\r\n\r\n        encoded = result[col].map(mapping).fillna(0).astype(int)\r\n\r\n        n_bits = max(1, len(mapping).bit_length())\r\n\r\n        binary = encoded.apply(\r\n            lambda x, n_bits=n_bits: list(map(int, format(x, f\"0{n_bits}b\")))\r\n        )\r\n\r\n        binary_df = pd.DataFrame(\r\n            binary.tolist(),\r\n            columns=[f\"{col}_bin{i}\" for i in range(n_bits)],\r\n            index=result.index\r\n        )\r\n\r\n        result.drop(columns=col, inplace=True)\r\n        result = pd.concat([result, binary_df], axis=1)\r\n\r\n    return result"]
[9.860476, "o", "/app/src/transform/PolynomialFeatures.py\r\n"]
[9.861932, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import PolynomialFeatures\r\n\r\n\r\ndef polynomial_features(df: pd.DataFrame, columns=None, degree=2, include_bias=False) -> pd.DataFrame:\r\n    \"\"\"\r\n    Generate polynomial feature combinations.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n"]
[9.861979, "o", "    if len(columns) == 0:\r\n        return result\r\n\r\n    poly = PolynomialFeatures(\r\n        degree=degree,\r\n        include_bias=include_bias\r\n    )\r\n\r\n    transformed = poly.fit_transform(result[columns])\r\n\r\n    poly_df = pd.DataFrame(\r\n        transformed,\r\n        columns=poly.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, poly_df], axis=1)\r\n\r\n"]
[9.862088, "o", "    return result"]
