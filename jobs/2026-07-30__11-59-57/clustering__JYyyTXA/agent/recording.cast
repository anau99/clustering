[27.295472, "i", "python3 - <<'PY'\nimport pandas as pd\n\ndef inspect(path, nuniq=10):\n    df = pd.read_csv(path)\n    print('\\n===', path, '===')\n    print('shape:', df.shape)\n    print('columns:', df.columns.tolist())\n    print('dtypes:\\n', df.dtypes)\n    na = df.isna().sum()\n    print('na_count_total:', int(na.sum()))\n    print('na_by_col (nonzero):\\n', na[na>0].sort_values(ascending=False))\n    obj_cols = df.select_dtypes(include=['object','category']).columns.tolist()\n    num_cols = df.select_dtypes(include=['number']).columns.tolist()\n    print('num_cols:', num_cols)\n    print('cat_cols:', obj_cols)\n    for c in obj_cols[:6]:\n        vc = df[c].astype(str).value_counts().head(nuniq)\n        print(f'\\n{c} top values:\\n{vc}')\n\ninspect('/app/diabetes_data.csv')\ninspect('/app/heart.csv')\nPY\n"]
