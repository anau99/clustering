[28.320547, "i", "cat > /app/run_cluster.py <<'PY'\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.metrics import silhouette_score\n\nfrom sklearn.cluster import KMeans, AgglomerativeClustering, MiniBatchKMeans, Birch\nfrom sklearn.mixture import GaussianMixture\n\nRANDOM_STATE = 42\n\n\ndef build_preprocessor(df: pd.DataFrame):\n    cat_cols = df.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\n    num_cols = df.select_dtypes(include=[\"number\"]).columns.tolist()\n\n    numeric_pipe = Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"median\")),\n        (\"scaler\", StandardScaler()),\n    ])\n\n    cat_pipe = Pipeline([\n        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n        (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False)),\n    ])\n\n    pre = ColumnTransformer([\n        (\"num\", numeric_pipe, num_co"]
[28.320616, "i", "ls),\n        (\"cat\", cat_pipe, cat_cols),\n    ], remainder=\"drop\")\n\n    return pre, num_cols, cat_cols\n\n\ndef cluster_and_select(X: np.ndarray, k: int = 2):\n    # Candidate models; all produce labels.\n    candidates = {\n        \"kmeans\": lambda: KMeans(n_clusters=k, n_init=\"auto\", random_state=RANDOM_STATE),\n        \"minibatch\": lambda: MiniBatchKMeans(n_clusters=k, random_state=RANDOM_STATE, batch_size=256),\n        \"gmm\": lambda: GaussianMixture(n_components=k, covariance_type=\"full\", random_state=RANDOM_STATE),\n        \"agglo\": lambda: AgglomerativeClustering(n_clusters=k, linkage=\"ward\"),\n        \"birch\": lambda: Birch(n_clusters=k),\n    }\n\n    best = (None, -1e9, None)  # (name, score, labels)\n    for name, make in candidates.items():\n        model = make()\n        try:\n            if name == \"gmm\":\n                labels = model.fit_predict(X)\n            else:\n                labels = model.fit_predict(X)\n\n            # Silhouette requires >1 label present\n            if len(set(labels)) < 2:\n          "]
[28.320745, "i", "      continue\n            score = silhouette_score(X, labels, metric=\"euclidean\")\n            if score > best[1]:\n                best = (name, score, labels)\n        except Exception:\n            continue\n\n    if best[0] is None:\n        # Fallback to kmeans\n        labels = KMeans(n_clusters=k, n_init=\"auto\", random_state=RANDOM_STATE).fit_predict(X)\n        return \"kmeans_fallback\", float(\"nan\"), labels\n\n    return best\n\n\ndef run(in_path: str, out_path: str):\n    df = pd.read_csv(in_path)\n\n    pre, num_cols, cat_cols = build_preprocessor(df)\n    X = pre.fit_transform(df)\n\n    name, score, labels = cluster_and_select(X, k=2)\n\n    # Ensure labels are 0/1\n    labels = pd.Series(labels).astype(int)\n    uniq = sorted(labels.unique().tolist())\n    if uniq != [0, 1]:\n        mapping = {uniq[i]: i for i in range(len(uniq))}\n        labels = labels.map(mapping).astype(int)\n\n    out = pd.DataFrame({\"pseudo_label\": labels.values})\n    out.to_csv(out_path, index=False)\n\n    print(f\"{in_path} -> {out_path} | model={na"]
[28.320767, "i", "me} silhouette={score} | X_shape={X.shape} | labels={sorted(out['pseudo_label'].unique())}\")\n\n\nif __name__ == \"__main__\":\n    run(\"/app/diabetes_data.csv\", \"/app/output_diabetes_data.csv\")\n    run(\"/app/heart.csv\", \"/app/output_heart.csv\")\nPY\n"]
[28.321549, "o", "cat > /app/run_cluster.py <<'PY'\r\n"]
