[8.905293, "o", "\r\n    encoder = KBinsDiscretizer("]
[8.905307, "o", "\r\n"]
[8.905333, "o", "        n_bins=n_bins,\r\n        encode=\"ordinal\","]
[8.905644, "o", "\r\n        strategy=strategy\r\n"]
[8.905743, "o", "    )"]
[8.906023, "o", "\r\n\r\n    result[columns] = encoder.fit_transform(result[columns])\r\n\r\n    return result"]
[8.906178, "o", "/app/src/transform/FrequencyEncoder.py\r\n"]
[8.907885, "o", "import pandas as pd\r\n"]
[8.908152, "o", "\r\n\r\ndef frequency_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Replace categories with their frequencies.\r\n    \"\"\"\r\n"]
[8.908486, "o", "\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n        freq = result[col].value_counts(normalize=True)\r\n        result[col] = result[col].map(freq)\r\n\r\n    return result"]
[8.908705, "o", "/app/src/transform/CountEncoder.py\r\n"]
[8.910841, "o", "import pandas as pd\r\n\r\n\r\ndef count_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Replace categories with occurrence counts.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n        counts = result[col].value_counts()\r\n        result[col] = result[col].map(counts)\r\n\r\n    return result"]
[8.911088, "o", "/app/src/transform/StandardScaler.py\r\n"]
[8.912438, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\n"]
[8.912544, "o", "def standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n"]
[8.91268, "o", "    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[8.913187, "o", "/app/src/transform/OrdinalEncoder.py\r\n"]
[8.914402, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OrdinalEncoder\r\n\r\n"]
[8.91444, "o", "\r\ndef ordinal_encoder(df: pd.DataFrame, columns=None, encode_all=False) -> pd.DataFrame:\r\n"]
[8.914546, "o", "    \"\"\"\r\n    Encode selected categorical columns using OrdinalEncoder.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OrdinalEncoder(\r\n        handle_unknown=\"use_encoded_value\",\r\n        unknown_value=-1\r\n    )\r\n\r\n    result[columns] = encoder.fit_transform(result[columns])\r\n\r\n"]
[8.914579, "o", "    return result"]
[8.91509, "o", "/app/src/transform/OnehotEncoder.py\r\n"]
[8.916265, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\n"]
[8.916518, "o", "def one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n    result = df.copy()\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, encoded_df], axis=1)\r\n\r\n    return result"]
[8.91684, "o", "/app/src/transform/Normalizer.py\r\n"]
[8.918216, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import Normalizer\r\n\r\n\r\ndef normalizer(df: pd.DataFrame, columns=None, norm=\"l2\") -> pd.DataFrame:\r\n    \"\"\"\r\n    Normalize samples using L1, L2 or Max norm.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = Normalizer(norm=norm)\r\n"]
[8.918493, "o", "\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[8.918604, "o", "/app/src/transform/BinaryEncoder.py\r\n"]
[8.920042, "o", "import pandas as pd\r\n"]
[8.920685, "o", "\r\n\r\ndef binary_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\""]
[8.920917, "o", "\r\n    Binary encode categorical columns.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n\r\n        uniques = sorted(result[col].dropna().unique())\r\n        mapping = {v: i for i, v in enumerate(uniques)}\r\n\r\n        encoded = result[col].map(mapping).fillna(0).astype(int)\r\n\r\n        n_bits = max(1, len(mapping).bit_length())\r\n\r\n        binary = encoded.apply(\r\n            lambda x, n_bits=n_bits: list(map(int, format(x, f\"0{n_bits}b\")))\r\n        )\r\n\r\n        binary_df = pd.DataFrame(\r\n            binary.tolist(),\r\n            columns=[f\"{col}_bin{i}\" for i in range(n_bits)],\r\n            index=result.index\r\n        )\r\n\r\n        result.drop(columns=col, inplace=True)\r\n        result = pd.concat([result, binary_df], axis=1)\r\n\r\n    return result/app/src/transform/PolynomialFeatures.py\r\n"]
[8.92216, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import PolynomialFeatures\r\n\r\n\r\ndef polynomial_features(df: pd.DataFrame, columns=None, degree=2, include_bias=False) -> pd.DataFrame:\r\n    \"\"\"\r\n    Generate polynomial feature combinations.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    poly = PolynomialFeatures(\r\n        degree=degree,\r\n        include_bias=include_bias\r\n    )\r\n\r\n    transformed = poly.fit_transform(result[columns])\r\n\r\n    poly_df = pd.DataFrame(\r\n        transformed,\r\n"]
[8.922191, "o", "        columns=poly.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, poly_df], axis=1)\r\n\r\n    return result"]
