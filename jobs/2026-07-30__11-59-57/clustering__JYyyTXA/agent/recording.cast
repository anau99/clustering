[9.873617, "o", "from sklearn.mixture import GaussianMixture\r\n\r\n\r\ndef gaussian_mixture(X, k):\r\n    model = GaussianMixture(\r\n        n_components=k,\r\n        covariance_type=\"full\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[9.874169, "o", "/app/src/cluster/kmean.py\r\n"]
[9.876074, "o", "from sklearn.cluster import KMeans\r\n\r\n\r\ndef kmeans(X, k):\r\n    model = KMeans(\r\n        n_clusters=k,\r\n        init=\"k-means++\",\r\n        n_init=\"auto\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
