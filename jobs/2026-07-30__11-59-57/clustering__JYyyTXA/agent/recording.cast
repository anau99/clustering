[8.897631, "o", "from sklearn.preprocessing import RobustScaler\r\n\r\n\r\ndef robust_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Scale features using statistics robust to outliers.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:"]
[8.898148, "o", "\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = RobustScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[8.898325, "o", "/app/src/transform/HashEncoder.py\r\n"]
[8.900906, "o", "import hashlib\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef hash_encoder(df: pd.DataFrame, columns=None, n_features=8) -> pd.DataFrame:\r\n    \"\"\"\r\n    Hash categorical columns into fixed-size integer features.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n\r\n        hashed = result[col].astype(str).apply(\r\n            lambda x: int(hashlib.md5(x.encode()).hexdigest(), 16)\r\n        )\r\n\r\n        result[col] = hashed % n_features\r\n\r\n    return result"]
[8.9012, "o", "/app/src/transform/MaxAbsScaler.py\r\n"]
[8.903044, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import MaxAbsScaler\r\n\r\n\r\ndef max_abs_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Scale numeric features by their maximum absolute value.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = MaxAbsScaler()\r\n\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n"]
[8.903279, "o", "    return result"]
