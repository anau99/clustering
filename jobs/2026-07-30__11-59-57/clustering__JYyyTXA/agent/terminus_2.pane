import pandas as pd
from sklearn.preprocessing import RobustScaler


def robust_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:
    """
    Scale features using statistics robust to outliers.
    """
    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["number"]).columns.tolist()

    if len(columns) == 0:
        return result

    scaler = RobustScaler()
    result[columns] = scaler.fit_transform(result[columns])

    return result/app/src/transform/HashEncoder.py
import hashlib

import pandas as pd


def hash_encoder(df: pd.DataFrame, columns=None, n_features=8) -> pd.DataFrame:
    """
    Hash categorical columns into fixed-size integer features.
    """

    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["object", "category"]).columns.tolist()

    for col in columns:

        hashed = result[col].astype(str).apply(
            lambda x: int(hashlib.md5(x.encode()).hexdigest(), 16)
        )

        result[col] = hashed % n_features

    return result/app/src/transform/MaxAbsScaler.py
import pandas as pd
from sklearn.preprocessing import MaxAbsScaler


def max_abs_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:
    """
    Scale numeric features by their maximum absolute value.
    """
    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["number"]).columns.tolist()

    if len(columns) == 0:
        return result

    scaler = MaxAbsScaler()

    result[columns] = scaler.fit_transform(result[columns])

    return result/app/src/transform/KBinsDiscretizer.py
import pandas as pd
from sklearn.preprocessing import KBinsDiscretizer


def kbins_discretizer(df: pd.DataFrame,columns=None, n_bins=5, strategy="quantile") -> pd.DataFrame:
    """
    Discretize numeric columns into bins.
    """
    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["number"]).columns.tolist()

    if len(columns) == 0:
        return result

    encoder = KBinsDiscretizer(
        n_bins=n_bins,
        encode="ordinal",
        strategy=strategy
    )

    result[columns] = encoder.fit_transform(result[columns])

    return result/app/src/transform/FrequencyEncoder.py
import pandas as pd


def frequency_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:
    """
    Replace categories with their frequencies.
    """

    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["object", "category"]).columns.tolist()

    for col in columns:
        freq = result[col].value_counts(normalize=True)
        result[col] = result[col].map(freq)

    return result/app/src/transform/CountEncoder.py
import pandas as pd


def count_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:
    """
    Replace categories with occurrence counts.
    """

    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["object", "category"]).columns.tolist()

    for col in columns:
        counts = result[col].value_counts()
        result[col] = result[col].map(counts)

    return result/app/src/transform/StandardScaler.py
import pandas as pd
from sklearn.preprocessing import StandardScaler


def standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:
    """
    Standardize selected columns.
    """
    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["number"]).columns.tolist()

    if len(columns) == 0:
        return result

    scaler = StandardScaler()
    result[columns] = scaler.fit_transform(result[columns])

    return result/app/src/transform/OrdinalEncoder.py
import pandas as pd
from sklearn.preprocessing import OrdinalEncoder


def ordinal_encoder(df: pd.DataFrame, columns=None, encode_all=False) -> pd.DataFrame:
    """
    Encode selected categorical columns using OrdinalEncoder.
    """
    result = df.copy()

    if columns is not None:
        pass

    elif encode_all:
        columns = result.columns.tolist()
    else:
        columns = result.select_dtypes(include=["object", "category"]).columns.tolist()

    if len(columns) == 0:
        return result

    encoder = OrdinalEncoder(
        handle_unknown="use_encoded_value",
        unknown_value=-1
    )

    result[columns] = encoder.fit_transform(result[columns])

    return result/app/src/transform/OnehotEncoder.py
import pandas as pd
from sklearn.preprocessing import OneHotEncoder


def one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:

    result = df.copy()
    if columns is not None:
        pass

    elif encode_all:
        columns = result.columns.tolist()
    else:
        columns = result.select_dtypes(
            include=["object", "category"]
        ).columns.tolist()

    if len(columns) == 0:
        return result

    encoder = OneHotEncoder(
        sparse_output=False,
        handle_unknown="ignore"
    )

    encoded = encoder.fit_transform(result[columns])

    encoded_df = pd.DataFrame(
        encoded,
        columns=encoder.get_feature_names_out(columns),
        index=result.index
    )

    result = result.drop(columns=columns)
    result = pd.concat([result, encoded_df], axis=1)

    return result/app/src/transform/Normalizer.py
import pandas as pd
from sklearn.preprocessing import Normalizer


def normalizer(df: pd.DataFrame, columns=None, norm="l2") -> pd.DataFrame:
    """
    Normalize samples using L1, L2 or Max norm.
    """
    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["number"]).columns.tolist()

    if len(columns) == 0:
        return result

    scaler = Normalizer(norm=norm)

    result[columns] = scaler.fit_transform(result[columns])

    return result/app/src/transform/BinaryEncoder.py
import pandas as pd


def binary_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:
    """
    Binary encode categorical columns.
    """

    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["object", "category"]).columns.tolist()

    for col in columns:

        uniques = sorted(result[col].dropna().unique())
        mapping = {v: i for i, v in enumerate(uniques)}

        encoded = result[col].map(mapping).fillna(0).astype(int)

        n_bits = max(1, len(mapping).bit_length())

        binary = encoded.apply(
            lambda x, n_bits=n_bits: list(map(int, format(x, f"0{n_bits}b")))
        )

        binary_df = pd.DataFrame(
            binary.tolist(),
            columns=[f"{col}_bin{i}" for i in range(n_bits)],
            index=result.index
        )

        result.drop(columns=col, inplace=True)
        result = pd.concat([result, binary_df], axis=1)

    return result/app/src/transform/PolynomialFeatures.py
import pandas as pd
from sklearn.preprocessing import PolynomialFeatures


def polynomial_features(df: pd.DataFrame, columns=None, degree=2, include_bias=False) -> pd.DataFrame:
    """
    Generate polynomial feature combinations.
    """

    result = df.copy()

    if columns is None:
        columns = result.select_dtypes(include=["number"]).columns.tolist()

    if len(columns) == 0:
        return result

    poly = PolynomialFeatures(
        degree=degree,
        include_bias=include_bias
    )

    transformed = poly.fit_transform(result[columns])

    poly_df = pd.DataFrame(
        transformed,
        columns=poly.get_feature_names_out(columns),
        index=result.index
    )

    result = result.drop(columns=columns)
    result = pd.concat([result, poly_df], axis=1)

    return result[?2004hroot@28ff7fec204a:/app# find /app/src/cluster -type f -maxdepth 2 -print -exec sed -n '1,220p' {} \;
