[13.191671, "o", "    return model.fit_predict(X)"]
[13.191889, "o", "/app/src/cluster/gaussian_mixture.py\r\n"]
[13.193362, "o", "from sklearn.mixture import GaussianMixture\r\n\r\n\r\ndef gaussian_mixture(X, k):\r\n    model = GaussianMixture(\r\n        n_components=k,\r\n        covariance_type=\"full\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[13.193704, "o", "/app/src/cluster/kmean.py\r\n"]
[13.194974, "o", "from sklearn.cluster import KMeans\r\n\r\n\r\ndef kmeans(X, k):\r\n    model = KMeans(\r\n        n_clusters=k,\r\n        init=\"k-means++\",\r\n        n_init=\"auto\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[13.195369, "o", "/app/src/cluster/spectral.py\r\n"]
[13.196623, "o", "from sklearn.cluster import SpectralClustering\r\n\r\n\r\ndef spectral(X, k):\r\n    model = SpectralClustering(\r\n        n_clusters=k,\r\n        affinity=\"nearest_neighbors\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[13.19693, "o", "/app/src/cluster/bisecting_kmeans.py\r\n"]
