[12.197952, "o", "/app/src/transform/RobustScaler.py\r\n"]
[12.199389, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import RobustScaler\r\n\r\n\r\ndef robust_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Scale features using statistics robust to outliers.\r\n    \"\"\"\r\n    result = df.copy()\r\n"]
[12.199797, "o", "\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = RobustScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[12.200099, "o", "/app/src/transform/HashEncoder.py\r\n"]
[12.201073, "o", "import hashlib\r\n\r\nimport pandas as pd\r\n\r\n\r\ndef hash_encoder(df: pd.DataFrame, columns=None, n_features=8) -> pd.DataFrame:\r\n    \"\"\"\r\n    Hash categorical columns into fixed-size integer features.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n"]
[12.20181, "o", "        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n\r\n        hashed = result[col].astype(str).apply(\r\n            lambda x: int(hashlib.md5(x.encode()).hexdigest(), 16)\r\n        )\r\n\r\n        result[col] = hashed % n_features\r\n\r\n    return result/app/src/transform/MaxAbsScaler.py\r\n"]
[12.202817, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import MaxAbsScaler\r\n\r\n"]
[12.202855, "o", "\r\ndef max_abs_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n"]
[12.203038, "o", "    Scale numeric features by their maximum absolute value.\r\n"]
[12.203067, "o", "    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = MaxAbsScaler()\r\n\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[12.203284, "o", "/app/src/transform/KBinsDiscretizer.py"]
[12.203634, "o", "\r\n"]
[12.204821, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import KBinsDiscretizer\r\n\r\n\r\ndef kbins_discretizer(df: pd.DataFrame,columns=None, n_bins=5, strategy=\"quantile\") -> pd.DataFrame:\r\n    \"\"\"\r\n    Discretize numeric columns into bins.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n"]
[12.204958, "o", "    encoder = KBinsDiscretizer(\r\n        n_bins=n_bins,\r\n        encode=\"ordinal\",\r\n        strategy=strategy\r\n    )\r\n\r\n    result[columns] = encoder.fit_transform(result[columns])\r\n\r\n    return result"]
[12.205225, "o", "/app/src/transform/FrequencyEncoder.py\r\n"]
[12.206122, "o", "import pandas as pd\r\n\r\n\r\ndef frequency_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Replace categories with their frequencies.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n"]
[12.206214, "o", "        freq = result[col].value_counts(normalize=True)\r\n        result[col] = result[col].map(freq)\r\n\r\n    return result"]
[12.206462, "o", "/app/src/transform/CountEncoder.py\r\n"]
[12.207412, "o", "import pandas as pd\r\n\r\n\r\ndef count_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Replace categories with occurrence counts.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n"]
[12.207447, "o", "\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    for col in columns:\r\n        counts = result[col].value_counts()\r\n        result[col] = result[col].map(counts)\r\n\r\n"]
[12.207468, "o", "    return result"]
[12.207747, "o", "/app/src/transform/StandardScaler.py\r\n"]
[12.208869, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\ndef standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n"]
[12.208994, "o", "        return result\r\n\r\n    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[12.209148, "o", "/app/src/transform/OrdinalEncoder.py\r\n"]
[12.210222, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OrdinalEncoder\r\n\r\n\r\ndef ordinal_encoder(df: pd.DataFrame, columns=None, encode_all=False) -> pd.DataFrame:\r\n    \"\"\"\r\n    Encode selected categorical columns using OrdinalEncoder.\r\n    \"\"\"\r\n"]
[12.210324, "o", "    result = df.copy()\r\n\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OrdinalEncoder(\r\n        handle_unknown=\"use_encoded_value\",\r\n        unknown_value=-1\r\n    )\r\n\r\n    result[columns] = encoder.fit_transform(result[columns])\r\n\r\n    return result"]
[12.210509, "o", "/app/src/transform/OnehotEncoder.py\r\n"]
[12.211655, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\ndef one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n    result = df.copy()\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n"]
[12.211683, "o", "\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n"]
[12.211698, "o", "    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, encoded_df], axis=1)\r\n\r\n"]
[12.211711, "o", "    return result"]
[12.212014, "o", "/app/src/transform/Normalizer.py\r\n"]
[12.213066, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import Normalizer\r\n\r\n\r\ndef normalizer(df: pd.DataFrame, columns=None, norm=\"l2\") -> pd.DataFrame:\r\n    \"\"\"\r\n    Normalize samples using L1, L2 or Max norm.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n"]
[12.213197, "o", "        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = Normalizer(norm=norm)\r\n\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[12.213345, "o", "/app/src/transform/BinaryEncoder.py\r\n"]
[12.214404, "o", "import pandas as pd\r\n\r\n\r\ndef binary_encoder(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Binary encode categorical columns.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"object\", \"category\"]).columns.tolist()\r\n"]
[12.214508, "o", "\r\n    for col in columns:\r\n\r\n        uniques = sorted(result[col].dropna().unique())\r\n        mapping = {v: i for i, v in enumerate(uniques)}\r\n\r\n        encoded = result[col].map(mapping).fillna(0).astype(int)\r\n\r\n        n_bits = max(1, len(mapping).bit_length())\r\n\r\n        binary = encoded.apply(\r\n"]
[12.214536, "o", "            lambda x, n_bits=n_bits: list(map(int, format(x, f\"0{n_bits}b\")))\r\n        )\r\n\r\n        binary_df = pd.DataFrame(\r\n            binary.tolist(),\r\n            columns=[f\"{col}_bin{i}\" for i in range(n_bits)],\r\n            index=result.index\r\n        )\r\n\r\n        result.drop(columns=col, inplace=True)\r\n        result = pd.concat([result, binary_df], axis=1)\r\n\r\n    return result"]
[12.214738, "o", "/app/src/transform/PolynomialFeatures.py\r\n"]
[12.215976, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import PolynomialFeatures\r\n\r\n\r\ndef polynomial_features(df: pd.DataFrame, columns=None, degree=2, include_bias=False) -> pd.DataFrame:\r\n    \"\"\"\r\n    Generate polynomial feature combinations.\r\n    \"\"\"\r\n\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n"]
[12.216012, "o", "\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    poly = PolynomialFeatures(\r\n        degree=degree,\r\n        include_bias=include_bias\r\n    )\r\n\r\n    transformed = poly.fit_transform(result[columns])\r\n\r\n    poly_df = pd.DataFrame(\r\n        transformed,\r\n"]
[12.216168, "o", "        columns=poly.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n"]
[12.21624, "o", "    result = result.drop(columns=columns)\r\n    result = pd.concat([result, poly_df], axis=1)\r\n\r\n    return result"]
[12.216701, "o", "\u001b[?2004h"]
