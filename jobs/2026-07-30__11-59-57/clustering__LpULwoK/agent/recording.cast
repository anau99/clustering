[32.845811, "o", "\r\n"]
[32.845947, "o", "\u001b[?2004l\r"]
[32.846136, "o", "\u001b[?2004h"]
[32.846236, "o", "> "]
[32.846275, "o", "        try:"]
[32.846564, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.846761, "o", "            model = ctor()"]
[32.84701, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.847134, "o", "> "]
[32.847498, "o", "            if isinstance(model, GaussianMixture):"]
