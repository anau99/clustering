[32.848701, "o", "\u001b[?2004l\r"]
[32.848815, "o", "\u001b[?2004h"]
[32.849128, "o", ">             else:"]
[32.849223, "o", "\r\n"]
[32.849411, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.849602, "o", "> "]
[32.849969, "o", "                labels = model.fit_predict(X)"]
