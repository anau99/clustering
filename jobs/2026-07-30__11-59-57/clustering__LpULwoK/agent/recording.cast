[32.823418, "o", "\r\n"]
[32.823567, "o", "\u001b[?2004l\r"]
[32.823603, "o", "\u001b[?2004h"]
[32.823891, "o", "> \r\n\u001b[?2004l\r"]
[32.823925, "o", "\u001b[?2004h"]
[32.824513, "o", ">     # Preprocess: impute + encode + scale"]
[32.824569, "o", "\r\n"]
[32.824684, "o", "\u001b[?2004l\r"]
[32.824863, "o", "\u001b[?2004h"]
[32.825038, "o", "> "]
[32.82623, "o", "    cat_pipe = Pipeline([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.826272, "o", "        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),"]
[32.826626, "o", "\r\n"]
[32.826763, "o", "\u001b[?2004l\r"]
[32.826922, "o", "\u001b[?2004h"]
[32.827078, "o", "> "]
[32.828017, "o", "        (\"ohe\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.828128, "o", "> "]
[32.828887, "o", "    ])\r\n\u001b[?2004l\r\u001b[?2004h>     num_pipe = Pipeline([\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.828959, "o", "> "]
[32.829219, "o", "        (\"imputer\", SimpleImputer(strategy=\"median\")),"]
[32.829699, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.831088, "o", ">         (\"scaler\", StandardScaler())\r\n\u001b[?2004l\r\u001b[?2004h>     ])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.831134, "o", "\u001b[?2004h"]
[32.831201, "o", "> "]
[32.831369, "o", "    pre = ColumnTransformer(["]
[32.831569, "o", "\r\n"]
[32.831695, "o", "\u001b[?2004l\r"]
[32.83184, "o", "\u001b[?2004h"]
[32.833201, "o", ">         (\"cat\", cat_pipe, categorical_cols),\r\n\u001b[?2004l\r\u001b[?2004h>         (\"num\", num_pipe, numeric_cols),"]
[32.83331, "o", "\r\n"]
[32.833392, "o", "\u001b[?2004l\r"]
[32.833493, "o", "\u001b[?2004h"]
[32.833797, "o", ">     ], remainder=\"drop\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.834126, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     X = pre.fit_transform(df)"]
[32.834542, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.834798, "o", ">     # ensure float64 dense"]
[32.835051, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.835183, "o", "> "]
[32.835488, "o", "    X = np.asarray(X, dtype=float)"]
[32.835757, "o", "\r\n\u001b[?2004l\r"]
[32.835919, "o", "\u001b[?2004h"]
[32.835999, "o", "> "]
[32.836164, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.83645, "o", ">     algos = []"]
[32.836548, "o", "\r\n"]
[32.836703, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.837361, "o", ">     algos.append((\"kmeans\", lambda: KMeans(n_clusters=2, n_init=50, random_state=RANDOM_STATE)))"]
[32.837518, "o", "\r\n"]
[32.83768, "o", "\u001b[?2004l\r"]
[32.83787, "o", "\u001b[?2004h"]
[32.838043, "o", "> "]
[32.838711, "o", "    algos.append((\"minibatch\", lambda: MiniBatchKMeans(n_clusters=2, random_state=RANDOM_STATE, batch_size=256, n_init=20)))"]
[32.838958, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.839648, "o", ">     algos.append((\"gmm\", lambda: GaussianMixture(n_components=2, covariance_type=\"full\", random_state=RANDOM_STATE, n_init=5)))"]
[32.839832, "o", "\r\n"]
[32.839992, "o", "\u001b[?2004l\r"]
[32.840182, "o", "\u001b[?2004h"]
[32.840419, "o", "> "]
[32.840932, "o", "    algos.append((\"agglo_ward\", lambda: AgglomerativeClustering(n_clusters=2, linkage=\"ward\")))"]
[32.841085, "o", "\r\n"]
[32.841291, "o", "\u001b[?2004l\r\u001b[?2004h"]
[32.841408, "o", "> "]
[32.84185, "o", "    algos.append((\"birch\", lambda: Birch(n_clusters=2)))"]
[32.842063, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.842438, "o", ">     # spectral can be expensive; keep but guard"]
[32.842599, "o", "\r\n"]
[32.842765, "o", "\u001b[?2004l\r"]
[32.842952, "o", "\u001b[?2004h"]
[32.843122, "o", "> "]
[32.843955, "o", "    algos.append((\"spectral\", lambda: SpectralClustering(n_clusters=2, affinity=\"nearest_neighbors\", n_neighbors=min(10, max(2, X.shape[0]-1)), random_state=RANDOM_STATE)))"]
[32.844198, "o", "\r\n\u001b[?2004l\r"]
[32.844406, "o", "\u001b[?2004h"]
[32.844492, "o", "> "]
[32.84473, "o", "\r\n"]
[32.844997, "o", "\u001b[?2004l\r\u001b[?2004h"]
