[13.186498, "o", "/app/src/cluster/agglomerative.py\r\n"]
[13.187823, "o", "from sklearn.cluster import AgglomerativeClustering\r\n\r\n\r\ndef agglomerative(X, k):\r\n    model = AgglomerativeClustering(\r\n        n_clusters=k,\r\n        linkage=\"ward\"\r\n    )\r\n    return model.fit_predict(X)"]
[13.188741, "o", "/app/src/cluster/minibatch_kmeans.py\r\n"]
[13.189667, "o", "from sklearn.cluster import MiniBatchKMeans\r\n\r\n\r\ndef minibatch_kmeans(X, k):\r\n    model = MiniBatchKMeans(\r\n        n_clusters=k,\r\n        random_state=42,\r\n        batch_size=1024\r\n    )\r\n"]
[13.189707, "o", "    return model.fit_predict(X)"]
