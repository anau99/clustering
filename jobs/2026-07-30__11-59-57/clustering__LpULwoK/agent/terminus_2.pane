[?2004l[?2004h>     algos.append(("kmeans", lambda: KMeans(n_clusters=2, n_init=50, random_state=RANDOM_STATE)))
[?2004l[?2004h>     algos.append(("minibatch", lambda: MiniBatchKMeans(n_clusters=2, random_state=RANDOM_STATE, batch_size=256, n_init=20)))
[?2004l[?2004h>     algos.append(("gmm", lambda: GaussianMixture(n_components=2, covariance_type="full", random_state=RANDOM_STATE, n_init=5)))
[?2004l[?2004h>     algos.append(("agglo_ward", lambda: AgglomerativeClustering(n_clusters=2, linkage="ward")))
[?2004l[?2004h>     algos.append(("birch", lambda: Birch(n_clusters=2)))
[?2004l[?2004h>     # spectral can be expensive; keep but guard
[?2004l[?2004h>     algos.append(("spectral", lambda: SpectralClustering(n_clusters=2, affinity="nearest_neighbors", n_neighbors=min(10, max(2, X.shape[0]-1)), random_state=RANDOM_STATE)))
[?2004l[?2004h> 
[?2004l[?2004h>     candidates = []
