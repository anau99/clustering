[?2004l[?2004h>                 labels = model.fit_predict(X)
[?2004l[?2004h>             else:
[?2004l[?2004h>                 labels = model.fit_predict(X)
[?2004l[?2004h>             scores = _score_clustering(X, labels)
[?2004l[?2004h>             candidates.append((name, labels, scores))
[?2004l[?2004h>         except Exception as e:
