[34.191582, "i", "cat > /app/run_cluster.py <<'PY'\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.metrics import silhouette_score\n\n\ndef best_cluster_labels(X, prefer=\"silhouette\"):\n    \"\"\"Try a few clusterers and return labels from the best by silhouette.\"\"\"\n    candidates = []\n\n    # KMeans\n    for seed in [0, 1, 2, 3, 4, 7, 11, 42]:\n        km = KMeans(n_clusters=2, n_init=50, random_state=seed)\n        lab = km.fit_predict(X)\n        candidates.append((\"kmeans\", seed, lab))\n\n    # GMM\n    for seed in [0, 1, 2, 3, 4, 7, 11, 42]:\n        gmm = GaussianMixture(n_components=2, covariance_type=\"full\", reg_covar=1e-6, n_init=5, random_state=seed)\n        lab = gmm.fit(X).predict(X)\n        candidates.append((\"gmm\", seed, lab))\n\n    # Agglomerative (no seed)\n    for linkage in "]
[34.192693, "o", "cat > /app/run_cluster.py <<'PY'"]
[34.192764, "i", "[\"ward\", \"complete\", \"average\"]:\n        try:\n            agg = AgglomerativeClustering(n_clusters=2, linkage=linkage)\n            lab = agg.fit_predict(X)\n            candidates.append((f\"agg_{linkage}\", None, lab))\n        except Exception:\n            pass\n\n    best = None\n    best_score = -1e9\n\n    for name, seed, lab in candidates:\n        # silhouette requires >1 label\n        if len(np.unique(lab)) < 2:\n            continue\n        try:\n            sc = silhouette_score(X, lab, metric=\"euclidean\")\n        except Exception:\n            continue\n        if sc > best_score:\n            best_score = sc\n            best = (name, seed, lab)\n\n    if best is None:\n        # fallback: first candidate\n        return candidates[0][2]\n\n    return best[2]\n\n\ndef cluster_diabetes(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    cat_cols = [c for c in df.columns if c != \"age\"]\n    num_cols = [\"age\"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            (\"num\", StandardScaler(), num_cols),\n            "]
[34.192801, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[34.192836, "i", "(\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\n        ],\n        remainder=\"drop\",\n    )\n\n    X = pre.fit_transform(df)\n    labels = best_cluster_labels(X)\n\n    out = pd.DataFrame({\"pseudo_label\": labels.astype(int)})\n    out.to_csv(out_path, index=False)\n\n\ndef cluster_heart(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    cat_cols = [\"sex\", \"cp\", \"fbs\", \"restecg\", \"exang\", \"slope\", \"ca\", \"thal\"]\n    num_cols = [\"age\", \"trestbps\", \"chol\", \"thalach\", \"oldpeak\"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            (\"num\", StandardScaler(), num_cols),\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\n        ],\n        remainder=\"drop\",\n    )\n\n    X = pre.fit_transform(df)\n    labels = best_cluster_labels(X)\n\n    out = pd.DataFrame({\"pseudo_label\": labels.astype(int)})\n    out.to_csv(out_path, index=False)\n\n\nif __name__ == \"__main__\":\n    cluster_diabetes(\"/app/diabetes_data.csv\", \"/app/output_diabetes_data.csv\")\n    cl"]
[34.19286, "i", "uster_heart(\"/app/heart.csv\", \"/app/output_heart.csv\")\n    print(\"Wrote /app/output_diabetes_data.csv and /app/output_heart.csv\")\nPY\n"]
