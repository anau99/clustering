[71.041877, "i", "cat > /app/run_cluster.py <<'PY'\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.cluster import KMeans\n\n\ndef kmeans_best_inertia(X, seeds=(0, 1, 2, 3, 4, 7, 11, 42)):\n    best_lab = None\n    best_inertia = np.inf\n    for seed in seeds:\n        km = KMeans(n_clusters=2, n_init=50, random_state=seed)\n        lab = km.fit_predict(X)\n        if km.inertia_ < best_inertia:\n            best_inertia = km.inertia_\n            best_lab = lab\n    return best_lab\n\n\ndef cluster_diabetes(in_path, out_path):\n    df = pd.read_csv(in_path)\n    cat_cols = [c for c in df.columns if c != \"age\"]\n    num_cols = [\"age\"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            (\"num\", StandardScaler(), num_cols),\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\n        ],\n        remainder=\"drop\",\n    )\n\n    X = pre.fit_transform(df)\n    labels = kmeans_best_inertia(X)"]
[71.042409, "o", "cat > /app/run_cluster.py <<'PY'\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\nfrom sklearn.compose import ColumnTransformer\r\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\r\nfrom sklearn.cluster import KMeans\r\n\r\n\r\ndef kmeans_best_inertia(X, seeds=(0, 1, 2, 3, 4, 7, 11, 42)):\r\n    best_lab = None\r\n    best_inertia = np.inf\r\n    for seed in seeds:\r\n        km = KMeans(n_clusters=2, n_init=50, random_state=seed)\r\n        lab = km.fit_predict(X)\r\n        if km.inertia_ < best_inertia:\r\n            best_inertia = km.inertia_\r\n            best_lab = lab\r\n    return best_lab\r\n\r\n\r\ndef cluster_diabetes(in_path, out_path):\r\n    df = pd.read_csv(in_path)\r\n    cat_cols = [c for c in df.columns if c != \"age\"]\r\n    num_cols = [\"age\"]\r\n\r\n    pre = ColumnTransformer(\r\n        transformers=[\r\n            (\"num\", StandardScaler(), num_cols),\r\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\r\n        ],\r\n        remainder=\"drop\",\r\n    )\r\n\r\n    X = pre.fit_transform(df)\r\n"]
[71.042911, "i", "\n    pd.DataFrame({\"pseudo_label\": labels.astype(int)}).to_csv(out_path, index=False)\n\n\ndef cluster_heart(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    cat_cols = [\"sex\", \"cp\", \"fbs\", \"restecg\", \"exang\", \"slope\", \"ca\", \"thal\"]\n    num_cols = [\"age\", \"trestbps\", \"chol\", \"thalach\", \"oldpeak\"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            (\"num\", StandardScaler(), num_cols),\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\n        ],\n        remainder=\"drop\",\n    )\n\n    X = pre.fit_transform(df)\n    labels = kmeans_best_inertia(X)\n    pd.DataFrame({\"pseudo_label\": labels.astype(int)}).to_csv(out_path, index=False)\n\n\nif __name__ == \"__main__\":\n    cluster_diabetes(\"/app/diabetes_data.csv\", \"/app/output_diabetes_data.csv\")\n    cluster_heart(\"/app/heart.csv\", \"/app/output_heart.csv\")\n    print(\"Wrote /app/output_diabetes_data.csv and /app/output_heart.csv\")\nPY\n"]
[71.043148, "o", "    labels = kmeans_best_inertia(X)\r\n    pd.DataFrame({\"pseudo_label\": labels.astype(int)}).to_csv(out_path, index=False)\r\n\r\n\r\ndef cluster_heart(in_path, out_path):\r\n    df = pd.read_csv(in_path)\r\n\r\n    cat_cols = [\"sex\", \"cp\", \"fbs\", \"restecg\", \"exang\", \"slope\", \"ca\", \"thal\"]\r\n    num_cols = [\"age\", \"trestbps\", \"chol\", \"thalach\", \"oldpeak\"]\r\n\r\n    pre = ColumnTransformer(\r\n        transformers=[\r\n            (\"num\", StandardScaler(), num_cols),\r\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\r\n        ],\r\n        remainder=\"drop\",\r\n    )\r\n\r\n    X = pre.fit_transform(df)\r\n    labels = kmeans_best_inertia(X)\r\n    pd.DataFrame({\"pseudo_label\": labels.astype(int)}).to_csv(out_path, index=False)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    cluster_diabetes(\"/app/diabetes_data.csv\", \"/app/output_diabetes_data.csv\")\r\n    cluster_heart(\"/app/heart.csv\", \"/app/output_heart.csv\")\r\n    print(\"Wrote /app/output_diabetes_data.csv and /app/output_heart.csv\")\r\nPY\r\n"]
[71.265791, "i", "python3 /app/run_cluster.py\n"]
