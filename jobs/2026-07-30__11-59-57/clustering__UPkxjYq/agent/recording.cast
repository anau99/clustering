[34.258308, "o", "    cat_cols = [c for c in df.columns if c != \"age\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.258406, "o", "    num_cols = [\"age\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     pre = ColumnTransformer(\r\n\u001b[?2004l\r\u001b[?2004h> "]
