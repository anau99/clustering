[57.741456, "i", "cat > /app/run_cluster.py <<'PY'\nimport numpy as np\nimport pandas as pd\n\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.metrics import silhouette_score\n\n\ndef best_cluster_labels(X):\n    \"\"\"Try a few clusterers and return labels from the best by silhouette.\"\"\"\n    candidates = []\n\n    # KMeans (fast + strong baseline)\n    for seed in [0, 1, 2, 3, 4, 7, 11, 42]:\n        km = KMeans(n_clusters=2, n_init=50, random_state=seed)\n        lab = km.fit_predict(X)\n        candidates.append((f\"kmeans_{seed}\", lab))\n\n    # Agglomerative (can help on some encodings)\n    for linkage in [\"ward\", \"complete\", \"average\"]:\n        try:\n            agg = AgglomerativeClustering(n_clusters=2, linkage=linkage)\n            lab = agg.fit_predict(X)\n            candidates.append((f\"agg_{linkage}\", lab))\n        except Exception:\n            pass\n\n    best_lab = None\n    best_score = -1e9\n    for name"]
[57.741548, "o", "cat > /app/run_cluster.py <<'PY'"]
[57.741591, "i", ", lab in candidates:\n        if len(np.unique(lab)) < 2:\n            continue\n        try:\n            sc = silhouette_score(X, lab, metric=\"euclidean\")\n        except Exception:\n            continue\n        if sc > best_score:\n            best_score = sc\n            best_lab = lab\n\n    if best_lab is None:\n        return candidates[0][1]\n    return best_lab\n\n\ndef cluster_diabetes(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    cat_cols = [c for c in df.columns if c != \"age\"]\n    num_cols = [\"age\"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            (\"num\", StandardScaler(), num_cols),\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\n        ],\n        remainder=\"drop\",\n    )\n\n    X = pre.fit_transform(df)\n    labels = best_cluster_labels(X)\n    pd.DataFrame({\"pseudo_label\": labels.astype(int)}).to_csv(out_path, index=False)\n\n\ndef cluster_heart(in_path, out_path):\n    df = pd.read_csv(in_path)\n\n    cat_cols = [\"sex\", \"cp\", \"fbs\", \"restecg\", \"exang"]
[57.74178, "i", "\", \"slope\", \"ca\", \"thal\"]\n    num_cols = [\"age\", \"trestbps\", \"chol\", \"thalach\", \"oldpeak\"]\n\n    pre = ColumnTransformer(\n        transformers=[\n            (\"num\", StandardScaler(), num_cols),\n            (\"cat\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False), cat_cols),\n        ],\n        remainder=\"drop\",\n    )\n\n    X = pre.fit_transform(df)\n    labels = best_cluster_labels(X)\n    pd.DataFrame({\"pseudo_label\": labels.astype(int)}).to_csv(out_path, index=False)\n\n\nif __name__ == \"__main__\":\n    cluster_diabetes(\"/app/diabetes_data.csv\", \"/app/output_diabetes_data.csv\")\n    cluster_heart(\"/app/heart.csv\", \"/app/output_heart.csv\")\n    print(\"Wrote /app/output_diabetes_data.csv and /app/output_heart.csv\")\nPY\n"]
