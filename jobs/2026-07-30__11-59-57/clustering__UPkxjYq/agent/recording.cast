[34.216331, "o", "\u001b[?2004l\r\u001b[?2004h"]
[34.216993, "o", "> "]
[34.217027, "o", "        gmm = GaussianMixture(n_components=2, covariance_type=\"full\", reg_covar=1e-6, n_init=5, random_state=seed)"]
