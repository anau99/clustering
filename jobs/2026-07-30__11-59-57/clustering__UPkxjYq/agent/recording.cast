[60.209492, "i", "python3 -c \"import pandas as pd; d=pd.read_csv('/app/output_diabetes_data.csv'); h=pd.read_csv('/app/output_heart.csv'); print('diabetes counts:\\n',d['pseudo_label'].value_counts()); print('heart counts:\\n',h['pseudo_label'].value_counts()); assert list(d.columns)==['pseudo_label']; assert list(h.columns)==['pseudo_label']; assert set(d['pseudo_label'].unique()).issubset({0,1}); assert set(h['pseudo_label'].unique()).issubset({0,1}); print('format ok')\"\n"]
[60.209649, "o", "python3 -c \"import pandas as pd; d=pd.read_csv('/app/output_diabetes_data.csv'); h=pd.read_csv('/app/output_heart.csv'); print('diabetes counts:\\n',d['pseudo_label'].value_counts()); print('heart counts:\\n',h['pseudo_label'].value_counts()); assert list(d.columns)==['pseudo_label']; assert list(h.columns)==['pseudo_label']; assert set(d['pseudo_label'].unique()).issubset({0,1}); assert set(h['pseudo_label'].unique()).issubset({0,1}); print('format ok')\"\r\n"]
