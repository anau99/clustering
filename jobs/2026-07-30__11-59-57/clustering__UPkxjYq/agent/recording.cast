[80.988194, "o", "\r\n\u001b[?2004l\r"]
[80.992449, "o", "-rw-r--r-- 1 root root 1053 Jul 30 05:02 /app/output_diabetes_data.csv\r\n-rw-r--r-- 1 root root 2063 Jul 30 05:02 /app/output_heart.csv\r\n"]
[80.992928, "o", "\u001b[?2004h"]
[80.99324, "o", "root@3d81a04076cb:/app# "]
[80.995024, "o", "python3 -c \"import pandas as pd; d=pd.read_csv('/app/output_diabetes_data.csv'); h=pd.read_csv('/app/output_heart.csv'); print('diabetes counts:', d['pseudo_label'].value_counts().to_dict()); print('heart counts:', h['pseudo_label'].value_counts().to_dict()); assert list(d.columns)==['pseudo_label']; assert list(h.columns)==['pseudo_label']; assert set(d['pseudo_label'].unique()).issubset({0,1}); assert set(h['pseudo_label'].unique()).issubset({0,1}); print('format ok')\"\r\n"]
[80.995139, "o", "\u001b[?2004l\r"]
[81.733217, "o", "diabetes counts: {0: 274, 1: 246}\r\n"]
