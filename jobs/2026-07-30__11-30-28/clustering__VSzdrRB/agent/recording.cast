[78.399596, "i", "cat > /app/solve.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, SpectralClustering, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder, MinMaxScaler\nfrom sklearn.decomposition import PCA\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ===================== DIABETES DATASET =====================\nprint(\"=== Processing Diabetes Dataset ===\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\n\n# Encode gender: Male=1, Female=0\ndf_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\n\n# The key features for diabetes are polyuria and polydipsia\n# Strategy: use all features, scale age, and cluster\n\n# Approach 1: StandardScaler on age, keep binary as-is, KMeans\ndf_d = df_diabetes.copy()\nscaler = StandardScaler()\ndf_d['age'] = scaler.fit_transform(df_d[['age']])\n\n# Try multiple methods\nresults_diabetes = {}\n\n# KMeans\nkm = KMeans(n_clusters=2, init='k-means++', n_init=50, ran"]
[78.399659, "i", "dom_state=42)\nresults_diabetes['kmeans'] = km.fit_predict(df_d)\n\n# GMM\ngmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_diabetes['gmm'] = gmm.fit_predict(df_d)\n\n# Agglomerative\nagg = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_diabetes['agg'] = agg.fit_predict(df_d)\n\n# Approach 2: Weight important features more heavily\ndf_d2 = df_diabetes.copy()\nscaler2 = StandardScaler()\ndf_d2['age'] = scaler2.fit_transform(df_d2[['age']])\n# Weight polyuria and polydipsia more (they are classic diabetes symptoms)\ndf_d2['polyuria'] = df_d2['polyuria'] * 2\ndf_d2['polydipsia'] = df_d2['polydipsia'] * 2\n\nkm2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans_weighted'] = km2.fit_predict(df_d2)\n\ngmm2 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_diabetes['gmm_weighted'] = gmm2.fit_predict(df_d2)\n\n# Approach 3: Use only the most relevant features\nkey_features = ['polyuria', '"]
[78.399701, "i", "polydipsia', 'sudden_weight_loss', 'polyphagia', \n                'irritability', 'partial_paresis', 'gender', 'age']\ndf_d3 = df_diabetes[key_features].copy()\ndf_d3['age'] = StandardScaler().fit_transform(df_d3[['age']])\n\nkm3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans_key'] = km3.fit_predict(df_d3)\n\n# Approach 4: Scale all features with StandardScaler\ndf_d4 = df_diabetes.copy().astype(float)\ndf_d4 = pd.DataFrame(StandardScaler().fit_transform(df_d4), columns=df_d4.columns)\n\nkm4 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans_allscaled'] = km4.fit_predict(df_d4)\n\ngmm4 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_diabetes['gmm_allscaled'] = gmm4.fit_predict(df_d4)\n\nagg4 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_diabetes['agg_allscaled'] = agg4.fit_predict(df_d4)\n\n# Approach 5: Simple rule-based using polyuria + polydipsia as primary signal\ndf_d5 "]
[78.399747, "i", "= df_diabetes.copy()\nscore = df_d5['polyuria'] + df_d5['polydipsia'] + df_d5['sudden_weight_loss'] + df_d5['irritability'] + df_d5['partial_paresis'] + df_d5['polyphagia'] + df_d5['gender']\nresults_diabetes['rule_based'] = (score >= 3).astype(int).values\n\nprint(\"Diabetes clustering done. Methods tried:\", list(results_diabetes.keys()))\nfor k, v in results_diabetes.items():\n    print(f\"  {k}: cluster 0 = {sum(v==0)}, cluster 1 = {sum(v==1)}\")\n\n# Use GMM with weighted features as primary choice (usually works well for mixed data)\n# But let's pick the one that gives a reasonable split\nbest_diabetes = results_diabetes['kmeans_weighted']\nprint(f\"\\nSelected for diabetes: kmeans_weighted\")\n\n# ===================== HEART DATASET =====================\nprint(\"\\n=== Processing Heart Dataset ===\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\nnumerical_features = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_features = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\nresults_heart = {}\n\n# Approach 1: "]
