[78.399905, "i", "_init=10)\nresults_heart['gmm_key'] = gmm_h3.fit_predict(df_h3)\n\nagg_h3 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_heart['agg_key'] = agg_h3.fit_predict(df_h3)\n\n# Approach 4: One-hot with key features weighted\ndf_h4 = df_heart.copy()\ndf_h4_num = df_h4[numerical_features].copy()\ndf_h4_num = pd.DataFrame(StandardScaler().fit_transform(df_h4_num), columns=numerical_features)\n\nencoder4 = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\ndf_h4_cat = pd.DataFrame(encoder4.fit_transform(df_h4[categorical_features]))\n\ndf_h4_combined = pd.concat([df_h4_num.reset_index(drop=True), df_h4_cat.reset_index(drop=True)], axis=1)\n\n# Weight important features\n# cp, ca, thal, exang, slope are important - already one-hot encoded\n# oldpeak and thalach are important numerical features\ndf_h4_combined['oldpeak'] = df_h4_combined['oldpeak'] * 2\ndf_h4_combined['thalach'] = df_h4_combined['thalach'] * 2\n\nkm_h4 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_onehot"]
