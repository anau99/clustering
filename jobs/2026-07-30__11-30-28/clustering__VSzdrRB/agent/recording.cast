[437.339035, "o", "    agree_flip = np.sum(majority == (1 - c))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[437.339149, "o", "    agree = max(agree_same, agree_flip)\r\n\u001b[?2004l\r"]
[437.339234, "o", "\u001b[?2004h> "]
[437.33966, "o", "    split = f\"{sum(c==0)}/{sum(c==1)}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[437.339912, "o", "    print(f\"  {name}: agreement={agree/len(c):.4f}, split={split}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[437.339941, "o", "\u001b[?2004h> "]
[437.340508, "o", "# Use majority vote as final\r\n\u001b[?2004l\r\u001b[?2004h> best_heart = majority\r\n\u001b[?2004l\r\u001b[?2004h> "]
[437.340681, "o", "print(f\"\\nFinal heart (majority): {sum(best_heart==0)}/{sum(best_heart==1)}\")\r\n\u001b[?2004l\r"]
[437.340807, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[437.34102, "o", "# ===================== SAVE =====================\r\n\u001b[?2004l\r"]
[437.341108, "o", "\u001b[?2004h"]
[437.34247, "o", "> "]
[437.342571, "o", "out_d = pd.DataFrame({'pseudo_label': best_diabetes})\r\n\u001b[?2004l\r\u001b[?2004h> out_d.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nSaved diabetes: {sum(best_diabetes==0)}/{sum(best_diabetes==1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out_h = pd.DataFrame({'pseudo_label': best_heart})\r\n\u001b[?2004l\r\u001b[?2004h> out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
