[487.703371, "i", "cat > /app/solve_final2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ===================== DIABETES =====================\nprint(\"=== Diabetes ===\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\n\n# polyuria OR polydipsia - the two strongest diabetes indicators\n# This had highest consensus with other methods (avg ARI=0.73)\nbest_diabetes = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\nprint(f\"Split: {sum(best_diabetes==0)}/{sum(best_diabetes==1)}\")\n\n# ===================== HEART =====================\nprint(\"\\n=== Heart ===\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\n# Weight important clinical features for heart disease\ndf_hw = df_heart.copy().astype(float)\ndf_hw['cp'] = df_hw['cp'] "]
[487.70357, "i", "* 2       # chest pain type\ndf_hw['ca'] = df_hw['ca'] * 2       # number of major vessels\ndf_hw['thal'] = df_hw['thal'] * 2   # thalassemia\ndf_hw['oldpeak'] = df_hw['oldpeak'] * 1.5  # ST depression\ndf_hw['exang'] = df_hw['exang'] * 2  # exercise induced angina\ndf_hw['slope'] = df_hw['slope'] * 1.5  # slope of peak exercise ST\ndf_hw['thalach'] = df_hw['thalach'] * 1.5  # max heart rate\n\n# Scale and cluster with Agglomerative Ward (gives realistic ~50/50 split)\ndf_hw_s = pd.DataFrame(StandardScaler().fit_transform(df_hw), columns=df_hw.columns)\nbest_heart = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hw_s)\nprint(f\"Split: {sum(best_heart==0)}/{sum(best_heart==1)}\")\n\n# ===================== SAVE =====================\nout_d = pd.DataFrame({'pseudo_label': best_diabetes})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\n\nout_h = pd.DataFrame({'pseudo_label': best_heart})\nout_h.to_csv('/app/output_heart.csv', index=False)\n\nprint(\"\\nSaved!\")\nprint(f\"Diabetes output: {len(out_d)} ro"]
