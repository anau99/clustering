[114.279454, "i", "cat > /app/solve.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, SpectralClustering, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder, MinMaxScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ===================== DIABETES DATASET =====================\nprint(\"=== Processing Diabetes Dataset ===\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\n\n# Approach: Weight important features, scale age\ndf_d2 = df_diabetes.copy()\ndf_d2['age'] = StandardScaler().fit_transform(df_d2[['age']])\ndf_d2['polyuria'] = df_d2['polyuria'] * 2\ndf_d2['polydipsia'] = df_d2['polydipsia'] * 2\n\nkm2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nbest_diabetes = km2.fit_predict(df_d2)\nprint(f\"Diabetes: cluster 0 = {sum(best_diabetes==0)}, cluster 1 = {sum(best_diabetes==1)}\")\n\n# ===================== HEART DAT"]
[114.27953, "i", "ASET =====================\nprint(\"\\n=== Processing Heart Dataset ===\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\nnumerical_features = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_features = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\nresults_heart = {}\n\n# Approach 1: One-hot encode categoricals, scale numericals\ndf_h1_num = df_heart[numerical_features].copy()\ndf_h1_num = pd.DataFrame(StandardScaler().fit_transform(df_h1_num), columns=numerical_features)\n\nencoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\ndf_h1_cat_encoded = encoder.fit_transform(df_heart[categorical_features])\ndf_h1_cat = pd.DataFrame(df_h1_cat_encoded, columns=[str(c) for c in encoder.get_feature_names_out(categorical_features)])\n\ndf_h1_combined = pd.concat([df_h1_num.reset_index(drop=True), df_h1_cat.reset_index(drop=True)], axis=1)\ndf_h1_combined.columns = df_h1_combined.columns.astype(str)\n\nkm_h1 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_one"]
[114.279561, "i", "hot'] = km_h1.fit_predict(df_h1_combined)\n\ngmm_h1 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_onehot'] = gmm_h1.fit_predict(df_h1_combined)\n\nagg_h1 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_heart['agg_onehot'] = agg_h1.fit_predict(df_h1_combined)\n\n# Approach 2: Treat all as numerical, scale everything\ndf_h2 = df_heart.copy().astype(float)\ndf_h2 = pd.DataFrame(StandardScaler().fit_transform(df_h2), columns=df_h2.columns)\n\nkm_h2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_allscaled'] = km_h2.fit_predict(df_h2)\n\ngmm_h2 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_allscaled'] = gmm_h2.fit_predict(df_h2)\n\nagg_h2 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_heart['agg_allscaled'] = agg_h2.fit_predict(df_h2)\n\n# Approach 3: Focus on key heart disease indicators\nkey_heart_features = ['cp', 'thalach', 'oldpeak', '"]
[114.279578, "i", "ca', 'thal', 'exang', 'slope']\ndf_h3 = df_heart[key_heart_features].copy().astype(float)\ndf_h3 = pd.DataFrame(StandardScaler().fit_transform(df_h3), columns=key_heart_features)\n\nkm_h3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_key'] = km_h3.fit_predict(df_h3)\n\ngmm_h3 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_key'] = gmm_h3.fit_predict(df_h3)\n\nagg_h3 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_heart['agg_key'] = agg_h3.fit_predict(df_h3)\n\n# Approach 4: Spectral clustering on key features\nspec_h = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)\nresults_heart['spectral_key'] = spec_h.fit_predict(df_h3)\n\nspec_h2 = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)\nresults_heart['spectral_allscaled'] = spec_h2.fit_predict(df_h2)\n\n# Approach 5: One-hot with weighted important features\ndf_h5 = df"]
[114.279594, "i", "_h1_combined.copy()\n# Weight oldpeak and thalach more\ndf_h5['oldpeak'] = df_h5['oldpeak'] * 2\ndf_h5['thalach'] = df_h5['thalach'] * 2\n\nkm_h5 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_onehot_w'] = km_h5.fit_predict(df_h5)\n\ngmm_h5 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_onehot_w'] = gmm_h5.fit_predict(df_h5)\n\n# Approach 6: Key features with more weight on ca, thal, cp\ndf_h6 = df_heart[key_heart_features].copy().astype(float)\ndf_h6['ca'] = df_h6['ca'] * 2\ndf_h6['thal'] = df_h6['thal'] * 2\ndf_h6['cp'] = df_h6['cp'] * 2\ndf_h6 = pd.DataFrame(StandardScaler().fit_transform(df_h6), columns=key_heart_features)\n\nkm_h6 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_key_w'] = km_h6.fit_predict(df_h6)\n\ngmm_h6 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_key_w'] = gmm_h6.fit_predict(df_h6)\n\nprint(\"Heart clust"]
[114.279616, "i", "ering done.\")\nfor k, v in results_heart.items():\n    print(f\"  {k}: cluster 0 = {sum(v==0)}, cluster 1 = {sum(v==1)}\")\n\n# Select best - GMM on key features is often a good choice for mixed data\nbest_heart = results_heart['gmm_key']\nprint(f\"\\nSelected for heart: gmm_key\")\n\n# ===================== SAVE RESULTS =====================\nout_diabetes = pd.DataFrame({'pseudo_label': best_diabetes})\nout_diabetes.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nSaved diabetes: {out_diabetes['pseudo_label'].value_counts().to_dict()}\")\n\nout_heart = pd.DataFrame({'pseudo_label': best_heart})\nout_heart.to_csv('/app/output_heart.csv', index=False)\nprint(f\"Saved heart: {out_heart['pseudo_label'].value_counts().to_dict()}\")\n\nprint(\"\\nDone!\")\nEOF\n"]
[114.280052, "o", "cat > /app/solve.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.280077, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r oldpeak and thalach more\r\ndf_h5['oldpea"]
[114.282605, "o", "\u001b[?2004h> "]
[114.283562, "o", "from sklearn.cluster import KMeans, SpectralClustering, AgglomerativeClustering\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.mixture import GaussianMixture\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.preprocessing import StandardScaler, OneHotEncoder, MinMaxScaler\r\n\u001b[?2004l\r\u001b[?2004h> import warnings\r\n\u001b[?2004l\r\u001b[?2004h> warnings.filterwarnings('ignore')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.285772, "o", "# ===================== DIABETES DATASET =====================\r\n"]
[114.286086, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[114.286741, "o", "print(\"=== Processing Diabetes Dataset ===\")\r\n"]
[114.286914, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.287129, "o", "> "]
[114.287956, "o", "df_diabetes = pd.read_csv('/app/diabetes_data.csv')\r\n"]
[114.288373, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.288879, "o", "> "]
[114.290104, "o", "df_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\r\n\u001b[?2004l\r'] = d"]
[114.290293, "o", "\u001b[?2004h"]
[114.290757, "o", "> "]
[114.290948, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.291274, "o", "> "]
[114.292162, "o", "# Approach: Weight important features, scale age\r\n\u001b[?2004l\r 2\r\nd\u001b[?2004h"]
[114.292533, "o", "> "]
[114.294757, "o", "df_d2 = df_diabetes.copy()\r\n\u001b[?2004l\r\u001b[?2004h> df_d2['age'] = StandardScaler().fit_transform(df_d2[['age']])\r\n\u001b[?2004l\r\u001b[?2004h> df_d2['polyuria'] = df_d2['polyuria'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_d2['polydipsia'] = df_d2['polydipsia'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> km2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.295227, "o", "best_diabetes = km2.fit_predict(df_d2)"]
[114.29541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.29569, "o", "> "]
[114.297159, "o", "print(f\"Diabetes: cluster 0 = {sum(best_diabetes==0)}, cluster 1 = {sum(best_diabetes==1)}\")"]
[114.297335, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.297568, "o", "> "]
[114.297895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.297951, "o", "> "]
[114.29912, "o", "# ===================== HEART DATASET =====================\r\n"]
[114.299417, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.299807, "o", "> "]
[114.300637, "o", "print(\"\\n=== Processing Heart Dataset ===\")"]
[114.300674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.300991, "o", "> "]
[114.301767, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n"]
[114.30195, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.302215, "o", "> "]
[114.302294, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.302621, "o", "> "]
[114.30342, "o", "numerical_features = ['trestbps', 'chol', 'thalach', 'oldpeak']"]
[114.304031, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.304426, "o", "> "]
[114.305811, "o", "categorical_features = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n"]
[114.306093, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.306241, "o", "> "]
[114.306473, "o", "\r\n"]
[114.306707, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.307076, "o", "> "]
[114.30821, "o", "results_heart = {}"]
[114.308539, "o", "\r\n"]
[114.308568, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.30953, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 1: One-hot encode categoricals, scale numericals\r\n\u001b[?2004l\r"]
[114.309613, "o", "\u001b[?2004h"]
[114.309656, "o", "> "]
[114.310334, "o", "df_h1_num = df_heart[numerical_features].copy()\r\n"]
[114.310365, "o", "\u001b[?2004l\r"]
[114.310631, "o", "\u001b[?2004h"]
[114.310802, "o", "> "]
[114.311425, "o", "df_h1_num = pd.DataFrame(StandardScaler().fit_transform(df_h1_num), columns=numerical_features)\r\n"]
[114.311765, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.312018, "o", "> \r\n\u001b[?2004l\r"]
[114.312252, "o", "\u001b[?2004h> "]
[114.313154, "o", "encoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\r\n\u001b[?2004l\r"]
[114.31332, "o", "\u001b[?2004h"]
[114.313419, "o", "> "]
[114.314051, "o", "df_h1_cat_encoded = encoder.fit_transform(df_heart[categorical_features])\r\n"]
[114.314071, "o", "\u001b[?2004l\r"]
[114.314228, "o", "\u001b[?2004h"]
[114.314342, "o", "> "]
[114.315587, "o", "df_h1_cat = pd.DataFrame(df_h1_cat_encoded, columns=[str(c) for c in encoder.get_feature_names_out(categorical_features)])\r\n\u001b[?2004l\r"]
[114.316523, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> df_h1_combined = pd.concat([df_h1_num.reset_index(drop=True), df_h1_cat.reset_index(drop=True)], axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.31665, "o", "df_h1_combined.columns = df_h1_combined.columns.astype(str)"]
[114.316972, "o", "\r\n\u001b[?2004l\r"]
[114.317044, "o", "\u001b[?2004h"]
[114.317161, "o", "> "]
[114.317189, "o", "\r\n"]
[114.317317, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.317333, "o", "> "]
[114.317993, "o", "km_h1 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r"]
[114.318057, "o", "\u001b[?2004h"]
[114.318141, "o", "> "]
[114.318688, "o", "results_heart['kmeans_onehot'] = km_h1.fit_predict(df_h1_combined)\r\n\u001b[?2004l\r"]
[114.318854, "o", "\u001b[?2004h"]
[114.31899, "o", "> "]
[114.319063, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.319515, "o", "> "]
[114.319803, "o", "gmm_h1 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n"]
[114.319884, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.319909, "o", "> "]
[114.32019, "o", "results_heart['gmm_onehot'] = gmm_h1.fit_predict(df_h1_combined)"]
[114.320374, "o", "\r\n\u001b[?2004l\r"]
[114.320442, "o", "\u001b[?2004h> \r\n"]
[114.32058, "o", "\u001b[?2004l\r"]
[114.320602, "o", "\u001b[?2004h> "]
[114.32089, "o", "agg_h1 = AgglomerativeClustering(n_clusters=2, linkage='ward')"]
[114.321082, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.321351, "o", "results_heart['agg_onehot'] = agg_h1.fit_predict(df_h1_combined)\r\n"]
[114.321573, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.321602, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[114.321617, "o", "> "]
[114.321892, "o", "# Approach 2: Treat all as numerical, scale everything"]
[114.321917, "o", "\r\n"]
[114.322083, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.322297, "o", "> df_h2 = df_heart.copy().astype(float)"]
[114.322394, "o", "\r\n"]
[114.322617, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[114.32289, "o", "df_h2 = pd.DataFrame(StandardScaler().fit_transform(df_h2), columns=df_h2.columns)\r\n\u001b[?2004l\r"]
[114.322993, "o", "\u001b[?2004h"]
[114.323009, "o", "> "]
[114.323223, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.323525, "o", "km_h2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n"]
[114.323549, "o", "\u001b[?2004l\r"]
[114.323667, "o", "\u001b[?2004h> "]
[114.324031, "o", "results_heart['kmeans_allscaled'] = km_h2.fit_predict(df_h2)"]
[114.324112, "o", "\r\n"]
[114.324133, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.324386, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.324759, "o", "gmm_h2 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n"]
[114.324863, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.324973, "o", "> "]
[114.325197, "o", "results_heart['gmm_allscaled'] = gmm_h2.fit_predict(df_h2)"]
[114.325391, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.325706, "o", "agg_h2 = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n"]
[114.325809, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.32591, "o", "> "]
[114.326131, "o", "results_heart['agg_allscaled'] = agg_h2.fit_predict(df_h2)"]
[114.326317, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.326599, "o", "# Approach 3: Focus on key heart disease indicators\r\n"]
[114.326673, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.326893, "o", "> "]
[114.327153, "o", "key_heart_features = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']"]
[114.327496, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> df_h3 = df_heart[key_heart_features].copy().astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.327919, "o", "df_h3 = pd.DataFrame(StandardScaler().fit_transform(df_h3), columns=key_heart_features)\r\n"]
[114.328023, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.328138, "o", "> \r\n\u001b[?2004l\r"]
[114.328154, "o", "\u001b[?2004h"]
[114.328387, "o", "> "]
[114.328579, "o", "km_h3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n"]
[114.328681, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.328697, "o", "> "]
[114.329003, "o", "results_heart['kmeans_key'] = km_h3.fit_predict(df_h3)"]
[114.329028, "o", "\r\n"]
[114.32913, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.329241, "o", "> \r\n\u001b[?2004l\r"]
[114.329258, "o", "\u001b[?2004h"]
[114.32951, "o", "> "]
[114.329723, "o", "gmm_h3 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)"]
[114.329822, "o", "\r\n\u001b[?2004l\r"]
[114.329839, "o", "\u001b[?2004h"]
[114.330085, "o", "> "]
[114.330223, "o", "results_heart['gmm_key'] = gmm_h3.fit_predict(df_h3)\r\n"]
[114.33025, "o", "\u001b[?2004l\r"]
[114.330472, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.330718, "o", "agg_h3 = AgglomerativeClustering(n_clusters=2, linkage='ward')"]
[114.33084, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.33095, "o", "> "]
[114.33124, "o", "results_heart['agg_key'] = agg_h3.fit_predict(df_h3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.331264, "o", "\r\n\u001b[?2004l\r"]
[114.331367, "o", "\u001b[?2004h"]
[114.331565, "o", "> "]
[114.331743, "o", "# Approach 4: Spectral clustering on key features\r\n\u001b[?2004l\r"]
[114.331902, "o", "\u001b[?2004h> "]
[114.33228, "o", "spec_h = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)"]
[114.332381, "o", "\r\n\u001b[?2004l\r"]
[114.332504, "o", "\u001b[?2004h> "]
[114.332785, "o", "results_heart['spectral_key'] = spec_h.fit_predict(df_h3)\r\n"]
[114.332808, "o", "\u001b[?2004l\r"]
[114.332916, "o", "\u001b[?2004h"]
[114.333028, "o", "> \r\n\u001b[?2004l\r"]
[114.333269, "o", "\u001b[?2004h> "]
[114.333558, "o", "spec_h2 = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)"]
[114.333654, "o", "\r\n\u001b[?2004l\r"]
[114.333795, "o", "\u001b[?2004h> "]
[114.334073, "o", "results_heart['spectral_allscaled'] = spec_h2.fit_predict(df_h2)\r\n"]
[114.334093, "o", "\u001b[?2004l\r"]
[114.334271, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.334375, "o", "\u001b[?2004h"]
[114.334395, "o", "> "]
[114.334666, "o", "# Approach 5: One-hot with weighted important features\r\n"]
[114.33469, "o", "\u001b[?2004l\r"]
[114.334935, "o", "\u001b[?2004h"]
[114.335509, "o", "> df_h5 = df_h1_combined.copy()\r\n\u001b[?2004l\r\u001b[?2004h> # Weight oldpeak and thalach more\r\n\u001b[?2004l\r\u001b[?2004h> df_h5['oldpeak'] = df_h5['oldpeak'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.33565, "o", "df_h5['thalach'] = df_h5['thalach'] * 2"]
[114.335669, "o", "\r\n"]
[114.335951, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.336189, "o", "km_h5 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)"]
[114.3363, "o", "\r\n\u001b[?2004l\r"]
[114.336418, "o", "\u001b[?2004h> "]
[114.336714, "o", "results_heart['kmeans_onehot_w'] = km_h5.fit_predict(df_h5)\r\n"]
[114.336738, "o", "\u001b[?2004l\r"]
[114.336912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[114.336999, "o", "\u001b[?2004h"]
[114.337162, "o", "> "]
[114.337517, "o", "gmm_h5 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n"]
[114.337622, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.337744, "o", "> "]
[114.337988, "o", "results_heart['gmm_onehot_w'] = gmm_h5.fit_predict(df_h5)\r\n"]
[114.338012, "o", "\u001b[?2004l\r"]
[114.3382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[114.338321, "o", "> "]
[114.338623, "o", "# Approach 6: Key features with more weight on ca, thal, cp\r\n\u001b[?2004l\r"]
[114.338736, "o", "\u001b[?2004h"]
[114.338957, "o", "> "]
[114.339176, "o", "df_h6 = df_heart[key_heart_features].copy().astype(float)"]
[114.339309, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.339519, "o", "> df_h6['ca'] = df_h6['ca'] * 2"]
[114.339617, "o", "\r\n"]
[114.339713, "o", "\u001b[?2004l\r"]
[114.339861, "o", "\u001b[?2004h"]
[114.339883, "o", "> "]
[114.340094, "o", "df_h6['thal'] = df_h6['thal'] * 2"]
[114.340119, "o", "\r\n"]
[114.340236, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.340253, "o", "> "]
[114.340547, "o", "df_h6['cp'] = df_h6['cp'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.340929, "o", "df_h6 = pd.DataFrame(StandardScaler().fit_transform(df_h6), columns=key_heart_features)\r\n"]
[114.341028, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.341228, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.341484, "o", "km_h6 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)"]
[114.341692, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.34193, "o", "results_heart['kmeans_key_w'] = km_h6.fit_predict(df_h6)\r\n"]
[114.341954, "o", "\u001b[?2004l\r"]
[114.342069, "o", "\u001b[?2004h"]
[114.342088, "o", "> "]
[114.342217, "o", "\r\n\u001b[?2004l\r"]
[114.342235, "o", "\u001b[?2004h"]
[114.342546, "o", "> "]
[114.342702, "o", "gmm_h6 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)"]
[114.342812, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.342986, "o", "> "]
[114.343171, "o", "results_heart['gmm_key_w'] = gmm_h6.fit_predict(df_h6)"]
[114.343197, "o", "\r\n"]
[114.343296, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.343412, "o", "> \r\n\u001b[?2004l\r"]
[114.343429, "o", "\u001b[?2004h"]
[114.343719, "o", "> print(\"Heart clustering done.\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.343743, "o", "> "]
[114.343965, "o", "for k, v in results_heart.items():\r\n"]
[114.344064, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.344081, "o", "> "]
[114.344384, "o", "    print(f\"  {k}: cluster 0 = {sum(v==0)}, cluster 1 = {sum(v==1)}\")"]
[114.344585, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[114.344609, "o", "> "]
[114.344974, "o", "# Select best - GMM on key features is often a good choice for mixed data\r\n"]
[114.344997, "o", "\u001b[?2004l\r"]
[114.345206, "o", "\u001b[?2004h> "]
[114.345407, "o", "best_heart = results_heart['gmm_key']\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.345431, "o", "> "]
[114.345699, "o", "print(f\"\\nSelected for heart: gmm_key\")"]
[114.345723, "o", "\r\n"]
[114.345826, "o", "\u001b[?2004l\r\u001b[?2004h"]
[114.345944, "o", "> \r\n\u001b[?2004l\r"]
[114.345961, "o", "\u001b[?2004h"]
[114.346228, "o", "> "]
[114.346386, "o", "# ===================== SAVE RESULTS =====================\r\n\u001b[?2004l\r"]
[114.346585, "o", "\u001b[?2004h"]
