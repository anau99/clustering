[437.306048, "i", "cat > /app/solve_v4.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.metrics import adjusted_rand_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ===================== DIABETES DATASET =====================\nprint(\"=== Diabetes Dataset ===\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\n\n# Rule-based: polyuria OR polydipsia - strongest diabetes indicators\nbest_diabetes = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\nprint(f\"Diabetes (rule polyuria|polydipsia): {sum(best_diabetes==0)}/{sum(best_diabetes==1)}\")\n\n# ===================== HEART DATASET =====================\nprint(\"\\n=== Heart Dataset ===\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\n# The heart disease dataset expected: ~50/50\n# Key featur"]
[437.306107, "i", "es for heart disease: cp, thalach, oldpeak, ca, thal, exang, slope\n# Strategy: Use all features with important ones weighted, then agglomerative\n# Also try majority vote ensemble for robustness\n\nnumerical_features = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_features = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\nkey_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']\n\n# Prepare different feature representations\n# 1. All scaled\ndf_hall = df_heart.copy().astype(float)\ndf_hall_s = pd.DataFrame(StandardScaler().fit_transform(df_hall), columns=df_hall.columns)\n\n# 2. Weighted all\ndf_hw = df_heart.copy().astype(float)\ndf_hw['cp'] = df_hw['cp'] * 2\ndf_hw['ca'] = df_hw['ca'] * 2\ndf_hw['thal'] = df_hw['thal'] * 2\ndf_hw['oldpeak'] = df_hw['oldpeak'] * 1.5\ndf_hw['exang'] = df_hw['exang'] * 2\ndf_hw['slope'] = df_hw['slope'] * 1.5\ndf_hw['thalach'] = df_hw['thalach'] * 1.5\ndf_hw_s = pd.DataFrame(StandardScaler().fit_transform(df_hw), columns=df_hw.columns)\n\n# 3. One-hot\ndf_h_num "]
[437.306136, "i", "= pd.DataFrame(StandardScaler().fit_transform(df_heart[numerical_features]), columns=numerical_features)\nencoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\ndf_h_cat = pd.DataFrame(encoder.fit_transform(df_heart[categorical_features]),\n                        columns=encoder.get_feature_names_out(categorical_features))\ndf_h_oh = pd.concat([df_h_num, df_h_cat], axis=1)\n\n# Generate multiple clusterings\nclusterings = []\n\n# Agglomerative ward - all scaled\nc1 = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hall_s)\nclusterings.append(('agg_all', c1))\n\n# Agglomerative ward - weighted\nc2 = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hw_s)\nclusterings.append(('agg_allw', c2))\n\n# Agglomerative ward - one-hot\nc3 = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_h_oh)\nclusterings.append(('agg_oh', c3))\n\n# KMeans - all scaled\nc4 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hall_s)\nclusterings.appe"]
[437.306253, "i", "nd(('km_all', c4))\n\n# KMeans - weighted\nc5 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hw_s)\nclusterings.append(('km_allw', c5))\n\n# KMeans - one-hot\nc6 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_h_oh)\nclusterings.append(('km_oh', c6))\n\n# Key features\ndf_hkey_s = pd.DataFrame(StandardScaler().fit_transform(df_heart[key_h].astype(float)), columns=key_h)\nc7 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hkey_s)\nclusterings.append(('km_key', c7))\n\nc8 = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hkey_s)\nclusterings.append(('agg_key', c8))\n\n# Agglomerative with different linkages\nc9 = AgglomerativeClustering(n_clusters=2, linkage='complete').fit_predict(df_hall_s)\nclusterings.append(('agg_complete', c9))\n\nc10 = AgglomerativeClustering(n_clusters=2, linkage='average').fit_predict(df_hall_s)\nclusterings.append(('agg_average', c10))\n\nprint(\"Individual methods:\")\nfor name, c"]
[437.30651, "o", "cat > /app/solve_v4.py << 'EOF'\r\n\u001b[?2004l\rnd(('km_all', c4))\r\n\r\n# KMeans - weighted\r\nc5 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hw_s)\r\nclusterings.append(('km_allw', c5))\r\n\r\n# KMeans - one-hot\r\nc6 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_h_oh)\r\nclusterings.append(('km_oh', c6))\r\n\r\n# Key features\r\ndf_hkey_s = pd.DataFrame(StandardScaler().fit_transform(df_heart[key_h].astype(float)), columns=key_h)\r\nc7 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hkey_s)\r\nclusterings.append(('km_key', c7))\r\n\r\nc8 = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hkey_s)\r\nclusterings.append(('agg_key', c8))\r\n\r\n# Agglomerative with different linkages\r\nc9 = AgglomerativeClustering(n_clusters=2, linkage='complete').fit_predict(df_hall_s)\r\nclusterings.append(('agg_complete', c9))\r\n\r\nc10 = AgglomerativeClustering(n_clusters=2, linkage='average').fit_predict(df_hall_s)\r\nclusterings.appen"]
[437.306924, "i", " in clusterings:\n    print(f\"  {name}: {sum(c==0)}/{sum(c==1)}\")\n\n# Majority vote ensemble\n# First align labels - use the first method as reference\nref = clusterings[0][1]\naligned = [ref.copy()]\nfor name, c in clusterings[1:]:\n    # Check if we need to flip labels\n    ari_same = adjusted_rand_score(ref, c)\n    # ARI is symmetric, no need to flip - but for voting we need consistent labels\n    # Check which alignment gives better agreement with reference\n    agree_same = np.sum(ref == c)\n    agree_flip = np.sum(ref == (1 - c))\n    if agree_flip > agree_same:\n        aligned.append(1 - c)\n    else:\n        aligned.append(c.copy())\n\n# Majority vote\nvotes = np.array(aligned)\nmajority = (votes.sum(axis=0) > len(aligned) / 2).astype(int)\n\nprint(f\"\\nMajority vote ensemble: {sum(majority==0)}/{sum(majority==1)}\")\n\n# Also try: pick the balanced method with highest agreement with majority\nprint(\"\\nAgreement with majority vote:\")\nbest_agree = -1\nbest_method = None\nfor name, c in clusterings:\n    # Align with majority\n   "]
[437.307802, "o", "d(('agg_average', c10))\r\n\r\nprint(\"Individual methods:\")\r\nfor name, c\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.cluster import KMeans, AgglomerativeClustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[437.307842, "i", " agree_same = np.sum(majority == c)\n    agree_flip = np.sum(majority == (1 - c))\n    agree = max(agree_same, agree_flip)\n    split = f\"{sum(c==0)}/{sum(c==1)}\"\n    print(f\"  {name}: agreement={agree/len(c):.4f}, split={split}\")\n\n# Use majority vote as final\nbest_heart = majority\nprint(f\"\\nFinal heart (majority): {sum(best_heart==0)}/{sum(best_heart==1)}\")\n\n# ===================== SAVE =====================\nout_d = pd.DataFrame({'pseudo_label': best_diabetes})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nSaved diabetes: {sum(best_diabetes==0)}/{sum(best_diabetes==1)}\")\n\nout_h = pd.DataFrame({'pseudo_label': best_heart})\nout_h.to_csv('/app/output_heart.csv', index=False)\nprint(f\"Saved heart: {sum(best_heart==0)}/{sum(best_heart==1)}\")\nprint(\"Done!\")\nEOF\n"]
