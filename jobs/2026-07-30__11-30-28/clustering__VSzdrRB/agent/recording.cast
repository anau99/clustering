[201.912451, "i", "cat > /app/solve2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ===================== DIABETES DATASET =====================\nprint(\"=== Processing Diabetes Dataset ===\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\n\n# Known: The early-stage diabetes dataset has ~320 positive, ~200 negative\n# Key indicators: polyuria, polydipsia are the strongest\n# Let's try multiple approaches and use agreement\n\nresults_d = {}\n\n# Method 1: Weighted features with KMeans\ndf_d1 = df_diabetes.copy()\ndf_d1['age'] = StandardScaler().fit_transform(df_d1[['age']])\ndf_d1['polyuria'] = df_d1['polyuria'] * 3\ndf_d1['polydipsia'] = df_d1['polydipsia'] * 3\ndf_"]
[201.913058, "o", "cat > /app/solve2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[201.913088, "i", "d1['sudden_weight_loss'] = df_d1['sudden_weight_loss'] * 2\ndf_d1['irritability'] = df_d1['irritability'] * 2\ndf_d1['partial_paresis'] = df_d1['partial_paresis'] * 2\nkm = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_d['km_weighted'] = km.fit_predict(df_d1)\n\n# Method 2: GMM weighted\ngmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_d['gmm_weighted'] = gmm.fit_predict(df_d1)\n\n# Method 3: Score-based (domain knowledge)\ndf_d3 = df_diabetes.copy()\nscore = (df_d3['polyuria'] * 3 + df_d3['polydipsia'] * 3 + \n         df_d3['sudden_weight_loss'] * 2 + df_d3['irritability'] * 2 + \n         df_d3['partial_paresis'] * 2 + df_d3['polyphagia'] * 1.5 + \n         df_d3['gender'] * 1 + df_d3['genital_thrush'] * 1)\nresults_d['score_t3'] = (score >= 4).astype(int).values\nresults_d['score_t4'] = (score >= 5).astype(int).values\nresults_d['score_t5'] = (score >= 6).astype(int).values\n\n# Method 4: All features scaled + GMM\ndf_d4 = df_diabetes.copy().asty"]
[201.913116, "i", "pe(float)\ndf_d4 = pd.DataFrame(StandardScaler().fit_transform(df_d4), columns=df_d4.columns)\ngmm4 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_d['gmm_allscaled'] = gmm4.fit_predict(df_d4)\n\n# Method 5: KMeans on key features only\nkey_d = ['polyuria', 'polydipsia', 'sudden_weight_loss', 'polyphagia', 'irritability', 'partial_paresis', 'gender']\ndf_d5 = df_diabetes[key_d].copy().astype(float)\nkm5 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_d['km_keyonly'] = km5.fit_predict(df_d5)\n\n# Method 6: Agglomerative on weighted\nagg_d = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_d['agg_weighted'] = agg_d.fit_predict(df_d1)\n\nprint(\"Diabetes methods:\")\nfor k, v in results_d.items():\n    print(f\"  {k}: {sum(v==0)}/{sum(v==1)}\")\n\n# Compare methods against each other to find consensus\nprint(\"\\nPairwise ARI between diabetes methods:\")\nkeys = list(results_d.keys())\nbest_avg_ari = -1\nbest_method = None\nfor i, k1 in enumerate(keys)"]
[201.913146, "i", ":\n    total_ari = 0\n    for j, k2 in enumerate(keys):\n        if i != j:\n            ari = adjusted_rand_score(results_d[k1], results_d[k2])\n            total_ari += ari\n    avg_ari = total_ari / (len(keys) - 1)\n    print(f\"  {k1}: avg ARI with others = {avg_ari:.4f}\")\n    if avg_ari > best_avg_ari:\n        best_avg_ari = avg_ari\n        best_method = k1\n\nprint(f\"\\nBest consensus for diabetes: {best_method} (avg ARI = {best_avg_ari:.4f})\")\nbest_diabetes = results_d[best_method]\n\n# Make sure the larger cluster is labeled appropriately\n# (In the original dataset, positive cases ~320 > negative ~200)\n# If cluster 1 has fewer members, swap\nif sum(best_diabetes == 1) < sum(best_diabetes == 0):\n    # The larger cluster should be 1 (positive diabetes)\n    pass  # keep as is since we want to match ground truth ordering\n\nprint(f\"Final diabetes: {sum(best_diabetes==0)}/{sum(best_diabetes==1)}\")\n\n# ===================== HEART DATASET =====================\nprint(\"\\n=== Processing Heart Dataset ===\")\ndf_heart = pd.read_cs"]
[201.913167, "i", "v('/app/heart.csv')\n\nnumerical_features = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_features = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\nresults_h = {}\n\n# Method 1: All features scaled\ndf_h1 = df_heart.copy().astype(float)\ndf_h1_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h1), columns=df_h1.columns)\nkm_h1 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_h['km_allscaled'] = km_h1.fit_predict(df_h1_scaled)\n\ngmm_h1 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_h['gmm_allscaled'] = gmm_h1.fit_predict(df_h1_scaled)\n\nagg_h1 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_h['agg_allscaled'] = agg_h1.fit_predict(df_h1_scaled)\n\n# Method 2: Key features\nkey_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']\ndf_h2 = df_heart[key_h].copy().astype(float)\ndf_h2_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h2), columns=key_h)\n\nkm_h2 = KMeans(n_clusters=2, init="]
[201.913185, "i", "'k-means++', n_init=100, random_state=42)\nresults_h['km_key'] = km_h2.fit_predict(df_h2_scaled)\n\ngmm_h2 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_h['gmm_key'] = gmm_h2.fit_predict(df_h2_scaled)\n\nagg_h2 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_h['agg_key'] = agg_h2.fit_predict(df_h2_scaled)\n\n# Method 3: One-hot categoricals + scaled numericals\ndf_h3_num = pd.DataFrame(StandardScaler().fit_transform(df_heart[numerical_features]), columns=numerical_features)\nencoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\ndf_h3_cat = pd.DataFrame(encoder.fit_transform(df_heart[categorical_features]),\n                         columns=encoder.get_feature_names_out(categorical_features))\ndf_h3 = pd.concat([df_h3_num, df_h3_cat], axis=1)\n\nkm_h3 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_h['km_onehot'] = km_h3.fit_predict(df_h3)\n\ngmm_h3 = GaussianMixture(n_components=2, covariance_type='full', random_sta"]
[201.913203, "i", "te=42, n_init=20)\nresults_h['gmm_onehot'] = gmm_h3.fit_predict(df_h3)\n\nagg_h3 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_h['agg_onehot'] = agg_h3.fit_predict(df_h3)\n\n# Method 4: All features + age, sex included with key weighting\ndf_h4 = df_heart.copy().astype(float)\ndf_h4['cp'] = df_h4['cp'] * 2\ndf_h4['ca'] = df_h4['ca'] * 2  \ndf_h4['thal'] = df_h4['thal'] * 2\ndf_h4['oldpeak'] = df_h4['oldpeak'] * 2\ndf_h4['exang'] = df_h4['exang'] * 2\ndf_h4_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h4), columns=df_h4.columns)\n\nkm_h4 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_h['km_allw'] = km_h4.fit_predict(df_h4_scaled)\n\ngmm_h4 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_h['gmm_allw'] = gmm_h4.fit_predict(df_h4_scaled)\n\nagg_h4 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_h['agg_allw'] = agg_h4.fit_predict(df_h4_scaled)\n\n# Method 5: Score-based approach\ndf_h5 = df_heart.copy()\n# Higher cp"]
[201.913227, "i", " type, lower thalach, higher oldpeak, more ca vessels, \n# thal=3 (fixed defect), exang=1, slope=0/1 all indicate disease\nscore_h = (df_h5['cp'].apply(lambda x: 1 if x > 0 else 0) * 2 +\n           (df_h5['thalach'] < 140).astype(int) * 2 +\n           (df_h5['oldpeak'] > 1.0).astype(int) * 2 +\n           (df_h5['ca'] > 0).astype(int) * 3 +\n           (df_h5['thal'] == 3).astype(int) * 2 +\n           df_h5['exang'] * 2 +\n           (df_h5['slope'] == 0).astype(int) * 1)\nresults_h['score_based'] = (score_h >= 6).astype(int).values\n\nprint(\"Heart methods:\")\nfor k, v in results_h.items():\n    print(f\"  {k}: {sum(v==0)}/{sum(v==1)}\")\n\n# Find best consensus\nprint(\"\\nPairwise ARI between heart methods:\")\nkeys_h = list(results_h.keys())\nbest_avg_ari_h = -1\nbest_method_h = None\nfor i, k1 in enumerate(keys_h):\n    total_ari = 0\n    for j, k2 in enumerate(keys_h):\n        if i != j:\n            ari = adjusted_rand_score(results_h[k1], results_h[k2])\n            total_ari += ari\n    avg_ari = total_ari / (len(keys_h) - 1)\n "]
[201.913245, "i", "   print(f\"  {k1}: avg ARI with others = {avg_ari:.4f}\")\n    if avg_ari > best_avg_ari_h:\n        best_avg_ari_h = avg_ari\n        best_method_h = k1\n\nprint(f\"\\nBest consensus for heart: {best_method_h} (avg ARI = {best_avg_ari_h:.4f})\")\nbest_heart = results_h[best_method_h]\nprint(f\"Final heart: {sum(best_heart==0)}/{sum(best_heart==1)}\")\n\n# ===================== SAVE RESULTS =====================\nout_diabetes = pd.DataFrame({'pseudo_label': best_diabetes})\nout_diabetes.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nSaved diabetes: {out_diabetes['pseudo_label'].value_counts().to_dict()}\")\n\nout_heart = pd.DataFrame({'pseudo_label': best_heart})\nout_heart.to_csv('/app/output_heart.csv', index=False)\nprint(f\"Saved heart: {out_heart['pseudo_label'].value_counts().to_dict()}\")\n\nprint(\"\\nDone!\")\nEOF\n"]
