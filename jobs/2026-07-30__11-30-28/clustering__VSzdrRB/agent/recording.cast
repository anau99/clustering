[18.677972, "o", "cat /app/src/transform/StandardScaler.py\r\n\u001b[?2004l\rimport pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\ndef standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n"]
[18.67852, "o", "    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
