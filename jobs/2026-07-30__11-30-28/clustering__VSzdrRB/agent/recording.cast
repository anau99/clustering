[282.806525, "o", "df_h_num = pd.DataFrame(StandardScaler().fit_transform(df_heart[numerical_features]), columns=numerical_features)\r\n\u001b[?2004l\r"]
[282.80664, "o", "\u001b[?2004h> "]
[282.806929, "o", "encoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\r\n\u001b[?2004l\r"]
[282.806994, "o", "\u001b[?2004h> "]
[282.80733, "o", "df_h_cat = pd.DataFrame(encoder.fit_transform(df_heart[categorical_features]),\r\n\u001b[?2004l\r"]
[282.807454, "o", "\u001b[?2004h> "]
[282.8078, "o", "                        columns=encoder.get_feature_names_out(categorical_features))\r\n\u001b[?2004l\r"]
[282.807886, "o", "\u001b[?2004h> "]
[282.808202, "o", "df_h_onehot = pd.concat([df_h_num, df_h_cat], axis=1)\r\n\u001b[?2004l\r"]
[282.808231, "o", "\u001b[?2004h> "]
[282.809095, "o", "agg2 = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> results_h['agg_onehot'] = agg2.fit_predict(df_h_onehot)\r\n\u001b[?2004l\r"]
[282.809341, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rp\u001b[?2004h> "]
[282.809469, "o", "# Method 3: Key features weighted + KMeans\r\n\u001b[?2004l\r"]
[282.81055, "o", "\u001b[?2004h> df_h3 = df_heart.copy().astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> df_h3['cp'] = df_h3['cp'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_h3['ca'] = df_h3['ca'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_h3['thal'] = df_h3['thal'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_h3['oldpeak'] = df_h3['oldpeak'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_h3['exang'] = df_h3['exang'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.8115, "o", "df_h3['slope'] = df_h3['slope'] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> df_h3['thalach'] = df_h3['thalach'] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> df_h3_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h3), columns=df_h3.columns)\r\n\u001b[?2004l\r\u001b[?2004h> km3 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r"]
[282.811582, "o", "\u001b[?2004h"]
[282.8122, "o", "> results_h['km_weighted'] = km3.fit_predict(df_h3_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[282.812988, "o", "> # Method 4: Key features only + Agglomerative\r\n\u001b[?2004l\r\u001b[?2004h> key_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']\r\n\u001b[?2004l\r\u001b[?2004h> df_h4 = df_heart[key_h].copy().astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.813535, "o", "df_h4_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h4), columns=key_h)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.813581, "o", "agg4 = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.813685, "o", "results_h['agg_key'] = agg4.fit_predict(df_h4_scaled)\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.813932, "o", "> \r\n\u001b[?2004l\r"]
[282.814018, "o", "\u001b[?2004h> # Method 5: Key features weighted + Agglomerative\r\n"]
[282.814036, "o", "\u001b[?2004l\r"]
[282.814153, "o", "\u001b[?2004h> "]
[282.814341, "o", "df_h5 = df_heart[key_h].copy().astype(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.814429, "o", "> "]
[282.814513, "o", "df_h5['cp'] = df_h5['cp'] * 2\r\n\u001b[?2004l\r"]
[282.814618, "o", "\u001b[?2004h> "]
[282.81551, "o", "df_h5['ca'] = df_h5['ca'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_h5['thal'] = df_h5['thal'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_h5_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h5), columns=key_h)\r\n\u001b[?2004l\r\u001b[?2004h> agg5 = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.815695, "o", "results_h['agg_key_w'] = agg5.fit_predict(df_h5_scaled)\r\n\u001b[?2004l\r"]
[282.815877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[282.815963, "o", "\u001b[?2004h> "]
[282.816506, "o", "# Method 6: PCA + KMeans\r\n\u001b[?2004l\r\u001b[?2004h> pca = PCA(n_components=5)\r\n\u001b[?2004l\r\u001b[?2004h> df_h6_pca = pca.fit_transform(df_h_all_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.816661, "o", "km6 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.816863, "o", "results_h['km_pca'] = km6.fit_predict(df_h6_pca)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.816997, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Method 7: PCA on one-hot\r\n\u001b[?2004l\r"]
[282.817487, "o", "\u001b[?2004h> "]
[282.818496, "o", "pca2 = PCA(n_components=10)\r\n\u001b[?2004l\r\u001b[?2004h> df_h7_pca = pca2.fit_transform(df_h_onehot)\r\n\u001b[?2004l\r\u001b[?2004h> km7 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_h['km_pca_onehot'] = km7.fit_predict(df_h7_pca)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Method 8: All weighted + Agglomerative\r\n\u001b[?2004l\r\u001b[?2004h> agg8 = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> results_h['agg_weighted'] = agg8.fit_predict(df_h3_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[282.818635, "o", "\u001b[?2004h> "]
[282.818835, "o", "# Method 9: GMM on key features weighted\r\n\u001b[?2004l\r"]
[282.81891, "o", "\u001b[?2004h> "]
[282.819196, "o", "gmm9 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n\u001b[?2004l\r"]
[282.819224, "o", "\u001b[?2004h"]
[282.819328, "o", "> "]
[282.819475, "o", "results_h['gmm_key_w'] = gmm9.fit_predict(df_h5_scaled)\r\n\u001b[?2004l\r"]
[282.819507, "o", "\u001b[?2004h> "]
[282.819542, "o", "\r\n\u001b[?2004l\r"]
[282.819692, "o", "\u001b[?2004h> "]
[282.819789, "o", "# Method 10: KMeans on key features\r\n"]
[282.819816, "o", "\u001b[?2004l\r"]
[282.820494, "o", "\u001b[?2004h> km10 = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_h['km_key'] = km10.fit_predict(df_h4_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Heart methods:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.820533, "o", "> "]
[282.820667, "o", "for k, v in results_h.items():\r\n\u001b[?2004l\r"]
[282.82075, "o", "\u001b[?2004h"]
[282.820774, "o", "> "]
[282.820899, "o", "    print(f\"  {k}: {sum(v==0)}/{sum(v==1)}\")\r\n\u001b[?2004l\r"]
[282.821034, "o", "\u001b[?2004h"]
[282.821101, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Find consensus\r\n\u001b[?2004l\r"]
[282.821159, "o", "\u001b[?2004h> "]
[282.821275, "o", "print(\"\\nConsensus analysis:\")\r\n\u001b[?2004l\r"]
[282.821341, "o", "\u001b[?2004h> "]
[282.821451, "o", "keys_h = list(results_h.keys())\r\n\u001b[?2004l\r"]
[282.821491, "o", "\u001b[?2004h"]
[282.82151, "o", "> "]
[282.821671, "o", "for i, k1 in enumerate(keys_h):\r\n\u001b[?2004l\r"]
[282.821727, "o", "\u001b[?2004h"]
[282.82175, "o", "> "]
[282.822022, "o", "    total_ari = 0\r\n\u001b[?2004l\r\u001b[?2004h>     count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.822134, "o", "    for j, k2 in enumerate(keys_h):\r\n\u001b[?2004l\r"]
[282.822234, "o", "\u001b[?2004h"]
[282.822497, "o", ">         if i != j:\r\n\u001b[?2004l\r\u001b[?2004h>             ari = adjusted_rand_score(results_h[k1], results_h[k2])\r\n\u001b[?2004l\r"]
[282.822524, "o", "\u001b[?2004h> "]
[282.82272, "o", "            total_ari += ari\r\n\u001b[?2004l\r"]
[282.822884, "o", "\u001b[?2004h> "]
[282.822915, "o", "            count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.822984, "o", "    avg_ari = total_ari / count\r\n"]
[282.823059, "o", "\u001b[?2004l\r"]
[282.824549, "o", "\u001b[?2004h>     print(f\"  {k1}: avg ARI = {avg_ari:.4f}, split = {sum(results_h[k1]==0)}/{sum(results_h[k1]==1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # For heart, prefer methods with ~50/50 split AND high consensus\r\n\u001b[?2004l\r\u001b[?2004h> # Filter methods with reasonable split (400-600 per cluster)\r\n\u001b[?2004l\r\u001b[?2004h> filtered = {k: v for k, v in results_h.items() \r\n\u001b[?2004l\r\u001b[?2004h>             if 400 <= sum(v==0) <= 625 and 400 <= sum(v==1) <= 625}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nFiltered methods (balanced split): {list(filtered.keys())}\")\r\n\u001b[?2004l\r"]
[282.824725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if filtered:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.824805, "o", "    best_avg = -1\r\n\u001b[?2004l\r"]
[282.824829, "o", "\u001b[?2004h"]
[282.82501, "o", ">     best_k = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.825081, "o", "    for k1 in filtered:\r\n\u001b[?2004l\r"]
[282.825102, "o", "\u001b[?2004h"]
[282.825116, "o", "> "]
[282.82548, "o", "        total_ari = 0\r\n\u001b[?2004l\r\u001b[?2004h>         count = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.825546, "o", "        for k2 in filtered:\r\n\u001b[?2004l\r"]
[282.826545, "o", "\u001b[?2004h>             if k1 != k2:\r\n\u001b[?2004l\r\u001b[?2004h>                 ari = adjusted_rand_score(filtered[k1], filtered[k2])\r\n\u001b[?2004l\r\u001b[?2004h>                 total_ari += ari\r\n\u001b[?2004l\r\u001b[?2004h>                 count += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.826974, "o", "        avg = total_ari / max(count, 1)\r\n\u001b[?2004l\r\u001b[?2004h>         if avg > best_avg:\r\n\u001b[?2004l\r"]
[282.827091, "o", "\u001b[?2004h"]
[282.827127, "o", "> "]
[282.827267, "o", "            best_avg = avg\r\n\u001b[?2004l\r"]
[282.827291, "o", "\u001b[?2004h"]
[282.827398, "o", "> "]
[282.827523, "o", "            best_k = k1\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.827545, "o", "> "]
[282.827876, "o", "    best_heart = filtered[best_k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.828262, "o", "    print(f\"Selected: {best_k} (avg ARI among balanced = {best_avg:.4f})\")\r\n\u001b[?2004l\r"]
[282.82844, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     # fallback\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.828522, "o", "> "]
[282.828628, "o", "    best_heart = results_h['agg_all']"]
[282.830503, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Fallback: agg_all\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Final heart: {sum(best_heart==0)}/{sum(best_heart==1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ===================== SAVE =====================\r\n\u001b[?2004l\r\u001b[?2004h> out_diabetes = pd.DataFrame({'pseudo_label': best_diabetes})\r\n\u001b[?2004l\r\u001b[?2004h> out_diabetes.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nSaved diabetes: {out_diabetes['pseudo_label'].value_counts().to_dict()}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.830641, "o", "out_heart = pd.DataFrame({'pseudo_label': best_heart})\r\n\u001b[?2004l\r"]
[282.830711, "o", "\u001b[?2004h> "]
[282.830873, "o", "out_heart.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r"]
[282.830982, "o", "\u001b[?2004h> "]
[282.831221, "o", "print(f\"Saved heart: {out_heart['pseudo_label'].value_counts().to_dict()}\")\r\n\u001b[?2004l\r"]
[282.83129, "o", "\u001b[?2004h> "]
[282.831391, "o", "print(\"Done!\")\r\n"]
