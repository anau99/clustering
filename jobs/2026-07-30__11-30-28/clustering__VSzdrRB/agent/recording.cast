[359.469752, "i", "cat > /app/solve_final.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.metrics import adjusted_rand_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ===================== DIABETES DATASET =====================\nprint(\"=== Diabetes Dataset ===\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_diabetes['gender'] = df_diabetes['gender'].map({'Male': 1, 'Female': 0})\n\n# Try various approaches\nresults_d = {}\n\n# Method A: Simple rule - polyuria OR polydipsia (strongest indicators)\nrule_a = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\nresults_d['rule_polyuria_or_polydipsia'] = rule_a\n\n# Method B: Weighted GMM  \ndf_db = df_diabetes.copy()\ndf_db['age'] = StandardScaler().fit_transform(df_db[['age']])\ndf_db['polyuria'] = df_db['polyuria'] * 3\ndf_db['polydipsia'] = df_db['polydipsia"]
[359.469909, "i", "'] * 3\ndf_db['sudden_weight_loss'] = df_db['sudden_weight_loss'] * 2\ndf_db['irritability'] = df_db['irritability'] * 2\ndf_db['partial_paresis'] = df_db['partial_paresis'] * 2\ndf_db['polyphagia'] = df_db['polyphagia'] * 1.5\ndf_db['gender'] = df_db['gender'] * 1.5\ngmm_b = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_d['gmm_weighted'] = gmm_b.fit_predict(df_db)\n\n# Method C: KMeans on weighted\nkm_c = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_d['km_weighted'] = km_c.fit_predict(df_db)\n\n# Method D: Agglomerative on weighted\nagg_d = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_d['agg_weighted'] = agg_d.fit_predict(df_db)\n\n# Method E: Rule with more features\ndf_de = df_diabetes.copy()\nscore_e = (df_de['polyuria'] * 3 + df_de['polydipsia'] * 3 + \n           df_de['sudden_weight_loss'] * 2 + df_de['irritability'] * 2 +\n           df_de['partial_paresis'] * 2 + df_de['polyphagia'] * 1.5 +\n           df_de['gender'] * 1.5 + "]
[359.470578, "i", "df_de['genital_thrush'] * 1)\nfor thresh in [3, 4, 5, 6]:\n    results_d[f'score_t{thresh}'] = (score_e >= thresh).astype(int).values\n\nprint(\"Methods and splits:\")\nfor k, v in results_d.items():\n    print(f\"  {k}: {sum(v==0)}/{sum(v==1)}\")\n\n# Calculate consensus\nprint(\"\\nConsensus:\")\nkeys = list(results_d.keys())\nbest_score = -1\nbest_k = None\nfor k1 in keys:\n    total = sum(adjusted_rand_score(results_d[k1], results_d[k2]) for k2 in keys if k2 != k1)\n    avg = total / (len(keys) - 1)\n    print(f\"  {k1}: avg ARI = {avg:.4f}\")\n    if avg > best_score:\n        best_score = avg\n        best_k = k1\n\nprint(f\"\\nBest diabetes: {best_k}\")\nbest_diabetes = results_d[best_k]\n\n# ===================== HEART DATASET =====================\nprint(\"\\n=== Heart Dataset ===\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\nnumerical_features = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_features = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\nkey_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope'"]
[359.47081, "o", "cat > /app/solve_final.py << 'EOF'\r\n\u001b[?2004l\r"]
[359.470842, "i", "]\n\nresults_h = {}\n\n# Method 1: All features standardized + various algorithms\ndf_hall = df_heart.copy().astype(float)\ndf_hall_s = pd.DataFrame(StandardScaler().fit_transform(df_hall), columns=df_hall.columns)\n\nresults_h['km_all'] = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hall_s)\nresults_h['agg_all'] = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hall_s)\nresults_h['gmm_all'] = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20).fit_predict(df_hall_s)\n\n# Method 2: Key features standardized\ndf_hkey = df_heart[key_h].copy().astype(float)\ndf_hkey_s = pd.DataFrame(StandardScaler().fit_transform(df_hkey), columns=key_h)\n\nresults_h['km_key'] = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hkey_s)\nresults_h['agg_key'] = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hkey_s)\nresults_h['gmm_key'] = GaussianMixture(n_components=2, covariance_type='full', random_stat"]
[359.470857, "o", "\u001b[?2004h"]
[359.470868, "i", "e=42, n_init=20).fit_predict(df_hkey_s)\n\n# Method 3: All features with important ones weighted\ndf_hw = df_heart.copy().astype(float)\ndf_hw['cp'] = df_hw['cp'] * 2\ndf_hw['ca'] = df_hw['ca'] * 2\ndf_hw['thal'] = df_hw['thal'] * 2\ndf_hw['oldpeak'] = df_hw['oldpeak'] * 1.5\ndf_hw['exang'] = df_hw['exang'] * 2\ndf_hw['slope'] = df_hw['slope'] * 1.5\ndf_hw['thalach'] = df_hw['thalach'] * 1.5\ndf_hw_s = pd.DataFrame(StandardScaler().fit_transform(df_hw), columns=df_hw.columns)\n\nresults_h['km_allw'] = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_hw_s)\nresults_h['agg_allw'] = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_hw_s)\nresults_h['gmm_allw'] = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20).fit_predict(df_hw_s)\n\n# Method 4: One-hot encoding\ndf_h_num = pd.DataFrame(StandardScaler().fit_transform(df_heart[numerical_features]), columns=numerical_features)\nencoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')"]
[359.471239, "o", "> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.471262, "i", "\ndf_h_cat = pd.DataFrame(encoder.fit_transform(df_heart[categorical_features]),\n                        columns=encoder.get_feature_names_out(categorical_features))\ndf_h_oh = pd.concat([df_h_num, df_h_cat], axis=1)\n\nresults_h['km_oh'] = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42).fit_predict(df_h_oh)\nresults_h['agg_oh'] = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(df_h_oh)\n\n# Method 5: Score-based\ndf_hs = df_heart.copy()\nscore_h = ((df_hs['cp'] > 0).astype(int) * 2 +\n           (df_hs['thalach'] < 140).astype(int) * 2 +\n           (df_hs['oldpeak'] > 1.0).astype(int) * 2 +\n           (df_hs['ca'] > 0).astype(int) * 3 +\n           (df_hs['thal'] == 3).astype(int) * 2 +\n           df_hs['exang'] * 2 +\n           (df_hs['slope'] == 0).astype(int) * 1)\nresults_h['score'] = (score_h >= 6).astype(int).values\n\nprint(\"Methods and splits:\")\nfor k, v in results_h.items():\n    print(f\"  {k}: {sum(v==0)}/{sum(v==1)}\")\n\n# Find best consensus among balanced methods\nprint(\"\\nCo"]
[359.471284, "i", "nsensus (all methods):\")\nkeys_h = list(results_h.keys())\nfor k1 in keys_h:\n    total = sum(adjusted_rand_score(results_h[k1], results_h[k2]) for k2 in keys_h if k2 != k1)\n    avg = total / (len(keys_h) - 1)\n    print(f\"  {k1}: avg ARI = {avg:.4f}, split={sum(results_h[k1]==0)}/{sum(results_h[k1]==1)}\")\n\n# Select the method with highest consensus\nbest_score_h = -1\nbest_kh = None\nfor k1 in keys_h:\n    total = sum(adjusted_rand_score(results_h[k1], results_h[k2]) for k2 in keys_h if k2 != k1)\n    avg = total / (len(keys_h) - 1)\n    if avg > best_score_h:\n        best_score_h = avg\n        best_kh = k1\n\nprint(f\"\\nBest heart: {best_kh} (consensus={best_score_h:.4f})\")\nbest_heart = results_h[best_kh]\n\n# ===================== SAVE =====================\nout_d = pd.DataFrame({'pseudo_label': best_diabetes})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nFinal diabetes: {sum(best_diabetes==0)}/{sum(best_diabetes==1)}\")\n\nout_h = pd.DataFrame({'pseudo_label': best_heart})\nout_h.to_csv('/app/output_h"]
