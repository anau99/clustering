[78.452504, "o", "# Approach 4: One-hot with key features weighted\r\n\u001b[?2004l\r\u001b[?2004h> df_h4 = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> df_h4_num = df_h4[numerical_features].copy()\r\n\u001b[?2004l\r\u001b[?2004h> df_h4_num = pd.DataFrame(StandardScaler().fit_transform(df_h4_num), columns=numerical_features)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> encoder4 = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\r\n\u001b[?2004l\r\u001b[?2004h> df_h4_cat = pd.DataFrame(encoder4.fit_transform(df_h4[categorical_features]))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> df_h4_combined = pd.concat([df_h4_num.reset_index(drop=True), df_h4_cat.reset_index(drop=True)], axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Weight important features\r\n\u001b[?2004l\r\u001b[?2004h> # cp, ca, thal, exang, slope are important - already one-hot encoded\r\n\u001b[?2004l\r\u001b[?2004h> "]
