[18.205392, "o", "from sklearn.cluster import KMeans\r\n"]
[18.205932, "o", "\r\n\r\ndef kmeans(X, k):\r\n    model = KMeans(\r\n        n_clusters=k,\r\n        init=\"k-means++\",\r\n        n_init=\"auto\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
