[?2004l[?2004h> 
[?2004l[?2004h> # Majority vote ensemble
[?2004l[?2004h> # First align labels - use the first method as reference
[?2004l[?2004h> ref = clusterings[0][1]
[?2004l[?2004h> aligned = [ref.copy()]
[?2004l[?2004h> for name, c in clusterings[1:]:
[?2004l[?2004h>     # Check if we need to flip labels
[?2004l[?2004h>     ari_same = adjusted_rand_score(ref, c)
[?2004l[?2004h>     # ARI is symmetric, no need to flip - but for voting we need consistent labels
[?2004l[?2004h>     # Check which alignment gives better agreement with reference
[?2004l[?2004h>     agree_same = np.sum(ref == c)
[?2004l[?2004h>     agree_flip = np.sum(ref == (1 - c))
[?2004l[?2004h>     if agree_flip > agree_same:
[?2004l[?2004h>         aligned.append(1 - c)
[?2004l[?2004h>     else:
[?2004l[?2004h>         aligned.append(c.copy())
[?2004l[?2004h> 
[?2004l[?2004h> # Majority vote
[?2004l[?2004h> votes = np.array(aligned)
[?2004l[?2004h> majority = (votes.sum(axis=0) > len(aligned) / 2).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nMajority vote ensemble: {sum(majority==0)}/{sum(majority==1)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Also try: pick the balanced method with highest agreement with majority
[?2004l[?2004h> print("\nAgreement with majority vote:")
[?2004l[?2004h> best_agree = -1
[?2004l[?2004h> best_method = None
[?2004l[?2004h> for name, c in clusterings:
[?2004l[?2004h>     # Align with majority
[?2004l[?2004h>     agree_same = np.sum(majority == c)
[?2004l[?2004h>     agree_flip = np.sum(majority == (1 - c))
[?2004l[?2004h>     agree = max(agree_same, agree_flip)
[?2004l[?2004h>     split = f"{sum(c==0)}/{sum(c==1)}"
[?2004l[?2004h>     print(f"  {name}: agreement={agree/len(c):.4f}, split={split}")
[?2004l[?2004h> 
[?2004l[?2004h> # Use majority vote as final
[?2004l[?2004h> best_heart = majority
[?2004l[?2004h> print(f"\nFinal heart (majority): {sum(best_heart==0)}/{sum(best_heart==1)}")
