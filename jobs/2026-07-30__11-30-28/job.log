.fit_predict(df_hk2.values)\nprint(f"Heart (key ohe kmeans): {np.bincount(labels_hk)}")\n\ngmm_hk = GaussianMixture(n_components=2, covariance_type=\'tied\', random_state=42, n_init=5)\nlabels_hk_gmm = gmm_hk.fit_predict(df_hk2.values)\nprint(f"Heart (key ohe gmm tied): {np.bincount(labels_hk_gmm)}")\n\n# ============ SAVE ============\n# Diabetes: use weighted kmeans (strong separation on key symptoms)\nprint("\\n=== SAVING ===")\nout_d = pd.DataFrame({\'pseudo_label\': best_d})\nout_d.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"Diabetes saved: {np.bincount(best_d)}")\n\n# Heart: use weighted kmeans (best separation)\nout_h = pd.DataFrame({\'pseudo_label\': best_h})\nout_h.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"Heart saved: {np.bincount(best_h)}")\n\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
