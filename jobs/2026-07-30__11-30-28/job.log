f_hw[\'slope\'] = df_hw[\'slope\'] * 1.5\ndf_hw[\'thalach\'] = df_hw[\'thalach\'] * 1.5\ndf_hw_s = pd.DataFrame(StandardScaler().fit_transform(df_hw), columns=df_hw.columns)\n\n# 3. One-hot\ndf_h_num = pd.DataFrame(StandardScaler().fit_transform(df_heart[numerical_features]), columns=numerical_features)\nencoder = OneHotEncoder(sparse_output=False, handle_unknown=\'ignore\')\ndf_h_cat = pd.DataFrame(encoder.fit_transform(df_heart[categorical_features]),\n                        columns=encoder.get_feature_names_out(categorical_features))\ndf_h_oh = pd.concat([df_h_num, df_h_cat], axis=1)\n\n# Generate multiple clusterings\nclusterings = []\n\n# Agglomerative ward - all scaled\nc1 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(df_hall_s)\nclusterings.append((\'agg_all\', c1))\n\n# Agglomerative ward - weighted\nc2 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(df_hw_s)\nclusterings.append((\'agg_allw\', c2))\n\n# Agglomerative ward - one-hot\nc3 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(df_h_oh)\nclusterings.append((\'agg_oh\', c3))\n\n# KMeans - all scaled\nc4 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42).fit_predict(df_hall_s)\nclusterings.append((\'km_all\', c4))\n\n# KMeans - weighted\nc5 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42).fit_predict(df_hw_s)\nclusterings.append((\'km_allw\', c5))\n\n# KMeans - one-hot\nc6 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42).fit_predict(df_h_oh)\nclusterings.append((\'km_oh\', c6))\n\n# Key features\ndf_hkey_s = pd.DataFrame(StandardScaler().fit_transform(df_heart[key_h].astype(float)), columns=key_h)\nc7 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42).fit_predict(df_hkey_s)\nclusterings.append((\'km_key\', c7))\n\nc8 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(df_hkey_s)\nclusterings.append((\'agg_key\', c8))\n\n# Agglomerative with different linkages\nc9 = AgglomerativeClustering(n_clusters=2, linkage=\'complete\').fit_predict(df_hall_s)\nclusterings.append((\'agg_complete\', c9))\n\nc10 = AgglomerativeClustering(n_clusters=2, linkage=\'average\').fit_predict(df_hall_s)\nclusterings.append((\'agg_average\', c10))\n\nprint("Individual methods:")\nfor name, c in clusterings:\n    print(f"  {name}: {sum(c==0)}/{sum(c==1)}")\n\n# Majority vote ensemble\n# First align labels - use the first method as reference\nref = clusterings[0][1]\naligned = [ref.copy()]\nfor name, c in clusterings[1:]:\n    # Check if we need to flip labels\n    ari_same = adjusted_rand_score(ref, c)\n    # ARI is symmetric, no need to flip - but for voting we need consistent labels\n    # Check which alignment gives better agreement with reference\n    agree_same = np.sum(ref == c)\n    agree_flip = np.sum(ref == (1 - c))\n    if agree_flip > agree_same:\n        aligned.append(1 - c)\n    else:\n        aligned.append(c.copy())\n\n# Majority vote\nvotes = np.array(aligned)\nmajority = (votes.sum(axis=0) > len(aligned) / 2).astype(int)\n\nprint(f"\\nMajority vote ensemble: {sum(majority==0)}/{sum(majority==1)}")\n\n# Also try: pick the balanced method with highest agreement with majority\nprint("\\nAgreement with majority vote:")\nbest_agree = -1\nbest_method = None\nfor name, c in clusterings:\n    # Align with majority\n    agree_same = np.sum(majority == c)\n    agree_flip = np.sum(majority == (1 - c))\n    agree = max(agree_same, agree_flip)\n    split = f"{sum(c==0)}/{sum(c==1)}"\n    print(f"  {name}: agreement={agree/len(c):.4f}, split={split}")\n\n# Use majority vote as final\nbest_heart = majority\nprint(f"\\nFinal heart (majority): {sum(best_heart==0)}/{sum(best_heart==1)}")\n\n# ===================== SAVE =====================\nout_d = pd.DataFrame({\'pseudo_label\': best_diabetes})\nout_d.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"\\nSaved diabetes: {sum(best_diabetes==0)}/{sum(best_diabetes==1)}")\n\nout_h = pd.DataFrame({\'pseudo_label\': best_heart})\nout_h.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"Saved heart: {sum(best_heart==0)}/{sum(best_heart==1)}")\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
