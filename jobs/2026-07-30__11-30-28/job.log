')\nprint(f"Shape: {df_heart.shape}")\nprint(df_heart.dtypes)\nprint(df_heart.head())\n\n# Separate numerical and categorical\nnumerical_cols = [\'trestbps\', \'chol\', \'thalach\', \'oldpeak\']\ncategorical_cols = [\'sex\', \'cp\', \'fbs\', \'restecg\', \'exang\', \'slope\', \'ca\', \'thal\']\n\n# One-hot encode categorical features\ndf_heart_proc = df_heart.copy()\n# Drop \'age\' since it\'s not mentioned in numerical features for heart\nif \'age\' in df_heart_proc.columns:\n    df_heart_proc = df_heart_proc.drop(columns=[\'age\'])\n\ndf_heart_proc = one_hot_encoder(df_heart_proc, columns=categorical_cols)\ndf_heart_proc = standard_scaler(df_heart_proc, columns=numerical_cols)\n\nprint("\\nHeart processed shape:", df_heart_proc.shape)\nprint(df_heart_proc.head())\n\nX_heart = df_heart_proc.values\n\n# KMeans\nlabels_km_h = kmeans(X_heart, 2)\nprint(f"\\nKMeans heart - cluster sizes: {np.bincount(labels_km_h)}")\n\n# Gaussian Mixture\nlabels_gm_h = gaussian_mixture(X_heart, 2)\nprint(f"GMM heart - cluster sizes: {np.bincount(labels_gm_h)}")\n\n# Spectral\nlabels_sp_h = spectral(X_heart, 2)\nprint(f"Spectral heart - cluster sizes: {np.bincount(labels_sp_h)}")\n\n# Try with PCA\npca_h = PCA(n_components=5)\nX_heart_pca = pca_h.fit_transform(X_heart)\nlabels_km_pca_h = kmeans(X_heart_pca, 2)\nprint(f"KMeans+PCA heart - cluster sizes: {np.bincount(labels_km_pca_h)}")\n\n# Save heart output\nheart_output = pd.DataFrame({\'pseudo_label\': labels_km_h})\nheart_output.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"\\nSaved heart output with KMeans")\n\nprint("\\nDone!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
