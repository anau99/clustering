Sending keys: ['cat > /app/solve_final.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score\n\n# ===== DIABETES DATASET =====\nprint("="*50)\nprint("DIABETES DATASET")\nprint("="*50)\ndf_diabetes = pd.read_csv(\'/app/diabetes_data.csv\')\n\n# Encode gender\ndf_diabetes[\'gender_num\'] = (df_diabetes[\'gender\'] == \'Male\').astype(int)\n\n# Create composite risk score based on domain knowledge\n# In the Early Stage Diabetes dataset, polyuria and polydipsia are nearly perfect predictors\nscore = (\n    df_diabetes[\'polyuria\'] * 4.0 +\n    df_diabetes[\'polydipsia\'] * 4.0 +\n    df_diabetes[\'sudden_weight_loss\'] * 2.0 +\n    df_diabetes[\'polyphagia\'] * 1.5 +\n    df_diabetes[\'irritability\'] * 2.0 +\n    df_diabetes[\'partial_paresis\'] * 2.0 +\n    df_diabetes[\'gender_num\'] * 1.5 +\n    df_diabetes[\'weakness\'] * 0.5 +\n    df_diabetes[\'genital_thrush\'] * 1.0 +\n    df_diabetes[\'visual_blurring\'] * 0.5 +\n    df_diabetes[\'itching\'] * (-0.5) +  # itching is actually negatively correlated in some studies\n    df_diabetes[\'delayed_healing\'] * (-0.5) +  # might be negatively correlated\n    df_diabetes[\'alopecia\'] * (-0.5) +\n    df_diabetes[\'obesity\'] * 0.5\n)\n\n# Use GMM on the score to find natural threshold\nscore_vals = score.values.reshape(-1, 1)\ngmm_d = GaussianMixture(n_components=2, random_state=42)\nlabels_d_score = gmm_d.fit_predict(score_vals)\n\n# Also try: prepare full feature set with proper weights\ndf_features = df_diabetes.drop(columns=[\'gender\']).copy()\nscaler_d = StandardScaler()\ndf_features[\'age\'] = scaler_d.fit_transform(df_features[[\'age\']])\n\n# Weight features by importance for diabetes prediction\nX_d_weighted = df_features.copy()\nimportance_d = {\n    \'polyuria\': 4.0, \'polydipsia\': 4.0, \'sudden_weight_loss\': 2.5,\n    \'polyphagia\': 2.0, \'irritability\': 2.0, \'partial_paresis\': 2.0,\n    \'gender_num\': 2.0, \'weakness\': 1.0, \'genital_thrush\': 1.5,\n    \'visual_blurring\': 1.0, \'itching\': 0.5, \'delayed_healing\': 0.5,\n    \'muscle_stiffness\': 0.5, \'alopecia\': 0.5, \'obesity\': 0.5, \'age\': 0.5\n}\nfor col, w in importance_d.items():\n    if col in X_d_weighted.columns:\n        X_d_weighted[col] = X_d_weighted[col] * w\n\nX_d_w = X_d_weighted.values\n\n# Multiple methods\nresults_d = {}\n\n# GMM on score\nresults_d[\'gmm_score\'] = labels_d_score\n\n# KMeans on weighted features\nkm_d = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_d[\'kmeans_w\'] = km_d.fit_predict(X_d_w)\n\n# GMM on weighted features  \ngmm_dw = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42, n_init=20)\nresults_d[\'gmm_w\'] = gmm_dw.fit_predict(X_d_w)\n\n# Agglomerative on weighted features\nagg_d = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_d[\'agg_w\'] = agg_d.fit_predict(X_d_w)\n\n# Rule-based (polyuria OR polydipsia)\nresults_d[\'rule_or\'] = ((df_diabetes[\'polyuria\'] == 1) | (df_diabetes[\'polydipsia\'] == 1)).astype(int).values\n\n# Consensus approach: majority vote\nall_labels_d = np.array([results_d[k] for k in results_d.keys()])\n\n# Check agreement between methods\nprint("\\nAgreement between diabetes methods (ARI):")\nkeys = list(results_d.keys())\nfor i in range(len(keys)):\n    for j in range(i+1, len(keys)):\n        ari = adjusted_rand_score(results_d[keys[i]], results_d[keys[j]])\n        if ari > 0.5:\n            print(f"  {keys[i]} vs {keys[j]}: ARI={ari:.4f}")\n\nprint("\\nDiabetes cluster sizes:")\nfor name, labels in results_d.items():\n    unique, counts = np.unique(labels, return_counts=True)\n    print(f"  {name}: {dict(zip(unique, counts))}")\n\n# Choose: use the GMM on weighted features - it should capture the structure well\n# The rule-based is good but may miss edge cases; GMM can handle the uncertainty\n# Actually, let\'s use the one that best matches expected ~320/200 split\n# Expected: 320 positive, 200 negative = 61.5%/38.5%\n\nbest_d_name = None\nbest_d_diff = float(\'inf\')\ntarget_ratio = 320.0 / 520.0  # ~0.615\n\nfor name, labels in results_d.items():\n    counts = np.bincount(labels)\n    ratio = max(counts) / sum(counts)\n    diff = abs(ratio - target_ratio)\n    if diff < best_d_diff:\n        best_d_diff = diff\n        best_d_name = name\n\nprint(f"\\nBest match to expected distribution: {best_d_name}")\nbest_d = results_d[best_d_name]\n\n# Actually, let\'s prefer the rule-based approach since polyuria/polydipsia are \n# known to be extremely strong predictors (>95% accuracy)\n# But let me also try the GMM on score which uses composite information\n# Use the method that most other methods agree with\nagreement_scores = {}\nfor name in results_d:\n    avg_ari = np.mean([adjusted_rand_score(results_d[name], results_d[other]) \n                       for other in results_d if other != name])\n    agreement_scores[name] = avg_ari\n\nprint("\\nAverage agreement with other methods:")\nfor name, score in sorted(agreement_scores.items(), key=lambda x: -x[1]):\n    print(f"  {name}: {score:.4f}")\n\n# Use the method with highest average agreement\nbest_consensus_name = max(agreement_scores, key=agreement_scores.get)\nprint(f"\\nUsing consensus winner: {best_consensus_name}")\nbest_d = results_d[best_consensus_name]\n\n# Save\nout_d = pd.DataFrame({\'pseudo_label\': best_d})\nout_d.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"Saved diabetes: {np.bincount(best_d)}")\n\n# ===== HEART DATASET =====\nprint("\\n" + "="*50)\nprint("HEART DATASET")\nprint("="*50)\ndf_heart = pd.read_csv(\'/app/heart.csv\')\n\nnumerical_cols = [\'trestbps\', \'chol\', \'thalach\', \'oldpeak\']\ncategorical_cols = [\'sex\', \'cp\', \'fbs\', \'restecg\', \'exang\', \'slope\', \'ca\', \'thal\']\n\n# Domain knowledge for heart disease:\n# In UCI heart dataset (Cleveland), the label is presence/absence of heart disease\n# Key features: cp (chest pain - value 0 = typical angina, most indicative of disease in some encodings)\n# In many versions: cp=0 is typical angina (high risk), but in others the encoding is reversed\n# thalach: lower max heart rate = more risk\n# oldpeak: higher ST depression = more risk  \n# ca: more vessels colored = more risk\n# thal: normal=1, fixed_defect=2, reversible_defect=3 (2,3 = more risk)\n# exang: 1 = exercise angina = more risk\n# slope: 0=upsloping(good), 1=flat(moderate), 2=downsloping(bad) - varies by encoding\n\n# Create a composite risk score\ndf_h = df_heart.copy()\n\n# Standardize numerical features\nfor col in numerical_cols:\n    df_h[col + \'_std\'] = (df_h[col] - df_h[col].mean()) / df_h[col].std()\n\n# In this dataset, cp seems to be encoded as 0,1,2,3\n# In standard UCI: 1=typical angina, 2=atypical, 3=non-anginal, 4=asymptomatic\n# Here 0-indexed: 0=typical angina, 1=atypical, 2=non-anginal, 3=asymptomatic\n# Asymptomatic (3) is actually most associated with disease presence!\n# Wait no - in the processed Cleveland dataset, cp=4 (asymptomatic) is most common in disease\n# So higher cp number = less typical symptoms = counterintuitively MORE disease\n\n# Actually let me reconsider. In UCI heart:\n# cp: chest pain type (0: typical angina, 1: atypical angina, 2: non-anginal pain, 3: asymptomatic)\n# People with asymptomatic chest pain (cp=3) are actually MORE likely to have heart disease\n# thalach: maximum heart rate - LOWER is worse\n# oldpeak: ST depression - HIGHER is worse\n# exang: exercise-induced angina - 1 is worse\n# slope: 0=upsloping(better), 1=flat(moderate), 2=downsloping(worse)\n# ca: number of major vessels colored by fluoroscopy (0-4) - HIGHER is worse\n# thal: 0=normal, 1=fixed defect, 2=reversible defect, 3=? \n# Actually thal values: 1=normal, 2=fixed defect, 3=reversible defect in many encodings\n\n# Create risk score\nrisk_score = (\n    df_h[\'cp\'] * 2.0 +  # higher cp = asymptomatic = more disease\n    (-df_h[\'thalach_std\']) * 1.5 +  # lower max HR = more risk\n    df_h[\'oldpeak_std\'] * 2.0 +  # higher ST depression = more risk\n    df_h[\'exang\'] * 2.5 +  # exercise angina = more risk\n    df_h[\'ca\'] * 3.0 +  # more vessels = more risk (very strong predictor)\n    (df_h[\'thal\'] >= 2).astype(float) * 2.0 +  # defect = more risk\n    df_h[\'slope\'] * 1.0 +  # encoding-dependent\n    df_h[\'sex\'] * 0.5 +  # male = slightly more risk\n    df_h[\'trestbps_std\'] * 0.5 +  # higher BP = more risk\n    df_h[\'fbs\'] * 0.5 +  # fasting blood sugar > 120 = more risk\n    (-df_h[\'chol_std\']) * 0.1  # chol is not very predictive\n)\n\nresults_h = {}\n\n# GMM on risk score\nrisk_vals = risk_score.values.reshape(-1, 1)\ngmm_risk = GaussianMixture(n_components=2, random_state=42)\nresults_h[\'gmm_risk\'] = gmm_risk.fit_predict(risk_vals)\n\n# KMeans on risk score\nkm_risk = KMeans(n_clusters=2, n_init=50, random_state=42)\nresults_h[\'kmeans_risk\'] = km_risk.fit_predict(risk_vals)\n\n# All features standardized with weights\nscaler_h = StandardScaler()\nX_h_all = scaler_h.fit_transform(df_heart.values)\nX_h_df = pd.DataFrame(X_h_all, columns=df_heart.columns)\n\n# Weight by importance\nweights_h = {\n    \'cp\': 2.5, \'thalach\': 2.0, \'oldpeak\': 2.5, \'ca\': 3.0, \'thal\': 2.5,\n    \'exang\': 2.5, \'slope\': 2.0, \'sex\': 1.0, \'age\': 1.0,\n    \'trestbps\': 0.8, \'chol\': 0.5, \'fbs\': 0.5, \'restecg\': 1.0\n}\nX_h_weighted = X_h_df.copy()\nfor col, w in weights_h.items():\n    X_h_weighted[col] = X_h_weighted[col] * w\nX_h_w = X_h_weighted.values\n\n# KMeans weighted\nkm_hw = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_h[\'kmeans_w\'] = km_hw.fit_predict(X_h_w)\n\n# GMM weighted\ngmm_hw = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42, n_init=20)\nresults_h[\'gmm_w\'] = gmm_hw.fit_predict(X_h_w)\n\n# Agglomerative weighted\nagg_hw = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_w\'] = agg_hw.fit_predict(X_h_w)\n\n# Key features only\nkey_features_h = [\'cp\', \'thalach\', \'oldpeak\', \'exang\', \'ca\', \'thal\', \'slope\']\nX_h_key = StandardScaler().fit_transform(df_heart[key_features_h])\n\nkm_key = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_h[\'kmeans_key\'] = km_key.fit_predict(X_h_key)\n\ngmm_key = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42, n_init=20)\nresults_h[\'gmm_key\'] = gmm_key.fit_predict(X_h_key)\n\nagg_key = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_key\'] = agg_key.fit_predict(X_h_key)\n\n# Check agreement\nprint("\\nHeart cluster sizes:")\nfor name, labels in results_h.items():\n    unique, counts = np.unique(labels, return_counts=True)\n    print(f"  {name}: {dict(zip(unique, counts))}")\n\nprint("\\nAgreement between heart methods (ARI):")\nkeys_h = list(results_h.keys())\nagreement_h = {}\nfor name in results_h:\n    avg_ari = np.mean([adjusted_rand_score(results_h[name], results_h[other]) \n                       for other in results_h if other != name])\n    agreement_h[name] = avg_ari\n\nfor name, score in sorted(agreement_h.items(), key=lambda x: -x[1]):\n    print(f"  {name}: {score:.4f}")\n\n# Use the one with highest agreement\nbest_h_name = max(agreement_h, key=agreement_h.get)\nprint(f"\\nUsing consensus winner: {best_h_name}")\nbest_h = results_h[best_h_name]\n\n# Save\nout_h = pd.DataFrame({\'pseudo_label\': best_h})\nout_h.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"Saved heart: {np.bincount(best_h)}")\n\nprint("\\nDone!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
