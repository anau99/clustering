e=42)\nresults_heart[\'spectral_key\'] = spec_h.fit_predict(df_h3)\n\nspec_h2 = SpectralClustering(n_clusters=2, affinity=\'nearest_neighbors\', n_neighbors=10, random_state=42)\nresults_heart[\'spectral_allscaled\'] = spec_h2.fit_predict(df_h2)\n\n# Approach 5: One-hot with weighted important features\ndf_h5 = df_h1_combined.copy()\n# Weight oldpeak and thalach more\ndf_h5[\'oldpeak\'] = df_h5[\'oldpeak\'] * 2\ndf_h5[\'thalach\'] = df_h5[\'thalach\'] * 2\n\nkm_h5 = KMeans(n_clusters=2, init=\'k-means++\', n_init=50, random_state=42)\nresults_heart[\'kmeans_onehot_w\'] = km_h5.fit_predict(df_h5)\n\ngmm_h5 = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42, n_init=10)\nresults_heart[\'gmm_onehot_w\'] = gmm_h5.fit_predict(df_h5)\n\n# Approach 6: Key features with more weight on ca, thal, cp\ndf_h6 = df_heart[key_heart_features].copy().astype(float)\ndf_h6[\'ca\'] = df_h6[\'ca\'] * 2\ndf_h6[\'thal\'] = df_h6[\'thal\'] * 2\ndf_h6[\'cp\'] = df_h6[\'cp\'] * 2\ndf_h6 = pd.DataFrame(StandardScaler().fit_transform(df_h6), columns=key_heart_features)\n\nkm_h6 = KMeans(n_clusters=2, init=\'k-means++\', n_init=50, random_state=42)\nresults_heart[\'kmeans_key_w\'] = km_h6.fit_predict(df_h6)\n\ngmm_h6 = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42, n_init=10)\nresults_heart[\'gmm_key_w\'] = gmm_h6.fit_predict(df_h6)\n\nprint("Heart clustering done.")\nfor k, v in results_heart.items():\n    print(f"  {k}: cluster 0 = {sum(v==0)}, cluster 1 = {sum(v==1)}")\n\n# Select best - GMM on key features is often a good choice for mixed data\nbest_heart = results_heart[\'gmm_key\']\nprint(f"\\nSelected for heart: gmm_key")\n\n# ===================== SAVE RESULTS =====================\nout_diabetes = pd.DataFrame({\'pseudo_label\': best_diabetes})\nout_diabetes.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"\\nSaved diabetes: {out_diabetes[\'pseudo_label\'].value_counts().to_dict()}")\n\nout_heart = pd.DataFrame({\'pseudo