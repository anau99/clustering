ipsia\'] * 2\nX_diab2[\'sudden_weight_loss\'] = X_diab2[\'sudden_weight_loss\'] * 1.5\nX_diab2[\'irritability\'] = X_diab2[\'irritability\'] * 1.5  \nX_diab2[\'partial_paresis\'] = X_diab2[\'partial_paresis\'] * 1.5\nX_diab2[\'gender\'] = X_diab2[\'gender\'] * 1.5\nlabels_km_w = KMeans(n_clusters=2, init=\'k-means++\', n_init=10, random_state=42).fit_predict(X_diab2.values)\nprint(f"KMeans weighted: {np.bincount(labels_km_w)}")\n\n# Try GMM on all features\nlabels_gmm_all = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42).fit_predict(X_diab.values)\nprint(f"GMM all features: {np.bincount(labels_gmm_all)}")\n\n# The best approach for diabetes is likely the one that gives ~320/200 split\n# KMeans on all features gives [315, 205] which is very close\n# Let\'s use that\n\n# Actually, let me also try: polyuria OR polydipsia as a simple binary classifier\nsimple_labels = ((df_diab[\'polyuria\'] == 1) | (df_diab[\'polydipsia\'] == 1)).astype(int).values\nprint(f"Simple polyuria|polydipsia: {np.bincount(simple_labels)}")\n\n# And polyuria AND polydipsia\nsimple_labels2 = ((df_diab[\'polyuria\'] == 1) & (df_diab[\'polydipsia\'] == 1)).astype(int).values  \nprint(f"Simple polyuria&polydipsia: {np.bincount(simple_labels2)}")\n\n# Use KMeans on all features (315/205 split, close to true 320/200)\ndiab_output = pd.DataFrame({\'pseudo_label\': labels_km_all})\ndiab_output.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint("Saved diabetes with KMeans all features")\n\n# ============ HEART DATASET ============\nprint("\\nProcessing heart.csv...")\ndf_heart = pd.read_csv(\'/app/heart.csv\')\n\n# For heart disease, key features are:\n# cp (chest pain type) - 0=typical angina(bad), 1=atypical, 2=non-anginal, 3=asymptomatic(bad)\n# thalach (max heart rate) - lower = more disease\n# oldpeak (ST depression) - higher = more disease\n# ca (num vessels colored) - higher = more disease\n# thal - 3=normal, 6=fixed defect(bad), 7=reversible defect(bad) - bu