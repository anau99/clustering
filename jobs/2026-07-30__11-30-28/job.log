(gives ~50/50)\ndf_h_all = df_heart.copy().astype(float)\ndf_h_all_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h_all), columns=df_h_all.columns)\nagg1 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_all\'] = agg1.fit_predict(df_h_all_scaled)\n\n# Method 2: One-hot + Agglomerative\nnumerical_features = [\'trestbps\', \'chol\', \'thalach\', \'oldpeak\']\ncategorical_features = [\'sex\', \'cp\', \'fbs\', \'restecg\', \'exang\', \'slope\', \'ca\', \'thal\']\ndf_h_num = pd.DataFrame(StandardScaler().fit_transform(df_heart[numerical_features]), columns=numerical_features)\nencoder = OneHotEncoder(sparse_output=False, handle_unknown=\'ignore\')\ndf_h_cat = pd.DataFrame(encoder.fit_transform(df_heart[categorical_features]),\n                        columns=encoder.get_feature_names_out(categorical_features))\ndf_h_onehot = pd.concat([df_h_num, df_h_cat], axis=1)\nagg2 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_onehot\'] = agg2.fit_predict(df_h_onehot)\n\n# Method 3: Key features weighted + KMeans\ndf_h3 = df_heart.copy().astype(float)\ndf_h3[\'cp\'] = df_h3[\'cp\'] * 2\ndf_h3[\'ca\'] = df_h3[\'ca\'] * 2\ndf_h3[\'thal\'] = df_h3[\'thal\'] * 2\ndf_h3[\'oldpeak\'] = df_h3[\'oldpeak\'] * 2\ndf_h3[\'exang\'] = df_h3[\'exang\'] * 2\ndf_h3[\'slope\'] = df_h3[\'slope\'] * 1.5\ndf_h3[\'thalach\'] = df_h3[\'thalach\'] * 1.5\ndf_h3_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h3), columns=df_h3.columns)\nkm3 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_h[\'km_weighted\'] = km3.fit_predict(df_h3_scaled)\n\n# Method 4: Key features only + Agglomerative\nkey_h = [\'cp\', \'thalach\', \'oldpeak\', \'ca\', \'thal\', \'exang\', \'slope\']\ndf_h4 = df_heart[key_h].copy().astype(float)\ndf_h4_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h4), columns=key_h)\nagg4 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_key\'] = agg4.fit_predict(df_h4_scaled)\n\n# Method 5: Key features weighted + Agglomerative\ndf_h5 = df_heart[key_h].copy().astype(float)\ndf_h5[\'cp\'] = df_h5[\'cp\'] * 2\ndf_h5[\'ca\'] = df_h5[\'ca\'] * 2\ndf_h5[\'thal\'] = df_h5[\'thal\'] * 2\ndf_h5_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h5), columns=key_h)\nagg5 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_key_w\'] = agg5.fit_predict(df_h5_scaled)\n\n# Method 6: PCA + KMeans\npca = PCA(n_components=5)\ndf_h6_pca = pca.fit_transform(df_h_all_scaled)\nkm6 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_h[\'km_pca\'] = km6.fit_predict(df_h6_pca)\n\n# Method 7: PCA on one-hot\npca2 = PCA(n_components=10)\ndf_h7_pca = pca2.fit_transform(df_h_onehot)\nkm7 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_h[\'km_pca_onehot\'] = km7.fit_predict(df_h7_pca)\n\n# Method 8: All weighted + Agglomerative\nagg8 = AgglomerativeClustering(n_clusters=2, linkage=\'ward\')\nresults_h[\'agg_weighted\'] = agg8.fit_predict(df_h3_scaled)\n\n# Method 9: GMM on key features weighted\ngmm9 = GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42, n_init=20)\nresults_h[\'gmm_key_w\'] = gmm9.fit_predict(df_h5_scaled)\n\n# Method 10: KMeans on key features\nkm10 = KMeans(n_clusters=2, init=\'k-means++\', n_init=100, random_state=42)\nresults_h[\'km_key\'] = km10.fit_predict(df_h4_scaled)\n\nprint("Heart methods:")\nfor k, v in results_h.items():\n    print(f"  {k}: {sum(v==0)}/{sum(v==1)}")\n\n# Find consensus\nprint("\\nConsensus analysis:")\nkeys_h = list(results_h.keys())\nfor i, k1 in enumerate(keys_h):\n    total_ari = 0\n    count = 0\n    for j, k2 in enumerate(keys_h):\n        if i != j:\n            ari = adjusted_rand_score(results_h[k1], results_h[k2])\n            total_ari += ari\n            count += 1\n    avg_ari = total_ari / count\n    print(f"  {k1}: avg ARI = {avg_ari:.4f}, split = {sum(results_h[k1]==0)}/{sum(results_h[k1]==1)}")\n\n# For heart, prefer methods with ~50/50 split AND high consensus\n# Filter methods with reasonable split (400-600 per cluster)\nfiltered = {k: v for k, v in results_h.items() \n            if 400 <= sum(v==0) <= 625 and 400 <= sum(v==1) <= 625}\n\nprint(f"\\nFiltered methods (balanced split): {list(filtered.keys())}")\n\nif filtered:\n    best_avg = -1\n    best_k = None\n    for k1 in filtered:\n        total_ari = 0\n        count = 0\n        for k2 in filtered:\n            if k1 != k2:\n                ari = adjusted_rand_score(filtered[k1], filtered[k2])\n                total_ari += ari\n                count += 1\n        avg = total_ari / max(count, 1)\n        if avg > best_avg:\n            best_avg = avg\n            best_k = k1\n    best_heart = filtered[best_k]\n    print(f"Selected: {best_k} (avg ARI among balanced = {best_avg:.4f})")\nelse:\n    # fallback\n    best_heart = results_h[\'agg_all\']\n    print("Fallback: agg_all")\n\nprint(f"Final heart: {sum(best_heart==0)}/{sum(best_heart==1)}")\n\n# ===================== SAVE =====================\nout_diabetes = pd.DataFrame({\'pseudo_label\': best_diabetes})\nout_diabetes.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"\\nSaved diabetes: {out_diabetes[\'pseudo_label\'].value_counts().to_dict()}")\n\nout_heart = pd.DataFrame({\'pseudo_label\': best_heart})\nout_heart.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"Saved heart: {out_heart[\'pseudo_label\'].value_counts().to_dict()}")\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
