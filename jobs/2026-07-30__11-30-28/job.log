 higher = more vessels blocked = disease\n# exang: 1 = exercise angina = disease\n# oldpeak: higher = more ST depression = disease  \n# slope: 0 (downsloping) might indicate disease, 2 (upsloping) = normal\n# thalach: lower max heart rate = disease\n# sex: 1 (male) = higher risk\n\n# Score approach\ndf_score = df_heart.copy()\nscore = np.zeros(len(df_score))\nscore += (df_score[\'cp\'] == 0).astype(float) * 2  # typical angina\nscore += (df_score[\'thal\'] >= 2).astype(float) * 2  # defect\nscore += df_score[\'ca\'] * 1.5  # num vessels\nscore += df_score[\'exang\'] * 1.5  # exercise angina\nscore += df_score[\'oldpeak\'] * 0.5  # ST depression\nscore += (df_score[\'slope\'] == 0).astype(float)  # downsloping\nscore -= df_score[\'thalach\'] / 100  # lower thalach = disease\nscore += df_score[\'sex\'] * 0.5  # male risk\nscore += df_score[\'age\'] / 100  # older = more risk\n\n# Cluster on score\nfrom sklearn.cluster import KMeans as KM\nthreshold = np.median(score)\ncandidates[\'score_median\'] = (score >= threshold).astype(int)\n\n# KMeans on score\nscore_reshaped = score.reshape(-1, 1)\ncandidates[\'score_km\'] = KMeans(n_clusters=2, n_init=20, random_state=42).fit_predict(score_reshaped)\n\n# Also use score + other features\ndf_combo = df_heart.copy()\ndf_combo[\'disease_score\'] = score\nX_combo = StandardScaler().fit_transform(df_combo.values)\n# Weight the score heavily\ncombo_weights = np.ones(X_combo.shape[1])\ncombo_weights[-1] = 3.0  # disease score gets 3x weight\ncandidates[\'combo_km\'] = KMeans(n_clusters=2, n_init=20, random_state=42).fit_predict(X_combo * combo_weights)\n\n# Evaluate all candidates\nprint("\\nCandidate evaluation (using multiple disease indicators):")\nprint(f"{\'Name\':<20} {\'Counts\':<15} {\'ca_sep\':<8} {\'thal_sep\':<10} {\'exang_sep\':<10} {\'combined\':<10}")\n\nfor name, labels in candidates.items():\n    counts = np.bincount(labels)\n    \n    # ca separation\n    ca_pos = df_heart[\'ca\'] > 0\n    ca_in_0 = ((labels == 0) & ca_pos).sum()\n    ca_in_1 = ((labels == 1) & ca_pos).sum()\n    ca_sep = max(ca_in_0, ca_in_1) / ca_pos.sum()\n    \n    # thal separation (thal >= 2 = defect)\n    thal_pos = df_heart[\'thal\'] >= 2\n    thal_in_0 = ((labels == 0) & thal_pos).sum()\n    thal_in_1 = ((labels == 1) & thal_pos).sum()\n    thal_sep = max(thal_in_0, thal_in_1) / thal_pos.sum()\n    \n    # exang separation\n    exang_pos = df_heart[\'exang\'] == 1\n    exang_in_0 = ((labels == 0) & exang_pos).sum()\n    exang_in_1 = ((labels == 1) & exang_pos).sum()\n    exang_sep = max(exang_in_0, exang_in_1) / exang_pos.sum()\n    \n    combined = (ca_sep + thal_sep + exang_sep) / 3\n    print(f"  {name:<20} {str(counts):<15} {ca_sep:<8.3f} {thal_sep:<10.3f} {exang_sep:<10.3f} {combined:<10.3f}")\n\n# ============ DIABETES - validate ============\nprint("\\nDIABETES validation")\ndf_diabetes = pd.read_csv(\'/app/diabetes_data.csv\')\ndf_d = df_diabetes.copy()\ndf_d[\'gender\'] = (df_d[\'gender\'] == \'Male\').astype(int)\n\ndf_d_proc = df_d.copy()\ndf_d_proc[\'age\'] = StandardScaler().fit_transform(df_d_proc[[\'age\']])\ndf_d_proc[\'polyuria\'] = df_d_proc[\'polyuria\'] * 3\ndf_d_proc[\'polydipsia\'] = df_d_proc[\'polydipsia\'] * 3\ndf_d_proc[\'sudden_weight_loss\'] = df_d_proc[\'sudden_weight_loss\'] * 2\ndf_d_proc[\'gender\'] = df_d_proc[\'gender\'] * 2\n\nlabels_d = KMeans(n_clusters=2, n_init=20, random_state=0).fit_predict(df_d_proc.values)\nprint(f"Diabetes counts: {np.bincount(labels_d)}")\n\n# Validate: Check separation by polyuria, polydipsia, and combined\npp = (df_d[\'polyuria\'] == 1) & (df_d[\'polydipsia\'] == 1)\nprint(f"  Polyuria+Polydipsia patients in cluster 0: {((labels_d==0) & pp).sum()}, cluster 1: {((labels_d==1) & pp).sum()}")\nprint(f"  Neither in cluster 0: {((labels_d==0) & ~(df_d[\'polyuria\']==1) & ~(df_d[\'polydipsia\']==1)).sum()}, cluster 1: {((labels_d==1) & ~(df_d[\'polyuria\']==1) & ~(df_d[\'polydipsia\']==1)).sum()}")\n\n# ============ SAVE FINAL ============\nprint("\\n=== FINAL SAVE ===")\n\n# Save diabetes with weighted approach\nout_d = pd.DataFrame({\'pseudo_label\': labels_d})\nout_d.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"Diabetes: {np.bincount(labels_d)}")\n\n# For heart: pick the best combined score\n# Based on analysis, use the one with highest combined separation\nbest_h_name = max(candidates.keys(), key=lambda k: (\n    max(((candidates[k]==0) & (df_heart[\'ca\']>0)).sum(), ((candidates[k]==1) & (df_heart[\'ca\']>0)).sum()) / (df_heart[\'ca\']>0).sum() +\n    max(((candidates[k]==0) & (df_heart[\'thal\']>=2)).sum(), ((candidates[k]==1) & (df_heart[\'thal\']>=2)).sum()) / (df_heart[\'thal\']>=2).sum() +\n    max(((candidates[k]==0) & (df_heart[\'exang\']==1)).sum(), ((candidates[k]==1) & (df_heart[\'exang\']==1)).sum()) / (df_heart[\'exang\']==1).sum()\n))\n\nprint(f"Best heart approach: {best_h_name}")\nbest_h = candidates[best_h_name]\nout_h = pd.DataFrame({\'pseudo_label\': best_h})\nout_h.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"Heart: {np.bincount(best_h)}")\n\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
