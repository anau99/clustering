nprint("\\n\\nRefined scoring approach:")\nscore2 = np.zeros(len(df_heart))\n\n# cp=0 (typical angina) - actually this is LESS associated with disease in Kaggle data\n# cp=3 (asymptomatic) - MOST associated with disease\nscore2 += (df_heart[\'cp\'] == 0).astype(float) * 2.0  \n\n# thal: in Kaggle encoding:\n# 0=normal, 1=fixed defect, 2=reversible defect, 3=?\n# Or: 1=normal, 2=fixed defect, 3=reversible defect\n# Reversible defect is most associated with disease\nscore2 += (df_heart[\'thal\'] == 2).astype(float) * 2.0  # reversible defect\nscore2 += (df_heart[\'thal\'] == 3).astype(float) * 1.0  # fixed defect\n\n# ca: number of major vessels colored by fluoroscopy (0-3)\n# Higher = more disease\nscore2 += df_heart[\'ca\'] * 2.0\n\n# exang: exercise induced angina (1=yes)\nscore2 += df_heart[\'exang\'] * 2.0\n\n# oldpeak: ST depression\nscore2 += df_heart[\'oldpeak\'] * 1.0\n\n# slope: 0=upsloping, 1=flat, 2=downsloping\n# In some encodings: downsloping or flat is worse\n# slope=2 (downsloping) associated with disease in some; slope=0 in others\nscore2 += (df_heart[\'slope\'] == 0).astype(float) * 1.0\n\n# thalach: maximum heart rate achieved\n# Lower max HR = more disease\nscore2 -= df_heart[\'thalach\'] / 50.0\n\n# sex: 1=male, higher risk\nscore2 += df_heart[\'sex\'] * 0.5\n\n# age: older = higher risk\nscore2 += df_heart[\'age\'] / 50.0\n\n# restecg: 0=normal, 1=ST-T wave abnormality, 2=left ventricular hypertrophy\nscore2 += (df_heart[\'restecg\'] > 0).astype(float) * 0.5\n\n# fbs: fasting blood sugar > 120 mg/dl\nscore2 += df_heart[\'fbs\'] * 0.3\n\nprint(f"Score2 stats: mean={score2.mean():.2f}, std={score2.std():.2f}, min={score2.min():.2f}, max={score2.max():.2f}")\n\n# Try different thresholds\nfor pct in [45, 48, 50, 52, 55]:\n    threshold = np.percentile(score2, pct)\n    labels = (score2 >= threshold).astype(int)\n    ca_pos = df_heart[\'ca\'] > 0\n    ca_sep = max(((labels==0)&ca_pos).sum(), ((labels==1)&ca_pos).sum()) / ca_pos.sum()\n    exang_pos =