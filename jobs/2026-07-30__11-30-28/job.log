e, labels in [\n    (\'kmeans_all\', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_all_scaled)),\n    (\'gmm_all\', GaussianMixture(n_components=2, random_state=42).fit_predict(X_all_scaled)),\n    (\'agglo_all\', AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(X_all_scaled)),\n    (\'spectral_all\', SpectralClustering(n_clusters=2, affinity=\'nearest_neighbors\', random_state=42).fit_predict(X_all_scaled)),\n]:\n    sil = silhouette_score(X_all_scaled, labels)\n    results_d[name] = (labels, sil)\n    print(f"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}")\n\n# Method 3: Weight features by importance\ndf_d_weighted = df_d.copy()\nweight = 3.0\nfor feat in important_features:\n    df_d_weighted[feat] = df_d_weighted[feat] * weight\nX_weighted = StandardScaler().fit_transform(df_d_weighted.values)\n\nfor name, labels in [\n    (\'kmeans_weighted\', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_weighted)),\n    (\'gmm_weighted\', GaussianMixture(n_components=2, random_state=42).fit_predict(X_weighted)),\n    (\'agglo_weighted\', AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(X_weighted)),\n]:\n    sil = silhouette_score(X_weighted, labels)\n    results_d[name] = (labels, sil)\n    print(f"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}")\n\n# Method 4: PCA then cluster\npca = PCA(n_components=5)\nX_pca = pca.fit_transform(X_all_scaled)\nfor name, labels in [\n    (\'kmeans_pca\', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_pca)),\n    (\'gmm_pca\', GaussianMixture(n_components=2, random_state=42).fit_predict(X_pca)),\n]:\n    sil = silhouette_score(X_pca, labels)\n    results_d[name] = (labels, sil)\n    print(f"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}")\n\n# Method 5: Simple sum-based approach\n# Sum of all binary symptom features as a "severity score"\nsymptom_cols = [c for c in df_d.columns if c != \'age\']\ndf_d[\'symptom_sum\'] = df_d[