pos).sum()) / ca_pos.sum()\nexang_sep = max(((labels_score1==0)&exang_pos).sum(), ((labels_score1==1)&exang_pos).sum()) / exang_pos.sum()\nprint(f"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}")\n\n# Save the best heart result\nprint("\\n=== SAVING HEART ===")\n# Use score2 median (more refined domain knowledge)\nout_h = pd.DataFrame({\'pseudo_label\': labels_med2})\nout_h.to_csv(\'/app/output_heart.csv\', index=False)\nprint(f"Heart saved: {np.bincount(labels_med2)}")\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
