nkage=\'ward\').fit_predict(X_h3)),\n]:\n    sil = silhouette_score(X_h3, labels)\n    results_h[name] = (labels, sil)\n    print(f"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}")\n\n# Approach 4: PCA on one-hot encoded\npca_h = PCA(n_components=5)\nX_h_pca = pca_h.fit_transform(X_h1)\nfor name, labels in [\n    (\'kmeans_pca\', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h_pca)),\n    (\'gmm_pca\', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h_pca)),\n]:\n    sil = silhouette_score(X_h_pca, labels)\n    results_h[name] = (labels, sil)\n    print(f"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}")\n\n# Approach 5: Weighted features\ndf_h_w = df_heart.copy().astype(float)\nweight_cols = [\'cp\', \'thalach\', \'oldpeak\', \'ca\', \'thal\', \'exang\']\nfor col in weight_cols:\n    df_h_w[col] = df_h_w[col] * 2.0\nX_h5 = StandardScaler().fit_transform(df_h_w.values)\nfor name, labels in [\n    (\'kmeans_weighted\', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h5)),\n    (\'gmm_weighted\', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h5)),\n    (\'agglo_weighted\', AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(X_h5)),\n]:\n    sil = silhouette_score(X_h5, labels)\n    results_h[name] = (labels, sil)\n    print(f"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}")\n\nprint("\\n\\n" + "="*60)\nprint("SAVING BEST RESULTS")\nprint("="*60)\n\n# For diabetes, use the GMM weighted approach\n# For the diabetes dataset, a good cluster should split ~320/200 or similar\n# The rule-based approach using polyuria|polydipsia should give the best ARI\nprint("\\nDiabetes: Using rule-based (polyuria OR polydipsia)")\nout_d = pd.DataFrame({\'pseudo_label\': results_d[\'rule_based\'][0]})\nout_d.to_csv(\'/app/output_diabetes_data.csv\', index=False)\nprint(f"Distribution: {np.bincount(results_d[\'rule_based\'][0])}")\n\n# For heart, use spectral or agglo on key features