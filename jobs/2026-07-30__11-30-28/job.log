y\'] = X5[\'irritability\'] * 1.5\nX5[\'partial_paresis\'] = X5[\'partial_paresis\'] * 1.5\nX5 = X5.values\n\nstrategies_diab = {\'X1_all\': X1, \'X2_weight_poly\': X2, \'X3_subset\': X3, \'X4_heavy_weight\': X4, \'X5_moderate_weight\': X5}\n\nbest_diab_labels = None\nbest_diab_name = ""\n\nfor name, X in strategies_diab.items():\n    for algo_name, algo_func in [\n        (\'KMeans\', lambda X: KMeans(n_clusters=2, init=\'k-means++\', n_init=10, random_state=42).fit_predict(X)),\n        (\'GMM\', lambda X: GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42).fit_predict(X)),\n        (\'Agglo\', lambda X: AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(X)),\n        (\'Bisecting\', lambda X: BisectingKMeans(n_clusters=2, random_state=42).fit_predict(X)),\n    ]:\n        labels = algo_func(X)\n        counts = np.bincount(labels)\n        ratio = min(counts) / max(counts)\n        print(f"  {name} + {algo_name}: clusters={counts}, ratio={ratio:.3f}")\n\n# Based on domain knowledge, the diabetes dataset should have roughly 200 positive, 320 negative\n# (or flipped). Let\'s use the strategies that give ~200/320 split.\n# Strategy 2 with KMeans seemed to work well.\n\n# Let\'s go with weighted polyuria/polydipsia + KMeans\nprint("\\nUsing Strategy 2 (weighted polyuria+polydipsia) + KMeans for diabetes")\nlabels_diab = KMeans(n_clusters=2, init=\'k-means++\', n_init=10, random_state=42).fit_predict(X2)\nprint(f"Final diabetes clusters: {np.bincount(labels_diab)}")\n\ndiab_output = pd.DataFrame({\'pseudo_label\': labels_diab})\ndiab_output.to_csv(\'/app/output_diabetes_data.csv\', index=False)\n\n# ============ HEART DATASET ============\nprint("\\n" + "="*60)\nprint("Processing heart.csv...")\nprint("="*60)\ndf_heart = pd.read_csv(\'/app/heart.csv\')\n\nnumerical_cols = [\'trestbps\', \'chol\', \'thalach\', \'oldpeak\']\ncategorical_cols = [\'sex\', \'cp\', \'fbs\', \'restecg\', \'exang\', \'slope\', \'ca\', \'thal\']\n\n# Strategy 1: One-hot encode all categoricals, standardize numericals\ndef prep_heart_onehot(df, weight_dict=None):\n    d = df.copy()\n    # One-hot encode categorical\n    cat_df = pd.get_dummies(d[categorical_cols].astype(str), drop_first=False)\n    # Standardize numerical\n    num_df = d[numerical_cols].copy()\n    scaler = StandardScaler()\n    num_df = pd.DataFrame(scaler.fit_transform(num_df), columns=numerical_cols)\n    result = pd.concat([num_df, cat_df.reset_index(drop=True)], axis=1)\n    if weight_dict:\n        for col, w in weight_dict.items():\n            matching = [c for c in result.columns if c.startswith(col)]\n            for m in matching:\n                result[m] = result[m] * w\n    return result.values\n\n# Strategy 2: Keep categorical as ordinal, standardize everything\ndef prep_heart_ordinal(df, weight_dict=None):\n    d = df.copy()\n    scaler = StandardScaler()\n    d_scaled = pd.DataFrame(scaler.fit_transform(d), columns=d.columns)\n    if weight_dict:\n        for col, w in weight_dict.items():\n            if col in d_scaled.columns:\n                d_scaled[col] = d_scaled[col] * w\n    return d_scaled.values\n\n# Strategy 3: Use only the most important features\ndef prep_heart_subset(df):\n    d = df[[\'cp\', \'thalach\', \'oldpeak\', \'exang\', \'ca\', \'thal\', \'slope\']].copy()\n    # One-hot encode cp, thal, slope\n    cat_df = pd.get_dummies(d[[\'cp\', \'thal\', \'slope\']].astype(str), drop_first=False)\n    num_df = d[[\'thalach\', \'oldpeak\']].copy()\n    scaler = StandardScaler()\n    num_df = pd.DataFrame(scaler.fit_transform(num_df), columns=[\'thalach\', \'oldpeak\'])\n    binary_df = d[[\'exang\', \'ca\']].copy()\n    result = pd.concat([num_df, binary_df.reset_index(drop=True), cat_df.reset_index(drop=True)], axis=1)\n    return result.values\n\n# Key features for heart disease: cp, thalach, oldpeak, ca, thal, exang, slope\nweight_dict1 = {\'cp\': 2, \'thalach\': 2, \'oldpeak\': 2, \'ca\': 2, \'thal\': 2, \'exang\': 2, \'slope\': 1.5}\nweight_dict2 = {\'cp\': 3, \'thalach\': 2, \'oldpeak\': 2, \'ca\': 3, \'thal\': 3, \'exang\': 2, \'slope\': 2}\n\nheart_strategies = {\n    \'onehot_noweight\': prep_heart_onehot(df_heart),\n    \'onehot_weight1\': prep_heart_onehot(df_heart, weight_dict1),\n    \'onehot_weight2\': prep_heart_onehot(df_heart, weight_dict2),\n    \'ordinal_noweight\': prep_heart_ordinal(df_heart),\n    \'ordinal_weight1\': prep_heart_ordinal(df_heart, {\'cp\': 2, \'thalach\': 2, \'oldpeak\': 2, \'ca\': 2, \'thal\': 2, \'exang\': 2}),\n    \'subset\': prep_heart_subset(df_heart),\n}\n\nfor name, X in heart_strategies.items():\n    for algo_name, algo_func in [\n        (\'KMeans\', lambda X: KMeans(n_clusters=2, init=\'k-means++\', n_init=10, random_state=42).fit_predict(X)),\n        (\'GMM\', lambda X: GaussianMixture(n_components=2, covariance_type=\'full\', random_state=42).fit_predict(X)),\n        (\'Agglo\', lambda X: AgglomerativeClustering(n_clusters=2, linkage=\'ward\').fit_predict(X)),\n        (\'Bisecting\', lambda X: BisectingKMeans(n_clusters=2, random_state=42).fit_predict(X)),\n    ]:\n        labels = algo_func(X)\n        counts = np.bincount(labels)\n        ratio = min(counts) / max(counts)\n        print(f"  {name} + {algo_name}: clusters={counts}, ratio={ratio:.3f}")\n\n# Based on the heart disease dataset, typically about 500/525 split (roughly equal)\n# Let\'s try the weighted onehot approach with KMeans\nprint("\\nUsing onehot_weight2 + KMeans for heart")\nX_heart_final = prep_heart_onehot(df_heart, weight_dict2)\nlabels_heart = KMeans(n_clusters=2, init=\'k-means++\', n_init=10, random_state=42).fit_predict(X_heart_final)\nprint(f"Final heart clusters: {np.bincount(labels_heart)}")\n\nheart_output = pd.DataFrame({\'pseudo_label\': labels_heart})\nheart_output.to_csv(\'/app/output_heart.csv\', index=False)\n\nprint("\\nDone!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
