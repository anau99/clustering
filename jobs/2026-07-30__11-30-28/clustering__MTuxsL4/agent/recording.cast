[131.254658, "i", " or rule-based depending on what seems reasonable\n# The typical diabetes dataset has ~320 positive and ~200 negative (or similar split)\n# rule_based gives a reasonable split\n\n\n# ============ HEART DATASET ============\nprint(\"\\n\" + \"=\"*60)\nprint(\"HEART DATASET\")\nprint(\"=\"*60)\ndf_heart = pd.read_csv('/app/heart.csv')\n\nnumerical_cols = ['age', 'trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\nresults_h = {}\n\n# Approach 1: One-hot encode categoricals, standard scale numericals\ndf_h = df_heart.copy()\ncat_encoded = pd.get_dummies(df_h[categorical_cols], columns=categorical_cols, prefix=categorical_cols)\nnum_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h[numerical_cols]), columns=numerical_cols)\nX_h1 = pd.concat([num_scaled, cat_encoded], axis=1).values\n\nfor name, labels in [\n    ('kmeans_ohe', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h1)),\n    ('gmm_ohe', GaussianMixture(n_components=2, random_state=42).fit_"]
