[131.265996, "o", "\u001b[?2004h> "]
[131.266158, "o", "for name, labels in [\r\n\u001b[?2004l\r"]
[131.266183, "o", "\u001b[?2004h> "]
[131.2666, "o", "    ('kmeans_key', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_key)),\r\n\u001b[?2004l\r"]
[131.266693, "o", "\u001b[?2004h> "]
[131.267102, "o", "    ('gmm_key', GaussianMixture(n_components=2, random_state=42).fit_predict(X_key)),\r\n\u001b[?2004l\r"]
[131.267244, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\rcop\u001b[?2004h"]
[131.267396, "o", "> "]
[131.267465, "o", "    sil = silhouette_score(X_key, labels)\r\n\u001b[?2004l\r"]
[131.26758, "o", "\u001b[?2004h> "]
[131.267709, "o", "    results_d[name] = (labels, sil)\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.26773, "o", "> "]
[131.268097, "o", "    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[131.26824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.268361, "o", "\u001b[?2004h"]
[131.268488, "o", "> "]
[131.268689, "o", "# Method 2: All features scaled, different algorithms\r\n"]
[131.268765, "o", "\u001b[?2004l\r\u001b[?2004h"]
[131.268784, "o", "> "]
[131.26891, "o", "scaler = StandardScaler()\r\n\u001b[?2004l\r"]
[131.269004, "o", "\u001b[?2004h> "]
[131.269273, "o", "X_all_scaled = scaler.fit_transform(df_d.values)\r\n\u001b[?2004l\r"]
[131.269357, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[131.269499, "o", "\u001b[?2004h> "]
[131.269517, "o", "for name, labels in [\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.269603, "o", "> "]
[131.269934, "o", "    ('kmeans_all', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_all_scaled)),\r\n\u001b[?2004l\r"]
[131.270078, "o", "\u001b[?2004h> "]
[131.270423, "o", "    ('gmm_all', GaussianMixture(n_components=2, random_state=42).fit_predict(X_all_scaled)),\r\n\u001b[?2004l\r"]
[131.270533, "o", "\u001b[?2004h> "]
[131.271019, "o", "    ('agglo_all', AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_all_scaled)),\r\n\u001b[?2004l\r"]
[131.271169, "o", "\u001b[?2004h"]
[131.271198, "o", "> "]
[131.27185, "o", "    ('spectral_all', SpectralClustering(n_clusters=2, affinity='nearest_neighbors', random_state=42).fit_predict(X_all_scaled)),\r\n\u001b[?2004l\r"]
[131.272039, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.273188, "o", "    sil = silhouette_score(X_all_scaled, labels)\r\n\u001b[?2004l\r\u001b[?2004h>     results_d[name] = (labels, sil)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Method 3: Weight features by importance\r\n\u001b[?2004l\r\u001b[?2004h> df_d_weighted = df_d.copy()\r\n\u001b[?2004l\r\u001b[?2004h> weight = 3.0\r\n\u001b[?2004l\r\u001b[?2004h> for feat in important_features:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.273542, "o", "    df_d_weighted[feat] = df_d_weighted[feat] * weight\r\n\u001b[?2004l\r"]
[131.273573, "o", "\u001b[?2004h"]
[131.273587, "o", "> "]
[131.274026, "o", "X_weighted = StandardScaler().fit_transform(df_d_weighted.values)\r\n\u001b[?2004l\r"]
[131.274114, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[131.27413, "o", "> "]
[131.274266, "o", "for name, labels in [\r\n\u001b[?2004l\r"]
[131.274472, "o", "\u001b[?2004h> "]
[131.274841, "o", "    ('kmeans_weighted', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_weighted)),\r\n\u001b[?2004l\r"]
[131.27487, "o", "\u001b[?2004h> "]
[131.275416, "o", "    ('gmm_weighted', GaussianMixture(n_components=2, random_state=42).fit_predict(X_weighted)),\r\n\u001b[?2004l\r"]
[131.275545, "o", "\u001b[?2004h"]
[131.275806, "o", "> "]
[131.279172, "o", "    ('agglo_weighted', AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_weighted)),\r\n\u001b[?2004l\r\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h>     sil = silhouette_score(X_weighted, labels)\r\n\u001b[?2004l\r\u001b[?2004h>     results_d[name] = (labels, sil)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Method 4: PCA then cluster\r\n\u001b[?2004l\r\u001b[?2004h> pca = PCA(n_components=5)\r\n\u001b[?2004l\r\u001b[?2004h> X_pca = pca.fit_transform(X_all_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in [\r\n\u001b[?2004l\r\u001b[?2004h>     ('kmeans_pca', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_pca)),\r\n\u001b[?2004l\r\u001b[?2004h>     ('gmm_pca', GaussianMixture(n_components=2, random_state=42).fit_predict(X_pca)),\r\n\u001b[?2004l\r\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h>     sil = silhouette_score(X_pca, labels)\r\n\u001b[?2004l\r\u001b[?2004h>     results_d[name] = (labels, sil)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h>"]
[131.279326, "o", " \r\n\u001b[?2004l\r\u001b[?2004h> # Method 5: Simple sum-based approach\r\n\u001b[?2004l\r\u001b[?2004h> # Sum of all binary symptom features as a \"severity score\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.279338, "o", "symptom_cols = [c for c in df_d.columns if c != 'age']\r\n\u001b[?2004l\r"]
[131.279398, "o", "\u001b[?2004h> "]
[131.279691, "o", "df_d['symptom_sum'] = df_d[symptom_cols].sum(axis=1)\r\n\u001b[?2004l\r"]
[131.279778, "o", "\u001b[?2004h> "]
[131.280062, "o", "# Cluster based on symptom sum and polyuria/polydipsia\r\n\u001b[?2004l\r"]
[131.28024, "o", "\u001b[?2004h> "]
[131.280415, "o", "X_sum = df_d[['symptom_sum', 'polyuria', 'polydipsia']].values\r\n\u001b[?2004l\r"]
[131.280444, "o", "\u001b[?2004h"]
[131.28051, "o", "> "]
[131.28065, "o", "X_sum_scaled = StandardScaler().fit_transform(X_sum)\r\n\u001b[?2004l\r"]
[131.280734, "o", "\u001b[?2004h> "]
[131.280816, "o", "for name, labels in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.281465, "o", "    ('kmeans_sum', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_sum_scaled)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.281717, "o", "    ('gmm_sum', GaussianMixture(n_components=2, random_state=42).fit_predict(X_sum_scaled)),\r\n\u001b[?2004l\ratu"]
[131.281782, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r"]
[131.281997, "o", "\u001b[?2004h> "]
[131.28225, "o", "    sil = silhouette_score(X_sum_scaled, labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.282414, "o", "    results_d[name] = (labels, sil)\r\n\u001b[?2004l\r"]
[131.282457, "o", "\u001b[?2004h"]
[131.28265, "o", "> "]
[131.282847, "o", "    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[131.283053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.283179, "o", "# Method 6: Simple rule-based approach\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.283206, "o", "> "]
[131.283474, "o", "# If polyuria=1 OR polydipsia=1, likely diabetic\r\n\u001b[?2004l\r"]
[131.283561, "o", "\u001b[?2004h"]
[131.283619, "o", "> "]
[131.284119, "o", "rule_labels = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\r\n\u001b[?2004l\r"]
[131.284202, "o", "\u001b[?2004h> "]
[131.28446, "o", "print(f\"rule_based: dist={np.bincount(rule_labels)}\")\r\n\u001b[?2004l\r"]
[131.284674, "o", "\u001b[?2004h"]
[131.284738, "o", "> "]
[131.285199, "o", "results_d['rule_based'] = (rule_labels, 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Method 7: polyuria AND polydipsia\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.285345, "o", "rule2_labels = ((df_diabetes['polyuria'] == 1) & (df_diabetes['polydipsia'] == 1)).astype(int).values\r\n\u001b[?2004l\r"]
[131.285371, "o", "\u001b[?2004h"]
[131.285383, "o", "> "]
[131.285709, "o", "print(f\"rule2_based (AND): dist={np.bincount(rule2_labels)}\")\r\n\u001b[?2004l\r"]
[131.285809, "o", "\u001b[?2004h> "]
[131.28603, "o", "results_d['rule2_based'] = (rule2_labels, 0)\r\n\u001b[?2004l\r\\n\" + \""]
[131.286092, "o", "\u001b[?2004h"]
[131.286106, "o", "> "]
[131.28612, "o", "\r\n\u001b[?2004l\r"]
[131.28621, "o", "\u001b[?2004h> "]
[131.286566, "o", "# Use GMM on weighted features - usually works well for this type of data\r\n\u001b[?2004l\r"]
[131.286756, "o", "\u001b[?2004h> "]
[131.287188, "o", "# But also save the rule-based as an alternative\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n--- Diabetes: Selecting best method ---\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.287449, "o", "# We'll go with gmm_weighted or rule-based depending on what seems reasonable\r\n\u001b[?2004l\r"]
[131.287538, "o", "\u001b[?2004h> "]
[131.289187, "o", "# The typical diabetes dataset has ~320 positive and ~200 negative (or similar split)\r\n\u001b[?2004l\r\u001b[?2004h> # rule_based gives a reasonable split\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============ HEART DATASET ============\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"HEART DATASET\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> numerical_cols = ['age', 'trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r\u001b[?2004h> categorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[131.28962, "o", "\u001b[?2004l\r\u001b[?2004h> results_h = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.28978, "o", "# Approach 1: One-hot encode categoricals, standard scale numericals\r\n\u001b[?2004l\r"]
[131.289929, "o", "\u001b[?2004h> "]
[131.290025, "o", "df_h = df_heart.copy()\r\n\u001b[?2004l\r"]
[131.290046, "o", "\u001b[?2004h> "]
[131.290485, "o", "cat_encoded = pd.get_dummies(df_h[categorical_cols], columns=categorical_cols, prefix=categorical_cols)\r\n\u001b[?2004l\r"]
[131.290518, "o", "\u001b[?2004h"]
[131.290539, "o", "> "]
[131.290914, "o", "num_scaled = pd.DataFrame(StandardScaler().fit_transform(df_h[numerical_cols]), columns=numerical_cols)\r\n\u001b[?2004l\r"]
[131.29099, "o", "\u001b[?2004h> "]
[131.291258, "o", "X_h1 = pd.concat([num_scaled, cat_encoded], axis=1).values\r\n\u001b[?2004l\r"]
[131.291289, "o", "\u001b[?2004h"]
[131.291304, "o", "> \r\n"]
[131.291322, "o", "\u001b[?2004l\r"]
[131.291432, "o", "\u001b[?2004h> "]
[131.291653, "o", "for name, labels in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.291877, "o", "    ('kmeans_ohe', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h1)),\r\n\u001b[?2004l\r"]
[131.291979, "o", "\u001b[?2004h> "]
[131.292235, "o", "    ('gmm_ohe', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h1)),\r\n\u001b[?2004l\r"]
[131.292263, "o", "\u001b[?2004h"]
[131.292278, "o", "> "]
[131.292616, "o", "    ('agglo_ohe', AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h1)),\r\n\u001b[?2004l\r"]
[131.292745, "o", "\u001b[?2004h> ]:\r\n"]
[131.292766, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[131.293069, "o", "    sil = silhouette_score(X_h1, labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.293321, "o", "    results_h[name] = (labels, sil)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.29348, "o", "    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[131.293551, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.293628, "o", "\u001b[?2004h> "]
[131.293824, "o", "# Approach 2: Scale everything (treat categorical as ordinal)\r\n\u001b[?2004l\r"]
[131.293852, "o", "\u001b[?2004h"]
[131.293869, "o", "> "]
[131.294067, "o", "X_h2 = StandardScaler().fit_transform(df_heart.values)\r\n\u001b[?2004l\r"]
[131.294135, "o", "\u001b[?2004h> "]
[131.294235, "o", "for name, labels in [\r\n\u001b[?2004l\r"]
[131.294324, "o", "\u001b[?2004h> "]
[131.294692, "o", "    ('kmeans_ordinal', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h2)),\r\n\u001b[?2004l\r"]
[131.294721, "o", "\u001b[?2004h"]
[131.294736, "o", "> "]
[131.295085, "o", "    ('gmm_ordinal', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h2)),\r\n\u001b[?2004l\r"]
[131.295118, "o", "\u001b[?2004h"]
[131.295135, "o", "> "]
[131.295514, "o", "    ('agglo_ordinal', AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h2)),\r\n\u001b[?2004l\r"]
[131.295546, "o", "\u001b[?2004h> "]
[131.295959, "o", "    ('spectral_ordinal', SpectralClustering(n_clusters=2, affinity='nearest_neighbors', random_state=42).fit_predict(X_h2)),\r\n\u001b[?2004l\r"]
[131.295988, "o", "\u001b[?2004h"]
[131.296105, "o", "> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.296274, "o", "    sil = silhouette_score(X_h2, labels)\r\n"]
[131.296369, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[131.2965, "o", "    results_h[name] = (labels, sil)\r\n\u001b[?2004l\r"]
[131.296723, "o", "\u001b[?2004h> "]
[131.296847, "o", "    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[131.29688, "o", "\u001b[?2004h"]
[131.296899, "o", "> \r\n"]
[131.296916, "o", "\u001b[?2004l\r"]
[131.297363, "o", "\u001b[?2004h> # Approach 3: Use only most discriminative features for heart disease\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.297581, "o", "# cp, thalach, oldpeak, ca, thal, exang are strong predictors\r\n\u001b[?2004l\r"]
[131.297682, "o", "\u001b[?2004h"]
[131.297851, "o", "> "]
[131.297991, "o", "key_features_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang']\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.298018, "o", "> "]
[131.298196, "o", "df_h_key = df_heart[key_features_h].copy()\r\n\u001b[?2004l\r"]
[131.298345, "o", "\u001b[?2004h> "]
[131.298509, "o", "X_h3 = StandardScaler().fit_transform(df_h_key.values)\r\n\u001b[?2004l\r"]
[131.298537, "o", "\u001b[?2004h> "]
[131.298734, "o", "for name, labels in [\r\n\u001b[?2004l\r"]
[131.299179, "o", "\u001b[?2004h>     ('kmeans_key', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h3)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.299355, "o", "    ('gmm_key', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h3)),\r\n\u001b[?2004l\r"]
[131.299387, "o", "\u001b[?2004h> "]
[131.299727, "o", "    ('agglo_key', AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h3)),\r\n\u001b[?2004l\r"]
[131.299809, "o", "\u001b[?2004h> "]
[131.299868, "o", "]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.300013, "o", "    sil = silhouette_score(X_h3, labels)\r\n\u001b[?2004l\r"]
[131.300096, "o", "\u001b[?2004h> "]
[131.300223, "o", "    results_h[name] = (labels, sil)\r\n\u001b[?2004l\r"]
[131.30032, "o", "\u001b[?2004h> "]
[131.300541, "o", "    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[131.300719, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.30093, "o", "# Approach 4: PCA on one-hot encoded\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.301008, "o", "pca_h = PCA(n_components=5)\r\n\u001b[?2004l\r"]
[131.301423, "o", "\u001b[?2004h> X_h_pca = pca_h.fit_transform(X_h1)\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.302205, "o", "    ('kmeans_pca', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h_pca)),\r\n\u001b[?2004l\r\u001b[?2004h>     ('gmm_pca', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h_pca)),\r\n\u001b[?2004l\r\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.302362, "o", "    sil = silhouette_score(X_h_pca, labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
