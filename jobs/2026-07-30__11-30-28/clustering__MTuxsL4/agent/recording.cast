[17.560319, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\ndef standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\""]
[17.560805, "o", "\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result\u001b[?2004hroot@6156096e0877:/app# "]
[17.675684, "i", "cat /app/src/cluster/spectral.py\n"]
[17.676011, "o", "cat /app/src/cluster/spectral.py\r\n\u001b[?2004l\r"]
[17.677912, "o", "from sklearn.cluster import SpectralClustering\r\n\r\n\r\ndef spectral(X, k):\r\n    model = SpectralClustering(\r\n        n_clusters=k,\r\n        affinity=\"nearest_neighbors\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[17.678303, "o", "\u001b[?2004hroot@6156096e0877:/app# "]
[17.790726, "i", "cat /app/src/cluster/agglomerative.py\n"]
