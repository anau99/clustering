[282.089261, "o", "> l = GaussianMixture(n_components=2, random_state=42, n_init=5).fit_predict(X_h_all_scaled)"]
[282.089315, "o", "\r\n"]
[282.089357, "o", "\u001b[?2004l\r"]
[282.089465, "o", "\u001b[?2004h"]
