[63.480175, "o", "# Save heart output - using GMM approach 2\r\n\u001b[?2004l\r\u001b[?2004h> out_h = pd.DataFrame({'pseudo_label': labels_h2_gmm})\r\n\u001b[?2004l\r\u001b[?2004h> out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Saved heart output: {out_h['pseudo_label'].value_counts().to_dict()}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
