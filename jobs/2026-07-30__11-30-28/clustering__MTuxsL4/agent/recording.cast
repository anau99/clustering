[282.08995, "o", "> "]
[282.090354, "o", "print(f\"gmm_all: {np.bincount(l)}, sil={silhouette_score(X_h_all_scaled, l):.4f}\")"]
[282.090386, "o", "\r\n\u001b[?2004l\r"]
