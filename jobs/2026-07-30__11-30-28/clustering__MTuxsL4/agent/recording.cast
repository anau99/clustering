[282.097742, "o", "\u001b[?2004h"]
[282.097799, "o", "> "]
[282.097846, "o", "\r\n"]
[282.097887, "o", "\u001b[?2004l\r"]
[282.097958, "o", "\u001b[?2004h"]
[282.098052, "o", "> "]
[282.098344, "o", "# Consensus/ensemble: majority vote of multiple methods"]
[282.098419, "o", "\r\n\u001b[?2004l\r"]
[282.098471, "o", "\u001b[?2004h"]
[282.098773, "o", "> "]
[282.098811, "o", "# Align labels first (use correlation with km_key as reference)"]
[282.098851, "o", "\r\n"]
[282.098891, "o", "\u001b[?2004l\r"]
[282.098964, "o", "\u001b[?2004h"]
[282.099018, "o", "> "]
[282.099194, "o", "ref = results['km_key']\r\n"]
[282.099242, "o", "\u001b[?2004l\r"]
[282.09932, "o", "\u001b[?2004h"]
[282.099378, "o", "> "]
[282.09949, "o", "all_labels = []"]
[282.099583, "o", "\r\n\u001b[?2004l\r"]
[282.099607, "o", "\u001b[?2004h"]
[282.099827, "o", "> for name, labels in results.items():"]
[282.099869, "o", "\r\n"]
[282.099908, "o", "\u001b[?2004l\r"]
[282.10016, "o", "\u001b[?2004h> "]
[282.100408, "o", "    # Check if we need to flip\r\n"]
[282.100585, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[282.10065, "o", "    agree = np.mean(labels == ref)\r\n"]
[282.100707, "o", "\u001b[?2004l\r"]
[282.100791, "o", "\u001b[?2004h"]
[282.10096, "o", "> "]
[282.101028, "o", "    if agree < 0.5:\r\n\u001b[?2004l\r"]
[282.101105, "o", "\u001b[?2004h"]
[282.101331, "o", ">         labels_aligned = 1 - labels"]
[282.101374, "o", "\r\n"]
[282.101416, "o", "\u001b[?2004l\r"]
[282.101493, "o", "\u001b[?2004h"]
[282.10155, "o", "> "]
[282.10164, "o", "    else:"]
[282.101693, "o", "\r\n"]
[282.101758, "o", "\u001b[?2004l\r"]
[282.101968, "o", "\u001b[?2004h"]
[282.102003, "o", ">         labels_aligned = labels"]
[282.102043, "o", "\r\n"]
[282.102186, "o", "\u001b[?2004l\r"]
[282.10222, "o", "\u001b[?2004h"]
[282.102428, "o", ">     all_labels.append(labels_aligned)"]
[282.102478, "o", "\r\n"]
[282.102571, "o", "\u001b[?2004l\r"]
[282.102626, "o", "\u001b[?2004h"]
[282.10277, "o", "> \r\n\u001b[?2004l\r"]
[282.102858, "o", "\u001b[?2004h"]
[282.103033, "o", "> "]
[282.103068, "o", "all_labels = np.array(all_labels)"]
[282.103128, "o", "\r\n"]
[282.103215, "o", "\u001b[?2004l\r"]
[282.103312, "o", "\u001b[?2004h> "]
[282.103614, "o", "consensus = (all_labels.mean(axis=0) >= 0.5).astype(int)\r\n"]
[282.103682, "o", "\u001b[?2004l\r"]
[282.103734, "o", "\u001b[?2004h"]
[282.104199, "o", "> "]
[282.104361, "o", "print(f\"\\nConsensus: {np.bincount(consensus)}, sil={silhouette_score(X_h_key_scaled, consensus):.4f}\")"]
[282.104429, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.104459, "o", "> "]
[282.104558, "o", "\r\n\u001b[?2004l\r"]
[282.104627, "o", "\u001b[?2004h"]
[282.104691, "o", "> "]
[282.105047, "o", "# Pick the best: use km_key which has high silhouette and reasonable split"]
[282.105138, "o", "\r\n\u001b[?2004l\r"]
[282.105219, "o", "\u001b[?2004h"]
[282.105334, "o", "> "]
