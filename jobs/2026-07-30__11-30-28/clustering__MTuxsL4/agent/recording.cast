[131.255304, "i", "lts_h[name] = (labels, sil)\n    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\n\n# Approach 5: Weighted features\ndf_h_w = df_heart.copy().astype(float)\nweight_cols = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang']\nfor col in weight_cols:\n    df_h_w[col] = df_h_w[col] * 2.0\nX_h5 = StandardScaler().fit_transform(df_h_w.values)\nfor name, labels in [\n    ('kmeans_weighted', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_h5)),\n    ('gmm_weighted', GaussianMixture(n_components=2, random_state=42).fit_predict(X_h5)),\n    ('agglo_weighted', AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h5)),\n]:\n    sil = silhouette_score(X_h5, labels)\n    results_h[name] = (labels, sil)\n    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\n\nprint(\"\\n\\n\" + \"=\"*60)\nprint(\"SAVING BEST RESULTS\")\nprint(\"=\"*60)\n\n# For diabetes, use the GMM weighted approach\n# For the diabetes dataset, a good cluster should split ~320/200 or similar\n# The rule-based approach using"]
