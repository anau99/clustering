[131.253255, "i", "ted, labels)\n    results_d[name] = (labels, sil)\n    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\n\n# Method 4: PCA then cluster\npca = PCA(n_components=5)\nX_pca = pca.fit_transform(X_all_scaled)\nfor name, labels in [\n    ('kmeans_pca', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_pca)),\n    ('gmm_pca', GaussianMixture(n_components=2, random_state=42).fit_predict(X_pca)),\n]:\n    sil = silhouette_score(X_pca, labels)\n    results_d[name] = (labels, sil)\n    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\n\n# Method 5: Simple sum-based approach\n# Sum of all binary symptom features as a \"severity score\"\nsymptom_cols = [c for c in df_d.columns if c != 'age']\ndf_d['symptom_sum'] = df_d[symptom_cols].sum(axis=1)\n# Cluster based on symptom sum and polyuria/polydipsia\nX_sum = df_d[['symptom_sum', 'polyuria', 'polydipsia']].values\nX_sum_scaled = StandardScaler().fit_transform(X_sum)\nfor name, labels in [\n    ('kmeans_sum', KMeans(n_clusters=2, random_state=42, n_i"]
