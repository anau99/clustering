[316.832155, "i", "python -c \"\nimport pandas as pd\nd = pd.read_csv('/app/output_diabetes_data.csv')\nh = pd.read_csv('/app/output_heart.csv')\nprint('Diabetes:')\nprint(f'  Shape: {d.shape}')\nprint(f'  Columns: {d.columns.tolist()}')\nprint(f'  Values: {sorted(d[\"pseudo_label\"].unique())}')\nprint(f'  Counts: {d[\"pseudo_label\"].value_counts().to_dict()}')\nprint('Heart:')\nprint(f'  Shape: {h.shape}')\nprint(f'  Columns: {h.columns.tolist()}')\nprint(f'  Values: {sorted(h[\"pseudo_label\"].unique())}')\nprint(f'  Counts: {h[\"pseudo_label\"].value_counts().to_dict()}')\n\"\n"]
