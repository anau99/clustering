[282.08103, "o", "X_h_key = df_heart[key_feats_h].values.astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.081463, "o", "X_h_key_scaled = StandardScaler().fit_transform(X_h_key)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.081491, "o", "# All features\r\n"]
[282.081508, "o", "\u001b[?2004l\r"]
[282.081734, "o", "\u001b[?2004h> "]
[282.081759, "o", "X_h_all = df_heart.values.astype(float)\r\n"]
[282.081776, "o", "\u001b[?2004l\r"]
[282.081919, "o", "\u001b[?2004h> "]
[282.083326, "o", "X_h_all_scaled = StandardScaler().fit_transform(X_h_all)\r\n"]
[282.083459, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[282.08348, "o", "\u001b[?2004h"]
[282.083495, "o", "> "]
[282.083718, "o", "# Multiple methods\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.08374, "o", "results = {}"]
[282.083755, "o", "\r\n\u001b[?2004l\r"]
[282.084316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # KMeans on key features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.084527, "o", "l = KMeans(n_clusters=2, random_state=42, n_init=20).fit_predict(X_h_key_scaled)\r\n\u001b[?2004l\r\u001b[?2004h"]
[282.084555, "o", "> "]
[282.084752, "o", "results['km_key'] = l\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.085202, "o", "print(f\"km_key: {np.bincount(l)}, sil={silhouette_score(X_h_key_scaled, l):.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[282.085251, "o", "\u001b[?2004h"]
[282.08532, "o", "> "]
[282.08574, "o", "# GMM on key features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[282.085878, "o", "l = GaussianMixture(n_components=2, random_state=42, n_init=5).fit_predict(X_h_key_scaled)"]
[282.085924, "o", "\r\n"]
[282.086004, "o", "\u001b[?2004l\r"]
[282.086251, "o", "\u001b[?2004h> "]
[282.086282, "o", "results['gmm_key'] = l"]
[282.086325, "o", "\r\n"]
[282.087295, "o", "\u001b[?2004l\r\u001b[?2004h> print(f\"gmm_key: {np.bincount(l)}, sil={silhouette_score(X_h_key_scaled, l):.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # KMeans on all\r\n\u001b[?2004l\r\u001b[?2004h> l = KMeans(n_clusters=2, random_state=42, n_init=20).fit_predict(X_h_all_scaled)"]
