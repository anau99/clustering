[282.097198, "o", "\u001b[?2004l\r"]
[282.097223, "o", "\u001b[?2004h"]
[282.097547, "o", "> "]
[282.09758, "o", "    print(f\"km_key_s{seed}: {np.bincount(l)}, sil={sil:.4f}\")"]
