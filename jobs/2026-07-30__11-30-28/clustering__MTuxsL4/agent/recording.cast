[63.453273, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Preprocess diabetes: encode gender as binary, scale age\r\n\u001b[?2004l\r\u001b[?2004h> df_d = df_diabetes.copy()\r\n\u001b[?2004l\r\u001b[?2004h> # Gender encoding\r\n\u001b[?2004l\r\u001b[?2004h> df_d['gender'] = df_d['gender'].map({'Male': 1, 'Female': 0})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.453719, "o", "# Try approach 1: StandardScaler on all features then GMM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.453839, "o", "df_d_scaled = standard_scaler(df_d)\r\n\u001b[?2004l\r"]
[63.453996, "o", "\u001b[?2004h> "]
[63.454151, "o", "print(f\"\\nDiabetes scaled shape: {df_d_scaled.shape}\")\r\n\u001b[?2004l\r"]
[63.454301, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.454482, "o", "# Try multiple clustering methods\r\n"]
[63.454622, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[63.454711, "o", "X_d = df_d_scaled.values\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.454731, "o", "> \r\n\u001b[?2004l\r"]
[63.454871, "o", "\u001b[?2004h> "]
[63.454989, "o", "labels_d_kmeans = kmeans(X_d, 2)\r\n\u001b[?2004l\r"]
[63.45509, "o", "\u001b[?2004h> "]
[63.455483, "o", "labels_d_gmm = gaussian_mixture(X_d, 2)"]
[63.45565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.455796, "o", "labels_d_agglo = agglomerative(X_d, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.456087, "o", "> \r\n\u001b[?2004l\r"]
[63.457248, "o", "\u001b[?2004h> print(f\"KMeans cluster distribution: {np.bincount(labels_d_kmeans)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"GMM cluster distribution: {np.bincount(labels_d_gmm)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Agglomerative cluster distribution: {np.bincount(labels_d_agglo)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try approach 2: One-hot encode gender, scale age only\r\n\u001b[?2004l\r\u001b[?2004h> df_d2 = df_diabetes.copy()\r\n\u001b[?2004l\r"]
[63.457479, "o", ")}\")\r\n\r\n# For now, let's save the GMM results (typically best for mixed data)\r\n# Diabetes: use approach 1 GMM\r\nprint(\"\\n\\nSaving results...\")\r\n\r\n# Save diabetes output - using GMM on scaled data\r\nout_d = pd.DataFrame({'pseudo_label': labels_d_gmm})\r\nout_d.to_csv('/app/output_diabetes_data.csv', index=\u001b[?2004h> "]
[63.457683, "o", "df_d2 = one_hot_encoder(df_d2, columns=['gender'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.457901, "o", "> "]
[63.458158, "o", "df_d2 = standard_scaler(df_d2, columns=['age'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.458259, "o", "X_d2 = df_d2.values\r\n\u001b[?2004l\r"]
[63.458482, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.458621, "o", "labels_d2_kmeans = kmeans(X_d2, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.458861, "o", "labels_d2_gmm = gaussian_mixture(X_d2, 2)\r\n\u001b[?2004l\r"]
[63.459076, "o", "\u001b[?2004h> labels_d2_agglo = agglomerative(X_d2, 2)\r\n\u001b[?2004l\r"]
[63.459311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.459351, "o", "print(f\"\\nApproach 2:\")\r\n\u001b[?2004l\r"]
[63.459368, "o", "\u001b[?2004h"]
[63.459382, "o", "> "]
[63.460203, "o", "print(f\"KMeans cluster distribution: {np.bincount(labels_d2_kmeans)}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"GMM cluster distribution: {np.bincount(labels_d2_gmm)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.460336, "o", "print(f\"Agglomerative cluster distribution: {np.bincount(labels_d2_agglo)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.460383, "o", "\u001b[?2004h> "]
[63.460587, "o", "# Try approach 3: No scaling, just binary encode gender\r\n\u001b[?2004l\r"]
[63.460617, "o", "\u001b[?2004h"]
[63.460665, "o", "> "]
[63.460747, "o", "df_d3 = df_diabetes.copy()\r\n\u001b[?2004l\r"]
[63.460793, "o", "\u001b[?2004h> "]
[63.461021, "o", "df_d3['gender'] = df_d3['gender'].map({'Male': 1, 'Female': 0})\r\n\u001b[?2004l\r"]
[63.461063, "o", "\u001b[?2004h> "]
[63.461169, "o", "X_d3 = df_d3.values\r\n\u001b[?2004l\r"]
[63.461249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.461291, "o", "> "]
[63.461397, "o", "labels_d3_kmeans = kmeans(X_d3, 2)\r\n"]
[63.461431, "o", "\u001b[?2004l\r\u001b[?2004h"]
[63.461453, "o", "> "]
[63.461735, "o", "labels_d3_gmm = gaussian_mixture(X_d3, 2)\r\n\u001b[?2004l\r"]
[63.461834, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.461861, "o", "print(f\"\\nApproach 3 (no scaling):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.462211, "o", "print(f\"KMeans cluster distribution: {np.bincount(labels_d3_kmeans)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.462412, "o", "print(f\"GMM cluster distribution: {np.bincount(labels_d3_gmm)}\")\r\n\u001b[?2004l\r"]
[63.462495, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.462521, "o", "\u001b[?2004h> "]
[63.462654, "o", "# ============ HEART DATASET ============\r\n\u001b[?2004l\r"]
[63.462799, "o", "\u001b[?2004h> "]
[63.462954, "o", "print(\"\\n\\nProcessing heart.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.463034, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r"]
[63.463159, "o", "\u001b[?2004h> "]
[63.463307, "o", "print(f\"Shape: {df_heart.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.463423, "o", "print(f\"Columns: {df_heart.columns.tolist()}\")\r\n\u001b[?2004l\r"]
[63.463452, "o", "\u001b[?2004h"]
[63.463468, "o", "> "]
[63.463596, "o", "print(f\"Dtypes:\\n{df_heart.dtypes}\")\r\n\u001b[?2004l\r"]
[63.463681, "o", "\u001b[?2004h> "]
[63.464203, "o", "print(f\"Head:\\n{df_heart.head()}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Heart dataset: numerical features (trestbps, chol, thalach, oldpeak)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.464366, "o", "# categorical features: sex, cp, fbs, restecg, exang, slope, ca, thal\r\n\u001b[?2004l\r"]
[63.464434, "o", "\u001b[?2004h> "]
[63.464659, "o", "numerical_cols_h = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r"]
[63.464755, "o", "\u001b[?2004h> "]
[63.465113, "o", "categorical_cols_h = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r"]
[63.46526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.465474, "o", "# Note: 'age' is in the dataset but task says it's not numerical feature for clustering\r\n\u001b[?2004l\r"]
[63.465562, "o", "\u001b[?2004h> "]
[63.465822, "o", "# Actually the task says: four numerical features (trestbps, chol, thalach, oldpeak)\r\n\u001b[?2004l\r"]
[63.465849, "o", "\u001b[?2004h"]
[63.465866, "o", "> "]
[63.46622, "o", "# and eight categorical features: sex, cp, fbs, restecg, exang, slope, ca, thal\r\n\u001b[?2004l\r"]
[63.466329, "o", "\u001b[?2004h> "]
[63.46658, "o", "# So 'age' is not mentioned - let's check if we should drop it or include it\r\n\u001b[?2004l\r"]
[63.466676, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.466703, "o", "\u001b[?2004h> "]
[63.467053, "o", "# Approach 1: One-hot encode categoricals, standard scale numericals, include age as numerical\r\n\u001b[?2004l\r"]
[63.467083, "o", "\u001b[?2004h"]
[63.467098, "o", "> "]
[63.467311, "o", "df_h = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.467482, "o", "# Drop age since it's not mentioned in feature lists\r\n\u001b[?2004l\r"]
[63.46759, "o", "\u001b[?2004h> "]
[63.467838, "o", "# Actually let me keep it and try both\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.467911, "o", "df_h1 = df_h.drop(columns=['age'])\r\n\u001b[?2004l\r"]
[63.468037, "o", "\u001b[?2004h> "]
[63.468233, "o", "df_h1 = one_hot_encoder(df_h1, columns=categorical_cols_h)\r\n\u001b[?2004l\r"]
[63.468261, "o", "\u001b[?2004h"]
[63.468279, "o", "> "]
[63.468525, "o", "df_h1 = standard_scaler(df_h1, columns=numerical_cols_h)\r\n\u001b[?2004l\r"]
[63.468556, "o", "\u001b[?2004h"]
[63.468574, "o", "> "]
[63.46887, "o", "X_h1 = df_h1.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.468972, "o", "labels_h1_kmeans = kmeans(X_h1, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.468992, "o", "> "]
[63.469285, "o", "labels_h1_gmm = gaussian_mixture(X_h1, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.46947, "o", "labels_h1_agglo = agglomerative(X_h1, 2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[63.469502, "o", "\u001b[?2004l\r\u001b[?2004h"]
[63.46952, "o", "> "]
[63.469891, "o", "print(f\"\\nHeart Approach 1 (drop age, onehot cat, scale num):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.470133, "o", "print(f\"KMeans cluster distribution: {np.bincount(labels_h1_kmeans)}\")\r\n\u001b[?2004l\r"]
[63.470287, "o", "\u001b[?2004h> "]
[63.470462, "o", "print(f\"GMM cluster distribution: {np.bincount(labels_h1_gmm)}\")\r\n\u001b[?2004l\r"]
[63.470491, "o", "\u001b[?2004h"]
[63.470507, "o", "> "]
[63.471182, "o", "print(f\"Agglomerative cluster distribution: {np.bincount(labels_h1_agglo)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 2: Keep age, one-hot encode categoricals, scale all numerical\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.471211, "o", "df_h2 = df_h.copy()\r\n"]
[63.471228, "o", "\u001b[?2004l\r"]
[63.471331, "o", "\u001b[?2004h> "]
[63.471582, "o", "df_h2 = one_hot_encoder(df_h2, columns=categorical_cols_h)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.471681, "o", "> "]
[63.471806, "o", "all_num_cols = ['age'] + numerical_cols_h\r\n"]
[63.471829, "o", "\u001b[?2004l\r"]
[63.471927, "o", "\u001b[?2004h> "]
[63.47212, "o", "df_h2 = standard_scaler(df_h2, columns=all_num_cols)\r\n\u001b[?2004l\r"]
[63.472191, "o", "\u001b[?2004h> "]
[63.472292, "o", "X_h2 = df_h2.values\r\n\u001b[?2004l\r"]
[63.472366, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.472394, "o", "> "]
[63.472555, "o", "labels_h2_kmeans = kmeans(X_h2, 2)\r\n\u001b[?2004l\r"]
[63.472636, "o", "\u001b[?2004h> "]
[63.472774, "o", "labels_h2_gmm = gaussian_mixture(X_h2, 2)\r\n\u001b[?2004l\r"]
[63.472809, "o", "\u001b[?2004h"]
[63.472882, "o", "> "]
[63.473178, "o", "labels_h2_agglo = agglomerative(X_h2, 2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.473403, "o", "print(f\"\\nHeart Approach 2 (keep age, onehot cat, scale num):\")\r\n\u001b[?2004l\r"]
[63.473508, "o", "\u001b[?2004h"]
[63.473571, "o", "> "]
[63.473736, "o", "print(f\"KMeans cluster distribution: {np.bincount(labels_h2_kmeans)}\")\r\n\u001b[?2004l\r"]
[63.47386, "o", "\u001b[?2004h> "]
[63.474046, "o", "print(f\"GMM cluster distribution: {np.bincount(labels_h2_gmm)}\")\r\n\u001b[?2004l\r"]
[63.47408, "o", "\u001b[?2004h"]
[63.474099, "o", "> "]
[63.474366, "o", "print(f\"Agglomerative cluster distribution: {np.bincount(labels_h2_agglo)}\")\r\n\u001b[?2004l\r"]
[63.474397, "o", "\u001b[?2004h"]
[63.475181, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 3: Scale everything uniformly\r\n\u001b[?2004l\r\u001b[?2004h> df_h3 = df_h.copy()\r\n\u001b[?2004l\r\u001b[?2004h> df_h3 = one_hot_encoder(df_h3, columns=categorical_cols_h)\r\n\u001b[?2004l\r\u001b[?2004h> df_h3 = standard_scaler(df_h3)  # scale all\r\n\u001b[?2004l\r\u001b[?2004h> X_h3 = df_h3.values\r\n\u001b[?2004l\r"]
[63.475211, "o", "\u001b[?2004h> "]
[63.475308, "o", "\r\n\u001b[?2004l\r"]
[63.475333, "o", "\u001b[?2004h> "]
[63.475461, "o", "labels_h3_kmeans = kmeans(X_h3, 2)\r\n\u001b[?2004l\r"]
[63.475569, "o", "\u001b[?2004h> "]
[63.475683, "o", "labels_h3_gmm = gaussian_mixture(X_h3, 2)\r\n\u001b[?2004l\r"]
[63.475709, "o", "\u001b[?2004h> "]
[63.475874, "o", "labels_h3_agglo = agglomerative(X_h3, 2)\r\n\u001b[?2004l\r"]
[63.475963, "o", "\u001b[?2004h"]
[63.475992, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.476232, "o", "print(f\"\\nHeart Approach 3 (onehot cat, scale all):\")\r\n\u001b[?2004l\r"]
[63.476259, "o", "\u001b[?2004h"]
[63.476274, "o", "> "]
[63.476546, "o", "print(f\"KMeans cluster distribution: {np.bincount(labels_h3_kmeans)}\")\r\n\u001b[?2004l\r"]
[63.476697, "o", "\u001b[?2004h> "]
[63.476844, "o", "print(f\"GMM cluster distribution: {np.bincount(labels_h3_gmm)}\")\r\n\u001b[?2004l\r"]
[63.477167, "o", "\u001b[?2004h> "]
[63.477268, "o", "print(f\"Agglomerative cluster distribution: {np.bincount(labels_h3_agglo)}\")\r\n\u001b[?2004l\r"]
[63.477333, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.47739, "o", "> "]
[63.477622, "o", "# For now, let's save the GMM results (typically best for mixed data)\r\n\u001b[?2004l\r"]
[63.477679, "o", "\u001b[?2004h> "]
[63.477788, "o", "# Diabetes: use approach 1 GMM\r\n\u001b[?2004l\r"]
[63.477848, "o", "\u001b[?2004h> "]
[63.477953, "o", "print(\"\\n\\nSaving results...\")\r\n\u001b[?2004l\r"]
[63.478014, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[63.478028, "o", "\u001b[?2004h"]
[63.478053, "o", "> "]
