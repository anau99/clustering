[200.172231, "o", "symptom_weights = {"]
[200.172316, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.172377, "o", "> "]
[200.17302, "o", "    'polyuria': 3, 'polydipsia': 3, 'sudden_weight_loss': 2,\r\n"]
[200.173054, "o", "\u001b[?2004l\r\u001b[?2004h"]
[200.173501, "o", "> "]
[200.173744, "o", "    'partial_paresis': 2, 'irritability': 2, 'polyphagia': 1,\r\n\u001b[?2004l\r"]
[200.173797, "o", "\u001b[?2004h"]
[200.174346, "o", ">     'gender': 1, 'weakness': 1, 'genital_thrush': 1,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.174847, "o", "    'visual_blurring': 1, 'itching': -1, 'delayed_healing': -1,\r\n\u001b[?2004l\r"]
[200.174988, "o", "\u001b[?2004h> "]
[200.175511, "o", "    'muscle_stiffness': 0, 'alopecia': -1, 'obesity': 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.175649, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.175948, "o", "scores = np.zeros(len(df_d))\r\n\u001b[?2004l\r"]
[200.175995, "o", "\u001b[?2004h"]
[200.176045, "o", "> "]
[200.176487, "o", "for feat, w in symptom_weights.items():\r\n"]
[200.176514, "o", "\u001b[?2004l\r\u001b[?2004h"]
[200.176582, "o", "> "]
[200.176979, "o", "    scores += df_d[feat].values * w\r\n"]
[200.177006, "o", "\u001b[?2004l\r\u001b[?2004h"]
[200.177087, "o", "> "]
[200.177436, "o", "# Try different thresholds\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.177467, "o", "> "]
[200.177771, "o", "for thresh in [3, 4, 5, 6]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.178256, "o", "    labels_t = (scores >= thresh).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.178869, "o", "    print(f\"B (weighted sum >= {thresh}): {np.bincount(labels_t)}\")\r\n\u001b[?2004l\r"]
[200.179028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.179417, "o", "# Approach C: GMM on key features only\r\n\u001b[?2004l\r"]
[200.179461, "o", "\u001b[?2004h> "]
[200.180317, "o", "key_feats = ['polyuria', 'polydipsia', 'sudden_weight_loss', 'partial_paresis', 'irritability']\r\n\u001b[?2004l\r"]
[200.181066, "o", "\u001b[?2004h> X_key = df_d[key_feats].values\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.181188, "o", "> labels_C = GaussianMixture(n_components=2, random_state=42).fit_predict(X_key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.181504, "o", "print(f\"C (GMM key features): {np.bincount(labels_C)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.181525, "o", "\r\n\u001b[?2004l\re"]
[200.181542, "o", "\u001b[?2004h"]
[200.181742, "o", "> "]
[200.182083, "o", "# Approach D: KMeans on symptom sum + key features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.1824, "o", "df_d['symptom_sum'] = df_d.drop(columns=['age', 'gender']).sum(axis=1)\r\n\u001b[?2004l\r"]
[200.182636, "o", "\u001b[?2004h> "]
[200.185182, "o", "X_D = StandardScaler().fit_transform(df_d[['symptom_sum', 'polyuria', 'polydipsia', 'sudden_weight_loss', 'partial_paresis']].values)\r\n\u001b[?2004l\r\u001b[?2004h> labels_D = KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_D)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"D (KMeans symptom_sum+key): {np.bincount(labels_D)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # For the early-stage diabetes dataset, expected split is ~320 positive, ~200 negative\r\n\u001b[?2004l\r\u001b[?2004h> # labels_A gives [222, 298] which is closest\r\n\u001b[?2004l\r\u001b[?2004h> # Let's use labels_A\r\n\u001b[?2004l\r\u001b[?2004h> diabetes_labels = labels_A\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.185667, "o", "print(f\"\\nSelected diabetes labels: {np.bincount(diabetes_labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.185931, "o", "# ============ HEART DATASET ============\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.186174, "o", "print(\"\\nHEART DATASET\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.186352, "o", "> "]
[200.186476, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r"]
[200.186589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[200.186983, "o", "# For heart disease, the key predictive features are:\r\n\u001b[?2004l\r"]
[200.187232, "o", "\u001b[?2004h> "]
[200.1875, "o", "# cp (chest pain type): 0=typical angina, 1=atypical, 2=non-anginal, 3=asymptomatic\r\n\u001b[?2004l\r"]
[200.187633, "o", "\u001b[?2004h> "]
[200.18786, "o", "# thalach (max heart rate): lower -> more disease\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.187887, "o", "> "]
[200.188204, "o", "# oldpeak (ST depression): higher -> more disease\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.18843, "o", "> "]
[200.188612, "o", "# ca (number of major vessels): higher -> more disease  \r\n\u001b[?2004l\r"]
[200.188656, "o", "\u001b[?2004h"]
[200.188914, "o", "> "]
[200.189164, "o", "# thal: 3=normal, 6=fixed defect, 7=reversible defect (but coded 0,1,2,3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.189369, "o", "# exang (exercise induced angina): 1 -> more disease\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.189633, "o", "# slope: 0=upsloping, 1=flat, 2=downsloping\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.189833, "o", "# Let me check the actual coding\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.190072, "o", "print(f\"cp values: {sorted(df_heart['cp'].unique())}\")\r\n\u001b[?2004l\r"]
[200.190275, "o", "\u001b[?2004h> "]
[200.190651, "o", "print(f\"thal values: {sorted(df_heart['thal'].unique())}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.190872, "o", "> print(f\"ca values: {sorted(df_heart['ca'].unique())}\")\r\n\u001b[?2004l\r"]
[200.191025, "o", "\u001b[?2004h> "]
[200.191359, "o", "print(f\"slope values: {sorted(df_heart['slope'].unique())}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.191518, "o", "print(f\"restecg values: {sorted(df_heart['restecg'].unique())}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[200.191633, "o", "\u001b[?2004h> "]
[200.191834, "o", "# Multiple approaches for heart\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.19186, "o", "results_h = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.192056, "o", "# Approach 1: Key features, KMeans\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.192078, "o", "> "]
[200.192426, "o", "key_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']\r\n\u001b[?2004l\r\u001b[?2004h"]
[200.192456, "o", "> "]
[200.192972, "o", "X1 = StandardScaler().fit_transform(df_heart[key_h].values)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.193128, "o", "l1 = KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.193365, "o", "print(f\"H1 (KMeans key+slope): {np.bincount(l1)}\")"]
[200.193485, "o", "\r\n\u001b[?2004l\r"]
[200.193532, "o", "\u001b[?2004h> "]
[200.19363, "o", "results_h.append(('H1', l1))\r\n\u001b[?2004l\r"]
[200.193783, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.193969, "o", "# Approach 2: Key features, GMM\r\n\u001b[?2004l\r"]
[200.194, "o", "\u001b[?2004h> "]
[200.194286, "o", "l2 = GaussianMixture(n_components=2, random_state=42).fit_predict(X1)\r\n"]
[200.19432, "o", "\u001b[?2004l\r\u001b[?2004h"]
[200.194422, "o", "> "]
[200.194551, "o", "print(f\"H2 (GMM key+slope): {np.bincount(l2)}\")\r\n\u001b[?2004l\r"]
[200.194583, "o", "\u001b[?2004h"]
[200.19461, "o", "> "]
[200.194732, "o", "results_h.append(('H2', l2))\r\n\u001b[?2004l\r"]
[200.19476, "o", "\u001b[?2004h"]
[200.194786, "o", "> \r\n\u001b[?2004l\r"]
[200.194861, "o", "\u001b[?2004h> "]
[200.195129, "o", "# Approach 3: All features standardized, KMeans\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.195362, "o", "X3 = StandardScaler().fit_transform(df_heart.values)\r\n\u001b[?2004l\r"]
[200.195415, "o", "\u001b[?2004h"]
[200.195444, "o", "> "]
[200.195749, "o", "l3 = KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X3)\r\n"]
[200.195781, "o", "\u001b[?2004l\r"]
[200.195797, "o", "\u001b[?2004h"]
[200.195837, "o", "> "]
[200.196069, "o", "print(f\"H3 (KMeans all scaled): {np.bincount(l3)}\")\r\n"]
[200.196112, "o", "\u001b[?2004l\r"]
[200.196129, "o", "\u001b[?2004h"]
[200.196393, "o", "> results_h.append(('H3', l3))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[200.196485, "o", "\u001b[?2004h"]
[200.196557, "o", "> "]
[200.19681, "o", "# Approach 4: Key features with heavier weights on most important\r\n"]
[200.196831, "o", "\u001b[?2004l\r"]
[200.196877, "o", "\u001b[?2004h"]
[200.196909, "o", "> "]
[200.197421, "o", "df_hw = df_heart[['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope', 'age', 'sex']].copy().astype(float)\r\n"]
[200.197454, "o", "\u001b[?2004l\r"]
[200.19749, "o", "\u001b[?2004h"]
[200.197523, "o", "> "]
[200.197705, "o", "df_hw['cp'] *= 2\r\n"]
[200.197736, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[200.197798, "o", "df_hw['ca'] *= 3\r\n"]
[200.197816, "o", "\u001b[?2004l\r"]
[200.197948, "o", "\u001b[?2004h"]
[200.197974, "o", "> "]
[200.197991, "o", "df_hw['thal'] *= 2"]
[200.198008, "o", "\r\n\u001b[?2004l\r"]
[200.198061, "o", "\u001b[?2004h"]
[200.198089, "o", "> "]
[200.198215, "o", "df_hw['oldpeak'] *= 2\r\n"]
[200.198232, "o", "\u001b[?2004l\r"]
[200.198278, "o", "\u001b[?2004h"]
[200.198307, "o", "> "]
[200.198414, "o", "df_hw['exang'] *= 2\r\n"]
[200.198431, "o", "\u001b[?2004l\r"]
[200.19848, "o", "\u001b[?2004h"]
[200.198512, "o", "> "]
[200.198752, "o", "X4 = StandardScaler().fit_transform(df_hw.values)\r\n"]
[200.19909, "o", "\u001b[?2004l\r"]
[200.199126, "o", "\u001b[?2004h> "]
[200.199157, "o", "l4 = KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X4)"]
[200.199175, "o", "\r\n\u001b[?2004l\r"]
[200.199326, "o", "\u001b[?2004h> "]
[200.199502, "o", "print(f\"H4 (KMeans weighted key): {np.bincount(l4)}\")\r\n"]
[200.199523, "o", "\u001b[?2004l\r"]
[200.19957, "o", "\u001b[?2004h"]
[200.19961, "o", "> "]
[200.199762, "o", "results_h.append(('H4', l4))\r\n"]
[200.199787, "o", "\u001b[?2004l\r"]
[200.19983, "o", "\u001b[?2004h"]
[200.199864, "o", "> "]
[200.19988, "o", "\r\n\u001b[?2004l\r"]
[200.199932, "o", "\u001b[?2004h"]
[200.199964, "o", "> "]
[200.200303, "o", "l4g = GaussianMixture(n_components=2, random_state=42).fit_predict(X4)\r\n"]
[200.20033, "o", "\u001b[?2004l\r"]
[200.200364, "o", "\u001b[?2004h"]
[200.200396, "o", "> "]
[200.200645, "o", "print(f\"H4g (GMM weighted key): {np.bincount(l4g)}\")\r\n"]
[200.200665, "o", "\u001b[?2004l\r"]
[200.200716, "o", "\u001b[?2004h"]
[200.200747, "o", "> "]
[200.200902, "o", "results_h.append(('H4g', l4g))\r\n"]
[200.200922, "o", "\u001b[?2004l\r"]
[200.200969, "o", "\u001b[?2004h"]
[200.200999, "o", "> "]
[200.201016, "o", "\r\n"]
[200.201032, "o", "\u001b[?2004l\r"]
[200.20108, "o", "\u001b[?2004h"]
[200.201115, "o", "> "]
[200.20147, "o", "l4a = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X4)\r\n"]
[200.201504, "o", "\u001b[?2004l\r"]
[200.201522, "o", "\u001b[?2004h"]
[200.201557, "o", "> "]
[200.201817, "o", "print(f\"H4a (Agglo weighted key): {np.bincount(l4a)}\")\r\n"]
[200.201847, "o", "\u001b[?2004l\r"]
[200.201887, "o", "\u001b[?2004h"]
[200.201917, "o", "> "]
[200.202182, "o", "results_h.append(('H4a', l4a))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[200.202259, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[200.20243, "o", "# Approach 5: Rule-based for heart\r\n"]
[200.202456, "o", "\u001b[?2004l\r"]
[200.202492, "o", "\u001b[?2004h"]
[200.202589, "o", "> "]
[200.202993, "o", "# High risk: cp=0 (asymptomatic in some codings) or cp=2/3, high oldpeak, low thalach, ca>0, thal!=normal\r\n"]
[200.203022, "o", "\u001b[?2004l\r"]
[200.20313, "o", "\u001b[?2004h> "]
[200.203406, "o", "# Actually in this dataset, higher cp value might mean asymptomatic\r\n"]
[200.203436, "o", "\u001b[?2004l\r"]
[200.203473, "o", "\u001b[?2004h"]
[200.203505, "o", "> "]
[200.203683, "o", "# Let's try a score-based approach\r\n"]
[200.203703, "o", "\u001b[?2004l\r"]
[200.203755, "o", "\u001b[?2004h"]
[200.203786, "o", "> "]
[200.203966, "o", "heart_score = np.zeros(len(df_heart))\r\n"]
[200.203985, "o", "\u001b[?2004l\r"]
[200.204032, "o", "\u001b[?2004h"]
[200.204065, "o", "> "]
[200.204567, "o", "heart_score += (df_heart['cp'] == 0).astype(int) * 2  # asymptomatic chest pain is worst\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.204815, "o", "heart_score += (df_heart['exang'] == 1).astype(int) * 2\r\n"]
[200.204845, "o", "\u001b[?2004l\r"]
[200.204933, "o", "\u001b[?2004h> "]
[200.205103, "o", "heart_score += df_heart['oldpeak'] * 1.5\r\n"]
[200.205132, "o", "\u001b[?2004l\r"]
[200.205236, "o", "\u001b[?2004h"]
[200.205293, "o", "> "]
[200.205387, "o", "heart_score += df_heart['ca'] * 2\r\n"]
[200.205412, "o", "\u001b[?2004l\r"]
[200.205511, "o", "\u001b[?2004h> "]
[200.205902, "o", "heart_score += (df_heart['thal'] == 3).astype(int) * 1  # check which thal value means disease\r\n"]
[200.205933, "o", "\u001b[?2004l\r"]
[200.205968, "o", "\u001b[?2004h"]
[200.205999, "o", "> "]
[200.206265, "o", "heart_score += (df_heart['thal'] == 2).astype(int) * 2\r\n"]
[200.206296, "o", "\u001b[?2004l\r"]
[200.206397, "o", "\u001b[?2004h> "]
[200.20668, "o", "heart_score += (df_heart['slope'] == 0).astype(int) * 1  # downsloping\r\n"]
[200.20671, "o", "\u001b[?2004l\r"]
[200.206748, "o", "\u001b[?2004h"]
[200.206778, "o", "> "]
[200.207126, "o", "heart_score -= df_heart['thalach'] / 50  # lower heart rate -> more disease\r\n"]
[200.207165, "o", "\u001b[?2004l\r"]
[200.207204, "o", "\u001b[?2004h"]
[200.207232, "o", "> "]
[200.20725, "o", "\r\n"]
[200.207267, "o", "\u001b[?2004l\r"]
[200.207316, "o", "\u001b[?2004h"]
[200.207346, "o", "> "]
[200.207653, "o", "for thresh in [3, 4, 5, 6, 7]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[200.207848, "o", "    l_rule = (heart_score >= thresh).astype(int)\r\n\u001b[?2004l\r"]
[200.207879, "o", "\u001b[?2004h"]
[200.207966, "o", "> "]
[200.208237, "o", "    print(f\"H_rule (score >= {thresh}): {np.bincount(l_rule)}\")\r\n"]
[200.208261, "o", "\u001b[?2004l\r\u001b[?2004h"]
[200.208278, "o", "> "]
[200.208521, "o", "    results_h.append((f'H_rule_{thresh}', l_rule))\r\n"]
[200.208543, "o", "\u001b[?2004l\r"]
[200.21019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 6: Spectral on key features\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     l6 = SpectralClustering(n_clusters=2, affinity='rbf', random_state=42).fit_predict(X1)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"H6 (Spectral RBF key): {np.bincount(l6)}\")\r\n\u001b[?2004l\r\u001b[?2004h>     results_h.append(('H6', l6))\r\n\u001b[?2004l\r\u001b[?2004h> except:\r\n\u001b[?2004l\r"]
[200.210234, "o", "\u001b[?2004h"]
[200.210371, "o", "> "]
[200.210406, "o", "    pass\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[200.210439, "o", "\u001b[?2004h"]
[200.210471, "o", "> "]
[200.210681, "o", "# Approach 7: Agglomerative on all features\r\n"]
[200.210712, "o", "\u001b[?2004l\r"]
[200.212209, "o", "\u001b[?2004h> X7 = StandardScaler().fit_transform(df_heart.values)\r\n\u001b[?2004l\r\u001b[?2004h> l7 = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X7)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"H7 (Agglo all): {np.bincount(l7)}\")\r\n\u001b[?2004l\r\u001b[?2004h> results_h.append(('H7', l7))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # For the heart dataset, the expected split is roughly 500/525\r\n\u001b[?2004l\r\u001b[?2004h> "]
