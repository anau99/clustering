[131.251941, "i", "cat > /app/solve2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, SpectralClustering, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.decomposition import PCA\nfrom sklearn.metrics import silhouette_score\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ============ DIABETES DATASET ============\nprint(\"=\"*60)\nprint(\"DIABETES DATASET\")\nprint(\"=\"*60)\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\n\n# The diabetes dataset is about early-stage diabetes prediction\n# Key features: polyuria, polydipsia are the strongest predictors\n# Ground truth is likely Positive/Negative diabetes\n\ndf_d = df_diabetes.copy()\ndf_d['gender'] = df_d['gender'].map({'Male': 1, 'Female': 0})\n\n# Approach: Weight important features more heavily\n# polyuria and polydipsia are the most discriminative for diabetes\nimportant_features = ['polyuria', 'polydipsia', 'sudden_weight_loss', \n                    "]
[131.252188, "i", " 'partial_paresis', 'irritability', 'polyphagia']\nless_important = ['gender', 'weakness', 'genital_thrush', 'visual_blurring', \n                  'itching', 'delayed_healing', 'muscle_stiffness', 'alopecia', 'obesity']\n\nbest_silhouette_d = -1\nbest_labels_d = None\nbest_method_d = \"\"\n\nresults_d = {}\n\n# Method 1: Use only key features\nX_key = df_d[important_features].values\nfor name, labels in [\n    ('kmeans_key', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_key)),\n    ('gmm_key', GaussianMixture(n_components=2, random_state=42).fit_predict(X_key)),\n]:\n    sil = silhouette_score(X_key, labels)\n    results_d[name] = (labels, sil)\n    print(f\"{name}: silhouette={sil:.4f}, dist={np.bincount(labels)}\")\n\n# Method 2: All features scaled, different algorithms\nscaler = StandardScaler()\nX_all_scaled = scaler.fit_transform(df_d.values)\n\nfor name, labels in [\n    ('kmeans_all', KMeans(n_clusters=2, random_state=42, n_init=10).fit_predict(X_all_scaled)),\n    ('gmm_all', GaussianMixture(n_components=2, rand"]
