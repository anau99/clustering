[17.792867, "o", "from sklearn.cluster import AgglomerativeClustering\r\n\r\n\r\ndef agglomerative(X, k):\r\n    model = AgglomerativeClustering(\r\n        n_clusters=k,\r\n        linkage=\"ward\"\r\n    )\r\n    return model.fit_predict(X)"]
