[17.175109, "o", "cat /app/src/cluster/kmean.py\r\n\u001b[?2004l\r"]
[17.176384, "o", "from sklearn.cluster import KMeans\r\n\r\n\r\ndef kmeans(X, k):\r\n    model = KMeans(\r\n        n_clusters=k,\r\n        init=\"k-means++\",\r\n        n_init=\"auto\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[17.176809, "o", "\u001b[?2004hroot@6156096e0877:/app# "]
[17.319331, "i", "cat /app/src/cluster/gaussian_mixture.py\n"]
[17.319816, "o", "cat /app/src/cluster/gaussian_mixture.py\r\n"]
[17.319989, "o", "\u001b[?2004l\r"]
[17.321826, "o", "from sklearn.mixture import GaussianMixture\r\n\r\n\r\ndef gaussian_mixture(X, k):\r\n    model = GaussianMixture(\r\n        n_components=k,\r\n        covariance_type=\"full\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[17.322387, "o", "\u001b[?2004hroot@6156096e0877:/app# "]
[17.439834, "i", "cat /app/src/transform/OnehotEncoder.py\n"]
[17.440052, "o", "cat /app/src/transform/OnehotEncoder.py"]
[17.440086, "o", "\r\n\u001b[?2004l\r"]
[17.441866, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\ndef one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n    result = df.copy()\r\n"]
[17.442431, "o", "    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, encoded_df], axis=1)\r\n\r\n    return result"]
[17.442893, "o", "\u001b[?2004hroot@6156096e0877:/app# "]
[17.55768, "i", "cat /app/src/transform/StandardScaler.py\n"]
