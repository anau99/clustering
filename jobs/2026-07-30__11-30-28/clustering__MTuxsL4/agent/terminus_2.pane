[?2004l[?2004h> 
[?2004l[?2004h> # GMM on all
[?2004l[?2004h> l = GaussianMixture(n_components=2, random_state=42, n_init=5).fit_predict(X_h_all_scaled)
[?2004l[?2004h> results['gmm_all'] = l
[?2004l[?2004h> print(f"gmm_all: {np.bincount(l)}, sil={silhouette_score(X_h_all_scaled, l):.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Agglo on key
[?2004l[?2004h> l = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h_key_scaled)
[?2004l[?2004h> results['agglo_key'] = l
[?2004l[?2004h> print(f"agglo_key: {np.bincount(l)}, sil={silhouette_score(X_h_key_scaled, l):.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Agglo on all
[?2004l[?2004h> l = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h_all_scaled)
[?2004l[?2004h> results['agglo_all'] = l
[?2004l[?2004h> print(f"agglo_all: {np.bincount(l)}, sil={silhouette_score(X_h_all_scaled, l):.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Try with different random seeds for KMeans
[?2004l[?2004h> for seed in [0, 1, 2, 3, 5, 10, 100]:
[?2004l[?2004h>     l = KMeans(n_clusters=2, random_state=seed, n_init=20).fit_predict(X_h_key_scaled)
[?2004l[?2004h>     sil = silhouette_score(X_h_key_scaled, l)
[?2004l[?2004h>     results[f'km_key_s{seed}'] = l
[?2004l[?2004h>     print(f"km_key_s{seed}: {np.bincount(l)}, sil={sil:.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Consensus/ensemble: majority vote of multiple methods
[?2004l[?2004h> # Align labels first (use correlation with km_key as reference)
