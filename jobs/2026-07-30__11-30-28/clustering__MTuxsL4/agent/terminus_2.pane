[?2004l[?2004h> 
[?2004l[?2004h> all_labels = np.array(all_labels)
[?2004l[?2004h> consensus = (all_labels.mean(axis=0) >= 0.5).astype(int)
[?2004l[?2004h> print(f"\nConsensus: {np.bincount(consensus)}, sil={silhouette_score(X_h_key_scaled, consensus):.4f}")
[?2004l[?2004h> 
[?2004l[?2004h> # Pick the best: use km_key which has high silhouette and reasonable split
