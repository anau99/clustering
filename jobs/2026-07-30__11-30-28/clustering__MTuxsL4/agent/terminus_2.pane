[?2004l[?2004h> 
[?2004l[?2004h> # The most reliable approach: use the key diagnostic features
[?2004l[?2004h> # cp, thalach, oldpeak, ca, thal, exang are the primary predictors
[?2004l[?2004h> 
[?2004l[?2004h> key_feats_h = ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']
[?2004l[?2004h> X_h_key = df_heart[key_feats_h].values.astype(float)
[?2004l[?2004h> X_h_key_scaled = StandardScaler().fit_transform(X_h_key)
[?2004l[?2004h> 
[?2004l[?2004h> # All features
[?2004l[?2004h> X_h_all = df_heart.values.astype(float)
