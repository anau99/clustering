[?2004l======= HEART DATASET ============
print("\nProcessing heart.csv...")
df_heart = pd.read_csv('/app/heart.csv')

# Drop age (not in the specified feature list for heart)
df_h = df_heart.drop(columns=['age'])

# Standardize all features, weight important ones
scaler_h = StandardScaler()
X_h_scaled = pd.DataFrame(scaler_h.fit_transform(df_h), columns=df_h.columns)

# Weight important features for heart disease
X_h_w = X_h_scaled.copy()
X_h_w['cp'] = X_h_w['cp'] * 2.5
X_h_w['thalach'] = X_h_w['thalach'] * 2
X_h_w['oldpeak'] = X_h_w['oldpeak'] * 2
X_h_w['ca'] = X_h_w['ca'] * 2.5
X_h_w['thal'] = X_h_w['thal'] * 2.5
X_h_w['exang'] = X_h_w['exang'] * 2
X_h_w['slope'] = X_h_w['slope'] * 1.5

# GMM gives the most balanced split (497/528) closest to expected 50/50
labels_heart = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_h_w.values)
print(f"Heart GMM ordinal weighted: {np.bincount(labels_heart)}")

# Save heart
heart_output = pd.DataFrame({'pseudo_label': labels_heart})
heart_output.to_csv('/app/output_heart.csv', index=False)
print("Saved heart output")

print("\nDone!")
print("\nVerification:")
print(f"Diabetes output shape: {diab_output.shape}")
print(f"Heart output shape: {heart_output.shape}")
print(f"Diabetes unique labels: {diab_output['pseudo_label'].unique()}")
print(f"Heart unique labels: {heart_output['pseudo_label'].unique()}")
EOF
