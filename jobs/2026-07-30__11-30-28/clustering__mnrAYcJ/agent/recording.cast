[19.009737, "o", "cat /app/src/cluster/kmean.py\r\n\u001b[?2004l\r"]
[19.015334, "o", "from sklearn.cluster import KMeans"]
[19.016241, "o", "\r\n\r\n\r\ndef kmeans(X, k):\r\n    model = KMeans(\r\n        n_clusters=k,\r\n        init=\"k-means++\",\r\n        n_init=\"auto\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)\u001b[?2004h"]
[19.018234, "o", "root@25a96eac46b4:/app# "]
[19.22473, "i", "cat /app/src/transform/OnehotEncoder.py\n"]
[19.225127, "o", "cat /app/src/transform/OnehotEncoder.py"]
[19.229238, "o", "\r\n\u001b[?2004l\r"]
[19.237317, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\ndef one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n    result = df.copy()\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, encoded_df], axis=1)\r\n\r\n    return result"]
[19.237667, "o", "\u001b[?2004hroot@25a96eac46b4:/app# "]
[19.439598, "i", "cat /app/src/transform/StandardScaler.py\n"]
[19.439684, "o", "cat /app/src/transform/StandardScaler.py"]
[19.443195, "o", "\r\n"]
[19.444505, "o", "\u001b[?2004l\r"]
[19.447319, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\ndef standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:"]
[19.447891, "o", "\r\n        return result\r\n\r\n    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
[19.448656, "o", "\u001b[?2004hroot@25a96eac46b4:/app# "]
[19.615171, "i", "cat /app/src/cluster/gaussian_mixture.py\n"]
[19.616635, "o", "cat /app/src/cluster/gaussian_mixture.py\r\n\u001b[?2004l\r"]
[19.616891, "o", "from sklearn.mixture import GaussianMixture\r\n\r\n\r\ndef gaussian_mixture(X, k):\r\n    model = GaussianMixture(\r\n        n_components=k,\r\n        covariance_type=\"full\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[19.617197, "o", "\u001b[?2004h"]
[19.617456, "o", "root@25a96eac46b4:/app# "]
