[185.2884, "o", "\u001b[?2004h> "]
[185.288645, "o", "# ============ HEART DATASET ============\r\n\u001b[?2004l\r"]
[185.288669, "o", "\u001b[?2004h"]
[185.288871, "o", "> "]
[185.288992, "o", "print(\"\\nProcessing heart.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.289166, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r"]
[185.289279, "o", "\u001b[?2004h"]
[185.289329, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.289527, "o", "# For heart disease, key features are:\r\n\u001b[?2004l\r"]
[185.289626, "o", "\u001b[?2004h> "]
[185.290048, "o", "# cp (chest pain type) - 0=typical angina(bad), 1=atypical, 2=non-anginal, 3=asymptomatic(bad)\r\n\u001b[?2004l\r"]
[185.290073, "o", "\u001b[?2004h> "]
[185.290376, "o", "# thalach (max heart rate) - lower = more disease\r\n\u001b[?2004l\r"]
[185.290404, "o", "\u001b[?2004h> "]
[185.290748, "o", "# oldpeak (ST depression) - higher = more disease\r\n\u001b[?2004l\r'/ap\u001b[?2004h> "]
[185.292296, "o", "# ca (num vessels colored) - higher = more disease\r\n\u001b[?2004l\r\u001b[?2004h> # thal - 3=normal, 6=fixed defect(bad), 7=reversible defect(bad) - but encoded as 0,1,2,3\r\n\u001b[?2004l\r\u001b[?2004h> # exang (exercise induced angina) - 1 = more disease\r\n\u001b[?2004l\r\u001b[?2004h> # slope - 0=upsloping(good), 1=flat(bad), 2=downsloping(bad) -- depends on encoding\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Strategy: Standardize all features, weight important ones\r\n\u001b[?2004l\r\u001b[?2004h> df_h = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.292521, "o", "# Drop age since task says only 4 numerical + 8 categorical\r\n\u001b[?2004l\r\u001b[?2004h> if 'age' in df_h.columns:\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.292641, "o", "> "]
[185.293291, "o", "    df_h_noage = df_h.drop(columns=['age'])\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     df_h_noage = df_h.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 1: Standardize all, weight important features\r\n\u001b[?2004l\r\u001b[?2004h> scaler_h = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.293321, "o", "> "]
[185.29363, "o", "X_h_scaled = pd.DataFrame(scaler_h.fit_transform(df_h_noage), columns=df_h_noage.columns)\r\n\u001b[?2004l\r"]
[185.293773, "o", "\u001b[?2004h"]
[185.293795, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[185.293829, "o", "> "]
[185.293939, "o", "# Weight important features\r\n\u001b[?2004l\r\u001b[?2004h"]
[185.293959, "o", "> "]
[185.294025, "o", "X_h_w = X_h_scaled.copy()\r\n\u001b[?2004l\r"]
[185.294248, "o", "\u001b[?2004h> X_h_w['cp'] = X_h_w['cp'] * 2.5\r\n\u001b[?2004l\r"]
[185.294276, "o", "\u001b[?2004h"]
[185.295314, "o", "> X_h_w['thalach'] = X_h_w['thalach'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> X_h_w['oldpeak'] = X_h_w['oldpeak'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> X_h_w['ca'] = X_h_w['ca'] * 2.5\r\n\u001b[?2004l\r\u001b[?2004h> X_h_w['thal'] = X_h_w['thal'] * 2.5\r\n\u001b[?2004l\r\u001b[?2004h> X_h_w['exang'] = X_h_w['exang'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> X_h_w['slope'] = X_h_w['slope'] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.295671, "o", "labels_h_km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_h_w.values)\r\n\u001b[?2004l\r"]
[185.295698, "o", "\u001b[?2004h"]
[185.295938, "o", "> "]
[185.295995, "o", "print(f\"KMeans ordinal weighted: {np.bincount(labels_h_km)}\")\r\n\u001b[?2004l\r"]
[185.296068, "o", "\u001b[?2004h"]
[185.296169, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.296562, "o", "labels_h_gmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_h_w.values)\r\n\u001b[?2004l\r"]
[185.296594, "o", "\u001b[?2004h"]
[185.296609, "o", "> "]
[185.296846, "o", "print(f\"GMM ordinal weighted: {np.bincount(labels_h_gmm)}\")\r\n\u001b[?2004l\r"]
[185.296874, "o", "\u001b[?2004h"]
[185.296892, "o", "> \r\n\u001b[?2004l\r"]
[185.296984, "o", "\u001b[?2004h> "]
[185.297276, "o", "labels_h_agglo = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h_w.values)\r\n\u001b[?2004l\r"]
[185.297347, "o", "\u001b[?2004h> "]
[185.297557, "o", "print(f\"Agglo ordinal weighted: {np.bincount(labels_h_agglo)}\")\r\n\u001b[?2004l\r"]
[185.297585, "o", "\u001b[?2004h"]
[185.297601, "o", "> \r\n"]
[185.297619, "o", "\u001b[?2004l\r"]
[185.297725, "o", "\u001b[?2004h> "]
[185.297973, "o", "# Approach 2: One-hot encode categorical, standardize numerical, weight\r\n\u001b[?2004l\r"]
[185.298067, "o", "\u001b[?2004h> "]
[185.298225, "o", "numerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r"]
[185.298249, "o", "\u001b[?2004h"]
[185.298274, "o", "> "]
[185.29859, "o", "categorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r"]
[185.298661, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.298681, "o", "\u001b[?2004h"]
[185.298697, "o", "> "]
[185.299016, "o", "cat_df = pd.get_dummies(df_h_noage[categorical_cols].astype(str), drop_first=False)\r\n\u001b[?2004l\r"]
[185.299039, "o", "\u001b[?2004h"]
[185.299053, "o", "> "]
[185.299219, "o", "num_df = df_h_noage[numerical_cols].copy()\r\n\u001b[?2004l\r"]
[185.299307, "o", "\u001b[?2004h> "]
[185.299441, "o", "scaler2 = StandardScaler()\r\n\u001b[?2004l\r"]
[185.299521, "o", "\u001b[?2004h> "]
[185.299733, "o", "num_df = pd.DataFrame(scaler2.fit_transform(num_df), columns=numerical_cols)\r\n\u001b[?2004l\r"]
[185.299759, "o", "\u001b[?2004h"]
[185.299774, "o", "> "]
[185.300046, "o", "X_h_oh = pd.concat([num_df, cat_df.reset_index(drop=True)], axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.300069, "o", "\u001b[?2004h"]
[185.300084, "o", "> "]
[185.300305, "o", "# Weight\r\n\u001b[?2004l\r\u001b[?2004h> for col in X_h_oh.columns:\r\n"]
[185.300436, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[185.300461, "o", "    if col.startswith('cp_'):"]
[185.300476, "o", "\r\n\u001b[?2004l\r"]
[185.300561, "o", "\u001b[?2004h> "]
[185.300655, "o", "        X_h_oh[col] = X_h_oh[col] * 2\r\n\u001b[?2004l\r"]
[185.300768, "o", "\u001b[?2004h> "]
[185.300987, "o", "    elif col.startswith('ca_'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.301072, "o", "        X_h_oh[col] = X_h_oh[col] * 2\r\n\u001b[?2004l\r"]
[185.301141, "o", "\u001b[?2004h> "]
[185.301232, "o", "    elif col.startswith('thal_'):\r\n\u001b[?2004l\r"]
[185.301351, "o", "\u001b[?2004h> "]
[185.301454, "o", "        X_h_oh[col] = X_h_oh[col] * 2\r\n\u001b[?2004l\r"]
[185.301542, "o", "\u001b[?2004h> "]
[185.301609, "o", "    elif col == 'thalach':\r\n\u001b[?2004l\r"]
[185.301687, "o", "\u001b[?2004h"]
[185.301713, "o", "> "]
[185.301799, "o", "        X_h_oh[col] = X_h_oh[col] * 2\r\n\u001b[?2004l\r"]
[185.301967, "o", "\u001b[?2004h> "]
[185.302052, "o", "    elif col == 'oldpeak':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.302189, "o", "        X_h_oh[col] = X_h_oh[col] * 2\r\n\u001b[?2004l\r"]
[185.302283, "o", "\u001b[?2004h> "]
[185.302385, "o", "    elif col.startswith('exang_'):\r\n\u001b[?2004l\r"]
[185.302475, "o", "\u001b[?2004h> "]
[185.302607, "o", "        X_h_oh[col] = X_h_oh[col] * 1.5\r\n\u001b[?2004l\r"]
[185.302698, "o", "\u001b[?2004h> "]
[185.302814, "o", "    elif col.startswith('slope_'):\r\n\u001b[?2004l\r"]
[185.303014, "o", "\u001b[?2004h> "]
[185.303184, "o", "        X_h_oh[col] = X_h_oh[col] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.303215, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.30364, "o", "labels_h_oh_km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_h_oh.values)\r\n\u001b[?2004l\r"]
[185.303752, "o", "\u001b[?2004h> "]
[185.303984, "o", "print(f\"KMeans onehot weighted: {np.bincount(labels_h_oh_km)}\")\r\n\u001b[?2004l\r"]
[185.304084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.304463, "o", "labels_h_oh_agglo = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h_oh.values)\r\n\u001b[?2004l\r"]
[185.304496, "o", "\u001b[?2004h"]
[185.304513, "o", "> "]
[185.304749, "o", "print(f\"Agglo onehot weighted: {np.bincount(labels_h_oh_agglo)}\")\r\n\u001b[?2004l\r"]
[185.304814, "o", "\u001b[?2004h"]
[185.304838, "o", "> \r\n\u001b[?2004l\r"]
[185.304908, "o", "\u001b[?2004h> "]
[185.305305, "o", "labels_h_oh_gmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_h_oh.values)\r\n\u001b[?2004l\r"]
[185.305565, "o", "\u001b[?2004h> "]
[185.305654, "o", "print(f\"GMM onehot weighted: {np.bincount(labels_h_oh_gmm)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.306041, "o", "\u001b[?2004h> # Approach 3: Simple risk score for heart\r\n\u001b[?2004l\r"]
[185.306087, "o", "\u001b[?2004h> "]
[185.306431, "o", "# Higher risk: cp=0 (typical angina=bad in some encodings), exang=1, high oldpeak, low thalach, high ca, thal=3\r\n\u001b[?2004l\r"]
[185.306452, "o", "\u001b[?2004h"]
[185.30647, "o", "> "]
[185.306767, "o", "# Actually the encoding might be: cp=0 is asymptomatic (worst)\r\n\u001b[?2004l\r"]
[185.30688, "o", "\u001b[?2004h> "]
[185.307027, "o", "heart_risk = (df_heart['exang'].values * 2 + \r\n\u001b[?2004l\r"]
[185.307086, "o", "\u001b[?2004h> "]
[185.307392, "o", "              (df_heart['oldpeak'].values > 1).astype(int) * 2 + \r\n\u001b[?2004l\r"]
[185.307477, "o", "\u001b[?2004h"]
[185.307953, "o", ">               (df_heart['ca'].values >= 1).astype(int) * 2 +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.308112, "o", "              (df_heart['thal'].values == 3).astype(int) * 2 +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.309322, "o", "              (df_heart['cp'].values == 0).astype(int) * 2 +\r\n\u001b[?2004l\r\u001b[?2004h>               (df_heart['slope'].values == 0).astype(int) +\r\n\u001b[?2004l\r\u001b[?2004h>               (df_heart['thalach'].values < 140).astype(int))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> threshold_h = 5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.309465, "o", "labels_h_rule = (heart_risk >= threshold_h).astype(int)\r\n\u001b[?2004l\r"]
[185.309538, "o", "\u001b[?2004h> "]
[185.30995, "o", "print(f\"Rule-based heart (threshold={threshold_h}): {np.bincount(labels_h_rule)}\")\r\n\u001b[?2004l\r"]
[185.310032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.310471, "o", "# The heart disease dataset typically has roughly 50/50 split\r\n\u001b[?2004l\r"]
[185.310622, "o", "\u001b[?2004h> "]
