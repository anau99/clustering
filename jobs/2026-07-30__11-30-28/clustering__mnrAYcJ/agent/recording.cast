[111.542599, "o", "\u001b[?2004h"]
[111.542677, "o", "> "]
[111.544286, "o", "from sklearn.preprocessing import StandardScaler, OneHotEncoder\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.decomposition import PCA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ============ DIABETES DATASET ============\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Processing diabetes_data.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> df_diabetes = pd.read_csv('/app/diabetes_data.csv')\r\n\u001b[?2004l\rwith(col)]\r\n            for m in matching:\r\n                result[m] = result[m] * w\r\n    return result.values\r\n\r\n# Strategy 2: Keep categorical as ordinal, standardize everything\r\ndef prep_heart_ordinal(df, weight_dict=None):\r\n    d = df.copy()"]
[111.545122, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[111.545416, "o", "# Encode gender\r\n\u001b[?2004l\r"]
[111.545605, "o", "\u001b[?2004h> df_diab = df_diabetes.copy()\r\n\u001b[?2004l\r"]
[111.545822, "o", "\u001b[?2004h> "]
[111.545902, "o", "df_diab['gender'] = df_diab['gender'].map({'Male': 1, 'Female': 0})\r\n\u001b[?2004l\r    if weig"]
[111.546022, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.546529, "o", "# Key insight: polyuria and polydipsia are the strongest predictors of diabetes\r\n\u001b[?2004l\r"]
[111.546703, "o", "\u001b[?2004h"]
[111.546863, "o", "> "]
[111.54689, "o", "# Let's try different feature weighting strategies\r\n\u001b[?2004l\r"]
[111.547044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.547907, "o", "# Strategy 1: Use all features with standard scaling on age\r\n\u001b[?2004l\r\u001b[?2004h> X1 = df_diab.copy()\r\n\u001b[?2004l\r\u001b[?2004h> scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X1['age'] = scaler.fit_transform(X1[['age']])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.54832, "o", "X1 = X1.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.548689, "o", "# Strategy 2: Weight polyuria and polydipsia heavily\r\n\u001b[?2004l\r"]
[111.548788, "o", "\u001b[?2004h> "]
[111.548867, "o", "X2 = df_diab.copy()\r\n\u001b[?2004l\r"]
[111.548953, "o", "\u001b[?2004h> "]
[111.549182, "o", "X2['age'] = scaler.fit_transform(X2[['age']])\r\n\u001b[?2004l\r"]
[111.549314, "o", "\u001b[?2004h> "]
[111.549475, "o", "# Weight key features\r\n\u001b[?2004l\r"]
[111.549502, "o", "\u001b[?2004h"]
[111.549517, "o", "> "]
[111.54986, "o", "X2['polyuria'] = X2['polyuria'] * 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.550015, "o", "X2['polydipsia'] = X2['polydipsia'] * 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.550317, "o", "X2 = X2.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.550511, "o", "# Strategy 3: Just use polyuria + polydipsia + a few key features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.55108, "o", "X3 = df_diab[['polyuria', 'polydipsia', 'sudden_weight_loss', 'gender', 'irritability', 'partial_paresis', 'polyphagia']].copy()\r\n\u001b[?2004l\r"]
[111.551208, "o", "\u001b[?2004h> X3 = X3.values\r\n\u001b[?2004l\r"]
[111.551371, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.552306, "o", "# Strategy 4: Weight polyuria and polydipsia even more\r\n\u001b[?2004l\r\u001b[?2004h> X4 = df_diab.copy()\r\n\u001b[?2004l\r\u001b[?2004h> X4['age'] = scaler.fit_transform(X4[['age']])\r\n\u001b[?2004l\r\u001b[?2004h> X4['polyuria'] = X4['polyuria'] * 5\r\n\u001b[?2004l\r\u001b[?2004h> X4['polydipsia'] = X4['polydipsia'] * 5\r\n\u001b[?2004l\r\u001b[?2004h> X4 = X4.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.552546, "o", "# Strategy 5: Simple sum of symptoms as a single feature approach\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.552653, "o", "X5 = df_diab.copy()\r\n\u001b[?2004l\r"]
[111.552741, "o", "\u001b[?2004h> "]
[111.552927, "o", "X5['age'] = scaler.fit_transform(X5[['age']])\r\n\u001b[?2004l\r"]
[111.553074, "o", "\u001b[?2004h"]
[111.553149, "o", "> "]
[111.55325, "o", "X5['polyuria'] = X5['polyuria'] * 2\r\n\u001b[?2004l\r"]
[111.553332, "o", "\u001b[?2004h> "]
[111.553486, "o", "X5['polydipsia'] = X5['polydipsia'] * 2\r\n\u001b[?2004l\r"]
[111.553565, "o", "\u001b[?2004h> "]
[111.553814, "o", "X5['sudden_weight_loss'] = X5['sudden_weight_loss'] * 1.5\r\n\u001b[?2004l\r"]
[111.553886, "o", "\u001b[?2004h> "]
[111.554298, "o", "X5['irritability'] = X5['irritability'] * 1.5\r\n\u001b[?2004l\rct2),\r\n  \u001b[?2004h> "]
[111.554466, "o", "X5['partial_paresis'] = X5['partial_paresis'] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.554534, "o", "X5 = X5.values\r\n\u001b[?2004l\r"]
[111.554585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.554737, "o", "\u001b[?2004h> "]
[111.555214, "o", "strategies_diab = {'X1_all': X1, 'X2_weight_poly': X2, 'X3_subset': X3, 'X4_heavy_weight': X4, 'X5_moderate_weight': X5}\r\n\u001b[?2004l\r"]
[111.555304, "o", "\u001b[?2004h> \r\n"]
[111.555481, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[111.555558, "o", "best_diab_labels = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.555577, "o", "> "]
[111.55574, "o", "best_diab_name = \"\"\r\n\u001b[?2004l\r"]
[111.55593, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.556112, "o", "for name, X in strategies_diab.items():\r\n\u001b[?2004l\r"]
[111.5562, "o", "\u001b[?2004h> "]
[111.556399, "o", "    for algo_name, algo_func in [\r\n\u001b[?2004l\r"]
[111.556443, "o", "\u001b[?2004h> "]
[111.556952, "o", "        ('KMeans', lambda X: KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X)),\r\n\u001b[?2004l\r"]
[111.557031, "o", "\u001b[?2004h> "]
[111.557613, "o", "        ('GMM', lambda X: GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X)),\r\n\u001b[?2004l\r"]
[111.557735, "o", "\u001b[?2004h> "]
[111.560372, "o", "        ('Agglo', lambda X: AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X)),\r\n\u001b[?2004l\r\u001b[?2004h>         ('Bisecting', lambda X: BisectingKMeans(n_clusters=2, random_state=42).fit_predict(X)),\r\n\u001b[?2004l\r\u001b[?2004h>     ]:\r\n\u001b[?2004l\r\u001b[?2004h>         labels = algo_func(X)\r\n\u001b[?2004l\r\u001b[?2004h>         counts = np.bincount(labels)\r\n\u001b[?2004l\r\u001b[?2004h>         ratio = min(counts) / max(counts)\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  {name} + {algo_name}: clusters={counts}, ratio={ratio:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Based on domain knowledge, the diabetes dataset should have roughly 200 positive, 320 negative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.560639, "o", "# (or flipped). Let's use the strategies that give ~200/320 split.\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.560669, "o", "> "]
[111.560937, "o", "# Strategy 2 with KMeans seemed to work well.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.560967, "o", "\r\n\u001b[?2004l\r"]
[111.560983, "o", "\u001b[?2004h"]
[111.562299, "o", "> # Let's go with weighted polyuria/polydipsia + KMeans\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nUsing Strategy 2 (weighted polyuria+polydipsia) + KMeans for diabetes\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.562347, "o", "labels_diab = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X2)\r\n\u001b[?2004l\r"]
[111.562391, "o", "\u001b[?2004h"]
[111.562406, "o", "> "]
[111.562747, "o", "print(f\"Final diabetes clusters: {np.bincount(labels_diab)}\")\r\n\u001b[?2004l\r"]
[111.562776, "o", "\u001b[?2004h"]
[111.562792, "o", "> \r\n"]
[111.562803, "o", "\u001b[?2004l\r"]
[111.562869, "o", "\u001b[?2004h"]
[111.562924, "o", "> "]
[111.563138, "o", "diab_output = pd.DataFrame({'pseudo_label': labels_diab})\r\n\u001b[?2004l\r"]
[111.563198, "o", "\u001b[?2004h> "]
[111.563568, "o", "diab_output.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.563768, "o", "\u001b[?2004h> "]
[111.563926, "o", "# ============ HEART DATASET ============\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.564105, "o", "print(\"\\n\" + \"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.564237, "o", "print(\"Processing heart.csv...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.564395, "o", "print(\"=\"*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.564608, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[111.564682, "o", "\u001b[?2004h> "]
[111.564952, "o", "numerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r"]
[111.565042, "o", "\u001b[?2004h> "]
[111.565309, "o", "categorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r"]
[111.56542, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[111.565478, "o", "> "]
[111.565721, "o", "# Strategy 1: One-hot encode all categoricals, standardize numericals\r\n\u001b[?2004l\r"]
[111.565751, "o", "\u001b[?2004h"]
[111.565766, "o", "> "]
[111.565964, "o", "def prep_heart_onehot(df, weight_dict=None):\r\n\u001b[?2004l\r"]
[111.566045, "o", "\u001b[?2004h> "]
[111.566109, "o", "    d = df.copy()\r\n\u001b[?2004l\r"]
[111.566185, "o", "\u001b[?2004h> "]
[111.566307, "o", "    # One-hot encode categorical\r\n\u001b[?2004l\r"]
[111.566396, "o", "\u001b[?2004h"]
[111.566501, "o", "> "]
[111.566701, "o", "    cat_df = pd.get_dummies(d[categorical_cols].astype(str), drop_first=False)\r\n\u001b[?2004l\r"]
[111.566802, "o", "\u001b[?2004h"]
[111.566881, "o", "> "]
[111.566905, "o", "    # Standardize numerical\r\n"]
[111.568293, "o", "\u001b[?2004l\r\u001b[?2004h>     num_df = d[numerical_cols].copy()\r\n\u001b[?2004l\r\u001b[?2004h>     scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h>     num_df = pd.DataFrame(scaler.fit_transform(num_df), columns=numerical_cols)\r\n\u001b[?2004l\r\u001b[?2004h>     result = pd.concat([num_df, cat_df.reset_index(drop=True)], axis=1)\r\n\u001b[?2004l\r\u001b[?2004h>     if weight_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.568391, "o", "        for col, w in weight_dict.items():\r\n"]
[111.568421, "o", "\u001b[?2004l\r"]
[111.568504, "o", "\u001b[?2004h> "]
[111.568825, "o", "            matching = [c for c in result.columns if c.startswith(col)]\r\n\u001b[?2004l\r"]
[111.568931, "o", "\u001b[?2004h> "]
[111.569083, "o", "            for m in matching:\r\n"]
[111.569148, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[111.56936, "o", "                result[m] = result[m] * w\r\n\u001b[?2004l\r"]
[111.569506, "o", "\u001b[?2004h> "]
[111.569582, "o", "    return result.values\r\n\u001b[?2004l\r"]
[111.571056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Strategy 2: Keep categorical as ordinal, standardize everything\r\n\u001b[?2004l\r\u001b[?2004h> def prep_heart_ordinal(df, weight_dict=None):\r\n\u001b[?2004l\r\u001b[?2004h>     d = df.copy()\r\n\u001b[?2004l\r\u001b[?2004h>     scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h>     d_scaled = pd.DataFrame(scaler.fit_transform(d), columns=d.columns)\r\n\u001b[?2004l\r\u001b[?2004h>     if weight_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.572306, "o", "        for col, w in weight_dict.items():\r\n\u001b[?2004l\r\u001b[?2004h>             if col in d_scaled.columns:\r\n\u001b[?2004l\r\u001b[?2004h>                 d_scaled[col] = d_scaled[col] * w\r\n\u001b[?2004l\r\u001b[?2004h>     return d_scaled.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Strategy 3: Use only the most important features\r\n\u001b[?2004l\r\u001b[?2004h> def prep_heart_subset(df):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.57265, "o", "    d = df[['cp', 'thalach', 'oldpeak', 'exang', 'ca', 'thal', 'slope']].copy()\r\n\u001b[?2004l\r"]
[111.572681, "o", "\u001b[?2004h> "]
[111.572892, "o", "    # One-hot encode cp, thal, slope\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.572979, "o", "> "]
[111.573307, "o", "    cat_df = pd.get_dummies(d[['cp', 'thal', 'slope']].astype(str), drop_first=False)\r\n\u001b[?2004l\r"]
[111.57338, "o", "\u001b[?2004h"]
[111.573474, "o", "> "]
[111.57359, "o", "    num_df = d[['thalach', 'oldpeak']].copy()\r\n\u001b[?2004l\r"]
[111.573669, "o", "\u001b[?2004h"]
[111.573695, "o", "> "]
[111.573801, "o", "    scaler = StandardScaler()\r\n\u001b[?2004l\r"]
[111.573876, "o", "\u001b[?2004h> "]
[111.574275, "o", "    num_df = pd.DataFrame(scaler.fit_transform(num_df), columns=['thalach', 'oldpeak'])\r\n\u001b[?2004l\r"]
[111.574378, "o", "\u001b[?2004h> "]
[111.57451, "o", "    binary_df = d[['exang', 'ca']].copy()\r\n\u001b[?2004l\r"]
[111.574587, "o", "\u001b[?2004h> "]
[111.574963, "o", "    result = pd.concat([num_df, binary_df.reset_index(drop=True), cat_df.reset_index(drop=True)], axis=1)\r\n\u001b[?2004l\r"]
[111.575174, "o", "\u001b[?2004h>     return result.values\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.575194, "o", "> \r\n\u001b[?2004l\r"]
[111.575396, "o", "\u001b[?2004h> "]
[111.575584, "o", "# Key features for heart disease: cp, thalach, oldpeak, ca, thal, exang, slope\r\n\u001b[?2004l\r"]
[111.575673, "o", "\u001b[?2004h> "]
[111.575964, "o", "weight_dict1 = {'cp': 2, 'thalach': 2, 'oldpeak': 2, 'ca': 2, 'thal': 2, 'exang': 2, 'slope': 1.5}\r\n\u001b[?2004l\r"]
[111.57599, "o", "\u001b[?2004h> "]
[111.576311, "o", "weight_dict2 = {'cp': 3, 'thalach': 2, 'oldpeak': 2, 'ca': 3, 'thal': 3, 'exang': 2, 'slope': 2}\r\n\u001b[?2004l\r"]
[111.576338, "o", "\u001b[?2004h"]
[111.576352, "o", "> \r\n"]
[111.576369, "o", "\u001b[?2004l\r"]
[111.576487, "o", "\u001b[?2004h> heart_strategies = {\r\n\u001b[?2004l\r"]
[111.576664, "o", "\u001b[?2004h> "]
[111.576771, "o", "    'onehot_noweight': prep_heart_onehot(df_heart),\r\n\u001b[?2004l\r"]
[111.576936, "o", "\u001b[?2004h> "]
[111.57713, "o", "    'onehot_weight1': prep_heart_onehot(df_heart, weight_dict1),\r\n\u001b[?2004l\r"]
[111.577385, "o", "\u001b[?2004h> "]
[111.577412, "o", "    'onehot_weight2': prep_heart_onehot(df_heart, weight_dict2),\r\n\u001b[?2004l\r"]
[111.577546, "o", "\u001b[?2004h> "]
[111.578274, "o", "    'ordinal_noweight': prep_heart_ordinal(df_heart),\r\n\u001b[?2004l\r\u001b[?2004h>     'ordinal_weight1': prep_heart_ordinal(df_heart, {'cp': 2, 'thalach': 2, 'oldpeak': 2, 'ca': 2, 'thal': 2, 'exang': 2}),\r\n\u001b[?2004l\r"]
[111.578303, "o", "\u001b[?2004h> "]
[111.578493, "o", "    'subset': prep_heart_subset(df_heart),\r\n"]
[111.578517, "o", "\u001b[?2004l\r"]
[111.57866, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[111.57879, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.578989, "o", "for name, X in heart_strategies.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.579088, "o", "    for algo_name, algo_func in [\r\n\u001b[?2004l\r"]
[111.579117, "o", "\u001b[?2004h> "]
[111.579653, "o", "        ('KMeans', lambda X: KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X)),\r\n\u001b[?2004l\r"]
[111.57978, "o", "\u001b[?2004h> "]
[111.580246, "o", "        ('GMM', lambda X: GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X)),\r\n\u001b[?2004l\r"]
[111.58033, "o", "\u001b[?2004h> "]
[111.58082, "o", "        ('Agglo', lambda X: AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X)),\r\n\u001b[?2004l\r"]
[111.580924, "o", "\u001b[?2004h> "]
[111.581226, "o", "        ('Bisecting', lambda X: BisectingKMeans(n_clusters=2, random_state=42).fit_predict(X)),\r\n\u001b[?2004l\r"]
[111.581273, "o", "\u001b[?2004h> "]
[111.581527, "o", "    ]:\r\n\u001b[?2004l\r\u001b[?2004h>         labels = algo_func(X)\r\n\u001b[?2004l\r\u001b[?2004h"]
[111.581573, "o", "> "]
