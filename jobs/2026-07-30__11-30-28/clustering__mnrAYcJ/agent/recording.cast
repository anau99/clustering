[185.265424, "i", "cat > /app/solve_final.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.preprocessing import StandardScaler\n\n# ============ DIABETES DATASET ============\nprint(\"Processing diabetes_data.csv...\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\n\n# Encode gender\ndf_diab = df_diabetes.copy()\ndf_diab['gender'] = df_diab['gender'].map({'Male': 1, 'Female': 0})\n\n# Domain knowledge approach: polyuria and polydipsia are the two strongest\n# predictors of early-stage diabetes. \n# The dataset has ~320 positive and ~200 negative cases.\n\n# Approach: Create a simple risk score and use it to separate\n# polyuria + polydipsia together predict diabetes very well\nrisk_score = (df_diab['polyuria'].values * 2 + \n              df_diab['polydipsia'].values * 2 + \n              df_diab['sudden_weight_loss'].values +\n              df_diab['irritability'].values +\n              df_diab['partial_paresis'].values +\n "]
[185.265566, "i", "             df_diab['gender'].values * 0.5 +\n              df_diab['polyphagia'].values * 0.5)\n\n# Threshold-based: if risk_score >= 3, likely positive\nthreshold = 2.5\nlabels_rule = (risk_score >= threshold).astype(int)\nprint(f\"Rule-based diabetes: {np.bincount(labels_rule)}\")\n\n# Also try KMeans on all features with scaled age (which gave 315/205)\nscaler = StandardScaler()\nX_diab = df_diab.copy()\nX_diab['age'] = scaler.fit_transform(X_diab[['age']])\nlabels_km_all = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_diab.values)\nprint(f\"KMeans all features: {np.bincount(labels_km_all)}\")\n\n# Try combining: use polyuria+polydipsia as primary features with moderate weight\nX_diab2 = df_diab.copy()\nX_diab2['age'] = scaler.fit_transform(X_diab2[['age']])\nX_diab2['polyuria'] = X_diab2['polyuria'] * 2\nX_diab2['polydipsia'] = X_diab2['polydipsia'] * 2\nX_diab2['sudden_weight_loss'] = X_diab2['sudden_weight_loss'] * 1.5\nX_diab2['irritability'] = X_diab2['irritability'] * 1.5  \nX_diab2['parti"]
[185.265597, "i", "al_paresis'] = X_diab2['partial_paresis'] * 1.5\nX_diab2['gender'] = X_diab2['gender'] * 1.5\nlabels_km_w = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_diab2.values)\nprint(f\"KMeans weighted: {np.bincount(labels_km_w)}\")\n\n# Try GMM on all features\nlabels_gmm_all = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_diab.values)\nprint(f\"GMM all features: {np.bincount(labels_gmm_all)}\")\n\n# The best approach for diabetes is likely the one that gives ~320/200 split\n# KMeans on all features gives [315, 205] which is very close\n# Let's use that\n\n# Actually, let me also try: polyuria OR polydipsia as a simple binary classifier\nsimple_labels = ((df_diab['polyuria'] == 1) | (df_diab['polydipsia'] == 1)).astype(int).values\nprint(f\"Simple polyuria|polydipsia: {np.bincount(simple_labels)}\")\n\n# And polyuria AND polydipsia\nsimple_labels2 = ((df_diab['polyuria'] == 1) & (df_diab['polydipsia'] == 1)).astype(int).values  \nprint(f\"Simple polyuria&polydipsia: "]
[185.265629, "i", "{np.bincount(simple_labels2)}\")\n\n# Use KMeans on all features (315/205 split, close to true 320/200)\ndiab_output = pd.DataFrame({'pseudo_label': labels_km_all})\ndiab_output.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(\"Saved diabetes with KMeans all features\")\n\n# ============ HEART DATASET ============\nprint(\"\\nProcessing heart.csv...\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\n# For heart disease, key features are:\n# cp (chest pain type) - 0=typical angina(bad), 1=atypical, 2=non-anginal, 3=asymptomatic(bad)\n# thalach (max heart rate) - lower = more disease\n# oldpeak (ST depression) - higher = more disease\n# ca (num vessels colored) - higher = more disease\n# thal - 3=normal, 6=fixed defect(bad), 7=reversible defect(bad) - but encoded as 0,1,2,3\n# exang (exercise induced angina) - 1 = more disease\n# slope - 0=upsloping(good), 1=flat(bad), 2=downsloping(bad) -- depends on encoding\n\n# Strategy: Standardize all features, weight important ones\ndf_h = df_heart.copy()\n# Drop age since task says only 4"]
[185.265649, "i", " numerical + 8 categorical\nif 'age' in df_h.columns:\n    df_h_noage = df_h.drop(columns=['age'])\nelse:\n    df_h_noage = df_h.copy()\n\n# Approach 1: Standardize all, weight important features\nscaler_h = StandardScaler()\nX_h_scaled = pd.DataFrame(scaler_h.fit_transform(df_h_noage), columns=df_h_noage.columns)\n\n# Weight important features\nX_h_w = X_h_scaled.copy()\nX_h_w['cp'] = X_h_w['cp'] * 2.5\nX_h_w['thalach'] = X_h_w['thalach'] * 2\nX_h_w['oldpeak'] = X_h_w['oldpeak'] * 2\nX_h_w['ca'] = X_h_w['ca'] * 2.5\nX_h_w['thal'] = X_h_w['thal'] * 2.5\nX_h_w['exang'] = X_h_w['exang'] * 2\nX_h_w['slope'] = X_h_w['slope'] * 1.5\n\nlabels_h_km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_h_w.values)\nprint(f\"KMeans ordinal weighted: {np.bincount(labels_h_km)}\")\n\nlabels_h_gmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_h_w.values)\nprint(f\"GMM ordinal weighted: {np.bincount(labels_h_gmm)}\")\n\nlabels_h_agglo = AgglomerativeClustering(n_clusters=2, linkag"]
[185.265666, "i", "e='ward').fit_predict(X_h_w.values)\nprint(f\"Agglo ordinal weighted: {np.bincount(labels_h_agglo)}\")\n\n# Approach 2: One-hot encode categorical, standardize numerical, weight\nnumerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\ncat_df = pd.get_dummies(df_h_noage[categorical_cols].astype(str), drop_first=False)\nnum_df = df_h_noage[numerical_cols].copy()\nscaler2 = StandardScaler()\nnum_df = pd.DataFrame(scaler2.fit_transform(num_df), columns=numerical_cols)\nX_h_oh = pd.concat([num_df, cat_df.reset_index(drop=True)], axis=1)\n\n# Weight\nfor col in X_h_oh.columns:\n    if col.startswith('cp_'):\n        X_h_oh[col] = X_h_oh[col] * 2\n    elif col.startswith('ca_'):\n        X_h_oh[col] = X_h_oh[col] * 2\n    elif col.startswith('thal_'):\n        X_h_oh[col] = X_h_oh[col] * 2\n    elif col == 'thalach':\n        X_h_oh[col] = X_h_oh[col] * 2\n    elif col == 'oldpeak':\n        X_h_oh[col] = X_h_oh[col] * 2\n    elif col.startswith('exang_"]
[185.265686, "i", "'):\n        X_h_oh[col] = X_h_oh[col] * 1.5\n    elif col.startswith('slope_'):\n        X_h_oh[col] = X_h_oh[col] * 1.5\n\nlabels_h_oh_km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_h_oh.values)\nprint(f\"KMeans onehot weighted: {np.bincount(labels_h_oh_km)}\")\n\nlabels_h_oh_agglo = AgglomerativeClustering(n_clusters=2, linkage='ward').fit_predict(X_h_oh.values)\nprint(f\"Agglo onehot weighted: {np.bincount(labels_h_oh_agglo)}\")\n\nlabels_h_oh_gmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_h_oh.values)\nprint(f\"GMM onehot weighted: {np.bincount(labels_h_oh_gmm)}\")\n\n# Approach 3: Simple risk score for heart\n# Higher risk: cp=0 (typical angina=bad in some encodings), exang=1, high oldpeak, low thalach, high ca, thal=3\n# Actually the encoding might be: cp=0 is asymptomatic (worst)\nheart_risk = (df_heart['exang'].values * 2 + \n              (df_heart['oldpeak'].values > 1).astype(int) * 2 + \n              (df_heart['ca'].values >= 1).astype("]
[185.26571, "i", "int) * 2 +\n              (df_heart['thal'].values == 3).astype(int) * 2 +\n              (df_heart['cp'].values == 0).astype(int) * 2 +\n              (df_heart['slope'].values == 0).astype(int) +\n              (df_heart['thalach'].values < 140).astype(int))\n\nthreshold_h = 5\nlabels_h_rule = (heart_risk >= threshold_h).astype(int)\nprint(f\"Rule-based heart (threshold={threshold_h}): {np.bincount(labels_h_rule)}\")\n\n# The heart disease dataset typically has roughly 50/50 split\n# Let's use ordinal weighted + KMeans which gives a reasonable split\nheart_output = pd.DataFrame({'pseudo_label': labels_h_km})\nheart_output.to_csv('/app/output_heart.csv', index=False)\nprint(\"Saved heart with KMeans ordinal weighted\")\n\nprint(\"\\nDone!\")\nEOF\n"]
