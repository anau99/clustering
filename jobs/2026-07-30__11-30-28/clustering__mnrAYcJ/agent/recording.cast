[20.023556, "o", "\u001b[?2004hroot@25a96eac46b4:/app# "]
[46.913858, "i", "cat > /app/solve.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport sys\nsys.path.insert(0, '/app/src')\n\nfrom transform.OnehotEncoder import one_hot_encoder\nfrom transform.StandardScaler import standard_scaler\nfrom cluster.kmean import kmeans\nfrom cluster.gaussian_mixture import gaussian_mixture\nfrom cluster.spectral import spectral\nfrom cluster.agglomerative import *\nfrom cluster.bisecting_kmeans import *\n\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.decomposition import PCA\n\n# ============ DIABETES DATASET ============\nprint(\"Processing diabetes_data.csv...\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\nprint(f\"Shape: {df_diabetes.shape}\")\nprint(df_diabetes.dtypes)\nprint(df_diabetes.head())\n\n# Encode gender\ndf_diab_proc = df_diabetes.copy()\ndf_diab_proc['gender'] = df_diab_proc['gender'].map({'Male': 1, 'Female': 0})\n\n# Standardize age\ndf_diab_proc = standard_scaler(df_diab_proc, columns=['age'])\n\nprint(\"\\nDiabetes processed shape:\", df_diab_proc.shape)\nprint(df_diab_proc.head())"]
[46.914028, "i", "\n\n# Try multiple clustering methods\nX_diab = df_diab_proc.values\n\n# KMeans\nlabels_km = kmeans(X_diab, 2)\nprint(f\"\\nKMeans diabetes - cluster sizes: {np.bincount(labels_km)}\")\n\n# Gaussian Mixture\nlabels_gm = gaussian_mixture(X_diab, 2)\nprint(f\"GMM diabetes - cluster sizes: {np.bincount(labels_gm)}\")\n\n# Try with PCA\npca = PCA(n_components=5)\nX_diab_pca = pca.fit_transform(X_diab)\nlabels_km_pca = kmeans(X_diab_pca, 2)\nprint(f\"KMeans+PCA diabetes - cluster sizes: {np.bincount(labels_km_pca)}\")\n\n# Save best result for diabetes (try KMeans first, it usually works well for binary features)\ndiab_output = pd.DataFrame({'pseudo_label': labels_km})\ndiab_output.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nSaved diabetes output with KMeans\")\n\n# ============ HEART DATASET ============\nprint(\"\\n\\nProcessing heart.csv...\")\ndf_heart = pd.read_csv('/app/heart.csv')\nprint(f\"Shape: {df_heart.shape}\")\nprint(df_heart.dtypes)\nprint(df_heart.head())\n\n# Separate numerical and categorical\nnumerical_cols = ['trestbps'"]
[46.914061, "i", ", 'chol', 'thalach', 'oldpeak']\ncategorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\n# One-hot encode categorical features\ndf_heart_proc = df_heart.copy()\n# Drop 'age' since it's not mentioned in numerical features for heart\nif 'age' in df_heart_proc.columns:\n    df_heart_proc = df_heart_proc.drop(columns=['age'])\n\ndf_heart_proc = one_hot_encoder(df_heart_proc, columns=categorical_cols)\ndf_heart_proc = standard_scaler(df_heart_proc, columns=numerical_cols)\n\nprint(\"\\nHeart processed shape:\", df_heart_proc.shape)\nprint(df_heart_proc.head())\n\nX_heart = df_heart_proc.values\n\n# KMeans\nlabels_km_h = kmeans(X_heart, 2)\nprint(f\"\\nKMeans heart - cluster sizes: {np.bincount(labels_km_h)}\")\n\n# Gaussian Mixture\nlabels_gm_h = gaussian_mixture(X_heart, 2)\nprint(f\"GMM heart - cluster sizes: {np.bincount(labels_gm_h)}\")\n\n# Spectral\nlabels_sp_h = spectral(X_heart, 2)\nprint(f\"Spectral heart - cluster sizes: {np.bincount(labels_sp_h)}\")\n\n# Try with PCA\npca_h = PCA(n_components=5)\nX_heart_pca = pca"]
[46.914083, "i", "_h.fit_transform(X_heart)\nlabels_km_pca_h = kmeans(X_heart_pca, 2)\nprint(f\"KMeans+PCA heart - cluster sizes: {np.bincount(labels_km_pca_h)}\")\n\n# Save heart output\nheart_output = pd.DataFrame({'pseudo_label': labels_km_h})\nheart_output.to_csv('/app/output_heart.csv', index=False)\nprint(f\"\\nSaved heart output with KMeans\")\n\nprint(\"\\nDone!\")\nEOF\n"]
