[185.27721, "o", "# Also try KMeans on all features with scaled age (which gave 315/205)\r\n\u001b[?2004l\r"]
[185.277237, "o", "\u001b[?2004h"]
[185.277331, "o", "> "]
[185.277456, "o", "scaler = StandardScaler()\r\n\u001b[?2004l\r"]
[185.277547, "o", "\u001b[?2004h> "]
[185.277758, "o", "X_diab = df_diab.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.278331, "o", "X_diab['age'] = scaler.fit_transform(X_diab[['age']])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.278607, "o", "labels_km_all = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_diab.values)\r\n\u001b[?2004l\r"]
[185.278774, "o", "\u001b[?2004h> "]
[185.278976, "o", "print(f\"KMeans all features: {np.bincount(labels_km_all)}\")\r\n\u001b[?2004l\r"]
[185.279064, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[185.279126, "o", "\u001b[?2004h> "]
[185.279554, "o", "# Try combining: use polyuria+polydipsia as primary features with moderate weight\r\n\u001b[?2004l\r"]
[185.279641, "o", "\u001b[?2004h> "]
[185.279863, "o", "X_diab2 = df_diab.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.280125, "o", "X_diab2['age'] = scaler.fit_transform(X_diab2[['age']])\r\n\u001b[?2004l\r"]
[185.28025, "o", "\u001b[?2004h> "]
[185.280458, "o", "X_diab2['polyuria'] = X_diab2['polyuria'] * 2\r\n\u001b[?2004l\r"]
[185.280575, "o", "\u001b[?2004h> "]
[185.281437, "o", "X_diab2['polydipsia'] = X_diab2['polydipsia'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> X_diab2['sudden_weight_loss'] = X_diab2['sudden_weight_loss'] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> X_diab2['irritability'] = X_diab2['irritability'] * 1.5  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.281524, "o", "X_diab2['partial_paresis'] = X_diab2['partial_paresis'] * 1.5\r\n\u001b[?2004l\rcol] * 2\r\n    elif col == 'thalach':\r\n        X_h_oh[col] = X_h_oh[col] * 2\r\n    elif col == 'oldpeak':\r\n        X_h_oh[col] = X_h_oh[col] * 2\r\n    elif col.startswith('exang_\u001b[?2004h"]
[185.281546, "o", "> "]
[185.281842, "o", "X_diab2['gender'] = X_diab2['gender'] * 1.5\r\n\u001b[?2004l\r"]
[185.281976, "o", "\u001b[?2004h> "]
[185.282531, "o", "labels_km_w = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42).fit_predict(X_diab2.values)\r\n\u001b[?2004l\r"]
[185.282647, "o", "\u001b[?2004h> "]
[185.282909, "o", "print(f\"KMeans weighted: {np.bincount(labels_km_w)}\")\r\n\u001b[?2004l\r"]
[185.282993, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h"]
[185.283016, "o", "> "]
[185.283209, "o", "# Try GMM on all features\r\n\u001b[?2004l\r"]
[185.283332, "o", "\u001b[?2004h> "]
[185.284312, "o", "labels_gmm_all = GaussianMixture(n_components=2, covariance_type='full', random_state=42).fit_predict(X_diab.values)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"GMM all features: {np.bincount(labels_gmm_all)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # The best approach for diabetes is likely the one that gives ~320/200 split\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.285349, "o", "# KMeans on all features gives [315, 205] which is very close\r\n\u001b[?2004l\r\u001b[?2004h> # Let's use that\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Actually, let me also try: polyuria OR polydipsia as a simple binary classifier\r\n\u001b[?2004l\r\u001b[?2004h> simple_labels = ((df_diab['polyuria'] == 1) | (df_diab['polydipsia'] == 1)).astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.285432, "o", "print(f\"Simple polyuria|polydipsia: {np.bincount(simple_labels)}\")\r\n\u001b[?2004l\r"]
[185.285456, "o", "\u001b[?2004h> "]
[185.285474, "o", "\r\n\u001b[?2004l\r"]
[185.285958, "o", "\u001b[?2004h"]
[185.286024, "o", "> # And polyuria AND polydipsia\r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.286345, "o", "simple_labels2 = ((df_diab['polyuria'] == 1) & (df_diab['polydipsia'] == 1)).astype(int).values  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[185.286571, "o", "print(f\"Simple polyuria&polydipsia: {np.bincount(simple_labels2)}\")\r\n\u001b[?2004l\r"]
[185.286665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[185.286688, "o", "> "]
[185.28708, "o", "# Use KMeans on all features (315/205 split, close to true 320/200)\r\n\u001b[?2004l\r"]
[185.28719, "o", "\u001b[?2004h> "]
[185.28746, "o", "diab_output = pd.DataFrame({'pseudo_label': labels_km_all})\r\n\u001b[?2004l\r"]
[185.287516, "o", "\u001b[?2004h"]
[185.287575, "o", "> "]
[185.287891, "o", "diab_output.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r"]
