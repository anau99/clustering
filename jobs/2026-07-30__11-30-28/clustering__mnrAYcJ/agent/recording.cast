[19.770154, "o", "cat /app/src/cluster/spectral.py\r\n\u001b[?2004l\r"]
[19.771853, "o", "from sklearn.cluster import SpectralClustering\r\n\r\n\r\ndef spectral(X, k):\r\n    model = SpectralClustering(\r\n        n_clusters=k,\r\n        affinity=\"nearest_neighbors\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
