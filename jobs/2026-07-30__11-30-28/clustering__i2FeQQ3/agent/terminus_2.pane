[?2004l[?2004h> df_heart = pd.read_csv('/app/heart.csv')
[?2004l[?2004h> 
[?2004l[?2004h> numerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']
[?2004l[?2004h> categorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']
[?2004lope[?2004h> 
[?2004l[?2004h> # Domain knowledge for heart disease:
[?2004l[?2004h> # In UCI heart dataset (Cleveland), the label is presence/absence of heart disease
[?2004l[?2004h> # Key features: cp (chest pain - value 0 = typical angina, most indicative of disease in some encodings)
[?2004l[?2004h> # In many versions: cp=0 is typical angina (high risk), but in others the encoding is reversed
[?2004l[?2004h> # thalach: lower max heart rate = more risk
[?2004l[?2004h> # oldpeak: higher ST depression = more risk  
[?2004l[?2004h> # ca: more vessels colored = more risk
[?2004l[?2004h> # thal: normal=1, fixed_defect=2, reversible_defect=3 (2,3 = more risk)
[?2004l[?2004h> # exang: 1 = exercise angina = more risk
[?2004l[?2004h> # slope: 0=upsloping(good), 1=flat(moderate), 2=downsloping(bad) - varies by encoding
[?2004l[?2004h> 
[?2004l[?2004h> # Create a composite risk score
[?2004l[?2004h> df_h = df_heart.copy()
[?2004l[?2004h> 
[?2004l[?2004h> # Standardize numerical features
[?2004l[?2004h> for col in numerical_cols:
[?2004l[?2004h>     df_h[col + '_std'] = (df_h[col] - df_h[col].mean()) / df_h[col].std()
[?2004l[?2004h> 
[?2004l[?2004h> # In this dataset, cp seems to be encoded as 0,1,2,3
[?2004l[?2004h> # In standard UCI: 1=typical angina, 2=atypical, 3=non-anginal, 4=asymptomatic
[?2004l[?2004h> # Here 0-indexed: 0=typical angina, 1=atypical, 2=non-anginal, 3=asymptomatic
[?2004l[?2004h> # Asymptomatic (3) is actually most associated with disease presence!
[?2004l[?2004h> # Wait no - in the processed Cleveland dataset, cp=4 (asymptomatic) is most common in disease
[?2004l[?2004h> # So higher cp number = less typical symptoms = counterintuitively MORE disease
[?2004l[?2004h> 
[?2004l[?2004h> # Actually let me reconsider. In UCI heart:
[?2004l[?2004h> # cp: chest pain type (0: typical angina, 1: atypical angina, 2: non-anginal pain, 3: asymptomatic)
[?2004l[?2004h> # People with asymptomatic chest pain (cp=3) are actually MORE likely to have heart disease
[?2004l[?2004h> # thalach: maximum heart rate - LOWER is worse
[?2004l[?2004h> # oldpeak: ST depression - HIGHER is worse
[?2004l[?2004h> # exang: exercise-induced angina - 1 is worse
[?2004l[?2004h> # slope: 0=upsloping(better), 1=flat(moderate), 2=downsloping(worse)
[?2004l[?2004h> # ca: number of major vessels colored by fluoroscopy (0-4) - HIGHER is worse
[?2004l[?2004h> # thal: 0=normal, 1=fixed defect, 2=reversible defect, 3=? 
[?2004l[?2004h> # Actually thal values: 1=normal, 2=fixed defect, 3=reversible defect in many encodings
[?2004l[?2004h> 
[?2004l[?2004h> # Create risk score
[?2004l[?2004h> risk_score = (
[?2004l[?2004h>     df_h['cp'] * 2.0 +  # higher cp = asymptomatic = more disease
[?2004l[?2004h>     (-df_h['thalach_std']) * 1.5 +  # lower max HR = more risk
[?2004l[?2004h>     df_h['oldpeak_std'] * 2.0 +  # higher ST depression = more risk
[?2004l[?2004h>     df_h['exang'] * 2.5 +  # exercise angina = more risk
[?2004l[?2004h>     df_h['ca'] * 3.0 +  # more vessels = more risk (very strong predictor)
[?2004l[?2004h>     (df_h['thal'] >= 2).astype(float) * 2.0 +  # defect = more risk
[?2004l[?2004h>     df_h['slope'] * 1.0 +  # encoding-dependent
[?2004l[?2004h>     df_h['sex'] * 0.5 +  # male = slightly more risk
[?2004l[?2004h>     df_h['trestbps_std'] * 0.5 +  # higher BP = more risk
[?2004l[?2004h>     df_h['fbs'] * 0.5 +  # fasting blood sugar > 120 = more risk
[?2004l[?2004h>     (-df_h['chol_std']) * 0.1  # chol is not very predictive
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> results_h = {}
[?2004l[?2004h> 
[?2004l[?2004h> # GMM on risk score
[?2004l[?2004h> risk_vals = risk_score.values.reshape(-1, 1)
[?2004l[?2004h> gmm_risk = GaussianMixture(n_components=2, random_state=42)
[?2004l[?2004h> results_h['gmm_risk'] = gmm_risk.fit_predict(risk_vals)
[?2004l[?2004h> 
[?2004l[?2004h> # KMeans on risk score
[?2004l[?2004h> km_risk = KMeans(n_clusters=2, n_init=50, random_state=42)
[?2004l[?2004h> results_h['kmeans_risk'] = km_risk.fit_predict(risk_vals)
[?2004l[?2004h> 
