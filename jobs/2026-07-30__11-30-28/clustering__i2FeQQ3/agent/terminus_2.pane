[?2004l[?2004h> # The rule-based is good but may miss edge cases; GMM can handle the uncertainty
[?2004l[?2004h> # Actually, let's use the one that best matches expected ~320/200 split
[?2004l[?2004h> # Expected: 320 positive, 200 negative = 61.5%/38.5%
[?2004l[?2004h> 
[?2004l[?2004h> best_d_name = None
[?2004l[?2004h> best_d_diff = float('inf')
[?2004l[?2004h> target_ratio = 320.0 / 520.0  # ~0.615
[?2004l[?2004h> 
