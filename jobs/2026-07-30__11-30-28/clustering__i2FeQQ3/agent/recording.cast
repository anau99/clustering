[149.973361, "o", "\u001b[?2004h"]
[149.973447, "o", "> "]
[149.973671, "o", "# Simple rule-based: polyuria OR polydipsia -> cluster 1\r\n\u001b[?2004l\r"]
[149.973705, "o", "\u001b[?2004h"]
[149.973805, "o", "> "]
[149.974142, "o", "rule_based = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\r\n\u001b[?2004l\r"]
[149.974354, "o", "\u001b[?2004h> "]
[149.974458, "o", "results_d['rule_polyuria_polydipsia'] = rule_based\r\n"]
[149.97448, "o", "\u001b[?2004l\r"]
[149.974499, "o", "\u001b[?2004h"]
[149.974618, "o", "> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[149.97539, "o", "# polyuria AND polydipsia\r\n\u001b[?2004l\r\u001b[?2004h> rule_based2 = ((df_diabetes['polyuria'] == 1) & (df_diabetes['polydipsia'] == 1)).astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> results_d['rule_both'] = rule_based2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.975618, "o", "# Composite score approach\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.975648, "o", "df_score = df_diabetes.copy()\r\n\u001b[?2004l\r"]
[149.975665, "o", "\u001b[?2004h"]
[149.975703, "o", "> "]
[149.976055, "o", "df_score['score'] = (df_score['polyuria'] * 3 + df_score['polydipsia'] * 3 + \r\n\u001b[?2004l\r"]
[149.97613, "o", "\u001b[?2004h> "]
[149.976578, "o", "                     df_score['sudden_weight_loss'] * 2 + df_score['polyphagia'] * 1.5 +\r\n\u001b[?2004l\r"]
[149.976653, "o", "\u001b[?2004h> "]
[149.977413, "o", "                     df_score['irritability'] * 1.5 + df_score['partial_paresis'] * 1.5 +\r\n\u001b[?2004l\r\u001b[?2004h>                      df_score['gender_num'] * 0.5)\r\n\u001b[?2004l\r\u001b[?2004h> threshold = df_score['score'].median()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.978363, "o", "results_d['score_median'] = (df_score['score'] > threshold).astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Use GMM on the score\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.mixture import GaussianMixture as GM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.979395, "o", "score_vals = df_score['score'].values.reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> gmm_score = GM(n_components=2, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_d['gmm_score'] = gmm_score.fit_predict(score_vals)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nDiabetes results:\")\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in results_d.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.979488, "o", "    unique, counts = np.unique(labels, return_counts=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.979633, "o", "> "]
[149.979819, "o", "    sil = silhouette_score(X_d_vals, labels) if len(unique) > 1 else -1\r\n\u001b[?2004l\r sil = s"]
[149.979838, "o", "\u001b[?2004h> "]
[149.980206, "o", "    print(f\"  {name}: sizes={dict(zip(unique, counts))}, silhouette={sil:.4f}\")\r\n\u001b[?2004l\r"]
[149.980362, "o", "\u001b[?2004h"]
[149.980387, "o", "> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[149.981382, "o", "# The diabetes dataset ground truth is likely positive/negative.\r\n\u001b[?2004l\r\u001b[?2004h> # Known: ~320 positive, ~200 negative in Pima dataset, or it could be early-stage diabetes dataset\r\n\u001b[?2004l\r\u001b[?2004h> # Let's use the GMM on weighted features\r\n\u001b[?2004l\r\u001b[?2004h> best_d = results_d['gmm_w']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.981492, "o", "print(f\"\\nChosen diabetes: gmm_w, distribution: {np.bincount(best_d)}\")\r\n\u001b[?2004l\r"]
[149.981521, "o", "\u001b[?2004h> "]
[149.981652, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Save\r\n"]
[149.981674, "o", "\u001b[?2004l\r"]
[149.981804, "o", "\u001b[?2004h> "]
[149.982353, "o", "out_d = pd.DataFrame({'pseudo_label': best_d})\r\n\u001b[?2004l\r\u001b[?2004h> out_d.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r"]
[149.982481, "o", "\u001b[?2004h> "]
[149.982546, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.982637, "o", "# ===== HEART DATASET =====\r\n\u001b[?2004l\r"]
[149.982664, "o", "\u001b[?2004h"]
[149.98268, "o", "> "]
[149.98292, "o", "print(\"\\n\\nProcessing heart dataset...\")\r\n\u001b[?2004l\r"]
[149.982948, "o", "\u001b[?2004h> "]
[149.98315, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.983176, "o", "\u001b[?2004h> "]
[149.98345, "o", "numerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r"]
[149.986368, "o", "\u001b[?2004h> categorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results_h = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 1: All features standardized with weights\r\n\u001b[?2004l\r\u001b[?2004h> scaler_h = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_h = pd.DataFrame(scaler_h.fit_transform(df_heart.values), columns=df_heart.columns)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Weight important features\r\n\u001b[?2004l\r\u001b[?2004h> weights_h = {\r\n\u001b[?2004l\r\u001b[?2004h>     'cp': 2.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'thalach': 2.0,\r\n\u001b[?2004l\r\u001b[?2004h>     'oldpeak': 2.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'ca': 2.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'thal': 2.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'exang': 2.0,\r\n\u001b[?2004l\r\u001b[?2004h>     'slope': 2.0,\r\n\u001b[?2004l\r\u001b[?2004h>     'sex': 1.0,\r\n\u001b[?2004l\r\u001b[?2004h>     'age': 1.0,\r\n\u001b[?2004l\r\u001b[?2004h>     'trestbps': 1.0,\r\n\u001b[?2004l\r\u001b[?2004h>     'chol': 0.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'fbs': 0.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'restecg': 1.0,\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?"]
[149.986407, "o", "2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_h_w = X_h.copy()\r\n\u001b[?2004l\r\u001b[?2004h> for col, w in weights_h.items():\r\n\u001b[?2004l\r\u001b[?2004h>     X_h_w[col] = X_h_w[col] * w\r\n\u001b[?2004l\r\u001b[?2004h> X_h_w_vals = X_h_w.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.986601, "o", "km_hw = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r"]
[149.986635, "o", "\u001b[?2004h"]
[149.986651, "o", "> "]
[149.986874, "o", "results_h['kmeans_weighted'] = km_hw.fit_predict(X_h_w_vals)\r\n\u001b[?2004l\r"]
[149.986904, "o", "\u001b[?2004h> \r\n"]
[149.98692, "o", "\u001b[?2004l\r"]
[149.987034, "o", "\u001b[?2004h> "]
[149.98735, "o", "gmm_hw = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n\u001b[?2004l\r"]
[149.987448, "o", "\u001b[?2004h> "]
[149.987658, "o", "results_h['gmm_weighted'] = gmm_hw.fit_predict(X_h_w_vals)\r\n\u001b[?2004l\r"]
[149.987748, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[149.987772, "o", "> "]
[149.988013, "o", "agg_hw = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r"]
[149.988134, "o", "\u001b[?2004h> "]
[149.98937, "o", "results_h['agg_weighted'] = agg_hw.fit_predict(X_h_w_vals)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 2: One-hot encode + scale + weight\r\n\u001b[?2004l\r\u001b[?2004h> df_h_oh = pd.get_dummies(df_heart, columns=categorical_cols)\r\n\u001b[?2004l\r\u001b[?2004h> scaler_oh = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_h_oh = scaler_oh.fit_transform(df_h_oh.values)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> km_oh = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.989546, "o", "results_h['kmeans_onehot'] = km_oh.fit_predict(X_h_oh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[149.990013, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> gmm_oh = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n\u001b[?2004l\r"]
[149.990102, "o", "\u001b[?2004h> "]
[149.99028, "o", "results_h['gmm_onehot'] = gmm_oh.fit_predict(X_h_oh)\r\n\u001b[?2004l\r"]
[149.990362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[149.991309, "o", "\u001b[?2004h> # Approach 3: Score-based\r\n\u001b[?2004l\r\u001b[?2004h> df_h_score = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> # Compute a heart disease risk score based on medical knowledge\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.991594, "o", "# cp: 0=typical angina (less risk), 1,2,3 = atypical/non-anginal/asymptomatic (higher risk for 0)\r\n"]
[149.991697, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[149.992018, "o", "# Actually in the UCI heart dataset, higher cp value = less typical = more likely disease\r\n\u001b[?2004l\r"]
[149.99217, "o", "\u001b[?2004h> "]
[149.992419, "o", "# thalach: lower = more risk; exang: 1 = more risk; oldpeak: higher = more risk\r\n\u001b[?2004l\r"]
[149.995445, "o", "\u001b[?2004h> # ca: more vessels colored = more risk; thal: 3 = fixed defect = more risk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Standardize numerical features for scoring\r\n\u001b[?2004l\r\u001b[?2004h> df_h_std = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> for col in numerical_cols:\r\n\u001b[?2004l\r\u001b[?2004h>     df_h_std[col] = (df_h_std[col] - df_h_std[col].mean()) / df_h_std[col].std()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> score_h = (df_h_std['cp'] * 2.0 - df_h_std['thalach'] * 1.5 + \r\n\u001b[?2004l\r\u001b[?2004h>            df_h_std['oldpeak'] * 2.0 + df_heart['exang'] * 2.0 + \r\n\u001b[?2004l\r\u001b[?2004h>            df_heart['ca'] * 2.5 + (df_heart['thal'] == 3).astype(float) * 2.0 +\r\n\u001b[?2004l\r\u001b[?2004h>            df_heart['slope'].map({0: 1, 1: 0, 2: -0.5}) * 1.5 +\r\n\u001b[?2004l\r\u001b[?2004h>            df_heart['sex'] * 0.5)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> threshold_h = score_h.median()\r\n\u001b[?2004l\r\u001b[?2004h> results_h['score_median'] = (score_h > threshold_h).astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # GMM on score\r\n\u001b[?2004l\r\u001b"]
[149.996365, "o", "[?2004h> score_h_vals = score_h.values.reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> gmm_score_h = GaussianMixture(n_components=2, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_h['gmm_score'] = gmm_score_h.fit_predict(score_h_vals)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # KMeans on key features only\r\n\u001b[?2004l\r\u001b[?2004h> key_h = ['cp', 'thalach', 'oldpeak', 'exang', 'ca', 'thal', 'slope']\r\n\u001b[?2004l\r\u001b[?2004h> X_h_key = df_heart[key_h].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.996393, "o", "scaler_key = StandardScaler()\r\n\u001b[?2004l\r"]
[149.996412, "o", "\u001b[?2004h"]
[149.996427, "o", "> "]
[149.99667, "o", "X_h_key_scaled = scaler_key.fit_transform(X_h_key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.99693, "o", "km_key_h = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r"]
[149.997016, "o", "\u001b[?2004h> "]
[149.99729, "o", "results_h['kmeans_key'] = km_key_h.fit_predict(X_h_key_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.997608, "o", "gmm_key_h = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n\u001b[?2004l\r"]
[149.997708, "o", "\u001b[?2004h> "]
[149.997873, "o", "results_h['gmm_key'] = gmm_key_h.fit_predict(X_h_key_scaled)\r\n\u001b[?2004l\r"]
[149.998365, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nHeart results:\")\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in results_h.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.99852, "o", "    unique, counts = np.unique(labels, return_counts=True)\r\n\u001b[?2004l\r"]
[149.998595, "o", "\u001b[?2004h> "]
[149.998803, "o", "    sil = silhouette_score(X_h_w_vals, labels) if len(unique) > 1 else -1\r\n\u001b[?2004l\r"]
[149.998895, "o", "\u001b[?2004h> "]
[149.999148, "o", "    print(f\"  {name}: sizes={dict(zip(unique, counts))}, silhouette={sil:.4f}\")\r\n\u001b[?2004l\r"]
[149.99917, "o", "\u001b[?2004h"]
[149.999185, "o", "> "]
[149.999203, "o", "\r\n\u001b[?2004l\r"]
[149.999352, "o", "\u001b[?2004h> "]
[149.999559, "o", "# Use the score-based approach for heart (medical knowledge-driven)\r\n\u001b[?2004l\r"]
[149.999644, "o", "\u001b[?2004h"]
[149.999675, "o", "> "]
[149.999751, "o", "best_h = results_h['gmm_score']\r\n\u001b[?2004l\r"]
[149.999822, "o", "\u001b[?2004h"]
[149.999842, "o", "> "]
[150.000139, "o", "print(f\"\\nChosen heart: gmm_score, distribution: {np.bincount(best_h)}\")\r\n\u001b[?2004l\r"]
[150.000193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[150.000227, "o", "\u001b[?2004h"]
[150.000254, "o", "> "]
[150.000337, "o", "# Save\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.000879, "o", "out_h = pd.DataFrame({'pseudo_label': best_h})\r\n\u001b[?2004l\r\u001b[?2004h> out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[150.001006, "o", "\u001b[?2004h"]
[150.001068, "o", "> print(\"\\nDone!\")\r\n"]
[150.001096, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[150.001386, "o", "EOF\r\n\u001b[?2004l\r"]
