[149.955949, "i", "cat > /app/solve2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.cluster import KMeans, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.metrics import silhouette_score\n\n# ===== DIABETES DATASET =====\nprint(\"Processing diabetes dataset...\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\n\n# Encode gender\ndf_diabetes['gender_num'] = (df_diabetes['gender'] == 'Male').astype(int)\ndf_features = df_diabetes.drop(columns=['gender'])\n\n# Scale age\nscaler = StandardScaler()\ndf_features['age'] = scaler.fit_transform(df_features[['age']])\n\n# Approach: Heavily weight polyuria and polydipsia (most diagnostic for diabetes)\n# These two symptoms alone have very high predictive power for diabetes\nweights_d = {\n    'polyuria': 3.0,\n    'polydipsia': 3.0,\n    'sudden_weight_loss': 2.0,\n    'polyphagia': 1.5,\n    'irritability': 1.5,\n    'partial_paresis': 1.5,\n    'gender_num': 1.5,\n    'age': 1.0,\n    'weakness': 1.0,\n    'gen"]
[149.956018, "i", "ital_thrush': 1.0,\n    'visual_blurring': 1.0,\n    'itching': 1.0,\n    'delayed_healing': 1.0,\n    'muscle_stiffness': 1.0,\n    'alopecia': 1.0,\n    'obesity': 1.0,\n}\n\nX_d = df_features.copy()\nfor col in X_d.columns:\n    if col in weights_d:\n        X_d[col] = X_d[col] * weights_d[col]\nX_d_vals = X_d.values\n\n# Try multiple approaches with weighted features\nresults_d = {}\n\nfor n_init_val in [50, 100]:\n    km = KMeans(n_clusters=2, init='k-means++', n_init=n_init_val, random_state=42)\n    labels = km.fit_predict(X_d_vals)\n    name = f'kmeans_w_ninit{n_init_val}'\n    results_d[name] = labels\n\ngmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_d['gmm_w'] = gmm.fit_predict(X_d_vals)\n\nagg = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_d['agg_w'] = agg.fit_predict(X_d_vals)\n\n# Even more aggressive: just use polyuria + polydipsia + a few others\nkey_features = ['polyuria', 'polydipsia', 'sudden_weight_loss', 'polyphagia', 'irritability', 'partial_paresis'"]
[149.956043, "i", ", 'gender_num']\nX_d_key = df_features[key_features].values * 1.0\nkm_key = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_d['kmeans_key'] = km_key.fit_predict(X_d_key)\n\ngmm_key = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_d['gmm_key'] = gmm_key.fit_predict(X_d_key)\n\n# Simple rule-based: polyuria OR polydipsia -> cluster 1\nrule_based = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\nresults_d['rule_polyuria_polydipsia'] = rule_based\n\n# polyuria AND polydipsia\nrule_based2 = ((df_diabetes['polyuria'] == 1) & (df_diabetes['polydipsia'] == 1)).astype(int).values\nresults_d['rule_both'] = rule_based2\n\n# Composite score approach\ndf_score = df_diabetes.copy()\ndf_score['score'] = (df_score['polyuria'] * 3 + df_score['polydipsia'] * 3 + \n                     df_score['sudden_weight_loss'] * 2 + df_score['polyphagia'] * 1.5 +\n                     df_score['irritability'] * 1.5 + df_score['partial_paresis'] "]
[149.956066, "i", "* 1.5 +\n                     df_score['gender_num'] * 0.5)\nthreshold = df_score['score'].median()\nresults_d['score_median'] = (df_score['score'] > threshold).astype(int).values\n\n# Use GMM on the score\nfrom sklearn.mixture import GaussianMixture as GM\nscore_vals = df_score['score'].values.reshape(-1, 1)\ngmm_score = GM(n_components=2, random_state=42)\nresults_d['gmm_score'] = gmm_score.fit_predict(score_vals)\n\nprint(\"\\nDiabetes results:\")\nfor name, labels in results_d.items():\n    unique, counts = np.unique(labels, return_counts=True)\n    sil = silhouette_score(X_d_vals, labels) if len(unique) > 1 else -1\n    print(f\"  {name}: sizes={dict(zip(unique, counts))}, silhouette={sil:.4f}\")\n\n# The diabetes dataset ground truth is likely positive/negative.\n# Known: ~320 positive, ~200 negative in Pima dataset, or it could be early-stage diabetes dataset\n# Let's use the GMM on weighted features\nbest_d = results_d['gmm_w']\nprint(f\"\\nChosen diabetes: gmm_w, distribution: {np.bincount(best_d)}\")\n\n# Save\nout_d = pd.DataFram"]
[149.956168, "i", "e({'pseudo_label': best_d})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\n\n# ===== HEART DATASET =====\nprint(\"\\n\\nProcessing heart dataset...\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\nnumerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\nresults_h = {}\n\n# Approach 1: All features standardized with weights\nscaler_h = StandardScaler()\nX_h = pd.DataFrame(scaler_h.fit_transform(df_heart.values), columns=df_heart.columns)\n\n# Weight important features\nweights_h = {\n    'cp': 2.5,\n    'thalach': 2.0,\n    'oldpeak': 2.5,\n    'ca': 2.5,\n    'thal': 2.5,\n    'exang': 2.0,\n    'slope': 2.0,\n    'sex': 1.0,\n    'age': 1.0,\n    'trestbps': 1.0,\n    'chol': 0.5,\n    'fbs': 0.5,\n    'restecg': 1.0,\n}\n\nX_h_w = X_h.copy()\nfor col, w in weights_h.items():\n    X_h_w[col] = X_h_w[col] * w\nX_h_w_vals = X_h_w.values\n\nkm_hw = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_h['kmeans_weighted'] = km_hw"]
[149.956739, "o", "cat > /app/solve2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.956761, "i", ".fit_predict(X_h_w_vals)\n\ngmm_hw = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_h['gmm_weighted'] = gmm_hw.fit_predict(X_h_w_vals)\n\nagg_hw = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_h['agg_weighted'] = agg_hw.fit_predict(X_h_w_vals)\n\n# Approach 2: One-hot encode + scale + weight\ndf_h_oh = pd.get_dummies(df_heart, columns=categorical_cols)\nscaler_oh = StandardScaler()\nX_h_oh = scaler_oh.fit_transform(df_h_oh.values)\n\nkm_oh = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_h['kmeans_onehot'] = km_oh.fit_predict(X_h_oh)\n\ngmm_oh = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_h['gmm_onehot'] = gmm_oh.fit_predict(X_h_oh)\n\n# Approach 3: Score-based\ndf_h_score = df_heart.copy()\n# Compute a heart disease risk score based on medical knowledge\n# cp: 0=typical angina (less risk), 1,2,3 = atypical/non-anginal/asymptomatic (higher risk for 0)\n# Actually in the UCI heart dataset, hig"]
[149.957623, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.preprocessing import StandardScaler\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.cluster import KMeans, AgglomerativeClustering\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.mixture import GaussianMixture\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.957664, "i", "her cp value = less typical = more likely disease\n# thalach: lower = more risk; exang: 1 = more risk; oldpeak: higher = more risk\n# ca: more vessels colored = more risk; thal: 3 = fixed defect = more risk\n\n# Standardize numerical features for scoring\ndf_h_std = df_heart.copy()\nfor col in numerical_cols:\n    df_h_std[col] = (df_h_std[col] - df_h_std[col].mean()) / df_h_std[col].std()\n\nscore_h = (df_h_std['cp'] * 2.0 - df_h_std['thalach'] * 1.5 + \n           df_h_std['oldpeak'] * 2.0 + df_heart['exang'] * 2.0 + \n           df_heart['ca'] * 2.5 + (df_heart['thal'] == 3).astype(float) * 2.0 +\n           df_heart['slope'].map({0: 1, 1: 0, 2: -0.5}) * 1.5 +\n           df_heart['sex'] * 0.5)\n\nthreshold_h = score_h.median()\nresults_h['score_median'] = (score_h > threshold_h).astype(int).values\n\n# GMM on score\nscore_h_vals = score_h.values.reshape(-1, 1)\ngmm_score_h = GaussianMixture(n_components=2, random_state=42)\nresults_h['gmm_score'] = gmm_score_h.fit_predict(score_h_vals)\n\n# KMeans on key features only\nkey_h = ["]
[149.957684, "o", "from sklearn.metrics import silhouette_score\r\n\u001b[?2004l\r"]
[149.957698, "i", "'cp', 'thalach', 'oldpeak', 'exang', 'ca', 'thal', 'slope']\nX_h_key = df_heart[key_h].copy()\nscaler_key = StandardScaler()\nX_h_key_scaled = scaler_key.fit_transform(X_h_key)\nkm_key_h = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\nresults_h['kmeans_key'] = km_key_h.fit_predict(X_h_key_scaled)\n\ngmm_key_h = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\nresults_h['gmm_key'] = gmm_key_h.fit_predict(X_h_key_scaled)\n\nprint(\"\\nHeart results:\")\nfor name, labels in results_h.items():\n    unique, counts = np.unique(labels, return_counts=True)\n    sil = silhouette_score(X_h_w_vals, labels) if len(unique) > 1 else -1\n    print(f\"  {name}: sizes={dict(zip(unique, counts))}, silhouette={sil:.4f}\")\n\n# Use the score-based approach for heart (medical knowledge-driven)\nbest_h = results_h['gmm_score']\nprint(f\"\\nChosen heart: gmm_score, distribution: {np.bincount(best_h)}\")\n\n# Save\nout_h = pd.DataFrame({'pseudo_label': best_h})\nout_h.to_csv('/app/output_heart.csv', inde"]
[149.957713, "i", "x=False)\n\nprint(\"\\nDone!\")\nEOF\n"]
