[341.593347, "i", "python3 -c \"\nimport pandas as pd\nimport numpy as np\n\n# Verify outputs\nd = pd.read_csv('/app/output_diabetes_data.csv')\nh = pd.read_csv('/app/output_heart.csv')\n\nprint('Diabetes output:')\nprint(f'  Columns: {d.columns.tolist()}')\nprint(f'  Rows: {len(d)}')\nprint(f'  Values: {sorted(d[\\\"pseudo_label\\\"].unique().tolist())}')\nprint(f'  Distribution: {d[\\\"pseudo_label\\\"].value_counts().to_dict()}')\n\nprint('\\nHeart output:')\nprint(f'  Columns: {h.columns.tolist()}')\nprint(f'  Rows: {len(h)}')\nprint(f'  Values: {sorted(h[\\\"pseudo_label\\\"].unique().tolist())}')\nprint(f'  Distribution: {h[\\\"pseudo_label\\\"].value_counts().to_dict()}')\nprint('\\nAll checks passed!')\n\"\n"]
