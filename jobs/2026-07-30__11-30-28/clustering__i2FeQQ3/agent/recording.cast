[68.497566, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.497748, "o", "> "]
[68.498452, "o", "df_diabetes_features = df_diabetes.drop(columns=['gender'])"]
[68.498637, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.499025, "o", "> "]
[68.499059, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.499455, "o", "> "]
[68.500223, "o", "# All features are now numeric. Scale age, keep binary features as-is"]
[68.500529, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.500808, "o", "> "]
[68.501315, "o", "numerical_cols_d = ['age']\r\n"]
[68.501555, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[68.502548, "o", "categorical_cols_d = [c for c in df_diabetes_features.columns if c != 'age']\r\n"]
[68.502616, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.502958, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[68.503057, "o", "> "]
[68.50385, "o", "# Approach 1: Scale age, keep binary as-is, use KMeans\r\n"]
[68.503886, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.50552, "o", "> X_diabetes = df_diabetes_features.copy()\r\n\u001b[?2004l\r\u001b[?2004h> scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_diabetes['age'] = scaler.fit_transform(X_diabetes[['age']])\r\n\u001b[?2004l\r\u001b[?2004h> X_d = X_diabetes.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try multiple algorithms\r\n\u001b[?2004l\r\u001b[?2004h> results_diabetes = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # KMeans\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.506095, "o", "km = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)"]
[68.506309, "o", "\r\n"]
[68.506594, "o", "\u001b[?2004l\r"]
[68.506842, "o", "\u001b[?2004h"]
[68.507056, "o", "> "]
[68.507699, "o", "results_diabetes['kmeans'] = km.fit_predict(X_d)\r\n"]
[68.507925, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.508105, "o", "> "]
[68.509383, "o", "\r\n"]
[68.509416, "o", "\u001b[?2004l\r\u001b[?2004h> # GMM\r\n\u001b[?2004l\r\u001b[?2004h> gmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n\u001b[?2004l\r\u001b[?2004h> results_diabetes['gmm'] = gmm.fit_predict(X_d)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Agglomerative\r\n\u001b[?2004l\r\u001b[?2004h> agg = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.51008, "o", "results_diabetes['agg'] = agg.fit_predict(X_d)"]
[68.510294, "o", "\r\n"]
[68.510537, "o", "\u001b[?2004l\r"]
[68.510789, "o", "\u001b[?2004h"]
[68.511026, "o", "> "]
[68.511252, "o", "\r\n"]
[68.511479, "o", "\u001b[?2004l\r"]
[68.511728, "o", "\u001b[?2004h"]
[68.511985, "o", "> "]
[68.512351, "o", "# Try with PCA"]
[68.514383, "o", "\r\n"]
[68.514417, "o", "\u001b[?2004l\r\u001b[?2004h> pca = PCA(n_components=5)\r\n\u001b[?2004l\r\u001b[?2004h> X_d_pca = pca.fit_transform(X_d)\r\n\u001b[?2004l\r\u001b[?2004h> km_pca = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_diabetes['kmeans_pca'] = km_pca.fit_predict(X_d_pca)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 2: One-hot encode gender and use all features\r\n\u001b[?2004l\r\u001b[?2004h> df_d2 = df_diabetes.copy()\r\n\u001b[?2004l\r\u001b[?2004h> df_d2 = pd.get_dummies(df_d2, columns=['gender'], drop_first=False)\r\n\u001b[?2004l\r\u001b[?2004h> scaler2 = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.515074, "o", "df_d2['age'] = scaler2.fit_transform(df_d2[['age']])"]
[68.515289, "o", "\r\n"]
[68.515566, "o", "\u001b[?2004l\r"]
[68.51583, "o", "\u001b[?2004h"]
[68.516069, "o", "> "]
[68.516462, "o", "X_d2 = df_d2.values"]
[68.516692, "o", "\r\n"]
[68.516923, "o", "\u001b[?2004l\r"]
[68.517173, "o", "\u001b[?2004h"]
[68.517443, "o", "> "]
[68.517715, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.517946, "o", "> "]
[68.518755, "o", "km2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)"]
[68.51901, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.519218, "o", "> "]
[68.519965, "o", "results_diabetes['kmeans_onehot'] = km2.fit_predict(X_d2)\r\n"]
[68.52018, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.520209, "o", "> "]
[68.520607, "o", "\r\n\u001b[?2004l\r"]
[68.520777, "o", "\u001b[?2004h"]
[68.520931, "o", "> "]
[68.521943, "o", "# Approach 3: Weight the important features (polyuria, polydipsia are key diabetes symptoms)"]
[68.522185, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.522228, "o", "> "]
[68.52284, "o", "X_d3 = df_diabetes_features.copy()\r\n"]
[68.522984, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.523149, "o", "> "]
[68.523834, "o", "X_d3['age'] = scaler.fit_transform(X_d3[['age']])"]
[68.525383, "o", "\r\n"]
[68.525415, "o", "\u001b[?2004l\r\u001b[?2004h> # Give more weight to key diabetes symptoms\r\n\u001b[?2004l\r\u001b[?2004h> for col in ['polyuria', 'polydipsia', 'sudden_weight_loss', 'polyphagia', 'gender_encoded']:\r\n\u001b[?2004l\r\u001b[?2004h>     if col in X_d3.columns:\r\n\u001b[?2004l\r\u001b[?2004h>         X_d3[col] = X_d3[col] * 2.0\r\n\u001b[?2004l\r\u001b[?2004h> X_d3_vals = X_d3.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.525829, "o", "km3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)"]
[68.526039, "o", "\r\n"]
[68.526275, "o", "\u001b[?2004l\r"]
[68.526544, "o", "\u001b[?2004h"]
[68.526788, "o", "> "]
[68.527557, "o", "results_diabetes['kmeans_weighted'] = km3.fit_predict(X_d3_vals)"]
[68.527849, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.528095, "o", "> "]
[68.529378, "o", "\r\n\u001b[?2004l\r"]
[68.52941, "o", "\u001b[?2004h> gmm3 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n\u001b[?2004l\r\u001b[?2004h> results_diabetes['gmm_weighted'] = gmm3.fit_predict(X_d3_vals)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Try spectral clustering\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.52986, "o", "spec = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)"]
[68.53008, "o", "\r\n"]
[68.530266, "o", "\u001b[?2004l\r"]
[68.53053, "o", "\u001b[?2004h"]
[68.530782, "o", "> "]
[68.531225, "o", "results_diabetes['spectral'] = spec.fit_predict(X_d)"]
[68.531486, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.531754, "o", "> "]
[68.531779, "o", "\r\n\u001b[?2004l\r"]
[68.532197, "o", "\u001b[?2004h"]
[68.532441, "o", "> "]
[68.532469, "o", "# Print cluster sizes for each approach"]
[68.532915, "o", "\r\n"]
[68.533212, "o", "\u001b[?2004l\r"]
[68.533278, "o", "\u001b[?2004h"]
[68.533772, "o", "> print(\"\\nDiabetes cluster sizes:\")"]
[68.533983, "o", "\r\n"]
[68.534104, "o", "\u001b[?2004l\r"]
[68.534375, "o", "\u001b[?2004h"]
[68.534816, "o", "> "]
[68.534852, "o", "for name, labels in results_diabetes.items():"]
[68.535102, "o", "\r\n"]
[68.535185, "o", "\u001b[?2004l\r"]
[68.537429, "o", "\u001b[?2004h>     unique, counts = np.unique(labels, return_counts=True)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {name}: {dict(zip(unique, counts))}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Choose the weighted kmeans approach (polyuria/polydipsia are strong indicators of diabetes)\r\n\u001b[?2004l\r\u001b[?2004h> # The ground truth is likely diabetes positive/negative\r\n\u001b[?2004l\r\u001b[?2004h> best_diabetes = results_diabetes['kmeans_weighted']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save diabetes results\r\n\u001b[?2004l\r\u001b[?2004h> out_d = pd.DataFrame({'pseudo_label': best_diabetes})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.537785, "o", "out_d.to_csv('/app/output_diabetes_data.csv', index=False)"]
[68.538026, "o", "\r\n"]
[68.538257, "o", "\u001b[?2004l\r"]
[68.538528, "o", "\u001b[?2004h"]
[68.538769, "o", "> "]
[68.539333, "o", "print(f\"\\nSaved diabetes results. Cluster distribution: {np.bincount(best_diabetes)}\")"]
[68.539568, "o", "\r\n"]
[68.539791, "o", "\u001b[?2004l\r"]
[68.540042, "o", "\u001b[?2004h"]
[68.540273, "o", "> "]
[68.540517, "o", "\r\n"]
[68.540777, "o", "\u001b[?2004l\r\u001b[?2004h"]
[68.541132, "o", "> # ===== HEART DATASET ====="]
[68.541314, "o", "\r\n"]
[68.541596, "o", "\u001b[?2004l\r"]
[68.541825, "o", "\u001b[?2004h"]
[68.543371, "o", "> "]
[68.543402, "o", "print(\"\\nProcessing heart dataset...\")\r\n\u001b[?2004l\r\u001b[?2004h> df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> numerical_cols_h = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r\u001b[?2004h> categorical_cols_h = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results_heart = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.543823, "o", "# Approach 1: One-hot encode categoricals, scale numericals"]
[68.544032, "o", "\r\n"]
[68.544255, "o", "\u001b[?2004l\r"]
[68.54452, "o", "\u001b[?2004h"]
[68.544755, "o", "> "]
[68.545072, "o", "df_h1 = df_heart.copy()"]
[68.545302, "o", "\r\n"]
[68.545534, "o", "\u001b[?2004l\r"]
[68.545786, "o", "\u001b[?2004h"]
[68.546364, "o", "> "]
[68.546558, "o", "df_h1_cat = pd.get_dummies(df_h1[categorical_cols_h], columns=categorical_cols_h)"]
[68.546746, "o", "\r\n"]
[68.546966, "o", "\u001b[?2004l\r"]
[68.547221, "o", "\u001b[?2004h"]
[68.549377, "o", "> "]
[68.549409, "o", "scaler_h = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> df_h1_num = pd.DataFrame(scaler_h.fit_transform(df_h1[numerical_cols_h]), columns=numerical_cols_h)\r\n\u001b[?2004l\r\u001b[?2004h> X_h1 = pd.concat([df_h1_num, df_h1_cat], axis=1).values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> km_h1 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_heart['kmeans_onehot'] = km_h1.fit_predict(X_h1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.549699, "o", "gmm_h1 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)"]
[68.54984, "o", "\r\n\u001b[?2004l\r"]
[68.549945, "o", "\u001b[?2004h> "]
[68.550313, "o", "results_heart['gmm_onehot'] = gmm_h1.fit_predict(X_h1)\r\n\u001b[?2004l\r"]
[68.550381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.55056, "o", "agg_h1 = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.550847, "o", "results_heart['agg_onehot'] = agg_h1.fit_predict(X_h1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.550953, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.551241, "o", "# Approach 2: Scale all features as numeric (treat categoricals as ordinal)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.551307, "o", "> "]
[68.551416, "o", "df_h2 = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.551444, "o", "> "]
[68.554462, "o", "scaler_h2 = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_h2 = scaler_h2.fit_transform(df_h2.values)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> km_h2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_heart['kmeans_allscaled'] = km_h2.fit_predict(X_h2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> gmm_h2 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n\u001b[?2004l\r\u001b[?2004h> results_heart['gmm_allscaled'] = gmm_h2.fit_predict(X_h2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 3: Feature weighting - key heart disease indicators\r\n\u001b[?2004l\r\u001b[?2004h> df_h3 = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> scaler_h3 = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_h3 = pd.DataFrame(scaler_h3.fit_transform(df_h3.values), columns=df_h3.columns)\r\n\u001b[?2004l\r\u001b[?2004h> # Weight important features for heart disease\r\n\u001b[?2004l\r\u001b[?2004h> for col in ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']:\r\n\u001b[?2004l\r\u001b[?2004h>     X_h3[col] = X_h3[col] * 1.5\r\n\u001b[?2004l\r\u001b["]
[68.554511, "o", "?2004h> X_h3_vals = X_h3.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.554764, "o", "km_h3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.554909, "o", "results_heart['kmeans_weighted'] = km_h3.fit_predict(X_h3_vals)\r\n\u001b[?2004l\r"]
[68.554945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.554979, "o", "\u001b[?2004h"]
[68.554996, "o", "> "]
[68.555318, "o", "gmm_h3 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\r\n\u001b[?2004l\r"]
[68.55542, "o", "\u001b[?2004h"]
[68.555443, "o", "> "]
[68.555645, "o", "results_heart['gmm_weighted'] = gmm_h3.fit_predict(X_h3_vals)\r\n\u001b[?2004l\r"]
[68.555674, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.555773, "o", "\u001b[?2004h> "]
[68.555935, "o", "# Approach 4: PCA + clustering\r\n\u001b[?2004l\r"]
[68.556021, "o", "\u001b[?2004h> "]
[68.556104, "o", "pca_h = PCA(n_components=5)\r\n\u001b[?2004l\r"]
[68.556211, "o", "\u001b[?2004h> "]
[68.556306, "o", "X_h_pca = pca_h.fit_transform(X_h1)\r\n\u001b[?2004l\r"]
[68.556471, "o", "\u001b[?2004h> "]
[68.558411, "o", "km_h_pca = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_heart['kmeans_pca'] = km_h_pca.fit_predict(X_h_pca)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Spectral\r\n\u001b[?2004l\r\u001b[?2004h> spec_h = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_heart['spectral'] = spec_h.fit_predict(X_h2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Print cluster sizes\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nHeart cluster sizes:\")\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in results_heart.items():\r\n\u001b[?2004l\r\u001b[?2004h>     unique, counts = np.unique(labels, return_counts=True)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {name}: {dict(zip(unique, counts))}\")\r\n\u001b[?2004l\r"]
[68.558641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.558779, "o", "# Choose gmm_weighted as it's likely to capture the structure well\r\n\u001b[?2004l\r"]
[68.55891, "o", "\u001b[?2004h> "]
[68.559029, "o", "best_heart = results_heart['gmm_weighted']\r\n\u001b[?2004l\r"]
[68.559124, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.559253, "o", "# Save heart results\r\n\u001b[?2004l\r"]
[68.559297, "o", "\u001b[?2004h> "]
[68.559514, "o", "out_h = pd.DataFrame({'pseudo_label': best_heart})\r\n\u001b[?2004l\r"]
[68.559684, "o", "\u001b[?2004h> "]
[68.55979, "o", "out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r"]
[68.559827, "o", "\u001b[?2004h> "]
