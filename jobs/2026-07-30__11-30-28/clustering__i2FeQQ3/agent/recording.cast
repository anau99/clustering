[16.865501, "o", "from sklearn.cluster import SpectralClustering\r\n"]
[16.865661, "o", "\r\n\r\ndef spectral(X, k):\r\n    model = SpectralClustering(\r\n        n_clusters=k,\r\n        affinity=\"nearest_neighbors\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
