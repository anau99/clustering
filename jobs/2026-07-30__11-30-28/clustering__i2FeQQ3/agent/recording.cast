[17.198044, "o", "cat /app/src/transform/OnehotEncoder.py\r\n\u001b[?2004l\r"]
[17.200779, "o", "import pandas as pd"]
[17.20141, "o", "\r\n"]
[17.201609, "o", "from sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\ndef one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n"]
[17.202251, "o", "    result = df.copy()\r\n    if columns is not None:"]
[17.202441, "o", "\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n"]
[17.202479, "o", "\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, encoded_df], axis=1)\r\n"]
[17.203045, "o", "\r\n    return result"]
