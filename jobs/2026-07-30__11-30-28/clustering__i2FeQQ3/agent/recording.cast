[68.47449, "i", "cat > /app/solve.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nimport sys\nsys.path.insert(0, '/app/src')\n\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.cluster import KMeans, SpectralClustering, AgglomerativeClustering\nfrom sklearn.mixture import GaussianMixture\nfrom sklearn.decomposition import PCA\n\n# ===== DIABETES DATASET =====\nprint(\"Processing diabetes dataset...\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\n\n# Encode gender as binary\ndf_diabetes['gender_encoded'] = (df_diabetes['gender'] == 'Male').astype(int)\ndf_diabetes_features = df_diabetes.drop(columns=['gender'])\n\n# All features are now numeric. Scale age, keep binary features as-is\nnumerical_cols_d = ['age']\ncategorical_cols_d = [c for c in df_diabetes_features.columns if c != 'age']\n\n# Approach 1: Scale age, keep binary as-is, use KMeans\nX_diabetes = df_diabetes_features.copy()\nscaler = StandardScaler()\nX_diabetes['age'] = scaler.fit_transform(X_diabetes[['age']])\nX_d = X_diabetes.values\n\n# Try multipl"]
[68.474535, "i", "e algorithms\nresults_diabetes = {}\n\n# KMeans\nkm = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans'] = km.fit_predict(X_d)\n\n# GMM\ngmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_diabetes['gmm'] = gmm.fit_predict(X_d)\n\n# Agglomerative\nagg = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_diabetes['agg'] = agg.fit_predict(X_d)\n\n# Try with PCA\npca = PCA(n_components=5)\nX_d_pca = pca.fit_transform(X_d)\nkm_pca = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans_pca'] = km_pca.fit_predict(X_d_pca)\n\n# Approach 2: One-hot encode gender and use all features\ndf_d2 = df_diabetes.copy()\ndf_d2 = pd.get_dummies(df_d2, columns=['gender'], drop_first=False)\nscaler2 = StandardScaler()\ndf_d2['age'] = scaler2.fit_transform(df_d2[['age']])\nX_d2 = df_d2.values\n\nkm2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans_onehot'] = km2.fit_predict"]
[68.474555, "i", "(X_d2)\n\n# Approach 3: Weight the important features (polyuria, polydipsia are key diabetes symptoms)\nX_d3 = df_diabetes_features.copy()\nX_d3['age'] = scaler.fit_transform(X_d3[['age']])\n# Give more weight to key diabetes symptoms\nfor col in ['polyuria', 'polydipsia', 'sudden_weight_loss', 'polyphagia', 'gender_encoded']:\n    if col in X_d3.columns:\n        X_d3[col] = X_d3[col] * 2.0\nX_d3_vals = X_d3.values\n\nkm3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_diabetes['kmeans_weighted'] = km3.fit_predict(X_d3_vals)\n\ngmm3 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_diabetes['gmm_weighted'] = gmm3.fit_predict(X_d3_vals)\n\n# Try spectral clustering\nspec = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)\nresults_diabetes['spectral'] = spec.fit_predict(X_d)\n\n# Print cluster sizes for each approach\nprint(\"\\nDiabetes cluster sizes:\")\nfor name, labels in results_diabetes.items():\n    unique, co"]
[68.47458, "i", "unts = np.unique(labels, return_counts=True)\n    print(f\"  {name}: {dict(zip(unique, counts))}\")\n\n# Choose the weighted kmeans approach (polyuria/polydipsia are strong indicators of diabetes)\n# The ground truth is likely diabetes positive/negative\nbest_diabetes = results_diabetes['kmeans_weighted']\n\n# Save diabetes results\nout_d = pd.DataFrame({'pseudo_label': best_diabetes})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nSaved diabetes results. Cluster distribution: {np.bincount(best_diabetes)}\")\n\n# ===== HEART DATASET =====\nprint(\"\\nProcessing heart dataset...\")\ndf_heart = pd.read_csv('/app/heart.csv')\n\nnumerical_cols_h = ['trestbps', 'chol', 'thalach', 'oldpeak']\ncategorical_cols_h = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\n\nresults_heart = {}\n\n# Approach 1: One-hot encode categoricals, scale numericals\ndf_h1 = df_heart.copy()\ndf_h1_cat = pd.get_dummies(df_h1[categorical_cols_h], columns=categorical_cols_h)\nscaler_h = StandardScaler()\ndf_h1_num = pd.DataFrame(s"]
[68.481405, "i", "caler_h.fit_transform(df_h1[numerical_cols_h]), columns=numerical_cols_h)\nX_h1 = pd.concat([df_h1_num, df_h1_cat], axis=1).values\n\nkm_h1 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_onehot'] = km_h1.fit_predict(X_h1)\n\ngmm_h1 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_onehot'] = gmm_h1.fit_predict(X_h1)\n\nagg_h1 = AgglomerativeClustering(n_clusters=2, linkage='ward')\nresults_heart['agg_onehot'] = agg_h1.fit_predict(X_h1)\n\n# Approach 2: Scale all features as numeric (treat categoricals as ordinal)\ndf_h2 = df_heart.copy()\nscaler_h2 = StandardScaler()\nX_h2 = scaler_h2.fit_transform(df_h2.values)\n\nkm_h2 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_allscaled'] = km_h2.fit_predict(X_h2)\n\ngmm_h2 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_allscaled'] = gmm_h2.fit_predict(X_h2)\n\n# Approach 3: Feature weighti"]
[68.481442, "i", "ng - key heart disease indicators\ndf_h3 = df_heart.copy()\nscaler_h3 = StandardScaler()\nX_h3 = pd.DataFrame(scaler_h3.fit_transform(df_h3.values), columns=df_h3.columns)\n# Weight important features for heart disease\nfor col in ['cp', 'thalach', 'oldpeak', 'ca', 'thal', 'exang', 'slope']:\n    X_h3[col] = X_h3[col] * 1.5\nX_h3_vals = X_h3.values\n\nkm_h3 = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_weighted'] = km_h3.fit_predict(X_h3_vals)\n\ngmm_h3 = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=10)\nresults_heart['gmm_weighted'] = gmm_h3.fit_predict(X_h3_vals)\n\n# Approach 4: PCA + clustering\npca_h = PCA(n_components=5)\nX_h_pca = pca_h.fit_transform(X_h1)\nkm_h_pca = KMeans(n_clusters=2, init='k-means++', n_init=50, random_state=42)\nresults_heart['kmeans_pca'] = km_h_pca.fit_predict(X_h_pca)\n\n# Spectral\nspec_h = SpectralClustering(n_clusters=2, affinity='nearest_neighbors', n_neighbors=10, random_state=42)\nresults_heart['spectral'] = spec_"]
[68.48146, "i", "h.fit_predict(X_h2)\n\n# Print cluster sizes\nprint(\"\\nHeart cluster sizes:\")\nfor name, labels in results_heart.items():\n    unique, counts = np.unique(labels, return_counts=True)\n    print(f\"  {name}: {dict(zip(unique, counts))}\")\n\n# Choose gmm_weighted as it's likely to capture the structure well\nbest_heart = results_heart['gmm_weighted']\n\n# Save heart results\nout_h = pd.DataFrame({'pseudo_label': best_heart})\nout_h.to_csv('/app/output_heart.csv', index=False)\nprint(f\"\\nSaved heart results. Cluster distribution: {np.bincount(best_heart)}\")\n\nprint(\"\\nDone!\")\nEOF\n"]
