[258.515545, "o", "scaler_d = StandardScaler()\r\n\u001b[?2004l\r"]
[258.515757, "o", "\u001b[?2004h> "]
[258.517417, "o", "df_features['age'] = scaler_d.fit_transform(df_features[['age']])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Weight features by importance for diabetes prediction\r\n\u001b[?2004l\r\u001b[?2004h> X_d_weighted = df_features.copy()\r\n\u001b[?2004l\r\u001b[?2004h> importance_d = {\r\n\u001b[?2004l\r\u001b[?2004h>     'polyuria': 4.0, 'polydipsia': 4.0, 'sudden_weight_loss': 2.5,\r\n\u001b[?2004l\r\u001b[?2004h>     'polyphagia': 2.0, 'irritability': 2.0, 'partial_paresis': 2.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.517684, "o", "    'gender_num': 2.0, 'weakness': 1.0, 'genital_thrush': 1.5,\r\n\u001b[?2004l\r"]
[258.517932, "o", "\u001b[?2004h> "]
[258.518336, "o", "    'visual_blurring': 1.0, 'itching': 0.5, 'delayed_healing': 0.5,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.519441, "o", "    'muscle_stiffness': 0.5, 'alopecia': 0.5, 'obesity': 0.5, 'age': 0.5\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for col, w in importance_d.items():\r\n\u001b[?2004l\r\u001b[?2004h>     if col in X_d_weighted.columns:\r\n\u001b[?2004l\r\u001b[?2004h>         X_d_weighted[col] = X_d_weighted[col] * w\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_d_w = X_d_weighted.values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Multiple methods\r\n\u001b[?2004l\r\u001b[?2004h> results_d = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[258.519469, "o", "> "]
[258.519721, "o", "# GMM on score\r\n\u001b[?2004l\r_h[col] - df_\u001b[?2004h> "]
[258.519877, "o", "results_d['gmm_score'] = labels_d_score\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.519975, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.520177, "o", "# KMeans on weighted features\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.520203, "o", "> "]
[258.520606, "o", "km_d = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r"]
[258.520687, "o", "\u001b[?2004h> "]
[258.520941, "o", "results_d['kmeans_w'] = km_d.fit_predict(X_d_w)\r\n\u001b[?2004l\r"]
[258.520971, "o", "\u001b[?2004h"]
[258.520997, "o", "> "]
[258.521019, "o", "\r\n"]
[258.521035, "o", "\u001b[?2004l\r"]
[258.521076, "o", "\u001b[?2004h"]
[258.521099, "o", "> "]
[258.521255, "o", "# GMM on weighted features  \r\n\u001b[?2004l\r"]
[258.52129, "o", "\u001b[?2004h"]
[258.521311, "o", "> "]
[258.521968, "o", "gmm_dw = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n\u001b[?2004l\r"]
[258.521999, "o", "\u001b[?2004h> "]
[258.522034, "o", "results_d['gmm_w'] = gmm_dw.fit_predict(X_d_w)\r\n\u001b[?2004l\r"]
[258.522077, "o", "\u001b[?2004h"]
[258.522104, "o", "> \r\n\u001b[?2004l\r"]
[258.522672, "o", "\u001b[?2004h> # Agglomerative on weighted features\r\n\u001b[?2004l\r\u001b[?2004h> agg_d = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.522943, "o", "results_d['agg_w'] = agg_d.fit_predict(X_d_w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.523106, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.523295, "o", "# Rule-based (polyuria OR polydipsia)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.523754, "o", "results_d['rule_or'] = ((df_diabetes['polyuria'] == 1) | (df_diabetes['polydipsia'] == 1)).astype(int).values\r\n\u001b[?2004l\r"]
[258.523845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[258.523935, "o", "> "]
[258.524022, "o", "# Consensus approach: majority vote\r\n"]
[258.524098, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[258.524416, "o", "all_labels_d = np.array([results_d[k] for k in results_d.keys()])\r\n\u001b[?2004l\r"]
[258.524498, "o", "\u001b[?2004h"]
[258.524642, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.525462, "o", "# Check agreement between methods\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nAgreement between diabetes methods (ARI):\")\r\n\u001b[?2004l\r\u001b[?2004h> keys = list(results_d.keys())\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(len(keys)):\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(i+1, len(keys)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.525672, "o", "        ari = adjusted_rand_score(results_d[keys[i]], results_d[keys[j]])\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.52586, "o", ">         if ari > 0.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.526135, "o", "            print(f\"  {keys[i]} vs {keys[j]}: ARI={ari:.4f}\")\r\n\u001b[?2004l\r"]
[258.526318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.526516, "o", "\u001b[?2004h> "]
[258.527376, "o", "print(\"\\nDiabetes cluster sizes:\")\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in results_d.items():\r\n\u001b[?2004l\r\u001b[?2004h>     unique, counts = np.unique(labels, return_counts=True)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {name}: {dict(zip(unique, counts))}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Choose: use the GMM on weighted features - it should capture the structure well\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.527653, "o", "# The rule-based is good but may miss edge cases; GMM can handle the uncertainty\r\n\u001b[?2004l\r"]
[258.527751, "o", "\u001b[?2004h> "]
[258.528218, "o", "# Actually, let's use the one that best matches expected ~320/200 split\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.529004, "o", "# Expected: 320 positive, 200 negative = 61.5%/38.5%\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> best_d_name = None\r\n\u001b[?2004l\r\u001b[?2004h> best_d_diff = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> target_ratio = 320.0 / 520.0  # ~0.615\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.529197, "o", "for name, labels in results_d.items():\r\n\u001b[?2004l\r"]
[258.52922, "o", "\u001b[?2004h"]
[258.529233, "o", "> "]
[258.529554, "o", "    counts = np.bincount(labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.529719, "o", "    ratio = max(counts) / sum(counts)\r\n\u001b[?2004l\r"]
[258.529745, "o", "\u001b[?2004h"]
[258.529758, "o", "> "]
[258.53009, "o", "    diff = abs(ratio - target_ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.530158, "o", "    if diff < best_d_diff:\r\n\u001b[?2004l\r"]
[258.530343, "o", "\u001b[?2004h>         best_d_diff = diff"]
[258.530366, "o", "\r\n\u001b[?2004l\r"]
[258.530603, "o", "\u001b[?2004h> "]
[258.531384, "o", "        best_d_name = name\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nBest match to expected distribution: {best_d_name}\")\r\n\u001b[?2004l\r\u001b[?2004h> best_d = results_d[best_d_name]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Actually, let's prefer the rule-based approach since polyuria/polydipsia are \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.531506, "o", "# known to be extremely strong predictors (>95% accuracy)\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.531533, "o", "> "]
[258.531875, "o", "# But let me also try the GMM on score which uses composite information\r\n\u001b[?2004l\r"]
[258.531957, "o", "\u001b[?2004h> "]
[258.532385, "o", "# Use the method that most other methods agree with\r\n\u001b[?2004l\r\u001b[?2004h> agreement_scores = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.532484, "o", "for name in results_d:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.533382, "o", "    avg_ari = np.mean([adjusted_rand_score(results_d[name], results_d[other]) \r\n\u001b[?2004l\r\u001b[?2004h>                        for other in results_d if other != name])\r\n\u001b[?2004l\r\u001b[?2004h>     agreement_scores[name] = avg_ari\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nAverage agreement with other methods:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.533751, "o", "for name, score in sorted(agreement_scores.items(), key=lambda x: -x[1]):\r\n\u001b[?2004l\r"]
[258.533982, "o", "\u001b[?2004h"]
[258.53401, "o", ">     print(f\"  {name}: {score:.4f}\")\r\n\u001b[?2004l\r X_\u001b[?2004h"]
[258.534154, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.534488, "o", "# Use the method with highest average agreement\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.534716, "o", "best_consensus_name = max(agreement_scores, key=agreement_scores.get)\r\n\u001b[?2004l\r"]
[258.53482, "o", "\u001b[?2004h> "]
[258.535393, "o", "print(f\"\\nUsing consensus winner: {best_consensus_name}\")\r\n\u001b[?2004l\r\u001b[?2004h> best_d = results_d[best_consensus_name]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save\r\n\u001b[?2004l\r\u001b[?2004h> out_d = pd.DataFrame({'pseudo_label': best_d})\r\n\u001b[?2004l\r"]
[258.535569, "o", "\u001b[?2004h> "]
[258.535764, "o", "out_d.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r"]
[258.535848, "o", "\u001b[?2004h> "]
[258.536071, "o", "print(f\"Saved diabetes: {np.bincount(best_d)}\")\r\n\u001b[?2004l\r"]
[258.536154, "o", "\u001b[?2004h"]
[258.536187, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.53636, "o", "# ===== HEART DATASET =====\r\n\u001b[?2004l\r"]
[258.536499, "o", "\u001b[?2004h> "]
[258.536595, "o", "print(\"\\n\" + \"=\"*50)\r\n\u001b[?2004l\r"]
[258.537371, "o", "\u001b[?2004h> print(\"HEART DATASET\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=\"*50)\r\n\u001b[?2004l\r\u001b[?2004h> df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> numerical_cols = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.537576, "o", "categorical_cols = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\rope\u001b[?2004h> "]
[258.537607, "o", "\r\n\u001b[?2004l\r"]
[258.537625, "o", "\u001b[?2004h"]
[258.537727, "o", "> "]
[258.537887, "o", "# Domain knowledge for heart disease:\r\n\u001b[?2004l\r"]
[258.538308, "o", "\u001b[?2004h> "]
[258.538704, "o", "# In UCI heart dataset (Cleveland), the label is presence/absence of heart disease\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.539141, "o", "# Key features: cp (chest pain - value 0 = typical angina, most indicative of disease in some encodings)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.53969, "o", "# In many versions: cp=0 is typical angina (high risk), but in others the encoding is reversed\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.539866, "o", "> # thalach: lower max heart rate = more risk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.540217, "o", "# oldpeak: higher ST depression = more risk  \r\n\u001b[?2004l\r\u001b[?2004h"]
[258.540391, "o", "> # ca: more vessels colored = more risk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.540675, "o", "# thal: normal=1, fixed_defect=2, reversible_defect=3 (2,3 = more risk)\r\n\u001b[?2004l\r"]
[258.540799, "o", "\u001b[?2004h> "]
[258.541423, "o", "# exang: 1 = exercise angina = more risk\r\n\u001b[?2004l\r\u001b[?2004h> # slope: 0=upsloping(good), 1=flat(moderate), 2=downsloping(bad) - varies by encoding\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.541984, "o", "# Create a composite risk score\r\n\u001b[?2004l\r\u001b[?2004h> df_h = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Standardize numerical features\r\n\u001b[?2004l\r\u001b[?2004h> for col in numerical_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.542189, "o", "    df_h[col + '_std'] = (df_h[col] - df_h[col].mean()) / df_h[col].std()\r\n\u001b[?2004l\r"]
[258.542315, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.542627, "o", "# In this dataset, cp seems to be encoded as 0,1,2,3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.542949, "o", "# In standard UCI: 1=typical angina, 2=atypical, 3=non-anginal, 4=asymptomatic\r\n\u001b[?2004l\r"]
[258.543376, "o", "\u001b[?2004h> # Here 0-indexed: 0=typical angina, 1=atypical, 2=non-anginal, 3=asymptomatic\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.543688, "o", "# Asymptomatic (3) is actually most associated with disease presence!\r\n\u001b[?2004l\r"]
[258.543798, "o", "\u001b[?2004h"]
[258.543823, "o", "> "]
[258.545362, "o", "# Wait no - in the processed Cleveland dataset, cp=4 (asymptomatic) is most common in disease\r\n\u001b[?2004l\r\u001b[?2004h> # So higher cp number = less typical symptoms = counterintuitively MORE disease\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Actually let me reconsider. In UCI heart:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.545555, "o", "# cp: chest pain type (0: typical angina, 1: atypical angina, 2: non-anginal pain, 3: asymptomatic)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.545825, "o", "# People with asymptomatic chest pain (cp=3) are actually MORE likely to have heart disease\r\n\u001b[?2004l\r"]
[258.545852, "o", "\u001b[?2004h"]
[258.54587, "o", "> "]
[258.546112, "o", "# thalach: maximum heart rate - LOWER is worse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.546255, "o", "# oldpeak: ST depression - HIGHER is worse\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.546286, "o", "> "]
[258.546468, "o", "# exang: exercise-induced angina - 1 is worse\r\n\u001b[?2004l\r"]
[258.546495, "o", "\u001b[?2004h"]
[258.546568, "o", "> "]
[258.546797, "o", "# slope: 0=upsloping(better), 1=flat(moderate), 2=downsloping(worse)\r\n\u001b[?2004l\r"]
[258.54683, "o", "\u001b[?2004h> "]
[258.547123, "o", "# ca: number of major vessels colored by fluoroscopy (0-4) - HIGHER is worse\r\n\u001b[?2004l\r"]
[258.547336, "o", "\u001b[?2004h> "]
[258.547428, "o", "# thal: 0=normal, 1=fixed defect, 2=reversible defect, 3=? \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.547686, "o", "# Actually thal values: 1=normal, 2=fixed defect, 3=reversible defect in many encodings\r\n\u001b[?2004l\r"]
[258.547829, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.547942, "o", "\u001b[?2004h> # Create risk score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.548014, "o", "risk_score = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.548226, "o", "    df_h['cp'] * 2.0 +  # higher cp = asymptomatic = more disease\r\n\u001b[?2004l\r"]
[258.5483, "o", "\u001b[?2004h> "]
[258.5485, "o", "    (-df_h['thalach_std']) * 1.5 +  # lower max HR = more risk\r\n\u001b[?2004l\r"]
[258.54859, "o", "\u001b[?2004h> "]
[258.548814, "o", "    df_h['oldpeak_std'] * 2.0 +  # higher ST depression = more risk\r\n\u001b[?2004l\r"]
[258.548948, "o", "\u001b[?2004h"]
[258.548977, "o", "> "]
[258.549129, "o", "    df_h['exang'] * 2.5 +  # exercise angina = more risk\r\n\u001b[?2004l\r"]
[258.549183, "o", "\u001b[?2004h> "]
[258.549451, "o", "    df_h['ca'] * 3.0 +  # more vessels = more risk (very strong predictor)\r\n\u001b[?2004l\r"]
[258.549481, "o", "\u001b[?2004h"]
[258.549499, "o", "> "]
[258.549774, "o", "    (df_h['thal'] >= 2).astype(float) * 2.0 +  # defect = more risk\r\n\u001b[?2004l\r"]
[258.549909, "o", "\u001b[?2004h> "]
[258.550102, "o", "    df_h['slope'] * 1.0 +  # encoding-dependent\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.550133, "o", "> "]
[258.550401, "o", "    df_h['sex'] * 0.5 +  # male = slightly more risk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.550627, "o", "    df_h['trestbps_std'] * 0.5 +  # higher BP = more risk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.550834, "o", "    df_h['fbs'] * 0.5 +  # fasting blood sugar > 120 = more risk\r\n\u001b[?2004l\r"]
[258.550926, "o", "\u001b[?2004h> "]
[258.551166, "o", "    (-df_h['chol_std']) * 0.1  # chol is not very predictive\r\n\u001b[?2004l\r\u001b[?2004h"]
[258.551191, "o", "> )\r\n"]
[258.551209, "o", "\u001b[?2004l\r"]
[258.551304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[258.551494, "o", "> results_h = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.551574, "o", "\u001b[?2004h> "]
[258.551635, "o", "# GMM on risk score\r\n\u001b[?2004l\r"]
[258.551711, "o", "\u001b[?2004h> "]
[258.551905, "o", "risk_vals = risk_score.values.reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.552102, "o", "gmm_risk = GaussianMixture(n_components=2, random_state=42)\r\n\u001b[?2004l\r"]
[258.552235, "o", "\u001b[?2004h> "]
[258.552373, "o", "results_h['gmm_risk'] = gmm_risk.fit_predict(risk_vals)"]
[258.553376, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # KMeans on risk score\r\n\u001b[?2004l\r\u001b[?2004h> km_risk = KMeans(n_clusters=2, n_init=50, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> results_h['kmeans_risk'] = km_risk.fit_predict(risk_vals)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # All features standardized with weights\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.553457, "o", "scaler_h = StandardScaler()\r\n\u001b[?2004l\r"]
[258.553541, "o", "\u001b[?2004h> "]
[258.553705, "o", "X_h_all = scaler_h.fit_transform(df_heart.values)\r\n\u001b[?2004l\r"]
[258.553778, "o", "\u001b[?2004h> "]
[258.553979, "o", "X_h_df = pd.DataFrame(X_h_all, columns=df_heart.columns)\r\n\u001b[?2004l\r"]
[258.554037, "o", "\u001b[?2004h> "]
[258.554055, "o", "\r\n\u001b[?2004l\r"]
[258.554155, "o", "\u001b[?2004h> "]
[258.554228, "o", "# Weight by importance\r\n\u001b[?2004l\r"]
[258.554308, "o", "\u001b[?2004h"]
[258.554359, "o", "> weights_h = {\r\n\u001b[?2004l\r"]
[258.554434, "o", "\u001b[?2004h> "]
[258.554655, "o", "    'cp': 2.5, 'thalach': 2.0, 'oldpeak': 2.5, 'ca': 3.0, 'thal': 2.5,\r\n\u001b[?2004l\r"]
[258.554722, "o", "\u001b[?2004h> "]
[258.554905, "o", "    'exang': 2.5, 'slope': 2.0, 'sex': 1.0, 'age': 1.0,\r\n\u001b[?2004l\r"]
[258.554976, "o", "\u001b[?2004h> "]
[258.555227, "o", "    'trestbps': 0.8, 'chol': 0.5, 'fbs': 0.5, 'restecg': 1.0\r\n\u001b[?2004l\r"]
[258.555313, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[258.555444, "o", "\u001b[?2004h> "]
[258.555531, "o", "X_h_weighted = X_h_df.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.555676, "o", "for col, w in weights_h.items():\r\n\u001b[?2004l\r"]
[258.555747, "o", "\u001b[?2004h> "]
[258.555942, "o", "    X_h_weighted[col] = X_h_weighted[col] * w\r\n\u001b[?2004l\r"]
[258.556037, "o", "\u001b[?2004h> "]
[258.556138, "o", "X_h_w = X_h_weighted.values\r\n\u001b[?2004l\r"]
[258.55621, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.556306, "o", "# KMeans weighted\r\n\u001b[?2004l\r"]
[258.556435, "o", "\u001b[?2004h"]
[258.556538, "o", "> "]
[258.556682, "o", "km_hw = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r"]
[258.556777, "o", "\u001b[?2004h"]
[258.556876, "o", "> "]
[258.556966, "o", "results_h['kmeans_w'] = km_hw.fit_predict(X_h_w)\r\n\u001b[?2004l\r"]
[258.557053, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.55708, "o", "\u001b[?2004h> "]
[258.557194, "o", "# GMM weighted\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.557584, "o", "gmm_hw = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n"]
[258.557684, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[258.557835, "o", "results_h['gmm_w'] = gmm_hw.fit_predict(X_h_w)\r\n\u001b[?2004l\r"]
[258.5579, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.557965, "o", "\u001b[?2004h> "]
[258.559149, "o", "# Agglomerative weighted\r\n\u001b[?2004l\r\u001b[?2004h> agg_hw = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> results_h['agg_w'] = agg_hw.fit_predict(X_h_w)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Key features only\r\n\u001b[?2004l\r\u001b[?2004h> key_features_h = ['cp', 'thalach', 'oldpeak', 'exang', 'ca', 'thal', 'slope']\r\n\u001b[?2004l\r\u001b[?2004h> X_h_key = StandardScaler().fit_transform(df_heart[key_features_h])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[258.559245, "o", "> "]
[258.559514, "o", "km_key = KMeans(n_clusters=2, init='k-means++', n_init=100, random_state=42)\r\n\u001b[?2004l\r"]
[258.559589, "o", "\u001b[?2004h> "]
[258.559816, "o", "results_h['kmeans_key'] = km_key.fit_predict(X_h_key)\r\n\u001b[?2004l\r"]
[258.559895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.559996, "o", "\u001b[?2004h> "]
[258.560341, "o", "gmm_key = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=20)\r\n\u001b[?2004l\r"]
[258.560468, "o", "\u001b[?2004h> "]
[258.560606, "o", "results_h['gmm_key'] = gmm_key.fit_predict(X_h_key)\r\n\u001b[?2004l\r"]
[258.560716, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.560818, "o", "\u001b[?2004h> "]
[258.560992, "o", "agg_key = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r"]
[258.561061, "o", "\u001b[?2004h> "]
[258.561274, "o", "results_h['agg_key'] = agg_key.fit_predict(X_h_key)\r\n\u001b[?2004l\r"]
[258.561358, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.561386, "o", "\u001b[?2004h> "]
[258.561486, "o", "# Check agreement\r\n"]
[258.562364, "o", "\u001b[?2004l\r\u001b[?2004h> print(\"\\nHeart cluster sizes:\")\r\n\u001b[?2004l\r\u001b[?2004h> for name, labels in results_h.items():\r\n\u001b[?2004l\r\u001b[?2004h>     unique, counts = np.unique(labels, return_counts=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.56258, "o", "    print(f\"  {name}: {dict(zip(unique, counts))}\")\r\n\u001b[?2004l\r"]
[258.564355, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nAgreement between heart methods (ARI):\")\r\n\u001b[?2004l\r\u001b[?2004h> keys_h = list(results_h.keys())\r\n\u001b[?2004l\r\u001b[?2004h> agreement_h = {}\r\n\u001b[?2004l\r\u001b[?2004h> for name in results_h:\r\n\u001b[?2004l\r\u001b[?2004h>     avg_ari = np.mean([adjusted_rand_score(results_h[name], results_h[other]) \r\n\u001b[?2004l\r\u001b[?2004h>                        for other in results_h if other != name])\r\n\u001b[?2004l\r\u001b[?2004h>     agreement_h[name] = avg_ari\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for name, score in sorted(agreement_h.items(), key=lambda x: -x[1]):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {name}: {score:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.564466, "o", "# Use the one with highest agreement\r\n\u001b[?2004l\r"]
[258.56456, "o", "\u001b[?2004h> "]
[258.564775, "o", "best_h_name = max(agreement_h, key=agreement_h.get)\r\n\u001b[?2004l\r"]
[258.564831, "o", "\u001b[?2004h> "]
[258.565016, "o", "print(f\"\\nUsing consensus winner: {best_h_name}\")\r\n\u001b[?2004l\r"]
[258.565086, "o", "\u001b[?2004h> "]
[258.565214, "o", "best_h = results_h[best_h_name]\r\n\u001b[?2004l\r"]
[258.565334, "o", "\u001b[?2004h"]
[258.565401, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[258.565426, "o", "# Save\r\n\u001b[?2004l\r"]
[258.565549, "o", "\u001b[?2004h> "]
[258.565676, "o", "out_h = pd.DataFrame({'pseudo_label': best_h})\r\n\u001b[?2004l\r"]
[258.565699, "o", "\u001b[?2004h"]
[258.565816, "o", "> "]
[258.565947, "o", "out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r"]
[258.566013, "o", "\u001b[?2004h> "]
[258.566195, "o", "print(f\"Saved heart: {np.bincount(best_h)}\")\r\n\u001b[?2004l\r"]
[258.566297, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[258.566393, "o", "\u001b[?2004h> print(\"\\nDone!\")\r\n\u001b[?2004l\r"]
[258.566498, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[258.56839, "o", "\u001b[?2004hroot@e8904edca287:/app# "]
[258.988596, "i", "python3 /app/solve_final.py\n"]
[258.988877, "o", "python3 /app/solve_final.py\r\n\u001b[?2004l\r"]
