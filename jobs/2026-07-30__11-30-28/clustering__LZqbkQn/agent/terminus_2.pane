[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler, OneHotEncoder
[?2004l[?2004h> from sklearn.cluster import KMeans
