[?2004l[?2004h> combo_weights[-1] = 3.0  # disease score gets 3x weight
[?2004l[?2004h> candidates['combo_km'] = KMeans(n_clusters=2, n_init=20, random_state=42).fit_predict(X_combo * combo_weights)
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate all candidates
[?2004l[?2004h> print("\nCandidate evaluation (using multiple disease indicators):")
