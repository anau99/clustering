print("\n==[?2004h> # Approach 4: Create a "disease score" and cluster on it
[?2004l[?2004h> # Heart disease indicators (higher = more likely disease):
[?2004l[?2004h> # cp: 0 is typical angina (disease), 1,2,3 are less typical
[?2004l[?2004h> # thal: 2 (reversible defect) = disease, 3 = fixed defect = disease, 1 = normal
[?2004l[?2004h> # ca: higher = more vessels blocked = disease
[?2004l[?2004h> # exang: 1 = exercise angina = disease
[?2004l[?2004h> # oldpeak: higher = more ST depression = disease  
[?2004l[?2004h> # slope: 0 (downsloping) might indicate disease, 2 (upsloping) = normal
[?2004l[?2004h> # thalach: lower max heart rate = disease
[?2004l[?2004h> # sex: 1 (male) = higher risk
[?2004l[?2004h> 
[?2004l[?2004h> # Score approach
[?2004l[?2004h> df_score = df_heart.copy()
[?2004l[?2004h> score = np.zeros(len(df_score))
[?2004l[?2004h> score += (df_score['cp'] == 0).astype(float) * 2  # typical angina
[?2004l[?2004h> score += (df_score['thal'] >= 2).astype(float) * 2  # defect
[?2004l[?2004h> score += df_score['ca'] * 1.5  # num vessels
[?2004l[?2004h> score += df_score['exang'] * 1.5  # exercise angina
[?2004l[?2004h> score += df_score['oldpeak'] * 0.5  # ST depression
[?2004l[?2004h> score += (df_score['slope'] == 0).astype(float)  # downsloping
[?2004l[?2004h> score -= df_score['thalach'] / 100  # lower thalach = disease
[?2004l[?2004h> score += df_score['sex'] * 0.5  # male risk
[?2004l[?2004h> score += df_score['age'] / 100  # older = more risk
[?2004l[?2004h> 
[?2004l[?2004h> # Cluster on score
[?2004l[?2004h> from sklearn.cluster import KMeans as KM
[?2004l[?2004h> threshold = np.median(score)
[?2004l[?2004h> candidates['score_median'] = (score >= threshold).astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # KMeans on score
[?2004l[?2004h> score_reshaped = score.reshape(-1, 1)
[?2004l[?2004h> candidates['score_km'] = KMeans(n_clusters=2, n_init=20, random_state=42).fit_predict(score_reshaped)
[?2004l[?2004h> 
[?2004l[?2004h> # Also use score + other features
