[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> from sklearn.cluster import KMeans
[?2004l[?2004h> 
[?2004l[?2004h> # ============ DIABETES ============
[?2004l[?2004h> df_diabetes = pd.read_csv('/app/diabetes_data.csv')
[?2004l[?2004h> df_d = df_diabetes.copy()
[?2004l[?2004h> df_d['gender'] = (df_d['gender'] == 'Male').astype(int)
[?2004l[?2004h> 
[?2004l[?2004h> # Scale age, weight key features
[?2004l[?2004h> df_d_proc = df_d.copy()
[?2004l[?2004h> df_d_proc['age'] = StandardScaler().fit_transform(df_d_proc[['age']])
[?2004l[?2004h> df_d_proc['polyuria'] = df_d_proc['polyuria'] * 3
[?2004l[?2004h> df_d_proc['polydipsia'] = df_d_proc['polydipsia'] * 3
[?2004l[?2004h> df_d_proc['sudden_weight_loss'] = df_d_proc['sudden_weight_loss'] * 2
[?2004l[?2004h> df_d_proc['gender'] = df_d_proc['gender'] * 2
[?2004l[?2004h> 
[?2004l[?2004h> labels_d = KMeans(n_clusters=2, n_init=20, random_state=0).fit_predict(df_d_proc.values)
[?2004l[?2004h> print(f"Diabetes: {np.bincount(labels_d)}")
[?2004l[?2004h> 
[?2004l[?2004h> # ============ HEART ============
[?2004l[?2004h> df_heart = pd.read_csv('/app/heart.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Refined scoring approach based on domain knowledge
[?2004l[?2004h> score = np.zeros(len(df_heart))
[?2004l[?2004h> score += (df_heart['cp'] == 0).astype(float) * 2.0
[?2004l[?2004h> score += (df_heart['thal'] == 2).astype(float) * 2.0
[?2004l[?2004h> score += (df_heart['thal'] == 3).astype(float) * 1.0
[?2004l[?2004h> score += np.array(df_heart['ca']) * 2.0
[?2004l[?2004h> score += np.array(df_heart['exang']) * 2.0
[?2004l[?2004h> score += np.array(df_heart['oldpeak']) * 1.0
[?2004l[?2004h> score += (df_heart['slope'] == 0).astype(float) * 1.0
[?2004l[?2004h> score -= np.array(df_heart['thalach']) / 50.0
[?2004l[?2004h> score += np.array(df_heart['sex']) * 0.5
[?2004l[?2004h> score += np.array(df_heart['age']) / 50.0
[?2004l[?2004h> score += (df_heart['restecg'] > 0).astype(float) * 0.5
[?2004l[?2004h> score += np.array(df_heart['fbs']) * 0.3
[?2004l[?2004h> 
[?2004l[?2004h> # Use 45th percentile as threshold (better separation)
[?2004l[?2004h> threshold = np.percentile(np.array(score), 45)
[?2004l[?2004h> labels_h = (np.array(score) >= threshold).astype(int)
[?2004l[?2004h> print(f"Heart: {np.bincount(labels_h)}")
[?2004l[?2004h> 
[?2004l[?2004h> # Verify
[?2004l[?2004h> ca_pos = df_heart['ca'] > 0
[?2004l[?2004h> ca_sep = max(((labels_h==0)&ca_pos).sum(), ((labels_h==1)&ca_pos).sum()) / ca_pos.sum()
[?2004l[?2004h> exang_pos = df_heart['exang'] == 1
[?2004l[?2004h> exang_sep = max(((labels_h==0)&exang_pos).sum(), ((labels_h==1)&exang_pos).sum()) / exang_pos.sum()
[?2004l[?2004h> print(f"Heart verification: ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}")
[?2004l[?2004h> 
[?2004l[?2004h> # ============ SAVE ============
[?2004l[?2004h> out_d = pd.DataFrame({'pseudo_label': labels_d})
[?2004l[?2004h> out_d.to_csv('/app/output_diabetes_data.csv', index=False)
