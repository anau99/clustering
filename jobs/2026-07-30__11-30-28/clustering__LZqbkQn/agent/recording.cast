[601.758185, "i", "hal_sep = max(thal_in_0, thal_in_1) / thal_pos.sum()\n    \n    # exang separation\n    exang_pos = df_heart['exang'] == 1\n    exang_in_0 = ((labels == 0) & exang_pos).sum()\n    exang_in_1 = ((labels == 1) & exang_pos).sum()\n    exang_sep = max(exang_in_0, exang_in_1) / exang_pos.sum()\n    \n    combined = (ca_sep + thal_sep + exang_sep) / 3\n    print(f\"  {name:<20} {str(counts):<15} {ca_sep:<8.3f} {thal_sep:<10.3f} {exang_sep:<10.3f} {combined:<10.3f}\")\n\n# ============ DIABETES - validate ============\nprint(\"\\nDIABETES validation\")\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_d = df_diabetes.copy()\ndf_d['gender'] = (df_d['gender'] == 'Male').astype(int)\n\ndf_d_proc = df_d.copy()\ndf_d_proc['age'] = StandardScaler().fit_transform(df_d_proc[['age']])\ndf_d_proc['polyuria'] = df_d_proc['polyuria'] * 3\ndf_d_proc['polydipsia'] = df_d_proc['polydipsia'] * 3\ndf_d_proc['sudden_weight_loss'] = df_d_proc['sudden_weight_loss'] * 2\ndf_d_proc['gender'] = df_d_proc['gender'] * 2\n\nlabels_d = KMeans(n_clusters=2, n_init="]
