[601.791303, "o", "\u001b[?2004h"]
[601.79133, "o", "> "]
[601.791531, "o", "print(\"\\n=== FINAL SAVE ===\")\r\n\u001b[?2004l\r"]
[601.791558, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
