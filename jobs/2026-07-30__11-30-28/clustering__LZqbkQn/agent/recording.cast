[601.785245, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.785448, "o", "    combined = (ca_sep + thal_sep + exang_sep) / 3\r\n\u001b[?2004l\r"]
[601.78559, "o", "\u001b[?2004h> "]
[601.785909, "o", "    print(f\"  {name:<20} {str(counts):<15} {ca_sep:<8.3f} {thal_sep:<10.3f} {exang_sep:<10.3f} {combined:<10.3f}\")\r\n\u001b[?2004l\r"]
[601.785939, "o", "\u001b[?2004h"]
[601.786015, "o", "> \r\n\u001b[?2004l\r"]
[601.786202, "o", "\u001b[?2004h> # ============ DIABETES - validate ============\r\n\u001b[?2004l\r"]
[601.786308, "o", "\u001b[?2004h> "]
[601.786417, "o", "print(\"\\nDIABETES validation\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[601.786579, "o", "> "]
[601.786725, "o", "df_diabetes = pd.read_csv('/app/diabetes_data.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.786841, "o", "df_d = df_diabetes.copy()\r\n\u001b[?2004l\r"]
[601.786963, "o", "\u001b[?2004h> "]
[601.787117, "o", "df_d['gender'] = (df_d['gender'] == 'Male').astype(int)\r\n\u001b[?2004l\r"]
[601.787263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.787453, "o", "df_d_proc = df_d.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.78771, "o", "df_d_proc['age'] = StandardScaler().fit_transform(df_d_proc[['age']])\r\n\u001b[?2004l\r"]
[601.787796, "o", "\u001b[?2004h"]
[601.788654, "o", "> df_d_proc['polyuria'] = df_d_proc['polyuria'] * 3\r\n\u001b[?2004l\r\u001b[?2004h> df_d_proc['polydipsia'] = df_d_proc['polydipsia'] * 3\r\n\u001b[?2004l\r\u001b[?2004h> df_d_proc['sudden_weight_loss'] = df_d_proc['sudden_weight_loss'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> df_d_proc['gender'] = df_d_proc['gender'] * 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.788957, "o", "labels_d = KMeans(n_clusters=2, n_init=20, random_state=0).fit_predict(df_d_proc.values)\r\n\u001b[?2004l\r"]
[601.789718, "o", "\u001b[?2004h> print(f\"Diabetes counts: {np.bincount(labels_d)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Validate: Check separation by polyuria, polydipsia, and combined\r\n\u001b[?2004l\r\u001b[?2004h> pp = (df_d['polyuria'] == 1) & (df_d['polydipsia'] == 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.79021, "o", "print(f\"  Polyuria+Polydipsia patients in cluster 0: {((labels_d==0) & pp).sum()}, cluster 1: {((labels_d==1) & pp).sum()}\")\r\n\u001b[?2004l\r"]
[601.790289, "o", "\u001b[?2004h"]
[601.790313, "o", "> "]
[601.790971, "o", "print(f\"  Neither in cluster 0: {((labels_d==0) & ~(df_d['polyuria']==1) & ~(df_d['polydipsia']==1)).sum()}, cluster 1: {((labels_d==1) & ~(df_d['polyuria']==1) & ~(df_d['polydipsia']==1)).sum()}\")\r\n\u001b[?2004l\r"]
[601.791116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
