[121.942934, "o", "\u001b[?2004h"]
[121.942955, "o", "> "]
[121.943659, "o", "# ============ HEART DATASET ============\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n\" + \"=\"*50)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"HEART DATASET\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"=\"*50)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.943882, "o", "df_heart = pd.read_csv('/app/heart.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.943911, "o", "\u001b[?2004h> "]
[121.944142, "o", "cat_cols_heart = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r"]
[121.944274, "o", "\u001b[?2004h> "]
[121.944432, "o", "num_cols_heart = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r"]
[121.944506, "o", "\u001b[?2004h> "]
[121.944526, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.944728, "o", "> "]
[121.944952, "o", "# Approach A: Scale all features (treat categorical as ordinal since they're already numeric)\r\n\u001b[?2004l\r"]
[121.945071, "o", "\u001b[?2004h> "]
[121.945174, "o", "df_h_a = df_heart.copy()"]
[121.945206, "o", "\r\n\u001b[?2004l\r"]
[121.945279, "o", "\u001b[?2004h"]
[121.947641, "o", "> scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_h_a = scaler.fit_transform(df_h_a.values)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> results_h = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for rs in [0, 1, 2, 42, 100, 123]:\r\n\u001b[?2004l\r\u001b[?2004h>     km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=rs)\r\n\u001b[?2004l\r\u001b[?2004h>     labels = km.fit_predict(X_h_a)\r\n\u001b[?2004l\r\u001b[?2004h>     key = f'allscaled_kmeans_rs{rs}'\r\n\u001b[?2004l\r\u001b[?2004h>     results_h[key] = labels\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"  {key}: {np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for cov in ['full', 'tied', 'diag', 'spherical']:\r\n\u001b[?2004l\r\u001b[?2004h>     for rs in [0, 42]:\r\n\u001b[?2004l\r\u001b[?2004h>         gmm = GaussianMixture(n_components=2, covariance_type=cov, random_state=rs, n_init=5)\r\n\u001b[?2004l\r\u001b[?2004h>         labels = gmm.fit_predict(X_h_a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.947878, "o", "        key = f'allscaled_gmm_{cov}_rs{rs}'\r\n\u001b[?2004l\r"]
[121.948649, "o", "\u001b[?2004h>         results_h[key] = labels\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  {key}: {np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for linkage in ['ward', 'complete', 'average']:\r\n\u001b[?2004l\r\u001b[?2004h>     agg = AgglomerativeClustering(n_clusters=2, linkage=linkage)\r\n\u001b[?2004l\r"]
[121.94871, "o", "\u001b[?2004h> "]
[121.948948, "o", "    labels = agg.fit_predict(X_h_a)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.949064, "o", "    key = f'allscaled_agg_{linkage}'\r\n\u001b[?2004l\r"]
[121.949101, "o", "\u001b[?2004h"]
[121.949266, "o", "> "]
[121.949332, "o", "    results_h[key] = labels\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.949542, "o", "    print(f\"  {key}: {np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[121.949624, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[121.949883, "o", "# Approach B: One-hot encode multi-category features, scale numerical\r\n\u001b[?2004l\r"]
[121.949912, "o", "\u001b[?2004h"]
[121.949929, "o", "> "]
[121.950096, "o", "from sklearn.preprocessing import OneHotEncoder\r\n\u001b[?2004l\r"]
[121.950138, "o", "\u001b[?2004h"]
[121.950155, "o", "> "]
[121.950248, "o", "df_h_b = df_heart.copy()\r\n\u001b[?2004l\r"]
[121.950342, "o", "\u001b[?2004h> "]
[121.950518, "o", "multi_cat = ['cp', 'slope', 'ca', 'thal']  # multi-category\r\n\u001b[?2004l\r"]
[121.950547, "o", "\u001b[?2004h"]
[121.950563, "o", "> "]
[121.951456, "o", "binary_cat = ['sex', 'fbs', 'restecg', 'exang']  # binary-ish\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> enc = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\r\n\u001b[?2004l\r\u001b[?2004h> encoded = enc.fit_transform(df_h_b[multi_cat])\r\n\u001b[?2004l\r"]
[121.951595, "o", "\u001b[?2004h> "]
[121.951896, "o", "encoded_df = pd.DataFrame(encoded, columns=enc.get_feature_names_out(multi_cat), index=df_h_b.index)\r\n\u001b[?2004l\r"]
[121.952037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.952239, "o", "df_h_b2 = df_h_b.drop(columns=multi_cat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.952477, "o", "df_h_b2 = pd.concat([df_h_b2, encoded_df], axis=1)\r\n\u001b[?2004l\r"]
[121.952548, "o", "\u001b[?2004h"]
[121.952569, "o", "> \r\n\u001b[?2004l\r"]
[121.952645, "o", "\u001b[?2004h> "]
[121.952994, "o", "# Scale numerical columns\r\n\u001b[?2004l\r"]
[121.953076, "o", "\u001b[?2004h> scaler2 = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.953176, "o", "num_cols_all = ['age'] + num_cols_heart\r\n\u001b[?2004l\r"]
[121.95325, "o", "\u001b[?2004h> "]
[121.953555, "o", "df_h_b2[num_cols_all] = scaler2.fit_transform(df_h_b2[num_cols_all])\r\n"]
[121.953711, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.953749, "o", "\u001b[?2004h> "]
[121.953838, "o", "X_h_b = df_h_b2.values\r\n\u001b[?2004l\r"]
[121.953861, "o", "\u001b[?2004h"]
[121.953937, "o", "> \r\n\u001b[?2004l\r"]
[121.954124, "o", "\u001b[?2004h> "]
[121.954301, "o", "km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42)\r\n\u001b[?2004l\r"]
[121.954444, "o", "\u001b[?2004h> "]
[121.954504, "o", "labels = km.fit_predict(X_h_b)\r\n"]
[121.95452, "o", "\u001b[?2004l\r"]
[121.954673, "o", "\u001b[?2004h> "]
[121.954746, "o", "results_h['onehot_kmeans'] = labels\r\n\u001b[?2004l\r"]
[121.954817, "o", "\u001b[?2004h> "]
[121.955007, "o", "print(f\"  onehot_kmeans: {np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[121.95503, "o", "\u001b[?2004h"]
[121.95569, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> gmm = GaussianMixture(n_components=2, covariance_type='full', random_state=42, n_init=5)\r\n\u001b[?2004l\r\u001b[?2004h> labels = gmm.fit_predict(X_h_b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.955789, "o", "results_h['onehot_gmm'] = labels\r\n\u001b[?2004l\r"]
[121.955976, "o", "\u001b[?2004h> "]
[121.957185, "o", "print(f\"  onehot_gmm: {np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> agg = AgglomerativeClustering(n_clusters=2, linkage='ward')\r\n\u001b[?2004l\r\u001b[?2004h> labels = agg.fit_predict(X_h_b)\r\n\u001b[?2004l\r\u001b[?2004h> results_h['onehot_agg'] = labels\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  onehot_agg: {np.bincount(labels)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # PCA after one-hot\r\n\u001b[?2004l\r"]
[121.957217, "o", "\u001b[?2004h> "]
[121.957391, "o", "pca_h = PCA(n_components=5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.957665, "o", "> X_h_pca = pca_h.fit_transform(X_h_b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.957953, "o", "km = KMeans(n_clusters=2, init='k-means++', n_init=10, random_state=42)\r\n\u001b[?2004l\r"]
[121.958052, "o", "\u001b[?2004h> "]
[121.958213, "o", "labels = km.fit_predict(X_h_pca)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.958378, "o", "results_h['onehot_pca5_kmeans'] = labels\r\n\u001b[?2004l\r"]
[121.958482, "o", "\u001b[?2004h> "]
[121.958677, "o", "print(f\"  onehot_pca5_kmeans: {np.bincount(labels)}\")\r\n\u001b[?2004l\r"]
[121.958797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.959085, "o", "# The heart dataset likely has ~500/525 split (roughly balanced)\r\n\u001b[?2004l\r"]
[121.959208, "o", "\u001b[?2004h> "]
[121.959386, "o", "print(\"\\n--- Heart: Looking for reasonable splits ---\")\r\n\u001b[?2004l\r"]
[121.959467, "o", "\u001b[?2004h> "]
[121.959641, "o", "for key, labels in results_h.items():\r\n\u001b[?2004l\r"]
[121.959711, "o", "\u001b[?2004h> "]
[121.959844, "o", "    counts = np.bincount(labels)\r\n\u001b[?2004l\r"]
[121.95996, "o", "\u001b[?2004h> "]
[121.960068, "o", "    ratio = min(counts) / max(counts)\r\n\u001b[?2004l\r"]
[121.960146, "o", "\u001b[?2004h> "]
[121.960259, "o", "    if 0.3 < ratio < 0.85:\r\n\u001b[?2004l\r"]
[121.960287, "o", "\u001b[?2004h"]
[121.960304, "o", "> "]
[121.960616, "o", "        print(f\"  {key}: {counts} (ratio={ratio:.2f})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.960804, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.960911, "o", "# ============ CHOOSE BEST AND SAVE ============\r\n\u001b[?2004l\r"]
[121.960977, "o", "\u001b[?2004h> "]
[121.961266, "o", "# For diabetes: use GMM with full covariance on age-scaled data\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.961366, "o", "> "]
[121.961589, "o", "# Based on domain knowledge, GMM full covariance typically works well\r\n\u001b[?2004l\r"]
[121.96167, "o", "\u001b[?2004h> "]
[121.961805, "o", "best_d_key = 'gmm_full_rs42'\r\n\u001b[?2004l\r"]
[121.961916, "o", "\u001b[?2004h> "]
[121.962052, "o", "best_diabetes = results_d[best_d_key]\r\n\u001b[?2004l\r"]
[121.962173, "o", "\u001b[?2004h> "]
[121.962417, "o", "print(f\"\\nChosen diabetes: {best_d_key} -> {np.bincount(best_diabetes)}\")\r\n\u001b[?2004l\r"]
[121.962502, "o", "\u001b[?2004h> "]
[121.962525, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[121.962822, "o", "# For heart: use KMeans on all-scaled data (most stable, balanced)\r\n\u001b[?2004l\r"]
[121.962908, "o", "\u001b[?2004h> "]
[121.96306, "o", "best_h_key = 'allscaled_kmeans_rs42'\r\n\u001b[?2004l\r"]
[121.963114, "o", "\u001b[?2004h"]
[121.963171, "o", "> "]
[121.963313, "o", "best_heart = results_h[best_h_key]\r\n"]
[121.963402, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[121.963653, "o", "print(f\"Chosen heart: {best_h_key} -> {np.bincount(best_heart)}\")\r\n\u001b[?2004l\r"]
[121.963733, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[121.963817, "o", "\u001b[?2004h> # Save"]
[121.963839, "o", "\r\n\u001b[?2004l\r"]
[121.963919, "o", "\u001b[?2004h> "]
[121.96416, "o", "out_d = pd.DataFrame({'pseudo_label': best_diabetes})\r\n\u001b[?2004l\r"]
[121.965642, "o", "\u001b[?2004h> out_d.to_csv('/app/output_diabetes_data.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> out_h = pd.DataFrame({'pseudo_label': best_heart})\r\n\u001b[?2004l\r\u001b[?2004h> out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nSaved outputs!\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Diabetes: {out_d['pseudo_label'].value_counts().to_dict()}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[121.965733, "o", "> "]
[121.965954, "o", "print(f\"Heart: {out_h['pseudo_label'].value_counts().to_dict()}\")\r\n\u001b[?2004l\r"]
[121.96607, "o", "\u001b[?2004h> "]
[121.966195, "o", "EOF\r\n\u001b[?2004l\r"]
[121.967722, "o", "\u001b[?2004hroot@e123fae6e01b:/app# "]
[122.391515, "i", "python /app/solve2.py\n"]
[122.391773, "o", "python /app/solve2.py\r\n\u001b[?2004l\r"]
