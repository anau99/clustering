[58.972404, "o", "df_d3 = df_diabetes.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.972631, "o", "df_d3['gender'] = (df_d3['gender'] == 'Male').astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> "]
