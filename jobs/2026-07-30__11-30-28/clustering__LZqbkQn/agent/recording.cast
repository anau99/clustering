[692.629203, "i", "cat > /app/refine.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.cluster import KMeans\nfrom sklearn.mixture import GaussianMixture\n\n# Let me refine the heart approach further\ndf_heart = pd.read_csv('/app/heart.csv')\n\n# The UCI heart dataset labels:\n# 0 = no disease, 1 = disease\n# Key features: cp, thal, ca, exang, oldpeak, slope, thalach\n\n# In the UCI heart dataset:\n# cp: 0=typical angina (disease!), 1=atypical, 2=non-anginal, 3=asymptomatic... \n# Wait, actually in many encodings:\n# cp: 0=typical angina, 1=atypical angina, 2=non-anginal pain, 3=asymptomatic\n# In some versions: higher cp value = less typical = more disease\n# Let's check the distribution\nprint(\"cp value counts:\")\nprint(df_heart['cp'].value_counts().sort_index())\nprint(\"\\nthal value counts:\")\nprint(df_heart['thal'].value_counts().sort_index())\nprint(\"\\nca value counts:\")\nprint(df_heart['ca'].value_counts().sort_index())\nprint(\"\\nslope value counts:\")\nprint(df_heart["]
[692.629336, "i", "'slope'].value_counts().sort_index())\nprint(\"\\nexang value counts:\")\nprint(df_heart['exang'].value_counts().sort_index())\n\n# In the standard UCI heart dataset encoding:\n# cp: 1=typical angina, 2=atypical, 3=non-anginal, 4=asymptomatic\n# But here it's 0-indexed: 0=typical angina, 1=atypical, 2=non-anginal, 3=asymptomatic\n# Disease patients tend to have cp=0 (typical angina) - but actually in many analyses,\n# asymptomatic (cp=3 or cp=0 depending on encoding) is most associated with disease\n# Let's check: in common Kaggle heart datasets, cp=0 is \"typical angina\" \n# and is actually associated with NO disease in some encodings\n\n# Actually, looking at the Kaggle heart disease dataset:\n# cp: Value 0: typical angina, Value 1: atypical angina, Value 2: non-anginal pain, Value 3: asymptomatic\n# Asymptomatic (cp=3) is actually MOST associated with heart disease!\n\n# Let me reconsider the score:\nprint(\"\\n\\nRefined scoring approach:\")\nscore2 = np.zeros(len(df_heart))\n\n# cp=0 (typical angina) - actually this is LESS associa"]
[692.629373, "i", "ted with disease in Kaggle data\n# cp=3 (asymptomatic) - MOST associated with disease\nscore2 += (df_heart['cp'] == 0).astype(float) * 2.0  \n\n# thal: in Kaggle encoding:\n# 0=normal, 1=fixed defect, 2=reversible defect, 3=?\n# Or: 1=normal, 2=fixed defect, 3=reversible defect\n# Reversible defect is most associated with disease\nscore2 += (df_heart['thal'] == 2).astype(float) * 2.0  # reversible defect\nscore2 += (df_heart['thal'] == 3).astype(float) * 1.0  # fixed defect\n\n# ca: number of major vessels colored by fluoroscopy (0-3)\n# Higher = more disease\nscore2 += df_heart['ca'] * 2.0\n\n# exang: exercise induced angina (1=yes)\nscore2 += df_heart['exang'] * 2.0\n\n# oldpeak: ST depression\nscore2 += df_heart['oldpeak'] * 1.0\n\n# slope: 0=upsloping, 1=flat, 2=downsloping\n# In some encodings: downsloping or flat is worse\n# slope=2 (downsloping) associated with disease in some; slope=0 in others\nscore2 += (df_heart['slope'] == 0).astype(float) * 1.0\n\n# thalach: maximum heart rate achieved\n# Lower max HR = more disease\nscore2"]
[692.629404, "i", " -= df_heart['thalach'] / 50.0\n\n# sex: 1=male, higher risk\nscore2 += df_heart['sex'] * 0.5\n\n# age: older = higher risk\nscore2 += df_heart['age'] / 50.0\n\n# restecg: 0=normal, 1=ST-T wave abnormality, 2=left ventricular hypertrophy\nscore2 += (df_heart['restecg'] > 0).astype(float) * 0.5\n\n# fbs: fasting blood sugar > 120 mg/dl\nscore2 += df_heart['fbs'] * 0.3\n\nprint(f\"Score2 stats: mean={score2.mean():.2f}, std={score2.std():.2f}, min={score2.min():.2f}, max={score2.max():.2f}\")\n\n# Try different thresholds\nfor pct in [45, 48, 50, 52, 55]:\n    threshold = np.percentile(score2, pct)\n    labels = (score2 >= threshold).astype(int)\n    ca_pos = df_heart['ca'] > 0\n    ca_sep = max(((labels==0)&ca_pos).sum(), ((labels==1)&ca_pos).sum()) / ca_pos.sum()\n    exang_pos = df_heart['exang'] == 1\n    exang_sep = max(((labels==0)&exang_pos).sum(), ((labels==1)&exang_pos).sum()) / exang_pos.sum()\n    print(f\"  pct={pct}: counts={np.bincount(labels)}, ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\n\n# Use KMeans on the score\nsco"]
[692.629429, "i", "re2_arr = np.array(score2).reshape(-1, 1)\nkm_score = KMeans(n_clusters=2, n_init=20, random_state=42)\nlabels_score_km = km_score.fit_predict(score2_arr)\nprint(f\"\\nScore2 KMeans: {np.bincount(labels_score_km)}\")\nca_pos = df_heart['ca'] > 0\nca_sep = max(((labels_score_km==0)&ca_pos).sum(), ((labels_score_km==1)&ca_pos).sum()) / ca_pos.sum()\nexang_pos = df_heart['exang'] == 1\nexang_sep = max(((labels_score_km==0)&exang_pos).sum(), ((labels_score_km==1)&exang_pos).sum()) / exang_pos.sum()\nprint(f\"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\n\n# Try median on score2\nthreshold_med = np.median(score2)\nlabels_med2 = (np.array(score2) >= threshold_med).astype(int)\nprint(f\"\\nScore2 median: {np.bincount(labels_med2)}\")\nca_sep = max(((labels_med2==0)&ca_pos).sum(), ((labels_med2==1)&ca_pos).sum()) / ca_pos.sum()\nexang_sep = max(((labels_med2==0)&exang_pos).sum(), ((labels_med2==1)&exang_pos).sum()) / exang_pos.sum()\nprint(f\"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\n\n# Compare with the original score approac"]
[692.62945, "i", "h\ndf_score = df_heart.copy()\nscore1 = np.zeros(len(df_score))\nscore1 += (df_score['cp'] == 0).astype(float) * 2\nscore1 += (df_score['thal'] >= 2).astype(float) * 2\nscore1 += df_score['ca'] * 1.5\nscore1 += df_score['exang'] * 1.5\nscore1 += df_score['oldpeak'] * 0.5\nscore1 += (df_score['slope'] == 0).astype(float)\nscore1 -= df_score['thalach'] / 100\nscore1 += df_score['sex'] * 0.5\nscore1 += df_score['age'] / 100\n\nthreshold1 = np.median(np.array(score1))\nlabels_score1 = (np.array(score1) >= threshold1).astype(int)\nprint(f\"\\nOriginal score median: {np.bincount(labels_score1)}\")\nca_sep = max(((labels_score1==0)&ca_pos).sum(), ((labels_score1==1)&ca_pos).sum()) / ca_pos.sum()\nexang_sep = max(((labels_score1==0)&exang_pos).sum(), ((labels_score1==1)&exang_pos).sum()) / exang_pos.sum()\nprint(f\"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\n\n# Save the best heart result\nprint(\"\\n=== SAVING HEART ===\")\n# Use score2 median (more refined domain knowledge)\nout_h = pd.DataFrame({'pseudo_label': labels_med2})\nout_h.to_c"]
[692.629468, "i", "sv('/app/output_heart.csv', index=False)\nprint(f\"Heart saved: {np.bincount(labels_med2)}\")\nprint(\"Done!\")\nEOF\n"]
