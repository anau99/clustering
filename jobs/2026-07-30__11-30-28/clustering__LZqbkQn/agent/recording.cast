[285.16154, "i", "      print(f\"  {name}: sil={sil:.4f}, counts={counts}\")\n\n# ============ FINAL SELECTION ============\nprint(\"\\n\" + \"=\"*60)\nprint(\"FINAL SELECTION\")\nprint(\"=\"*60)\n\n# For diabetes: pick the best silhouette with reasonable split\n# Expected split: ~200/320 (positive class is larger)\nbest_d_name = sorted_d[0][0]\nbest_d_labels = sorted_d[0][1][0]\nprint(f\"Diabetes: {best_d_name}, sil={sorted_d[0][1][1]:.4f}, counts={np.bincount(best_d_labels)}\")\n\n# For heart: pick the one with best silhouette and reasonable split\n# Filter to those with reasonable balance\nfor name, (labels, sil) in sorted_h:\n    counts = np.bincount(labels)\n    if min(counts) > 300 and max(counts) < 750:\n        best_h_name = name\n        best_h_labels = labels\n        print(f\"Heart: {name}, sil={sil:.4f}, counts={counts}\")\n        break\n\n# Save\nout_d = pd.DataFrame({'pseudo_label': best_d_labels})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\nprint(f\"\\nSaved diabetes: {out_d['pseudo_label'].value_counts().to_dict()}\")\n\nout_h = pd.DataFr"]
