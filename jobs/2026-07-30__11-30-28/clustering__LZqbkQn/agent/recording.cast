[694.632535, "o", "  ca_sep=0.676, exang_sep=0.670\r\n"]
[694.632918, "o", "\r\nScore2 median: [508 517]\r\n"]
[694.633575, "o", "  ca_sep=0.832, exang_sep=0.890\r\n"]
[694.637075, "o", "\r\nOriginal score median: [508 517]\r\n"]
[694.637816, "o", "  ca_sep=0.821, exang_sep=0.913\r\n\r\n=== SAVING HEART ===\r\n"]
