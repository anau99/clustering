[692.635649, "o", "\u001b[?2004h> "]
[692.635869, "o", "# In some versions: higher cp value = less typical = more disease"]
[692.636036, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.636151, "o", "> "]
[692.63652, "o", "# Let's check the distribution\r\n"]
[692.636708, "o", "\u001b[?2004l\r"]
[692.638654, "o", "\u001b[?2004h> "]
[692.638891, "o", "print(\"cp value counts:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(df_heart['cp'].value_counts().sort_index())\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nthal value counts:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(df_heart['thal'].value_counts().sort_index())\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nca value counts:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(df_heart['ca'].value_counts().sort_index())\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nslope value counts:\")\r\n\u001b[?2004l\r\u001b[?2004h> print(df_heart['slope'].value_counts().sort_index())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.639003, "o", "print(\"\\nexang value counts:\")\r\n\u001b[?2004l\r"]
[692.639023, "o", "\u001b[?2004h> "]
[692.639293, "o", "print(df_heart['exang'].value_counts().sort_index())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[692.639438, "o", "\u001b[?2004h"]
[692.640696, "o", "> # In the standard UCI heart dataset encoding:\r\n\u001b[?2004l\r\u001b[?2004h> # cp: 1=typical angina, 2=atypical, 3=non-anginal, 4=asymptomatic\r\n\u001b[?2004l\r\u001b[?2004h> # But here it's 0-indexed: 0=typical angina, 1=atypical, 2=non-anginal, 3=asymptomatic\r\n\u001b[?2004l\r\u001b[?2004h> # Disease patients tend to have cp=0 (typical angina) - but actually in many analyses,\r\n\u001b[?2004l\r\u001b[?2004h> # asymptomatic (cp=3 or cp=0 depending on encoding) is most associated with disease\r\n\u001b[?2004l\r"]
[692.640828, "o", "\u001b[?2004h> "]
[692.641079, "o", "# Let's check: in common Kaggle heart datasets, cp=0 is \"typical angina\" \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.641395, "o", "# and is actually associated with NO disease in some encodings\r\n\u001b[?2004l\r"]
[692.641428, "o", "\u001b[?2004h> "]
[692.641448, "o", "\r\n\u001b[?2004l\r"]
[692.641574, "o", "\u001b[?2004h> "]
[692.642688, "o", "# Actually, looking at the Kaggle heart disease dataset:\r\n\u001b[?2004l\r\u001b[?2004h> # cp: Value 0: typical angina, Value 1: atypical angina, Value 2: non-anginal pain, Value 3: asymptomatic\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.643937, "o", "# Asymptomatic (cp=3) is actually MOST associated with heart disease!\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Let me reconsider the score:\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n\\nRefined scoring approach:\")\r\n\u001b[?2004l\r\u001b[?2004h> score2 = np.zeros(len(df_heart))\r\n\u001b[?2004l\r"]
[692.644074, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.64449, "o", "# cp=0 (typical angina) - actually this is LESS associated with disease in Kaggle data\r\n\u001b[?2004l\r"]
[692.644725, "o", "\u001b[?2004h> "]
[692.6449, "o", "# cp=3 (asymptomatic) - MOST associated with disease\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.645162, "o", "score2 += (df_heart['cp'] == 0).astype(float) * 2.0  \r\n\u001b[?2004l\r"]
[692.645266, "o", "\u001b[?2004h"]
[692.645299, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.645757, "o", "# thal: in Kaggle encoding:\r\n\u001b[?2004l\r"]
[692.645859, "o", "\u001b[?2004h> # 0=normal, 1=fixed defect, 2=reversible defect, 3=?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.646204, "o", "# Or: 1=normal, 2=fixed defect, 3=reversible defect\r\n\u001b[?2004l\r"]
[692.646258, "o", "\u001b[?2004h"]
[692.64647, "o", "> "]
[692.646671, "o", "# Reversible defect is most associated with disease"]
[692.646753, "o", "\r\n\u001b[?2004l\r"]
[692.646889, "o", "\u001b[?2004h> "]
[692.647164, "o", "score2 += (df_heart['thal'] == 2).astype(float) * 2.0  # reversible defect"]
[692.647256, "o", "\r\n\u001b[?2004l\r"]
[692.647676, "o", "\u001b[?2004h> score2 += (df_heart['thal'] == 3).astype(float) * 1.0  # fixed defect\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.647909, "o", "# ca: number of major vessels colored by fluoroscopy (0-3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.648043, "o", "# Higher = more disease\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.648072, "o", "> "]
[692.648275, "o", "score2 += df_heart['ca'] * 2.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[692.6483, "o", "\u001b[?2004h> "]
[692.648486, "o", "# exang: exercise induced angina (1=yes)\r\n\u001b[?2004l\r"]
[692.648507, "o", "\u001b[?2004h"]
[692.648519, "o", "> "]
[692.648832, "o", "score2 += df_heart['exang'] * 2.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.648903, "o", "# oldpeak: ST depression\r\n\u001b[?2004l\r"]
[692.648962, "o", "\u001b[?2004h> "]
[692.649156, "o", "score2 += df_heart['oldpeak'] * 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.649247, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.649419, "o", "# slope: 0=upsloping, 1=flat, 2=downsloping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.649603, "o", "# In some encodings: downsloping or flat is worse\r\n\u001b[?2004l\r"]
[692.649749, "o", "\u001b[?2004h> "]
[692.649958, "o", "# slope=2 (downsloping) associated with disease in some; slope=0 in others\r\n\u001b[?2004l\r"]
[692.650029, "o", "\u001b[?2004h"]
[692.650246, "o", "> "]
[692.650653, "o", "score2 += (df_heart['slope'] == 0).astype(float) * 1.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # thalach: maximum heart rate achieved\r\n\u001b[?2004l\r\u001b[?2004h> # Lower max HR = more disease\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.650887, "o", "score2 -= df_heart['thalach'] / 50.0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[692.650972, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[692.651211, "o", "# sex: 1=male, higher risk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.651281, "o", "score2 += df_heart['sex'] * 0.5\r\n\u001b[?2004l\r"]
[692.651301, "o", "\u001b[?2004h"]
[692.651315, "o", "> "]
[692.651329, "o", "\r\n"]
[692.651632, "o", "\u001b[?2004l\r\u001b[?2004h> # age: older = higher risk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.651735, "o", "score2 += df_heart['age'] / 50.0\r\n\u001b[?2004l\r"]
[692.651819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[692.65184, "o", "\u001b[?2004h"]
[692.65212, "o", "> "]
[692.652193, "o", "# restecg: 0=normal, 1=ST-T wave abnormality, 2=left ventricular hypertrophy\r\n\u001b[?2004l\r"]
[692.652218, "o", "\u001b[?2004h"]
[692.652248, "o", "> "]
[692.652454, "o", "score2 += (df_heart['restecg'] > 0).astype(float) * 0.5\r\n\u001b[?2004l\r"]
[692.652631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.652764, "o", "# fbs: fasting blood sugar > 120 mg/dl\r\n\u001b[?2004l\r"]
[692.652878, "o", "\u001b[?2004h> "]
[692.652971, "o", "score2 += df_heart['fbs'] * 0.3\r\n\u001b[?2004l\r"]
[692.653014, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[692.653043, "o", "\u001b[?2004h> "]
[692.653462, "o", "print(f\"Score2 stats: mean={score2.mean():.2f}, std={score2.std():.2f}, min={score2.min():.2f}, max={score2.max():.2f}\")\r\n\u001b[?2004l\r"]
[692.653546, "o", "\u001b[?2004h"]
[692.653569, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[692.653585, "o", "> "]
[692.653939, "o", "# Try different thresholds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.654001, "o", "for pct in [45, 48, 50, 52, 55]:\r\n"]
[692.654053, "o", "\u001b[?2004l\r"]
[692.654068, "o", "\u001b[?2004h> "]
[692.654249, "o", "    threshold = np.percentile(score2, pct)\r\n\u001b[?2004l\r"]
[692.654454, "o", "\u001b[?2004h> "]
[692.654654, "o", "    labels = (score2 >= threshold).astype(int)\r\n\u001b[?2004l\r"]
[692.654686, "o", "\u001b[?2004h"]
[692.654704, "o", "> "]
[692.654947, "o", "    ca_pos = df_heart['ca'] > 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.655239, "o", "    ca_sep = max(((labels==0)&ca_pos).sum(), ((labels==1)&ca_pos).sum()) / ca_pos.sum()\r\n\u001b[?2004l\r"]
[692.655307, "o", "\u001b[?2004h"]
[692.65537, "o", "> "]
[692.655461, "o", "    exang_pos = df_heart['exang'] == 1\r\n\u001b[?2004l\r"]
[692.655562, "o", "\u001b[?2004h> "]
[692.655953, "o", "    exang_sep = max(((labels==0)&exang_pos).sum(), ((labels==1)&exang_pos).sum()) / exang_pos.sum()\r\n\u001b[?2004l\r"]
[692.656018, "o", "\u001b[?2004h> "]
[692.656373, "o", "    print(f\"  pct={pct}: counts={np.bincount(labels)}, ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\r\n\u001b[?2004l\r"]
[692.656514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.656847, "o", "# Use KMeans on the score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.656935, "o", "score2_arr = np.array(score2).reshape(-1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.657206, "o", "km_score = KMeans(n_clusters=2, n_init=20, random_state=42)\r\n\u001b[?2004l\r"]
[692.657353, "o", "\u001b[?2004h"]
[692.657467, "o", "> "]
[692.657543, "o", "labels_score_km = km_score.fit_predict(score2_arr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.657803, "o", "print(f\"\\nScore2 KMeans: {np.bincount(labels_score_km)}\")\r\n\u001b[?2004l\r"]
[692.657904, "o", "\u001b[?2004h> "]
[692.658001, "o", "ca_pos = df_heart['ca'] > 0\r\n\u001b[?2004l\r"]
[692.658024, "o", "\u001b[?2004h"]
[692.658039, "o", "> "]
[692.658433, "o", "ca_sep = max(((labels_score_km==0)&ca_pos).sum(), ((labels_score_km==1)&ca_pos).sum()) / ca_pos.sum()\r\n\u001b[?2004l\r"]
[692.65852, "o", "\u001b[?2004h> "]
[692.658701, "o", "exang_pos = df_heart['exang'] == 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.659081, "o", "exang_sep = max(((labels_score_km==0)&exang_pos).sum(), ((labels_score_km==1)&exang_pos).sum()) / exang_pos.sum()\r\n\u001b[?2004l\r"]
[692.659104, "o", "\u001b[?2004h"]
[692.659119, "o", "> "]
[692.659383, "o", "print(f\"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\r\n\u001b[?2004l\r"]
[692.659503, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[692.659571, "o", "> "]
[692.659641, "o", "# Try median on score2\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.659665, "o", "> "]
[692.659881, "o", "threshold_med = np.median(score2)\r\n\u001b[?2004l\r"]
[692.660112, "o", "\u001b[?2004h> "]
[692.660204, "o", "labels_med2 = (np.array(score2) >= threshold_med).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.66023, "o", "> "]
[692.660383, "o", "print(f\"\\nScore2 median: {np.bincount(labels_med2)}\")\r\n"]
[692.66041, "o", "\u001b[?2004l\r"]
[692.660438, "o", "\u001b[?2004h"]
[692.661638, "o", "> ca_sep = max(((labels_med2==0)&ca_pos).sum(), ((labels_med2==1)&ca_pos).sum()) / ca_pos.sum()\r\n\u001b[?2004l\r\u001b[?2004h> exang_sep = max(((labels_med2==0)&exang_pos).sum(), ((labels_med2==1)&exang_pos).sum()) / exang_pos.sum()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Compare with the original score approach\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.661797, "o", "df_score = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.661997, "o", "score1 = np.zeros(len(df_score))\r\n\u001b[?2004l\r"]
[692.66203, "o", "\u001b[?2004h> "]
[692.662299, "o", "score1 += (df_score['cp'] == 0).astype(float) * 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.662444, "o", "score1 += (df_score['thal'] >= 2).astype(float) * 2\r\n\u001b[?2004l\r"]
[692.662482, "o", "\u001b[?2004h> "]
[692.662696, "o", "score1 += df_score['ca'] * 1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.6628, "o", "> "]
[692.662885, "o", "score1 += df_score['exang'] * 1.5\r\n\u001b[?2004l\r"]
[692.662941, "o", "\u001b[?2004h> "]
[692.663141, "o", "score1 += df_score['oldpeak'] * 0.5\r\n\u001b[?2004l\r"]
[692.663213, "o", "\u001b[?2004h> "]
[692.663421, "o", "score1 += (df_score['slope'] == 0).astype(float)\r\n\u001b[?2004l\r"]
[692.663493, "o", "\u001b[?2004h> "]
[692.6637, "o", "score1 -= df_score['thalach'] / 100\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.664639, "o", "> score1 += df_score['sex'] * 0.5\r\n\u001b[?2004l\r\u001b[?2004h> score1 += df_score['age'] / 100\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> threshold1 = np.median(np.array(score1))\r\n\u001b[?2004l\r\u001b[?2004h> labels_score1 = (np.array(score1) >= threshold1).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\nOriginal score median: {np.bincount(labels_score1)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.664914, "o", "ca_sep = max(((labels_score1==0)&ca_pos).sum(), ((labels_score1==1)&ca_pos).sum()) / ca_pos.sum()\r\n\u001b[?2004l\r"]
[692.665033, "o", "\u001b[?2004h"]
[692.665236, "o", "> "]
[692.665407, "o", "exang_sep = max(((labels_score1==0)&exang_pos).sum(), ((labels_score1==1)&exang_pos).sum()) / exang_pos.sum()\r\n\u001b[?2004l\r"]
[692.665542, "o", "\u001b[?2004h> "]
[692.665744, "o", "print(f\"  ca_sep={ca_sep:.3f}, exang_sep={exang_sep:.3f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.665875, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.665962, "o", "# Save the best heart result\r\n\u001b[?2004l\r"]
[692.666121, "o", "\u001b[?2004h> "]
[692.666309, "o", "print(\"\\n=== SAVING HEART ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.66643, "o", "# Use score2 median (more refined domain knowledge)\r\n\u001b[?2004l\r"]
[692.66659, "o", "\u001b[?2004h> "]
[692.666755, "o", "out_h = pd.DataFrame({'pseudo_label': labels_med2})\r\n\u001b[?2004l\r"]
[692.666871, "o", "\u001b[?2004h> "]
[692.667056, "o", "out_h.to_csv('/app/output_heart.csv', index=False)\r\n\u001b[?2004l\r"]
[692.667125, "o", "\u001b[?2004h"]
[692.667283, "o", "> "]
[692.667439, "o", "print(f\"Heart saved: {np.bincount(labels_med2)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[692.667467, "o", "print(\"Done!\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[692.66754, "o", "> "]
[692.667572, "o", "EOF\r\n\u001b[?2004l\r"]
[692.668923, "o", "\u001b[?2004hroot@e123fae6e01b:/app# "]
[693.118405, "i", "python /app/refine.py\n"]
[693.118662, "o", "python /app/refine.py\r\n\u001b[?2004l\r"]
[694.581446, "o", "cp value counts:\r\n"]
[694.583192, "o", "cp\r\n0    497\r\n1    167\r\n2    284\r\n3     77\r\nName: count, dtype: int64\r\n\r\nthal value counts:\r\n"]
[694.584221, "o", "thal\r\n0      7\r\n1     64\r\n2    544\r\n3    410\r\nName: count, dtype: int64\r\n\r\nca value counts:\r\n"]
[694.585026, "o", "ca\r\n0    578\r\n1    226\r\n2    134\r\n3     69\r\n4     18\r\nName: count, dtype: int64\r\n\r\nslope value counts:\r\n"]
[694.585961, "o", "slope\r\n0     74\r\n1    482\r\n2    469\r\nName: count, dtype: int64\r\n\r\nexang value counts:\r\n"]
[694.586672, "o", "exang\r\n0    680\r\n1    345\r\nName: count, dtype: int64\r\n\r\n\r\nRefined scoring approach:"]
[694.586754, "o", "\r\n"]
[694.590966, "o", "Score2 stats: mean=4.51, std=3.64, min=-2.26, max=14.78\r\n"]
[694.592754, "o", "  pct=45: counts=[460 565], ca_sep=0.890, exang_sep=0.948\r\n"]
[694.594391, "o", "  pct=48: counts=[492 533], ca_sep=0.855, exang_sep=0.910\r\n"]
[694.596024, "o", "  pct=50: counts=[508 517], ca_sep=0.832, exang_sep=0.890\r\n"]
[694.597591, "o", "  pct=52: counts=[530 495], ca_sep=0.790, exang_sep=0.881\r\n"]
