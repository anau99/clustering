[601.794087, "o", "    max(((candidates[k]==0) & (df_heart['thal']>=2)).sum(), ((candidates[k]==1) & (df_heart['thal']>=2)).sum()) / (df_heart['thal']>=2).sum() +\r\n\u001b[?2004l\r"]
[601.794184, "o", "\u001b[?2004h"]
[601.794653, "o", "> "]
[601.794875, "o", "    max(((candidates[k]==0) & (df_heart['exang']==1)).sum(), ((candidates[k]==1) & (df_heart['exang']==1)).sum()) / (df_heart['exang']==1).sum()\r\n\u001b[?2004l\r\u001b[?2004h> ))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[601.794959, "o", "\r\n\u001b[?2004l\r"]
