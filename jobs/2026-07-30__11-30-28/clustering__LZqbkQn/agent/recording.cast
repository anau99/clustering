[694.828314, "o", "\u001b[?2004hroot@e123fae6e01b:/app# "]
[728.707706, "i", "cat > /app/save_final.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.cluster import KMeans\n\n# ============ DIABETES ============\ndf_diabetes = pd.read_csv('/app/diabetes_data.csv')\ndf_d = df_diabetes.copy()\ndf_d['gender'] = (df_d['gender'] == 'Male').astype(int)\n\n# Scale age, weight key features\ndf_d_proc = df_d.copy()\ndf_d_proc['age'] = StandardScaler().fit_transform(df_d_proc[['age']])\ndf_d_proc['polyuria'] = df_d_proc['polyuria'] * 3\ndf_d_proc['polydipsia'] = df_d_proc['polydipsia'] * 3\ndf_d_proc['sudden_weight_loss'] = df_d_proc['sudden_weight_loss'] * 2\ndf_d_proc['gender'] = df_d_proc['gender'] * 2\n\nlabels_d = KMeans(n_clusters=2, n_init=20, random_state=0).fit_predict(df_d_proc.values)\nprint(f\"Diabetes: {np.bincount(labels_d)}\")\n\n# ============ HEART ============\ndf_heart = pd.read_csv('/app/heart.csv')\n\n# Refined scoring approach based on domain knowledge\nscore = np.zeros(len(df_heart))\nscore += (df_heart['cp'] == 0).astype(float) * 2.0\n"]
[728.70777, "i", "score += (df_heart['thal'] == 2).astype(float) * 2.0\nscore += (df_heart['thal'] == 3).astype(float) * 1.0\nscore += np.array(df_heart['ca']) * 2.0\nscore += np.array(df_heart['exang']) * 2.0\nscore += np.array(df_heart['oldpeak']) * 1.0\nscore += (df_heart['slope'] == 0).astype(float) * 1.0\nscore -= np.array(df_heart['thalach']) / 50.0\nscore += np.array(df_heart['sex']) * 0.5\nscore += np.array(df_heart['age']) / 50.0\nscore += (df_heart['restecg'] > 0).astype(float) * 0.5\nscore += np.array(df_heart['fbs']) * 0.3\n\n# Use 45th percentile as threshold (better separation)\nthreshold = np.percentile(np.array(score), 45)\nlabels_h = (np.array(score) >= threshold).astype(int)\nprint(f\"Heart: {np.bincount(labels_h)}\")\n\n# Verify\nca_pos = df_heart['ca'] > 0\nca_sep = max(((labels_h==0)&ca_pos).sum(), ((labels_h==1)&ca_pos).sum()) / ca_pos.sum()\nexang_pos = df_heart['exang'] == 1\nexang_sep = max(((labels_h==0)&exang_pos).sum(), ((labels_h==1)&exang_pos).sum()) / exang_pos.sum()\nprint(f\"Heart verification: ca_sep={ca_sep:.3f}, exa"]
[728.707792, "i", "ng_sep={exang_sep:.3f}\")\n\n# ============ SAVE ============\nout_d = pd.DataFrame({'pseudo_label': labels_d})\nout_d.to_csv('/app/output_diabetes_data.csv', index=False)\n\nout_h = pd.DataFrame({'pseudo_label': labels_h})\nout_h.to_csv('/app/output_heart.csv', index=False)\n\nprint(\"\\nFiles saved!\")\nprint(f\"Diabetes shape: {out_d.shape}, values: {sorted(out_d['pseudo_label'].unique())}\")\nprint(f\"Heart shape: {out_h.shape}, values: {sorted(out_h['pseudo_label'].unique())}\")\nEOF\n"]
