[58.979108, "o", "\u001b[?2004h> "]
[58.979264, "o", "# Categorical: sex, cp, fbs, restecg, exang, slope, ca, thal\r\n\u001b[?2004l\r"]
[58.979643, "o", "\u001b[?2004h> "]
[58.979742, "o", "# Note: 'age' is in the dataset but not listed as numerical feature to use\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.980639, "o", "\u001b[?2004h> cat_cols_heart = ['sex', 'cp', 'fbs', 'restecg', 'exang', 'slope', 'ca', 'thal']\r\n\u001b[?2004l\r\u001b[?2004h> num_cols_heart = ['trestbps', 'chol', 'thalach', 'oldpeak']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.980807, "o", "# Approach 1: One-hot encode categorical, standard scale numerical\r\n\u001b[?2004l\r"]
[58.980839, "o", "\u001b[?2004h"]
[58.980856, "o", "> "]
[58.981137, "o", "df_h = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.981504, "o", "> df_h_enc = one_hot_encoder(df_h, columns=cat_cols_heart)\r\n\u001b[?2004l\r\u001b[?2004h> df_h_enc = standard_scaler(df_h_enc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.981535, "o", "> \r\n\u001b[?2004l\r"]
[58.981689, "o", "\u001b[?2004h> "]
[58.981926, "o", "labels_h_kmeans = kmeans(df_h_enc.values, 2)"]
[58.982662, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> labels_h_gmm = gaussian_mixture(df_h_enc.values, 2)\r\n\u001b[?2004l\r\u001b[?2004h> labels_h_agg = agglomerative(df_h_enc.values, 2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Approach 2: Scale all (treat categorical as ordinal)\r\n"]
[58.982969, "o", "\u001b[?2004l\r\u001b[?2004h> df_h2 = df_heart.copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.983114, "o", "df_h2_scaled = standard_scaler(df_h2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.983315, "o", "labels_h_kmeans2 = kmeans(df_h2_scaled.values, 2)\r\n\u001b[?2004l\r"]
[58.983431, "o", "\u001b[?2004h> "]
[58.983588, "o", "labels_h_gmm2 = gaussian_mixture(df_h2_scaled.values, 2)\r\n\u001b[?2004l\r"]
[58.983692, "o", "\u001b[?2004h> "]
[58.983866, "o", "labels_h_agg2 = agglomerative(df_h2_scaled.values, 2)\r\n\u001b[?2004l\r"]
[58.983891, "o", "\u001b[?2004h> "]
[58.983989, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.984647, "o", "# Approach 3: One-hot encode, standard scale, then spectral\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     labels_h_spectral = spectral(df_h_enc.values, 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.984734, "o", "    print(f\"Spectral (onehot+scaled): {np.bincount(labels_h_spectral)}\")\r\n\u001b[?2004l\r"]
[58.984761, "o", "\u001b[?2004h> "]
[58.98487, "o", "except Exception as e:\r\n\u001b[?2004l\r"]
[58.984966, "o", "\u001b[?2004h> "]
[58.985064, "o", "    print(f\"Spectral failed: {e}\")\r\n\u001b[?2004l\r"]
[58.985132, "o", "\u001b[?2004h> "]
[58.985363, "o", "    labels_h_spectral = labels_h_kmeans\r\n\u001b[?2004l\r"]
