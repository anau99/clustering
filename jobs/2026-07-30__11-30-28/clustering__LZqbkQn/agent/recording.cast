[16.166571, "o", "cat /app/src/cluster/kmean.py\r\n\u001b[?2004l\r"]
[16.168084, "o", "from sklearn.cluster import KMeans\r\n\r\n\r\ndef kmeans(X, k):\r\n    model = KMeans(\r\n        n_clusters=k,\r\n        init=\"k-means++\",\r\n        n_init=\"auto\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[16.168714, "o", "\u001b[?2004hroot@e123fae6e01b:/app# "]
[16.291885, "i", "cat /app/src/cluster/gaussian_mixture.py\n"]
[16.292288, "o", "cat /app/src/cluster/gaussian_mixture.py\r\n\u001b[?2004l\r"]
[16.294434, "o", "from sklearn.mixture import GaussianMixture\r\n\r\n\r\ndef gaussian_mixture(X, k):\r\n    model = GaussianMixture(\r\n        n_components=k,\r\n        covariance_type=\"full\",\r\n        random_state=42\r\n    )\r\n    return model.fit_predict(X)"]
[16.294808, "o", "\u001b[?2004h"]
[16.294872, "o", "root@e123fae6e01b:/app# "]
[16.415244, "i", "cat /app/src/transform/OnehotEncoder.py\n"]
[16.41568, "o", "cat /app/src/transform/OnehotEncoder.py\r\n\u001b[?2004l\r"]
[16.417234, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import OneHotEncoder\r\n\r\n\r\ndef one_hot_encoder(df: pd.DataFrame,columns=None,encode_all=False) -> pd.DataFrame:\r\n\r\n    result = df.copy()\r\n    if columns is not None:\r\n        pass\r\n\r\n    elif encode_all:\r\n        columns = result.columns.tolist()\r\n    else:\r\n        columns = result.select_dtypes(\r\n            include=[\"object\", \"category\"]\r\n        ).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    encoder = OneHotEncoder(\r\n        sparse_output=False,\r\n        handle_unknown=\"ignore\"\r\n    )\r\n\r\n    encoded = encoder.fit_transform(result[columns])\r\n\r\n    encoded_df = pd.DataFrame(\r\n        encoded,\r\n        columns=encoder.get_feature_names_out(columns),\r\n        index=result.index\r\n    )\r\n\r\n    result = result.drop(columns=columns)\r\n    result = pd.concat([result, encoded_df], axis=1)\r\n\r\n    return result"]
[16.418265, "o", "\u001b[?2004hroot@e123fae6e01b:/app# "]
[16.523112, "i", "cat /app/src/transform/StandardScaler.py\n"]
[16.523556, "o", "cat /app/src/transform/StandardScaler.py\r\n\u001b[?2004l\r"]
[16.524824, "o", "import pandas as pd\r\nfrom sklearn.preprocessing import StandardScaler\r\n\r\n\r\ndef standard_scaler(df: pd.DataFrame, columns=None) -> pd.DataFrame:\r\n    \"\"\"\r\n    Standardize selected columns.\r\n    \"\"\"\r\n    result = df.copy()\r\n\r\n    if columns is None:\r\n        columns = result.select_dtypes(include=[\"number\"]).columns.tolist()\r\n\r\n    if len(columns) == 0:\r\n        return result\r\n\r\n    scaler = StandardScaler()\r\n    result[columns] = scaler.fit_transform(result[columns])\r\n\r\n    return result"]
